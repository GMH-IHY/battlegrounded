--!strict
-- FungusParts (ModuleScript)
-- Location: ReplicatedStorage > Combat > FungusParts
--
-- The Lotus Fungus growing on a character (data: FungusData, generated by tools/models/fungus.py).
-- The SERVER builds it once (Attach) and shows the pieces of the current meter stage and below
-- (SetStage); the change replicates, so the growth snaps from stage to stage for everyone, never
-- swelling smoothly (docs/art/ArtDirection.md). The hand always stays bare.
-- Every piece is massless, never collides and can't be hit.

local Data = require(script.Parent.FungusData)

local FungusParts = {}

local FOLDER = "Fungus"
local GLOW = Color3.fromRGB(16, 152, 168)
local GLOW_FORM = Color3.fromRGB(90, 230, 240)

local function quiet(part: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
end

function FungusParts.Attach(character: Model): Model
	local old = character:FindFirstChild(FOLDER)
	if old then
		old:Destroy()
	end
	local model = Instance.new("Model")
	model.Name = FOLDER
	for i, spec in Data.Parts do
		local limb = character:FindFirstChild(spec.Limb)
		if limb and limb:IsA("BasePart") then
			local part = Instance.new("Part")
			part.Name = string.format("%s%d", spec.Name, i)
			part.Shape = if spec.Shape == "Ball" then Enum.PartType.Ball else Enum.PartType.Block
			part.Size = spec.Size
			part.Color = spec.Color
			part.Material = if spec.Neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
			quiet(part)
			part.CFrame = limb.CFrame * spec.CFrame
			part.Transparency = 1
			part:SetAttribute("Stage", spec.Stage)
			part:SetAttribute("Glow", spec.Neon)
			local weld = Instance.new("Weld")
			weld.Part0 = limb
			weld.Part1 = part
			weld.C0 = spec.CFrame
			weld.Parent = part
			part.Parent = model
		end
	end
	model:SetAttribute("Stage", 0)
	model.Parent = character
	return model
end

-- Shows the growth of `stage` (0 = none) and below. form = the stage 3 form: the glowing specks
-- burn brighter.
function FungusParts.SetStage(character: Model, stage: number, form: boolean?)
	local model = character:FindFirstChild(FOLDER)
	if not model then
		return
	end
	local key = stage + (if form then 10 else 0)
	if model:GetAttribute("Stage") == key then
		return
	end
	model:SetAttribute("Stage", key)
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") then
			local partStage = part:GetAttribute("Stage")
			local shown = typeof(partStage) == "number" and partStage <= stage
			part.Transparency = if shown then 0 else 1
			if part:GetAttribute("Glow") == true then
				part.Color = if form then GLOW_FORM else GLOW
			end
		end
	end
end

return FungusParts
