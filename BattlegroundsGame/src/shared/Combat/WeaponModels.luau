--!strict
-- WeaponModels (ModuleScript)
-- Location: ReplicatedStorage > Combat > WeaponModels
--
-- Builds the sword and the dagger out of parts (data: WeaponModelsData, generated by
-- tools/models/weapons.py) and puts them on an R6 character. Call Attach on the SERVER so everyone
-- sees them:  WeaponModels.Attach(character)
--
--   Right Arm > SwordGrip   an invisible bone on a Motor6D (a wrist): animations key it to turn the
--                           blade. Unkeyed, the blade points along the arm's forward.
--   Torso > Sheath          the scabbard on the left hip.
--   Dagger                  welded to the hip (sheathed) or to the left hand (drawn). Drawing is a
--                           local change each client makes itself (SetDaggerDrawn): CombatClient
--                           for your own character right away, CombatFx for everyone else's.
-- Every piece is massless, never collides and can't be hit, so weapons don't change movement or
-- hitboxes.

local Data = require(script.Parent.WeaponModelsData)

local WeaponModels = {}

local FOLDER = "Weapons"

local function quiet(part: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
end

local function makeRoot(name: string, cframe: CFrame, parent: Instance): Part
	local root = Instance.new("Part")
	root.Name = name
	root.Size = Vector3.new(0.2, 0.2, 0.2)
	root.Transparency = 1
	quiet(root)
	root.CFrame = cframe
	root.Parent = parent
	return root
end

local function build(group: string, root: BasePart, parent: Instance)
	for _, spec in Data.Parts do
		if spec.Bone == group then
			local part = Instance.new("Part")
			part.Name = group .. spec.Name
			part.Size = spec.Size
			part.Color = spec.Color
			part.Material = spec.Material
			quiet(part)
			part.CFrame = root.CFrame * spec.CFrame
			local weld = Instance.new("Weld")
			weld.Part0 = root
			weld.Part1 = part
			weld.C0 = spec.CFrame
			weld.Parent = part
			part.Parent = parent
		end
	end
end

local function limb(character: Model, name: string): BasePart
	local part = character:FindFirstChild(name)
	assert(part and part:IsA("BasePart"), "WeaponModels: character has no " .. name)
	return part
end

function WeaponModels.Detach(character: Model)
	local old = character:FindFirstChild(FOLDER)
	if old then
		old:Destroy()
	end
	for _, joint in Data.Joints do
		local part0 = character:FindFirstChild(joint.Part0)
		local motor = part0 and part0:FindFirstChild(joint.Name)
		if motor and motor:IsA("Motor6D") then
			motor:Destroy()
		end
	end
end

function WeaponModels.Attach(character: Model): Model
	WeaponModels.Detach(character)
	local model = Instance.new("Model")
	model.Name = FOLDER

	-- The sword on its animated grip bone.
	for _, joint in Data.Joints do
		local part0 = limb(character, joint.Part0)
		local bone = makeRoot(joint.Name, part0.CFrame * joint.C0, model)
		local motor = Instance.new("Motor6D")
		motor.Name = joint.Name
		motor.Part0 = part0
		motor.Part1 = bone
		motor.C0 = joint.C0
		motor.Parent = part0 -- like the other R6 joints, so the Animator finds it
		build(joint.Name, bone, model)
	end

	-- The scabbard, and the dagger sheathed in it.
	for _, name in { "Sheath", "Dagger" } do
		local mount = Data.Mounts[if name == "Dagger" then "DaggerHip" else name]
		local part0 = limb(character, mount.Part0)
		local root = makeRoot(name .. "Root", part0.CFrame * mount.C0, model)
		local weld = Instance.new("Weld")
		weld.Name = "Mount"
		weld.Part0 = part0
		weld.Part1 = root
		weld.C0 = mount.C0
		weld.Parent = root
		build(name, root, model)
	end

	model.Parent = character
	return model
end

-- Moves the dagger between the hip and the left hand, on this machine only.
function WeaponModels.SetDaggerDrawn(character: Model, drawn: boolean)
	local model = character:FindFirstChild(FOLDER)
	local root = model and model:FindFirstChild("DaggerRoot")
	local weld = root and root:FindFirstChild("Mount")
	if not (weld and weld:IsA("Weld")) then
		return
	end
	local mount = Data.Mounts[if drawn then "DaggerHand" else "DaggerHip"]
	local part0 = character:FindFirstChild(mount.Part0)
	if part0 and part0:IsA("BasePart") and (weld.Part0 ~= part0 or weld.C0 ~= mount.C0) then
		weld.Part0 = part0
		weld.C0 = mount.C0
	end
end

return WeaponModels
