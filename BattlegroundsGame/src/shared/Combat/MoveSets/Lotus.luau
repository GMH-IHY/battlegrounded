--!strict
-- Lotus (ModuleScript)
-- Location: ReplicatedStorage > Combat > MoveSets > Lotus
--
-- The first magic system: the Lotus Fungus (docs/MoveData.md, "Lotus Fungus"). It grows from the
-- left arm, fed by your own health. Its meter (0-100) has three stages: 1 = 0-40, 2 = 40-80,
-- 3 = 80-100. Each key picks its variant by your stage (Loadout):
--   2  stab: 1 = a quick strand stab (+10 meter on hit), 2 = a strand racing along the ground
--      (unblockable, launches), 3 = a heavy spike (+8 on block, 1 armour point). Against an airborne
--      opponent in front, stages 1 and 3 impale instead: growth erupts under them.
--   3  spore: 1 = one spore, 2 = a fan of three that Infest, 3 = a beam (can't be blocked or parried).
--   4  grab: 1 = feast and throw (blockable: blocked, nothing happens), 2 = unblockable combo ender
--      that fills the meter to 80, 3 = feast with everything (can't be interrupted while starting).
--   R  hold = heal channel (+HP, +meter; a hit meanwhile is a counter-hit), tap = rip it out (-HP, -meter)
--   G  at a full meter: stage 3 form (~8 s of free stage 3 moves), then the meter drops to 20.
-- Stage 3 moves spend meter and missing one consumes you (HP, a stagger). All of it is the server's
-- to count (Fighter); these are the numbers.

local MoveTypes = require(script.Parent.Parent.MoveTypes)

local Define = MoveTypes.Define

-- Shared by every Lotus move.
local function lotus(t: { [string]: any }): MoveTypes.Move
	t.Magic = "Lotus"
	t.Weapon = "Lotus"
	t.Fx = t.Fx or {}
	t.Fx.Hand = "Left"
	t.Fx.Swing = t.Fx.Swing or "FungusSwing"
	t.Fx.Hit = t.Fx.Hit or "FungusHit"
	return Define(t)
end

