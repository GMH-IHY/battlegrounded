				<ProtectedString name="Source"><![CDATA[--!strict
-- MovementController (LocalScript)
-- Location: StarterPlayer > StarterCharacterScripts > MovementController
--
-- Reads player input and feeds it to this character's CharacterMotor and Dash.
-- Double-tap W: run. Space: jump; in the air press it again (or keep holding it) while moving
-- into and along a wall to wall hop; press it right before landing from a high fall to roll.
-- Sprinting into obstacles vaults / climbs / slides automatically (AutoParkour). Shift: dash.
-- M1: during a front dash the dash punch; during a side / back dash, late in a landing roll or in a
-- Moth flight it cuts straight into a swing, keeping your momentum; otherwise a swing (M1Preview, the
-- placeholder sword M1 until the combat system exists).
-- Left Ctrl: race special (Moth: tap = wing flight, hold = charge + throw the lantern, press while it's in
-- the air = suspend it, hold with it away = fly to it / to a tagged opponent). Race specials spend Stamina.
-- Tab: shift lock (ShiftLock script).
-- A fresh copy runs every time the character spawns.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local movementFolder = ReplicatedStorage:WaitForChild("Movement")
movementFolder:WaitForChild("CharacterMotor")
movementFolder:WaitForChild("MovementConfig")
movementFolder:WaitForChild("Dash")
movementFolder:WaitForChild("WallHop")
movementFolder:WaitForChild("LandingRoll")
movementFolder:WaitForChild("AutoParkour")
movementFolder:WaitForChild("Stamina")
movementFolder:WaitForChild("Lantern")
movementFolder:WaitForChild("Sfx")
movementFolder:WaitForChild("Controls")
local combatFolder = ReplicatedStorage:WaitForChild("Combat")
combatFolder:WaitForChild("M1Preview")

local CharacterMotor = require(ReplicatedStorage.Movement.CharacterMotor)
local Config = require(ReplicatedStorage.Movement.MovementConfig)
local Dash = require(ReplicatedStorage.Movement.Dash)
local WallHop = require(ReplicatedStorage.Movement.WallHop)
local LandingRoll = require(ReplicatedStorage.Movement.LandingRoll)
local AutoParkour = require(ReplicatedStorage.Movement.AutoParkour)
local Stamina = require(ReplicatedStorage.Movement.Stamina)
local Lantern = require(ReplicatedStorage.Movement.Lantern)
local Sfx = require(ReplicatedStorage.Movement.Sfx)
local Controls = require(ReplicatedStorage.Movement.Controls)
local M1Preview = require(ReplicatedStorage.Combat.M1Preview)

local DASH_KEYS: { [Enum.KeyCode]: boolean } = {
	[Enum.KeyCode.LeftShift] = true,
	[Enum.KeyCode.RightShift] = true,
}
local RACE_SPECIAL_KEY = Enum.KeyCode.LeftControl

local character = script.Parent
assert(character and character:IsA("Model"), "MovementController must be in StarterCharacterScripts")

local motor = CharacterMotor.new(character)
local forwardHeld = false
local dash = Dash.new(character, motor, function()
	return forwardHeld
end)
-- Each movement is blocked while another one owns the body. Parkour is created last but looked
-- up lazily, so the earlier ones can check it too.
local parkour: AutoParkour.AutoParkour? = nil
local function parkourBusy(): boolean
	return parkour ~= nil and parkour:IsBusy()
end
-- Race specials (Moth lantern flight) own the body too; looked up lazily like parkour.
local raceSpecial: Lantern.Lantern? = nil
local function raceSpecialBusy(): boolean
	return raceSpecial ~= nil and raceSpecial:IsBusy()
end
local wallHop = WallHop.new(character, motor, function()
	return dash:IsBusy() or parkourBusy() or raceSpecialBusy()
end)
local landingRoll = LandingRoll.new(character, motor, function()
	return dash:IsBusy() or wallHop:IsRunning() or parkourBusy() or raceSpecialBusy()
end)
local autoParkour = AutoParkour.new(character, motor, function()
	-- A front dash doesn't block parkour: parkour takes it over (see the dash hook below). Nor
	-- does a wall run: a ledge in reach during it gets grabbed (wall run hook).
	return (dash:IsBusy() and not dash:IsFrontDashing()) or landingRoll:IsRolling() or raceSpecialBusy()
end)
local stamina = Stamina.new(character, motor)
local moth = Lantern.new(character, motor, stamina, function()
	return dash:IsBusy() or wallHop:IsRunning() or parkourBusy() or landingRoll:IsRolling()
end)
raceSpecial = moth
local m1 = M1Preview.new(character, motor)
autoParkour:SetWallRunHook({
	isRunning = function()
		return wallHop:IsRunning()
	end,
	handOff = function()
		wallHop:Cancel()
	end,
})
autoParkour:SetDashHook({
	isDashing = function()
		return dash:IsFrontDashing()
	end,
	velocity = function()
		return dash:GetCurrentVelocity()
	end,
	handOff = function()
		dash:HandOff()
	end,
})
parkour = autoParkour
local connections: { RBXScriptConnection } = {}
local lastForwardTap = -math.huge
local lastDeniedAt = -math.huge

-- INPUT ----------------------------------------------------------------------
-- Every key is a named action (Controls), so the in-Studio tests press the same code the keyboard does.

-- M1: what a click does depends on what the body is doing (see the header).
local function pressM1()
	if moth:CancelCharge() or moth:OnM1() then
		m1:Request()
		return
	end
	if dash:IsFrontDashing() then
		dash:Punch()
		return
	end
	if dash:CancelIntoAttack() or landingRoll:CancelIntoAttack() then
		m1:Request()
		return
	end
	if dash:IsBusy() or landingRoll:IsRolling() or wallHop:IsRunning() or parkourBusy() then
		return
	end
	m1:Request()
end

local function pressDash()
	moth:CancelCharge()
	if not dash:Request() and dash:GetCooldownRemaining() > 0.15 then
		-- Pressed while it's still recharging: a short "no" (not spammable).
		local now = os.clock()
		if now - lastDeniedAt > 0.5 then
			lastDeniedAt = now
			Sfx.Play(character, "Denied", { volume = 0.7 })
		end
	end
end

local function pressForward()
	forwardHeld = true
	local now = os.clock()
	if now - lastForwardTap <= Config.DoubleTapWindow then
		motor:SetSprinting(true)
	end
	lastForwardTap = now
end

local function releaseForward()
	forwardHeld = false
	motor:SetSprinting(false)
end

local function pressJump()
	moth:CancelCharge()
	motor:SetJumpHeld(true)
	local madeJump = motor:RequestJump()
	wallHop:OnJumpPressed(madeJump)
	landingRoll:OnJumpPressed(madeJump)
	-- Pressed near the end of a dash or parkour move: jump right as it ends.
	dash:OnJumpPressed()
	autoParkour:OnJumpPressed()
end

local function releaseJump()
	motor:SetJumpHeld(false)
end

local function nothing() end

Controls.Register(character, {
	press = {
		Jump = pressJump,
		Dash = pressDash,
		Race = function()
			moth:Press()
		end,
		Forward = pressForward,
		M1 = pressM1,
	},
	release = {
		Jump = releaseJump,
		Dash = nothing,
		Race = function()
			moth:Release()
		end,
		Forward = releaseForward,
		M1 = nothing,
	},
})

table.insert(
	connections,
	UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
		if gameProcessed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			pressM1()
		elseif DASH_KEYS[input.KeyCode] then
			pressDash()
		elseif input.KeyCode == RACE_SPECIAL_KEY then
			moth:Press()
		elseif input.KeyCode == Enum.KeyCode.W then
			pressForward()
		elseif input.KeyCode == Enum.KeyCode.Space then
			pressJump()
		end
	end)
)

-- Releases are handled even when "gameProcessed" so a key can't get stuck (e.g. opening chat).
table.insert(
	connections,
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.W then
			releaseForward()
		elseif input.KeyCode == Enum.KeyCode.Space then
			releaseJump()
		elseif input.KeyCode == RACE_SPECIAL_KEY then
			moth:Release()
		end
	end)
)

table.insert(
	connections,
	UserInputService.WindowFocusReleased:Connect(function()
		releaseForward()
		releaseJump()
		moth:Release()
	end)
)

-- CLEANUP --------------------------------------------------------------------

local function cleanup()
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	Controls.Unregister(character)
	m1:Destroy()
	moth:Destroy()
	stamina:Destroy()
	autoParkour:Destroy()
	landingRoll:Destroy()
	wallHop:Destroy()
	dash:Destroy()
	motor:Destroy()
end

script.Destroying:Connect(cleanup)
local humanoid = character:FindFirstChildOfClass("Humanoid")
if humanoid then
	humanoid.Died:Connect(cleanup)
end
]]></ProtectedString></Properties>
			</Item>
			<Item class="LocalScript" referent="RBXB2E23463E70848C6AE8C919B4AAC5903">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--!strict
-- MovementSounds (LocalScript)
-- Location: StarterPlayer > StarterCharacterScripts > MovementSounds
--
-- Your character's movement sounds that follow its state: footsteps (speed-matched), fall wind,
-- jump / land, wall run, dash, roll, vault / climb / slide, Moth flights and the lantern, stamina
-- burnout. One-off hits that only the movement code knows about (wall kick, dash punch hit, lantern
-- impact / hit) are played by those modules directly. Everything goes through Sfx, which also sends
-- it to the other players. Sounds: SoundConfig.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local movement = ReplicatedStorage:WaitForChild("Movement")
movement:WaitForChild("Sfx")
movement:WaitForChild("MovementConfig")
local Sfx = require(ReplicatedStorage.Movement.Sfx)
local Config = require(ReplicatedStorage.Movement.MovementConfig)

local character = script.Parent :: Model
local humanoid = character:WaitForChild("Humanoid") :: Humanoid
local root = character:WaitForChild("HumanoidRootPart") :: BasePart

-- Footsteps: the loop has 4 steps in 1.57 s (~2.5 steps/s) at speed 1.
local STEP_SPEED_REF = 16 -- studs/s that match PlaybackSpeed 1
local STEP_MIN_SPEED = 2 -- slower than this = no steps
-- Fall wind fades in from this fall speed and is full at +FALL_WIND_RANGE.
local FALL_WIND_START = 45
local FALL_WIND_RANGE = 55
-- Landings: quieter than this fall speed make no land sound; full volume at LAND_FULL.
local LAND_MIN = 14
local LAND_FULL = 75
-- Stamina: burnout when it hits 0, recovered at this much; "full" chime only after dipping below this.
local BURNOUT_RECOVER_AT = 25
local FULL_CHIME_BELOW = 60

local connections: { RBXScriptConnection } = {}
local lastFallSpeed = 0 -- downward speed last frame (landing loudness)

local function attr(name: string): any
	return character:GetAttribute(name)
end

-- Another move owns the body (no footsteps / fall wind of our own then).
local function busy(): boolean
	return attr("Dashing") == true
		or attr("Rolling") == true
		or attr("WallRunning") == true
		or attr("Parkour") ~= nil
		or attr("Flying") ~= nil
end

-- FOOTSTEPS + FALL WIND (every frame) --------------------------------------------------

table.insert(
	connections,
	RunService.Heartbeat:Connect(function()
		if humanoid.Health <= 0 then
			return
		end
		local v = root.AssemblyLinearVelocity
		local flat = Vector3.new(v.X, 0, v.Z).Magnitude
		local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
		local state = humanoid:GetState()
		local climbing = state == Enum.HumanoidStateType.Climbing

		local stepping = grounded and not climbing and flat > STEP_MIN_SPEED and not busy()
		if stepping then
			local speed = math.clamp(flat / STEP_SPEED_REF, 0.75, 1.9)
			local volume = math.clamp(0.55 + flat / 60, 0.6, 1)
			if Sfx.IsLooping(character, "Footsteps") then
				Sfx.SetLoop(character, "Footsteps", speed, volume)
			else
				Sfx.Loop(character, "Footsteps", true, { speed = speed, volume = volume })
			end
		elseif Sfx.IsLooping(character, "Footsteps") then
			Sfx.Loop(character, "Footsteps", false)
		end

		local falling = -v.Y
		local windOn = not grounded and falling > FALL_WIND_START and attr("Flying") == nil
		if windOn then
			local volume = math.clamp((falling - FALL_WIND_START) / FALL_WIND_RANGE, 0.1, 1)
			if Sfx.IsLooping(character, "FallWind") then
				Sfx.SetLoop(character, "FallWind", nil, volume)
			else
				Sfx.Loop(character, "FallWind", true, { volume = volume })
			end
		elseif Sfx.IsLooping(character, "FallWind") then
			Sfx.Loop(character, "FallWind", false)
		end

		if not grounded then
			lastFallSpeed = math.max(falling, 0)
		end
	end)
)

-- JUMP / LAND ---------------------------------------------------------------------------------

table.insert(
	connections,
	humanoid.StateChanged:Connect(function(_old: Enum.HumanoidStateType, new: Enum.HumanoidStateType)
		if new == Enum.HumanoidStateType.Jumping then
			if attr("Parkour") == nil and attr("Rolling") ~= true then
				Sfx.Play(character, "Jump")
			end
		elseif new == Enum.HumanoidStateType.Landed then
			local fall = lastFallSpeed
			lastFallSpeed = 0
			if fall < LAND_MIN then
				return
			end
			-- The landing roll decides on this same touchdown: give it a frame, it has its own sound.
			task.defer(function()
				if attr("Rolling") == true or attr("Parkour") ~= nil then
					return
				end
				local t = math.clamp((fall - LAND_MIN) / (LAND_FULL - LAND_MIN), 0, 1)
				Sfx.Play(character, "Land", { volume = 0.35 + 0.65 * t, speed = 1.1 - 0.15 * t })
			end)
		end
	end)
)

-- STATE CHANGES (attributes written by the movement modules) -------------------------------

local function watch(name: string, fn: (value: any, old: any) -> ())
	local old = attr(name)
	table.insert(
		connections,
		character:GetAttributeChangedSignal(name):Connect(function()
			local value = attr(name)
			local was = old
			old = value
			fn(value, was)
		end)
	)
end

watch("Dashing", function(value)
	if value == true then
		Sfx.Play(character, "Dash")
	end
end)

watch("DashKind", function(value)
	if value == "Punch" then
		Sfx.PlayAny(character, { "DashPunchSwing", "DashPunchSwing2" })
	end
end)

watch("WallRunning", function(value)
	if value == true then
		Sfx.Play(character, "Land", { volume = 0.3, speed = 1.3 }) -- feet hit the wall
		Sfx.Loop(character, "WallRun", true)
	else
		Sfx.Loop(character, "WallRun", false)
	end
end)

watch("Rolling", function(value)
	if value == true then
		Sfx.Play(character, "Land", { volume = 0.4, speed = 1.15 })
		Sfx.Play(character, "Roll")
	end
end)

watch("Parkour", function(value)
	if value == "Vault" or value == "StepUp" then
		Sfx.Play(character, "Vault")
	elseif value == "Climb" then
		Sfx.Play(character, "LedgeGrab")
	elseif value == "Slide" then
		Sfx.Play(character, "Slide")
	end
end)

watch("Flying", function(value, old)
	if value == "Wings" then
		Sfx.Play(character, "WingFlight")
	elseif value == "Free" or value == "Tag" then
		if value == "Tag" then
			Sfx.Play(character, "TagFlight")
		end
		Sfx.Loop(character, "WingFlap", true)
	end
	if value ~= "Free" and value ~= "Tag" and (old == "Free" or old == "Tag") then
		Sfx.Loop(character, "WingFlap", false)
		Sfx.Play(character, "WingStop")
	end
end)

watch("LanternState", function(value, old)
	if value == "Charging" then
		Sfx.Loop(character, "LanternCharge", true)
	elseif old == "Charging" then
		Sfx.Loop(character, "LanternCharge", false)
	end
	if value == "Thrown" then
		Sfx.Play(character, "LanternThrow")
	elseif value == "Suspended" then
		Sfx.Play(character, "LanternSuspend")
	elseif value == "Hip" and old ~= nil and old ~= "Charging" and old ~= "Hip" then
		Sfx.Play(character, "LanternGrab")
	end
end)

-- The lantern's flight hum follows the lantern itself (Lantern.luau starts / stops it).

local burnedOut = false
local dipped = false
watch("Stamina", function(value)
	if typeof(value) ~= "number" then
		return
	end
	local max = attr("StaminaMax")
	local full = if typeof(max) == "number" then max else Config.StaminaMax
	if value <= 0 and not burnedOut then
		burnedOut = true
		Sfx.Loop(character, "Burnout", true)
	elseif burnedOut and value >= BURNOUT_RECOVER_AT then
		burnedOut = false
		Sfx.Loop(character, "Burnout", false)
		Sfx.Play(character, "BurnoutRecover")
	end
	if value < FULL_CHIME_BELOW then
		dipped = true
	elseif dipped and value >= full then
		dipped = false
		Sfx.Play(character, "StaminaFull")
	end
end)

-- CLEANUP ------------------------------------------------------------------------------------

local function cleanup()
	for _, c in connections do
		c:Disconnect()
	end
	table.clear(connections)
	Sfx.StopAll(character)
end

humanoid.Died:Connect(cleanup)
script.Destroying:Connect(cleanup)
]]></ProtectedString>
