			<Item class="LocalScript" referent="RBX28DDBA0CF2B94BB0B2256BF188D73A15">
        <Properties>
          <string name="Name">LanternViewer</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- LanternViewer (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > LanternViewer
--
-- Draws OTHER players' lanterns smoothly while they're out of hand. The server lantern (tag
-- "MothLantern") is only placed at the owner's reports (~20 a second), so here it's hidden and a
-- local copy is drawn instead:
--   Thrown    -> the arc is replayed from the throw's start values (LanternPhysics, same as the
--                owner), so it flies smoothly; it stops at whatever it runs into until the owner's
--                next report says what happened.
--   Suspended -> sits at the reported point with its light sphere.
--   Dropped   -> follows the reported point, smoothed.
-- On the hip / in the hand the server lantern (welded to the character) shows as it is.
-- Also plays the impact flash (attributes BurstAt / BurstId).
-- Your own lantern is drawn by Lantern.luau, not here.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

ReplicatedStorage:WaitForChild("Movement"):WaitForChild("LanternFx")
local LanternPhysics = require(ReplicatedStorage.Movement.LanternPhysics)
local LanternFx = require(ReplicatedStorage.Movement.LanternFx)

local player = Players.LocalPlayer
local TAG = "MothLantern"
-- How fast the copy catches up with a reported position (per second, exponential).
local FOLLOW_RATE = 18
-- Farther than this from the report: jump there.
local SNAP_DISTANCE = 25

type View = {
	model: Model,
	copy: Model?,
	state: string,
	position: Vector3,
	velocity: Vector3,
	-- Replayed throw: where the replay is, and whether it ran into something.
	replayPos: Vector3?,
	replayStopped: boolean,
	throwStart: number,
	casts: any,
	castsAt: number,
	lastBurstId: number,
	connections: { RBXScriptConnection },
}

local views: { [Model]: View } = {}

local function isMine(model: Model): boolean
	return model:GetAttribute("OwnerUserId") == player.UserId
end

local function removeCopy(view: View)
	if view.copy then
		view.copy:Destroy()
		view.copy = nil
	end
	LanternFx.hideServer(view.model, false)
end

local function onState(view: View)
	local state = view.model:GetAttribute("State")
	view.state = if typeof(state) == "string" then state else "Hip"
	if view.state == "Hip" or view.state == "Charging" then
		removeCopy(view)
		return
	end
	local core = view.model.PrimaryPart
	if not view.copy then
		view.copy = LanternFx.makeCopy(view.model, "LanternView")
		view.position = if core then core.Position else view.position
	end
	LanternFx.hideServer(view.model, true)
	if view.state == "Thrown" then
		local start = view.model:GetAttribute("ThrowStart")
		view.throwStart = if typeof(start) == "number" then start else Workspace:GetServerTimeNow()
		view.replayPos = nil
		view.replayStopped = false
	end
	if view.copy then
		LanternFx.styleCopy(view.copy, view.state)
	end
end

local function onBurst(view: View)
	local id = view.model:GetAttribute("BurstId")
	local at = view.model:GetAttribute("BurstAt")
	if typeof(id) == "number" and id ~= view.lastBurstId then
		view.lastBurstId = id
		if typeof(at) == "Vector3" then
			LanternFx.burst(at)
		end
	end
end

local function add(model: Instance)
	if not model:IsA("Model") or views[model] or isMine(model) then
		return
	end
	local burstId = model:GetAttribute("BurstId")
	local view: View = {
		model = model,
		copy = nil,
		state = "Hip",
		position = if model.PrimaryPart then model.PrimaryPart.Position else Vector3.zero,
		velocity = Vector3.zero,
		replayPos = nil,
		replayStopped = false,
		throwStart = 0,
		casts = nil,
		castsAt = -math.huge,
		lastBurstId = if typeof(burstId) == "number" then burstId else 0,
		connections = {},
	}
	views[model] = view
	table.insert(view.connections, model:GetAttributeChangedSignal("State"):Connect(function()
		onState(view)
	end))
	table.insert(view.connections, model:GetAttributeChangedSignal("BurstId"):Connect(function()
		onBurst(view)
	end))
	onState(view)
end

local function remove(model: Instance)
	local view = if model:IsA("Model") then views[model :: Model] else nil
	if not view then
		return
	end
	for _, c in view.connections do
		c:Disconnect()
	end
	if view.copy then
		view.copy:Destroy()
	end
	views[view.model] = nil
end

-- The replayed arc at the current server time (stops at the first thing it runs into).
local function replay(view: View): (Vector3, Vector3)
	local model = view.model
	local origin = model:GetAttribute("ThrowOrigin")
	local velocity = model:GetAttribute("ThrowVelocity")
	local gravity = model:GetAttribute("ThrowGravity")
	if typeof(origin) ~= "Vector3" or typeof(velocity) ~= "Vector3" or typeof(gravity) ~= "number" then
		local core = model.PrimaryPart
		return if core then core.Position else view.position, Vector3.zero
	end
	local t = math.max(0, Workspace:GetServerTimeNow() - view.throwStart)
	local pos, vel = LanternPhysics.at(origin, velocity, gravity, t)
	if view.replayStopped and view.replayPos then
		return view.replayPos, Vector3.zero
	end
	local from = view.replayPos or origin
	local casts = view.casts
	if not casts or os.clock() - view.castsAt > 0.25 then
		local ownerId = model:GetAttribute("OwnerUserId")
		local owner = if typeof(ownerId) == "number" then Players:GetPlayerByUserId(ownerId) else nil
		local ignore: { Instance } = {}
		if view.copy then
			table.insert(ignore, view.copy)
		end
		table.insert(ignore, model)
		casts = LanternPhysics.params(if owner then owner.Character else nil, ignore, true)
		view.casts = casts
		view.castsAt = os.clock()
	end
	local hit = LanternPhysics.cast(from, pos - from, casts)
	if hit then
		view.replayStopped = true
		view.replayPos = hit.position
		return hit.position, Vector3.zero
	end
	view.replayPos = pos
	return pos, vel
end

RunService.RenderStepped:Connect(function(dt: number)
	for _, view in views do
		local copy = view.copy
		if copy then
			-- Keep the server copy hidden (the character's camera transparency code can reset it).
			local core = view.model.PrimaryPart
			if core and core.LocalTransparencyModifier < 1 then
				LanternFx.hideServer(view.model, true)
			end
			local target = if core then core.Position else view.position
			if view.state == "Thrown" then
				local pos, vel = replay(view)
				view.position = pos
				view.velocity = vel
			else
				local gap = target - view.position
				if gap.Magnitude > SNAP_DISTANCE then
					view.position = target
				else
					view.position += gap * (1 - math.exp(-FOLLOW_RATE * dt))
				end
				view.velocity = Vector3.zero
			end
			LanternFx.placeCopy(copy, LanternFx.pose(view.position, view.velocity, view.state == "Thrown"))
		end
	end
end)

CollectionService:GetInstanceAddedSignal(TAG):Connect(add)
CollectionService:GetInstanceRemovedSignal(TAG):Connect(remove)
for _, model in CollectionService:GetTagged(TAG) do
	add(model)
end
]]></ProtectedString></Properties>
      </Item>
      <Item class="LocalScript" referent="RBXC3127A0B9B824E39BAA4E74E6BAB0718"><Properties><string name="Name">BodyLean</string><ProtectedString name="Source"><![CDATA[--!strict
-- BodyLean (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > BodyLean
--
-- Tilts every character very slightly into its turns and with its speed changes, on top of whatever
-- animation plays: banking into a curve while running, a lean forward when speeding up and back
-- when braking. It's visual only (nothing about movement changes) and computed on each client for
-- every character from its velocity, so nothing is sent over the network.
--
-- Stepped like the animations: the lean jumps to a new angle a few times a second (UpdateRate) in
-- whole steps of StepDegrees, instead of gliding. It's off while another move owns the body
-- (dash, wall run, parkour, roll, flight), in the air, when standing still, and faster than a run.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- Kept extremely subtle: a hint of weight, never a pose of its own.
local BANK_PER_TURN = 0.025 -- degrees of tilt per degree/second of turning
local MAX_BANK = 3 -- degrees
local LEAN_PER_ACCEL = 0.02 -- degrees of forward lean per stud/s² of speed change
local MAX_LEAN = 2 -- degrees
local STEP_DEGREES = 1
local UPDATE_RATE = 15 -- per second
local MIN_SPEED = 6 -- studs/s: slower than this, no lean
-- Faster than running = a dash or a parkour move. The "busy" attributes below are only set on the
-- owner's client, so this is how other players' moves are recognized.
local MAX_SPEED = 30
local BUSY_ATTRIBUTES = { "Dashing", "WallRunning", "Parkour", "Rolling", "Flying" }
local GROUND_STATES: { [Enum.HumanoidStateType]: boolean } = {
	[Enum.HumanoidStateType.Running] = true,
	[Enum.HumanoidStateType.RunningNoPhysics] = true,
	[Enum.HumanoidStateType.Landed] = true,
}

type Lean = {
	root: BasePart,
	humanoid: Humanoid,
	joint: Motor6D,
	c0Rotation: CFrame,
	lastDirection: Vector3,
	lastSpeed: number,
	lastSample: number,
	bank: number,
	lean: number,
}

local leans: { [Model]: Lean } = {}

local function quantize(degrees: number): number
	return math.round(degrees / STEP_DEGREES) * STEP_DEGREES
end

local function busy(character: Model): boolean
	for _, name in BUSY_ATTRIBUTES do
		local value = character:GetAttribute(name)
		if value ~= nil and value ~= false then
			return true
		end
	end
	return false
end

local function track(character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local joint = if root then root:WaitForChild("RootJoint", 10) else nil
	if not (root and root:IsA("BasePart") and humanoid and humanoid:IsA("Humanoid") and joint and joint:IsA("Motor6D")) then
		return
	end
	leans[character] = {
		root = root,
		humanoid = humanoid,
		joint = joint,
		c0Rotation = joint.C0.Rotation,
		lastDirection = Vector3.zero,
		lastSpeed = 0,
		lastSample = os.clock(),
		bank = 0,
		lean = 0,
	}
	character.AncestryChanged:Connect(function()
		if not character:IsDescendantOf(game) then
			leans[character] = nil
		end
	end)
end

-- Picks the next stepped lean from how the velocity changed since the last sample.
local function sample(character: Model, lean: Lean, now: number)
	local dt = now - lean.lastSample
	lean.lastSample = now
	local velocity = lean.root.AssemblyLinearVelocity
	local flat = Vector3.new(velocity.X, 0, velocity.Z)
	local speed = flat.Magnitude
	local grounded = GROUND_STATES[lean.humanoid:GetState()] == true
	if speed < MIN_SPEED or speed > MAX_SPEED or not grounded or busy(character) or dt <= 0 then
		lean.bank, lean.lean = 0, 0
		lean.lastDirection = if speed > 0.1 then flat.Unit else Vector3.zero
		lean.lastSpeed = speed
		return
	end
	local direction = flat.Unit
	local turnRate = 0
	if lean.lastDirection.Magnitude > 0.5 then
		-- + = turning left (counter-clockwise seen from above).
		local sine = lean.lastDirection:Cross(direction).Y
		turnRate = math.deg(math.asin(math.clamp(sine, -1, 1))) / dt
	end
	local accel = (speed - lean.lastSpeed) / dt
	-- Turning left tilts the top of the body left (negative tilt); faster = more.
	local speedShare = math.clamp(speed / 26, 0, 1)
	lean.bank = quantize(math.clamp(-turnRate * BANK_PER_TURN * speedShare, -MAX_BANK, MAX_BANK))
	lean.lean = quantize(math.clamp(accel * LEAN_PER_ACCEL, -MAX_LEAN, MAX_LEAN))
	lean.lastDirection = direction
	lean.lastSpeed = speed
end

local nextSample = 0
RunService.PreSimulation:Connect(function()
	local now = os.clock()
	local resample = now >= nextSample
	if resample then
		nextSample = now + 1 / UPDATE_RATE
	end
	for character, lean in leans do
		if resample then
			sample(character, lean, now)
		end
		if lean.bank ~= 0 or lean.lean ~= 0 then
			-- Same convention as the animation tools: forward lean = -pitch, tilt right = -roll, in
			-- the character's space, turned into the RootJoint's own frame.
			local extra = CFrame.Angles(math.rad(-lean.lean), 0, math.rad(-lean.bank))
			lean.joint.Transform *= lean.c0Rotation:Inverse() * extra * lean.c0Rotation
		end
	end
end)

local function watch(player: Player)
	if player.Character then
		task.spawn(track, player.Character)
	end
	player.CharacterAdded:Connect(track)
end

for _, player in Players:GetPlayers() do
	watch(player)
end
Players.PlayerAdded:Connect(watch)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX7311E3D9E044456E96656D4B2077021A"><Properties><string name="Name">MovementFx</string><ProtectedString name="Source"><![CDATA[--!strict
-- MovementFx (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > MovementFx
--
-- Small retro movement effects for every character nearby (docs/art/ArtDirection.md):
--   sweat  small blue balls popping off the head while the character is burnt out (the server's
--          "Burnout" attribute, which replicates)
--   dust   a low-poly grey cloud at the feet on a hard landing and when a dash starts: a few
--          faceted puffs (two cubes turned against each other) that swell, drift and fade in steps
-- Each client draws them from what it can see, so nothing extra is sent over the network. Every
-- effect moves in steps (FX_RATE updates per second, no tweening), like the animations. Parts are
-- pooled.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local FX_RATE = 20 -- effect updates per second (the step size)
local MAX_DISTANCE = 150 -- no effects for characters farther than this from the camera
local GRAVITY = 60 -- studs/s² for sweat drops (lighter than real: they arc)

local SWEAT_INTERVAL = 0.3 -- seconds between drops while burnt out
local SWEAT_SIZE = 0.22
local SWEAT_LIFE = 0.35
local SWEAT_COLOR = Color3.fromRGB(110, 190, 255)

local DUST_COLOR = Color3.fromRGB(190, 186, 176)
local LAND_IMPACT = 45 -- falling at least this fast (studs/s) when landing kicks up dust
local BIG_IMPACT = 95 -- ... this fast: a bigger cloud
local PUFF_LIFE = 0.45
local PUFF_DRAG = 6 -- per second: puffs slow down as they drift
local DASH_JUMP = 22 -- horizontal speed jumping up by this much in one frame = a dash started
local DASH_MIN_SPEED = 40
-- In the air, by Humanoid state (it replicates for every character; FloorMaterial isn't reliable
-- for other players' characters).
local AIR_STATES: { [Enum.HumanoidStateType]: boolean } = {
	[Enum.HumanoidStateType.Freefall] = true,
	[Enum.HumanoidStateType.Jumping] = true,
	[Enum.HumanoidStateType.FallingDown] = true,
}

-- A particle is one or more parts moving together. "drop" particles shrink as they fall; "puff"
-- particles swell to their full size, then shrink and fade (a cloud).
type Particle = {
	parts: { Part },
	offsets: { CFrame },
	cframe: CFrame,
	velocity: Vector3,
	gravity: number,
	drag: number,
	size: number,
	kind: "drop" | "puff",
	life: number,
	age: number,
}

type Watch = {
	character: Model,
	root: BasePart,
	head: BasePart?,
	humanoid: Humanoid,
	lastVelocity: Vector3,
	airborne: boolean,
	lowestVy: number,
	nextSweat: number,
}

local folder = Instance.new("Folder")
folder.Name = "MovementFx"
folder.Parent = Workspace

local pool: { Part } = {}
local particles: { Particle } = {}
local watched: { [Model]: Watch } = {}
local rng = Random.new()

local function take(shape: Enum.PartType): Part
	local part = table.remove(pool)
	if not part then
		local fresh = Instance.new("Part")
		fresh.Anchored = true
		fresh.CanCollide = false
		fresh.CanQuery = false
		fresh.CanTouch = false
		fresh.CastShadow = false
		fresh.Material = Enum.Material.SmoothPlastic
		fresh.TopSurface = Enum.SurfaceType.Smooth
		fresh.BottomSurface = Enum.SurfaceType.Smooth
		part = fresh
	end
	assert(part, "MovementFx: no part")
	part.Shape = shape
	part.Transparency = 0
	part.Parent = folder
	return part
end

local function release(part: Part)
	part.Parent = nil
	table.insert(pool, part)
end

local function place(p: Particle)
	for i, part in p.parts do
		part.CFrame = p.cframe * p.offsets[i]
	end
end

local function resize(p: Particle, size: number, transparency: number)
	for _, part in p.parts do
		part.Size = Vector3.one * math.max(size, 0.05)
		part.Transparency = transparency
	end
end

local function spawnDrop(size: number, color: Color3, position: Vector3, velocity: Vector3)
	local part = take(Enum.PartType.Ball)
	part.Color = color
	local p: Particle = {
		parts = { part },
		offsets = { CFrame.identity },
		cframe = CFrame.new(position),
		velocity = velocity,
		gravity = GRAVITY,
		drag = 0,
		size = size,
		kind = "drop",
		life = SWEAT_LIFE,
		age = 0,
	}
	resize(p, size, 0)
	place(p)
	table.insert(particles, p)
end

-- One faceted puff: two cubes, the second turned 45° on two axes, so together they read as a
-- chunky low-poly ball.
local function spawnPuff(size: number, position: Vector3, velocity: Vector3)
	local a, b = take(Enum.PartType.Block), take(Enum.PartType.Block)
	local shade = rng:NextNumber(0.9, 1.05)
	local color = Color3.new(
		math.min(DUST_COLOR.R * shade, 1),
		math.min(DUST_COLOR.G * shade, 1),
		math.min(DUST_COLOR.B * shade, 1)
	)
	a.Color, b.Color = color, color
	local spin = CFrame.Angles(rng:NextNumber(0, 6.28), rng:NextNumber(0, 6.28), rng:NextNumber(0, 6.28))
	local p: Particle = {
		parts = { a, b },
		offsets = { CFrame.identity, CFrame.Angles(math.rad(45), math.rad(45), 0) },
		cframe = CFrame.new(position) * spin,
		velocity = velocity,
		gravity = 0,
		drag = PUFF_DRAG,
		size = size,
		kind = "puff",
		life = PUFF_LIFE * rng:NextNumber(0.85, 1.15),
		age = 0,
	}
	resize(p, size * 0.5, 0)
	place(p)
	table.insert(particles, p)
end

local function sweat(watch: Watch)
	local head = watch.head
	if not head then
		return
	end
	local look = watch.root.CFrame
	local side = if rng:NextNumber() < 0.5 then -1 else 1
	local origin = head.Position + look.RightVector * (0.55 * side) + Vector3.new(0, 0.2, 0)
	local velocity = look.RightVector * (side * rng:NextNumber(3, 6)) - look.LookVector * rng:NextNumber(1, 3)
		+ Vector3.new(0, rng:NextNumber(8, 12), 0)
	spawnDrop(SWEAT_SIZE, SWEAT_COLOR, origin, velocity)
end

-- A cloud of `count` puffs at the feet: a ring (landing) or a spray behind (dash start).
local function dust(watch: Watch, count: number, spread: number, size: number, behind: boolean)
	local root = watch.root
	local feet = root.Position - Vector3.new(0, 2.6, 0)
	for i = 1, count do
		local angle
		if behind then
			local back = -root.CFrame.LookVector
			angle = math.atan2(back.X, back.Z) + rng:NextNumber(-0.8, 0.8)
		else
			angle = (i / count) * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
		end
		local out = Vector3.new(math.sin(angle), 0, math.cos(angle))
		local velocity = out * spread * rng:NextNumber(0.8, 1.2) + Vector3.new(0, rng:NextNumber(1.5, 3.5), 0)
		spawnPuff(size * rng:NextNumber(0.8, 1.25), feet + out * 0.7, velocity)
	end
end

local function track(character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not (root and root:IsA("BasePart") and humanoid and humanoid:IsA("Humanoid")) then
		return
	end
	local head = character:FindFirstChild("Head")
	watched[character] = {
		character = character,
		root = root,
		head = if head and head:IsA("BasePart") then head else nil,
		humanoid = humanoid,
		lastVelocity = root.AssemblyLinearVelocity,
		airborne = false,
		lowestVy = 0,
		nextSweat = 0,
	}
	character.AncestryChanged:Connect(function()
		if not character:IsDescendantOf(game) then
			watched[character] = nil
		end
	end)
end

-- Every frame: events (landings, dash starts) are caught the frame they happen.
local function watchCharacters(now: number)
	local camera = Workspace.CurrentCamera
	local eye = if camera then camera.CFrame.Position else Vector3.zero
	for _, watch in watched do
		local root = watch.root
		local velocity = root.AssemblyLinearVelocity
		local flatSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
		local lastFlat = Vector3.new(watch.lastVelocity.X, 0, watch.lastVelocity.Z).Magnitude
		local near = (root.Position - eye).Magnitude <= MAX_DISTANCE
		local airborne = AIR_STATES[watch.humanoid:GetState()] == true

		if airborne then
			watch.lowestVy = math.min(watch.lowestVy, velocity.Y)
		elseif watch.airborne then
			-- Just landed: dust by how hard.
			local impact = -watch.lowestVy
			if near and impact >= BIG_IMPACT then
				dust(watch, 6, 12, 1.6, false)
			elseif near and impact >= LAND_IMPACT then
				dust(watch, 4, 8, 1.1, false)
			end
			watch.lowestVy = 0
		end
		watch.airborne = airborne

		if near and not airborne and flatSpeed >= DASH_MIN_SPEED and flatSpeed - lastFlat >= DASH_JUMP then
			dust(watch, 3, 6, 1, true)
		end

		if near and watch.character:GetAttribute("Burnout") == true and now >= watch.nextSweat then
			watch.nextSweat = now + SWEAT_INTERVAL * rng:NextNumber(0.8, 1.2)
			sweat(watch)
		end
		watch.lastVelocity = velocity
	end
end

-- FX_RATE times a second: move every particle one step.
local function stepParticles(dt: number)
	for i = #particles, 1, -1 do
		local p = particles[i]
		p.age += dt
		if p.age >= p.life then
			for _, part in p.parts do
				release(part)
			end
			table.remove(particles, i)
			continue
		end
		p.velocity -= Vector3.new(0, p.gravity * dt, 0)
		p.velocity *= math.max(1 - p.drag * dt, 0)
		p.cframe += p.velocity * dt
		local t = p.age / p.life
		if p.kind == "drop" then
			resize(p, p.size * (1 - t), 0)
		elseif t < 0.35 then
			-- Swell in steps to full size.
			resize(p, p.size * (0.5 + t / 0.35 * 0.5), 0)
		else
			-- Shrink a little and fade out in steps.
			local fade = (t - 0.35) / 0.65
			resize(p, p.size * (1 - fade * 0.4), math.floor(fade * 4) / 4 * 0.8)
		end
		place(p)
	end
end

local accumulator = 0
RunService.Heartbeat:Connect(function(dt: number)
	watchCharacters(os.clock())
	accumulator += dt
	local step = 1 / FX_RATE
	if accumulator >= step then
		accumulator %= step
		stepParticles(step)
	end
end)

local function watchPlayer(player: Player)
	if player.Character then
		task.spawn(track, player.Character)
	end
	player.CharacterAdded:Connect(track)
end

for _, player in Players:GetPlayers() do
	watchPlayer(player)
end
Players.PlayerAdded:Connect(watchPlayer)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX4DF0979A7B2848999BDFD88BE046218C"><Properties><string name="Name">TestPanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- TestPanel (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > TestPanel
--
-- Studio only. Settings menu (gear) > Debug > Test panel opens it during Play: "Run all" runs every suite except the slow
-- ones, or pick a single suite. The tests take over your character (don't touch the keyboard);
-- results appear as each test finishes, and are printed to Output too. "Stop" ends the run after
-- the current test. The suites live in StarterPlayerScripts > Tests > Suites (see Tests > Harness).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

if not RunService:IsStudio() then
	return
end

local SettingsMenu = require(script.Parent:WaitForChild("SettingsMenu"))
local testsFolder = script.Parent:WaitForChild("Tests")
local Harness = require(testsFolder:WaitForChild("Harness"))
local suitesFolder = testsFolder:WaitForChild("Suites")

-- In the order they run. Slow suites are left out of "Run all".
local ORDER = { "Animation", "Basics", "Dash", "Attacks", "Combat", "Lotus", "Landing", "WallHop", "Parkour", "Flow", "Truss", "Moth", "Performance", "ParkourSweep" }
local SLOW: { [string]: boolean } = { ParkourSweep = true }

local suites: { Harness.Suite } = {}
for _, name in ORDER do
	local module = suitesFolder:WaitForChild(name, 5)
	if module and module:IsA("ModuleScript") then
		table.insert(suites, (require :: any)(module))
	else
		warn("[Tests] suite missing: " .. name)
	end
end

-- UI ----------------------------------------------------------------------------------------------

local GREEN, RED, GREY = "#6BE36B", "#FF6060", "#A8A8A8"

local gui = Instance.new("ScreenGui")
gui.Name = "TestPanel"
gui.ResetOnSpawn = false
gui.DisplayOrder = 200
gui.Enabled = false

local panel = Instance.new("Frame")
panel.AnchorPoint = Vector2.new(1, 0)
panel.Position = UDim2.new(1, -10, 0, 50)
panel.Size = UDim2.fromOffset(760, 520)
panel.BackgroundColor3 = Color3.fromRGB(16, 16, 18)
panel.BackgroundTransparency = 0.1
panel.BorderSizePixel = 0
panel.Parent = gui

local buttons = Instance.new("Frame")
buttons.Size = UDim2.new(0, 170, 1, 0)
buttons.BackgroundTransparency = 1
buttons.Parent = panel
local buttonList = Instance.new("UIListLayout")
buttonList.Padding = UDim.new(0, 4)
buttonList.Parent = buttons
local buttonPadding = Instance.new("UIPadding")
buttonPadding.PaddingTop = UDim.new(0, 8)
buttonPadding.PaddingLeft = UDim.new(0, 8)
buttonPadding.PaddingRight = UDim.new(0, 8)
buttonPadding.Parent = buttons

local summary = Instance.new("TextLabel")
summary.Position = UDim2.fromOffset(180, 8)
summary.Size = UDim2.new(1, -190, 0, 22)
summary.BackgroundTransparency = 1
summary.Font = Enum.Font.Code
summary.TextSize = 15
summary.TextColor3 = Color3.new(1, 1, 1)
summary.TextXAlignment = Enum.TextXAlignment.Left
summary.RichText = true
summary.Text = "Pick a suite, or Run all. Don't touch the keyboard while it runs."
summary.Parent = panel

local results = Instance.new("ScrollingFrame")
results.Position = UDim2.fromOffset(180, 36)
results.Size = UDim2.new(1, -190, 1, -46)
results.BackgroundTransparency = 1
results.BorderSizePixel = 0
results.ScrollBarThickness = 6
results.AutomaticCanvasSize = Enum.AutomaticSize.Y
results.CanvasSize = UDim2.new()
results.Parent = panel
local resultList = Instance.new("UIListLayout")
resultList.Padding = UDim.new(0, 2)
resultList.Parent = results

gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

local lineCount = 0
local function line(text: string)
	lineCount += 1
	local label = Instance.new("TextLabel")
	label.LayoutOrder = lineCount
	label.Size = UDim2.new(1, -8, 0, 0)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Code
	label.TextSize = 13
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextWrapped = true
	label.RichText = true
	label.Text = text
	label.Parent = results
	results.CanvasPosition = Vector2.new(0, math.huge)
	print("[Tests] " .. (string.gsub(text, "<[^>]+>", "")))
end

local function color(text: string, hex: string): string
	return string.format('<font color="%s">%s</font>', hex, text)
end

local function escape(text: string): string
	return (string.gsub(string.gsub(string.gsub(text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"))
end

-- RUNNING -----------------------------------------------------------------------------------------

local running = false
local stopRequested = false
local passedTests, failedTests = 0, 0
local failures: { string } = {}

local function report(result: Harness.Result)
	local tag = if result.passed then color("PASS", GREEN) else color("FAIL", RED)
	line(string.format("%s <b>%s / %s</b> %s", tag, escape(result.suite), escape(result.test), color(string.format("(%.1fs)", result.seconds), GREY)))
	for _, check in result.checks do
		local mark = if check.passed then color("  ok ", GREEN) else color("  X  ", RED)
		line(mark .. escape(check.name) .. (if check.detail ~= "" then color(" — " .. escape(check.detail), GREY) else ""))
	end
	for _, text in result.logs do
		line(color("  · " .. escape(text), GREY))
	end
	if result.error then
		line(color("  error: " .. escape(result.error), RED))
	end
	if result.passed then
		passedTests += 1
	else
		failedTests += 1
		table.insert(failures, result.suite .. " / " .. result.test)
	end
	summary.Text = string.format("Running... %s passed, %s failed", color(tostring(passedTests), GREEN), color(tostring(failedTests), RED))
end

local function run(selected: { Harness.Suite })
	if running then
		return
	end
	running = true
	stopRequested = false
	passedTests, failedTests = 0, 0
	table.clear(failures)
	for _, child in results:GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	local started = os.clock()
	Harness.run(selected, report, function()
		return stopRequested
	end)
	running = false
	local verdict = if failedTests == 0 then color("ALL PASSED", GREEN) else color(string.format("%d FAILED", failedTests), RED)
	summary.Text = string.format("%s — %d passed, %d failed in %.0fs%s", verdict, passedTests, failedTests, os.clock() - started,
		if stopRequested then " (stopped)" else "")
	if #failures > 0 then
		line(color("Failed: " .. escape(table.concat(failures, ", ")), RED))
	end
end

local function button(text: string, onClick: () -> ())
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, 26)
	b.BackgroundColor3 = Color3.fromRGB(44, 44, 50)
	b.BorderSizePixel = 0
	b.Font = Enum.Font.SourceSansBold
	b.TextSize = 16
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Text = text
	b.Parent = buttons
	b.Activated:Connect(onClick)
end

button("Run all", function()
	local quick = {}
	for _, suite in suites do
		if not SLOW[suite.name] then
			table.insert(quick, suite)
		end
	end
	task.spawn(run, quick)
end)
for _, suite in suites do
	button(suite.name .. (if SLOW[suite.name] then " (slow)" else ""), function()
		task.spawn(run, { suite })
	end)
end
button("Stop", function()
	stopRequested = true
end)
local setSwitch = SettingsMenu.AddToggle("Debug", "Test panel", false, function(on: boolean)
	gui.Enabled = on
	if on then
		SettingsMenu.Close()
	end
end)
button("Close", function()
	gui.Enabled = false
	setSwitch(false)
end)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX1F357DBA8924446DA6E808C4D5E02385"><Properties><string name="Name">Tests</string></Properties><Item class="ModuleScript" referent="RBX3E23A34874E544FCA1FB2C1FD0355775"><Properties><string name="Name">Harness</string><ProtectedString name="Source"><![CDATA[--!strict
-- Harness (ModuleScript)
-- Location: StarterPlayer > StarterPlayerScripts > Tests > Harness
--
-- The in-Studio test runner. A suite is a ModuleScript in Tests > Suites returning
--   { name = "Dash", description = "...", tests = { { name = "...", run = function(t) ... end }, ... } }
-- Each test gets a Context `t` and makes any number of checks with t:check(name, passed, detail).
-- A test fails if a check fails or it errors; the next test runs either way.
--
-- Tests play the game the way a player does: keys go through Controls (the same functions the
-- keyboard calls), movement through Humanoid:Move with Roblox's own controls switched off, and
-- Space held means Humanoid.Jump every frame (what Roblox's control script does). Before every test
-- the character is reset: keys released, standing on the ground, full health and stamina, no
-- cooldowns, camera back to normal. Anything a test creates with t:temp() is removed after it.
--
-- Combat: the server owns fights, so combat tests read the server's state (t:server(model) returns
-- a Fighter snapshot) and drive the training dummies through the Studio Debug remote
-- (t:dummy(name, mode, cframe) puts one in place, t:debug(op, ...) for anything else).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Movement = ReplicatedStorage:WaitForChild("Movement")
local Combat = ReplicatedStorage:WaitForChild("Combat")
local CharacterMotor = require(Movement:WaitForChild("CharacterMotor"))
local Dash = require(Movement:WaitForChild("Dash"))
local WallHop = require(Movement:WaitForChild("WallHop"))
local LandingRoll = require(Movement:WaitForChild("LandingRoll"))
local AutoParkour = require(Movement:WaitForChild("AutoParkour"))
local Lantern = require(Movement:WaitForChild("Lantern"))
local Stamina = require(Movement:WaitForChild("Stamina"))
local Controls = require(Movement:WaitForChild("Controls"))
local CombatClient = require(Combat:WaitForChild("CombatClient"))
local CombatRemotes = require(Combat:WaitForChild("CombatRemotes"))

local player = Players.LocalPlayer

export type Check = { name: string, passed: boolean, detail: string }
export type Result = {
	suite: string,
	test: string,
	checks: { Check },
	logs: { string },
	error: string?,
	seconds: number,
	passed: boolean,
}

export type JumpStats = { height: number, airtime: number, hang: number, maxY: number, peakSpeed: number }

local Context = {}
Context.__index = Context

type ContextData = {
	character: Model,
	humanoid: Humanoid,
	root: BasePart,
	motor: CharacterMotor.CharacterMotor,
	dash: Dash.Dash,
	hop: WallHop.WallHop,
	roll: LandingRoll.LandingRoll,
	parkour: AutoParkour.AutoParkour,
	lantern: Lantern.Lantern,
	stamina: Stamina.Stamina,
	combat: CombatClient.CombatClient,
	actions: Controls.Actions,
	camera: Camera,
	result: Result,
	jumpHeld: boolean,
	temps: { Instance },
	savedHealth: number,
}

export type Context = typeof(setmetatable({} :: ContextData, Context))
export type Test = { name: string, run: (Context) -> () }
export type Suite = { name: string, description: string, tests: { Test } }

local Harness = {}

-- CHECKS ---------------------------------------------------------------------------------------

function Context.check(self: Context, name: string, passed: boolean, detail: string?)
	table.insert(self.result.checks, { name = name, passed = passed, detail = detail or "" })
end

function Context.log(self: Context, text: string)
	table.insert(self.result.logs, text)
end

-- Makes a check that `value` is within `tolerance` of `want`, with both in the detail.
function Context.near(self: Context, name: string, value: number, want: number, tolerance: number, extra: string?)
	local detail = string.format("%.2f (want %.2f ± %.2f)", value, want, tolerance)
	if extra then
		detail ..= ", " .. extra
	end
	self:check(name, math.abs(value - want) <= tolerance, detail)
end

-- TIME ------------------------------------------------------------------------------------------

-- One frame. Space held = Humanoid.Jump every frame, like Roblox's control script.
function Context.frame(self: Context): number
	if self.jumpHeld then
		self.humanoid.Jump = true
	end
	return task.wait()
end

function Context.wait(self: Context, seconds: number)
	local t0 = os.clock()
	while os.clock() - t0 < seconds do
		self:frame()
	end
end

-- Waits until `condition` is true (checked every frame), at most `timeout` seconds. `each` runs
-- every frame first (keep steering, sample something).
function Context.waitFor(self: Context, condition: () -> boolean, timeout: number, each: (() -> ())?): boolean
	local t0 = os.clock()
	while os.clock() - t0 < timeout do
		if each then
			each()
		end
		if condition() then
			return true
		end
		self:frame()
	end
	return condition()
end

function Context.grounded(self: Context, timeout: number?): boolean
	return self:waitFor(function()
		return self.motor:GetMode() == "Ground"
	end, timeout or 4)
end

-- INPUT -----------------------------------------------------------------------------------------

function Context.press(self: Context, action: Controls.ActionName)
	if action == "Jump" then
		self.jumpHeld = true
		self.humanoid.Jump = true
	end
	(self.actions.press :: any)[action]()
end

function Context.release(self: Context, action: Controls.ActionName)
	if action == "Jump" then
		self.jumpHeld = false
		self.humanoid.Jump = false
	end
	(self.actions.release :: any)[action]()
end

-- Press, hold for `hold` seconds (default a quick tap), release.
function Context.tap(self: Context, action: Controls.ActionName, hold: number?)
	self:press(action)
	self:wait(hold or 0.06)
	self:release(action)
end

-- Keys held, as a world direction (Humanoid:Move); sprint = the run toggle (double-tapped W).
function Context.move(self: Context, direction: Vector3, sprint: boolean?)
	self.motor:SetSprinting(sprint == true)
	self.humanoid:Move(direction, false)
end

function Context.stop(self: Context)
	self.motor:SetSprinting(false)
	self.humanoid:Move(Vector3.zero, false)
	if self.jumpHeld then
		self:release("Jump")
	end
	self.humanoid.Jump = false
end

-- PLACES ----------------------------------------------------------------------------------------

-- Puts the character at `position` facing `facing`, stopped and standing on the ground.
function Context.teleport(self: Context, position: Vector3, facing: Vector3)
	self:stop()
	self.root.AssemblyLinearVelocity = Vector3.zero
	self.root.CFrame = CFrame.lookAt(position, position + facing)
	task.wait(0.1)
	self:grounded(3)
	task.wait(0.3)
end

-- A camera looking along `look` from behind the character (tests that aim with the camera).
function Context.aimCamera(self: Context, look: Vector3)
	self.camera.CameraType = Enum.CameraType.Scriptable
	local at = self.root.Position
	self.camera.CFrame = CFrame.lookAt(at - look.Unit * 12 + Vector3.new(0, 5, 0), at)
end

-- Anything given here is destroyed after the test.
function Context.temp(self: Context, instance: Instance)
	table.insert(self.temps, instance)
end

-- An anchored part for this test only.
function Context.block(self: Context, name: string, size: Vector3, cframe: CFrame): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cframe
	part.Color = Color3.fromRGB(120, 90, 200)
	part.Parent = Workspace
	self:temp(part)
	return part
end

-- MEASURING -------------------------------------------------------------------------------------

function Context.flatSpeed(self: Context): number
	local v = self.root.AssemblyLinearVelocity
	return Vector3.new(v.X, 0, v.Z).Magnitude
end

function Context.waitDashReady(self: Context)
	task.wait(self.dash:GetCooldownRemaining() + 0.05)
end

-- Sets health to a share of max for the rest of the test (restored afterwards).
function Context.setHealth(self: Context, share: number)
	self.humanoid.Health = self.humanoid.MaxHealth * share
end

-- Presses jump once (the keys set beforehand stay held) and watches the airtime.
function Context.jumpOnce(self: Context, timeout: number?): JumpStats
	local startY = self.root.Position.Y
	self:press("Jump")
	self:waitFor(function()
		return self.motor:GetMode() == "Air"
	end, 0.5)
	self:release("Jump")
	local start = os.clock()
	local maxY, hang, peakSpeed = startY, 0, 0
	while self.motor:GetMode() == "Air" and os.clock() - start < (timeout or 4) do
		local dt = self:frame()
		local velocity = self.root.AssemblyLinearVelocity
		maxY = math.max(maxY, self.root.Position.Y)
		peakSpeed = math.max(peakSpeed, Vector3.new(velocity.X, 0, velocity.Z).Magnitude)
		-- A normal jump is over in well under a second. Hovering after that = stuck.
		if os.clock() - start > 0.7 and math.abs(velocity.Y) < 4 then
			hang += dt
		end
	end
	return { height = maxY - startY, airtime = os.clock() - start, hang = hang, maxY = maxY, peakSpeed = peakSpeed }
end

-- Records every change of the character attribute `name` (e.g. "LocoAnim") until the returned
-- function is called, which gives back the list of values in order (nil shows as "-").
function Context.recordAttribute(self: Context, name: string): () -> { string }
	return self:recordAttributeOn(self.character, name)
end

-- The same for any instance (a dummy's "CombatState").
function Context.recordAttributeOn(self: Context, instance: Instance, name: string): () -> { string }
	local seen: { string } = {}
	local function add()
		local value = instance:GetAttribute(name)
		table.insert(seen, if value == nil then "-" else tostring(value))
	end
	add()
	local connection = instance:GetAttributeChangedSignal(name):Connect(add)
	return function()
		connection:Disconnect()
		return seen
	end
end

-- COMBAT ----------------------------------------------------------------------------------------

-- The Studio Debug remote (CombatServer): test helpers on the server.
function Context.debug(self: Context, op: string, a: any?, b: any?): any
	return CombatRemotes.Get().Debug:InvokeServer(op, a, b)
end

-- The server's view of a fighter (yours by default): state, move, frame, stamina, combo...
function Context.server(self: Context, model: Model?): { [string]: any }
	local snapshot = self:debug("State", model or self.character)
	return if typeof(snapshot) == "table" then snapshot else {}
end

-- A training dummy by name (Workspace > TrainingDummies), reset to full health at `cframe`
-- (default: where it stands) in `mode`.
function Context.dummy(self: Context, name: string, mode: string?, cframe: CFrame?): Model
	local folder = Workspace:WaitForChild("TrainingDummies", 10)
	local model = folder and folder:WaitForChild(name, 10)
	assert(model and model:IsA("Model"), "no dummy " .. name)
	self:debug("ResetDummy", name, cframe)
	self:debug("DummyMode", name, mode or "Stand")
	task.wait(0.15)
	return model
end

-- Stands `studs` in front of a dummy, facing it.
function Context.faceDummy(self: Context, dummy: Model, studs: number)
	local root = dummy:FindFirstChild("HumanoidRootPart") :: BasePart
	local look = root.CFrame.LookVector
	local spot = root.Position + Vector3.new(look.X, 0, look.Z).Unit * studs + Vector3.new(0, 1, 0)
	self:teleport(spot, (root.Position - spot) * Vector3.new(1, 0, 1))
end

-- Waits until the attribute `name` on `model` equals `value`.
function Context.waitAttribute(self: Context, model: Instance, name: string, value: any, timeout: number): boolean
	return self:waitFor(function()
		return model:GetAttribute(name) == value
	end, timeout)
end

-- RUNNING ---------------------------------------------------------------------------------------

local function controlModule(): any?
	local playerScripts = player:FindFirstChild("PlayerScripts")
	local module = playerScripts and playerScripts:FindFirstChild("PlayerModule")
	if not module or not module:IsA("ModuleScript") then
		return nil
	end
	local ok, playerModule = pcall((require :: any), module)
	return if ok then playerModule:GetControls() else nil
end

-- Everything a test needs, or nil + why not (character still spawning).
local function makeContext(result: Result): (Context?, string?)
	local character = player.Character
	if not character then
		return nil, "no character"
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	local motor = CharacterMotor.Get(character)
	local dash = Dash.Get(character)
	local hop = WallHop.Get(character)
	local roll = LandingRoll.Get(character)
	local parkour = AutoParkour.Get(character)
	local lantern = Lantern.Get(character)
	local stamina = Stamina.Get(character)
	local combat = CombatClient.Get(character)
	local actions = Controls.Get(character)
	local camera = Workspace.CurrentCamera
	if not (humanoid and root and root:IsA("BasePart") and motor and dash and hop and roll and parkour and lantern and stamina and combat and actions and camera) then
		return nil, "character's movement isn't ready yet"
	end
	local context = setmetatable({
		character = character,
		humanoid = humanoid,
		root = root,
		motor = motor,
		dash = dash,
		hop = hop,
		roll = roll,
		parkour = parkour,
		lantern = lantern,
		stamina = stamina,
		combat = combat,
		actions = actions,
		camera = camera,
		result = result,
		jumpHeld = false,
		temps = {},
		savedHealth = humanoid.Health,
	} :: ContextData, Context)
	return context, nil
end

local function reset(t: Context)
	t.actions.release.Jump()
	t.actions.release.Race()
	t.actions.release.Forward()
	t.actions.release.Block()
	t.jumpHeld = false
	t:stop()
	t.combat:ResetForTest()
	t:debug("Reset")
	t.camera.CameraType = Enum.CameraType.Custom
	t.humanoid.Health = t.humanoid.MaxHealth
	t.stamina:Set(t.stamina:GetMax())
end

local function cleanup(t: Context)
	for _, instance in t.temps do
		instance:Destroy()
	end
	table.clear(t.temps)
	reset(t)
	t.humanoid.Health = t.savedHealth
end

-- Runs one test; returns its result (never throws).
function Harness.runTest(suite: Suite, test: Test): Result
	local result: Result = {
		suite = suite.name,
		test = test.name,
		checks = {},
		logs = {},
		error = nil,
		seconds = 0,
		passed = false,
	}
	local t, why = makeContext(result)
	if not t then
		result.error = why
		return result
	end
	local started = os.clock()
	reset(t)
	local ok, err = xpcall(function()
		test.run(t)
	end, function(message)
		return debug.traceback(tostring(message), 2)
	end)
	cleanup(t)
	result.seconds = os.clock() - started
	if not ok then
		result.error = tostring(err)
	end
	local allPassed = #result.checks > 0
	for _, check in result.checks do
		allPassed = allPassed and check.passed
	end
	result.passed = ok and allPassed
	return result
end

-- Runs suites in order. `onResult` gets each test's result as it finishes; `shouldStop` is asked
-- between tests. Roblox's controls are off while it runs.
function Harness.run(suites: { Suite }, onResult: (Result) -> (), shouldStop: () -> boolean)
	local controls = controlModule()
	if controls then
		controls:Disable()
	end
	for _, suite in suites do
		for _, test in suite.tests do
			if shouldStop() then
				break
			end
			onResult(Harness.runTest(suite, test))
		end
	end
	if controls then
		controls:Enable()
	end
	local t = makeContext({ suite = "", test = "", checks = {}, logs = {}, seconds = 0, passed = true })
	if t then
		t:teleport(Vector3.new(0, 4, 0), Vector3.zAxis)
	end
end

return Harness
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX8F155CE3A54245BBB2DCD550F8ADA030"><Properties><string name="Name">Suites</string></Properties><Item class="ModuleScript" referent="RBX6E0A9F62B2384888B4D6D3CCC900A053"><Properties><string name="Name">Animation</string><ProtectedString name="Source"><![CDATA[--!strict
-- Animation suite: every animation in AnimationConfig loads, and the locomotion transitions play
-- in the right order (read from the character attribute "LocoAnim" that Animate keeps): start
-- running, stop (straight to Idle, no skid), turn around, and nothing popping through Idle in between.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Harness = require(script.Parent.Parent.Harness)
local AnimationConfig = require(ReplicatedStorage.Movement.AnimationConfig)
local AnimationLibrary = require(ReplicatedStorage.Movement.AnimationLibrary)

type Context = Harness.Context

local OPEN = Vector3.new(120, 4, -60)

local function sequence(record: () -> { string }): string
	return table.concat(record(), " > ")
end

local tests: { Harness.Test } = {
	{
		name = "Every animation loads",
		run = function(t)
			local missing = {}
			local count = 0
			for name in AnimationConfig.Ids do
				count += 1
				if not AnimationLibrary.Get(name) then
					table.insert(missing, name)
				end
			end
			table.sort(missing)
			t:check("all of AnimationConfig.Ids", #missing == 0,
				if #missing == 0 then string.format("%d animations", count) else "missing: " .. table.concat(missing, ", "))
		end,
	},
	{
		name = "Start, stop and turn clips",
		run = function(t)
			t:teleport(OPEN, Vector3.zAxis)
			local record = t:recordAttribute("LocoAnim")
			t:move(Vector3.zAxis, true)
			t:wait(0.8)
			local start = sequence(record)
			t:check("standing -> running plays SprintStart, then Sprint", string.find(start, "Idle > SprintStart > Sprint") ~= nil, start)

			record = t:recordAttribute("LocoAnim")
			t:move(Vector3.zero, false)
			t:wait(0.6)
			local stop = sequence(record)
			t:check("running -> stopping goes straight to Idle (no skid)", string.find(stop, "Sprint > Idle") ~= nil, stop)

			t:move(Vector3.zAxis, true)
			t:wait(0.8)
			record = t:recordAttribute("LocoAnim")
			t:move(-Vector3.zAxis, true)
			t:wait(0.5)
			local turn = sequence(record)
			t:check("turning around at speed plays SprintTurn", string.find(turn, "SprintTurn") ~= nil, turn)
			t:stop()

			t:teleport(OPEN, Vector3.zAxis)
			record = t:recordAttribute("LocoAnim")
			t:move(Vector3.zAxis, false)
			t:wait(0.4)
			local walk = sequence(record)
			t:check("standing -> walking plays WalkStart, then the walk", string.find(walk, "Idle > WalkStart > WalkForward") ~= nil, walk)
		end,
	},
}

return {
	name = "Animation",
	description = "Every animation loads; start / stop / turn clips in order",
	tests = tests,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEF1968B1B98F489AB8024AB7F14A3162"><Properties><string name="Name">Attacks</string><ProtectedString name="Source"><![CDATA[--!strict
-- Attacks suite (movement into attacks, on your own client): the M1 chain and its timings, clicks
-- during a swing queueing the next, which move each key picks (running = lunge, Space held on hit 3 =
-- launcher, air chain, dagger, 1), a side / back dash cutting straight into a swing with its
-- momentum, a front dash's M1 being the lunge, a landing roll cutting into a swing late, no dashing
-- out of a wind-up (but out of a recovery), and slowed walking. Hits are the Combat suite's job.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Harness = require(script.Parent.Parent.Harness)
local Config = require(ReplicatedStorage.Movement.MovementConfig)
local CombatConfig = require(ReplicatedStorage.Combat.CombatConfig)

type Context = Harness.Context

local LANE = Vector3.new(-40, 4, -120)
local FRAME = 1 / 60

local function waitIdle(t: Context)
	t:waitFor(function()
		return t.combat:GetPhase() == "Idle"
	end, 2)
end

local tests: { Harness.Test } = {
	{
		name = "M1 chain: 3 swings, then it starts over",
		run = function(t)
			t:teleport(LANE, Vector3.zAxis)
			local order = {}
			for _ = 1, 4 do
				t:press("M1")
				table.insert(order, t.combat:GetIndex())
				waitIdle(t)
			end
			t:check("swings 1, 2, 3, then 1 again", table.concat(order, ",") == "1,2,3,1", table.concat(order, ","))
			t:wait(CombatConfig.ChainWindow + 0.1)
			t:press("M1")
			t:check("a pause longer than the chain window starts over at 1", t.combat:GetIndex() == 1)
			waitIdle(t)
		end,
	},
	{
		name = "M1 timings and queueing",
		run = function(t)
			t:teleport(LANE, Vector3.zAxis)
			local record = t:recordAttribute("AttackPhase")
			local started = os.clock()
			t:press("M1")
			local activeAt = 0
			t:waitFor(function()
				return t.combat:GetPhase() == "Idle"
			end, 1, function()
				if t.combat:GetPhase() == "Active" and activeAt == 0 then
					activeAt = os.clock() - started
				end
			end)
			local total = os.clock() - started
			local phases = table.concat(record(), " > ")
			t:check("phases in order", phases == "- > Startup > Active > Recovery > -", phases)
			t:near("the hit comes out after 5 frames", activeAt, 5 * FRAME, 2 * FRAME)
			t:near("a whiffed M1 lasts 18 frames", total, 18 * FRAME, 3 * FRAME)
			t:press("M1")
			t:wait(0.05)
			t:press("M1") -- during the first swing: queued
			local first = t.combat:GetIndex()
			t:waitFor(function()
				return t.combat:GetIndex() ~= first
			end, 1)
			t:check("a click during a swing queues the next one", t.combat:GetIndex() == first + 1,
				string.format("swing %d then %d", first, t.combat:GetIndex()))
			waitIdle(t)
		end,
	},
	{
		name = "Which move each key picks",
		run = function(t)
			t:teleport(LANE, Vector3.zAxis)
			t:press("M1")
			t:check("M1 standing = M1 1", t.combat:GetMoveId() == "Sword.M1_1", tostring(t.combat:GetMoveId()))
			waitIdle(t)
			t:press("M1")
			waitIdle(t)
			t.motor:SetJumpHeld(true)
			t:press("M1")
			t:check("hit 3 with Space held = the launcher", t.combat:GetMoveId() == "Sword.Launcher", tostring(t.combat:GetMoveId()))
			t.motor:SetJumpHeld(false)
			waitIdle(t)
			t:wait(CombatConfig.ChainWindow + 0.1)

			t:teleport(LANE, Vector3.zAxis)
			t:move(Vector3.zAxis, true)
			t:wait(0.8)
			t:press("M1")
			t:check("running M1 = the lunge", t.combat:GetMoveId() == "Sword.Lunge", tostring(t.combat:GetMoveId()))
			t:stop()
			waitIdle(t)

			t:teleport(LANE, Vector3.zAxis)
			t:press("M2")
			t:check("right click = the dagger stab", t.combat:GetMoveId() == "Dagger.Stab", tostring(t.combat:GetMoveId()))
			waitIdle(t)
			t:press("One")
			t:check("1 = the sword's 1", t.combat:GetMoveId() == "Sword.One", tostring(t.combat:GetMoveId()))
			waitIdle(t)
			t:press("One")
			t:check("1 again inside its cooldown: nothing", t.combat:GetMoveId() == nil)

			t:teleport(LANE, Vector3.zAxis)
			t:press("Jump")
			t:waitFor(function()
				return t.motor:GetMode() == "Air"
			end, 0.5)
			t:release("Jump")
			t:wait(0.12)
			t:press("M1")
			t:check("M1 in the air = air M1 1", t.combat:GetMoveId() == "Sword.AirM1_1", tostring(t.combat:GetMoveId()))
			local y0 = t.root.Position.Y
			t:wait(0.15)
			t:check("an air move keeps you up while it plays", math.abs(t.root.Position.Y - y0) < 1,
				string.format("moved %.2f studs vertically", t.root.Position.Y - y0))
			waitIdle(t)
			t:grounded(3)
		end,
	},
	{
		name = "Side and back dashes cut into a swing, keeping momentum",
		run = function(t)
			local cases = {
				{ label = "side dash (A)", keys = Vector3.xAxis },
				{ label = "back dash (S)", keys = -Vector3.zAxis },
			}
			for _, case in cases do
				t:waitDashReady()
				t:teleport(LANE, Vector3.zAxis)
				t:aimCamera(Vector3.zAxis)
				t.humanoid:Move(case.keys, false)
				t:frame()
				t:press("Dash")
				t:wait(0.08)
				local dashSpeed = t:flatSpeed()
				t:press("M1")
				local reason = t.dash:GetLastEndReason()
				local phase = t.combat:GetPhase()
				t:frame()
				local carried = t:flatSpeed()
				t:check(case.label .. ": the dash ends on the click and the swing starts that frame",
					not t.dash:IsBusy() and reason == "attack" and phase == "Startup", string.format("dash ended by %s, swing %s", reason, phase))
				t:check(case.label .. ": you slide into the swing", carried > Config.WalkSpeed,
					string.format("%.1f studs/s right after (dash was %.1f)", carried, dashSpeed))
				t:stop()
				waitIdle(t)
			end
		end,
	},
	{
		name = "A front dash's M1 is the lunge",
		run = function(t)
			t:waitDashReady()
			t:teleport(LANE, Vector3.zAxis)
			t:aimCamera(Vector3.zAxis)
			t:frame()
			local start = t.root.Position
			t:press("Dash")
			t:wait(0.1)
			t:press("M1")
			t:check("front dash + click = the lunge", t.combat:GetMoveId() == "Sword.Lunge" and not t.dash:IsBusy(),
				string.format("move %s, dash %s", tostring(t.combat:GetMoveId()), t.dash:GetPhase()))
			waitIdle(t)
			local travelled = ((t.root.Position - start) * Vector3.new(1, 0, 1)).Magnitude
			t:check("it lunges well past a plain dash", travelled > Config.FrontDashDistance * 0.6,
				string.format("%.1f studs in all", travelled))
		end,
	},
	{
		name = "A landing roll cuts into a swing late, not early",
		run = function(t)
			local function rollAndClick(after: number): (boolean, string)
				t:teleport(Vector3.new(-100, 4, -100), Vector3.zAxis)
				local restY = t.root.Position.Y
				t.root.CFrame += Vector3.new(0, 20, 0)
				local pressed = false
				t:waitFor(function()
					return t.roll:IsRolling()
				end, 4, function()
					local vy = -t.root.AssemblyLinearVelocity.Y
					if not pressed and vy > 1 and t.root.Position.Y - restY <= vy * 0.08 + 0.3 then
						t:press("Jump")
						pressed = true
					end
				end)
				if t.jumpHeld then
					t:release("Jump")
				end
				local rolled = t.roll:IsRolling()
				t:wait(after)
				t:press("M1")
				local phase = t.combat:GetPhase()
				local stillRolling = t.roll:IsRolling()
				t:waitFor(function()
					return not t.roll:IsRolling() and t.combat:GetPhase() == "Idle"
				end, 2)
				return rolled and not stillRolling, phase
			end
			local cut, phase = rollAndClick(Config.RollAttackCancelTime + 0.03)
			t:check("late in the roll: it ends and the swing starts", cut and phase == "Startup", "swing " .. phase)
			local early, earlyPhase = rollAndClick(0.03)
			t:check("early in the roll: nothing", not early and earlyPhase == "Idle", "swing " .. earlyPhase)
		end,
	},
	{
		name = "No dashing out of a wind-up or hit, but out of a recovery; walking slows while swinging",
		run = function(t)
			t:waitDashReady()
			t:teleport(LANE, Vector3.zAxis)
			t:press("M1")
			local blocked = not t.dash:Request()
			t:check("no dash during startup", blocked)
			t:waitFor(function()
				return t.combat:GetPhase() == "Recovery"
			end, 1)
			t:press("Dash")
			t:check("a dash in the recovery cancels the swing", t.dash:IsBusy() and t.combat:GetPhase() == "Idle",
				string.format("dash %s, swing %s", t.dash:GetPhase(), t.combat:GetPhase()))
			t:waitFor(function()
				return not t.dash:IsBusy()
			end, 2)
			t:move(Vector3.zAxis, false)
			t:wait(0.4)
			t:press("M1")
			t:wait(0.22) -- past the swing's small step forward
			local slowed = t:flatSpeed()
			t:near("walking while swinging", slowed, Config.WalkSpeed * CombatConfig.AttackMoveSpeedScale, 1.5)
			waitIdle(t)
			t:wait(0.3)
			t:near("walking again after the swing", t:flatSpeed(), Config.WalkSpeed, 0.6)
		end,
	},
}

return {
	name = "Attacks",
	description = "M1 chain, key picks, movement cancels into attacks",
	tests = tests,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX78140A86D5CE499F87264E762B16F01D"><Properties><string name="Name">Basics</string><ProtectedString name="Source"><![CDATA[--!strict
-- Basics suite: walking and running speeds, exact jump heights, walls never holding you up, the
-- jump box and 9-stud ledge, fall gravity and terminal velocity, and speeds by health.
-- Uses the MovementTestCourse (tall wall x 33..35, z 32..80; blue jump box x -38..-22, z 32..48,
-- 4 high; red ledge 9 high at z 64..80) and open baseplate.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Harness = require(script.Parent.Parent.Harness)
local Config = require(ReplicatedStorage.Movement.MovementConfig)

type Context = Harness.Context

local OPEN_AREA = Vector3.new(140, 4, -140)
local TOLERANCE = 0.35

local function spreadOk(values: { number }, want: number): boolean
	for _, v in values do
		if math.abs(v - want) > TOLERANCE then
			return false
		end
	end
	return #values > 0
end

local function list(values: { number }): string
	local parts = {}
	for _, v in values do
		table.insert(parts, string.format("%.2f", v))
	end
	return table.concat(parts, " ")
end

local function jumpHeights(t: Context, direction: Vector3, sprint: boolean, count: number): { number }
	t:teleport(OPEN_AREA, Vector3.zAxis)
	t:move(direction, sprint)
	t:wait(if sprint then 0.6 else 0.2)
	local heights = {}
	for _ = 1, count do
		table.insert(heights, t:jumpOnce().height)
		t:wait(0.15) -- let the Humanoid settle so every jump starts from the ground
	end
	return heights
end

-- Tall wall: jump into it. It must never hold you up in the air.
local function wallCase(t: Context, direction: Vector3, sprint: boolean, pushFirst: boolean)
	local start = Vector3.new(33 - 10 * direction.X, 4, 56 - 10 * direction.Z)
	t:teleport(start, direction)
	t:move(direction, sprint)
	t:wait(if pushFirst then 1 else 0.15)
	local stats = t:jumpOnce(4)
	t:check("never held up by the wall", stats.hang < 0.1 and stats.airtime < 1.2,
		string.format("airtime %.2fs, hanging %.2fs", stats.airtime, stats.hang))
end

local function speedScaleAt(share: number): number
	local full = math.clamp(Config.HealthSpeedFullAbove, 1e-3, 1)
	return Config.LowHealthSpeedScale + (1 - Config.LowHealthSpeedScale) * math.clamp(share / full, 0, 1)
end

-- Average ground speed over the last `measure` seconds of moving +Z for `total` seconds.
local function moveFor(t: Context, sprint: boolean, total: number, measure: number): number
	local sum, count = 0, 0
	local t0 = os.clock()
	while os.clock() - t0 < total do
		t:move(Vector3.zAxis, sprint)
		if os.clock() - t0 > total - measure and t.motor:GetMode() == "Ground" then
			sum += t:flatSpeed()
			count += 1
		end
		t:frame()
	end
	return if count > 0 then sum / count else 0
end

local tests: { Harness.Test } = {
	{
		name = "Walk and run speeds",
		run = function(t)
			t:teleport(OPEN_AREA, Vector3.zAxis)
			t:move(Vector3.zAxis, false)
			t:wait(0.8)
			t:near("walk speed", t.motor:GetHorizontalSpeed(), Config.WalkSpeed, 0.5)
			local start = os.clock()
			t:move(Vector3.zAxis, true)
			local reached = t:waitFor(function()
				return t.motor:GetHorizontalSpeed() >= Config.RunSpeed - 0.5
			end, 2)
			local ramp = os.clock() - start
			t:wait(0.5)
			t:check("run speed reached", reached, string.format("in %.2fs (want ~%.2f)", ramp, Config.RunAccelTime))
			t:near("run speed", t.motor:GetHorizontalSpeed(), Config.RunSpeed, 0.5)
		end,
	},
	{
		name = "Jump heights are exact (standing, walking, running, held)",
		run = function(t)
			local want = Config.JumpHeight
			local standing = jumpHeights(t, Vector3.zero, false, 4)
			t:check("standing", spreadOk(standing, want), list(standing))
			local walking = jumpHeights(t, Vector3.zAxis, false, 4)
			t:check("walking", spreadOk(walking, want), list(walking))
			local running = jumpHeights(t, Vector3.zAxis, true, 4)
			t:check("running", spreadOk(running, want), list(running))
			-- Held: the Humanoid re-jumps on every landing.
			t:teleport(OPEN_AREA, Vector3.zAxis)
			t:move(Vector3.zAxis, true)
			t:wait(0.6)
			t:press("Jump")
			local groundY = t.root.Position.Y
			local heights: { number } = {}
			local maxY, wasAir = groundY, false
			t:waitFor(function()
				return #heights >= 5
			end, 8, function()
				local inAir = t.motor:GetMode() == "Air"
				if inAir then
					maxY = math.max(maxY, t.root.Position.Y)
				elseif wasAir then
					table.insert(heights, maxY - groundY)
					maxY = groundY
				end
				wasAir = inAir
			end)
			t:release("Jump")
			t:check("held Space", #heights >= 5 and spreadOk(heights, want), list(heights))
		end,
	},
	{
		name = "Walls never hold you up",
		run = function(t)
			wallCase(t, Vector3.xAxis, true, false)
			wallCase(t, Vector3.xAxis, true, true)
			wallCase(t, Vector3.new(1, 0, 1).Unit, true, false)
			wallCase(t, Vector3.xAxis, false, false)
		end,
	},
	{
		name = "4-stud box reachable, 9-stud ledge grabbed without a fling",
		run = function(t)
			t:teleport(Vector3.new(-30, 4, 22), Vector3.zAxis)
			t:move(Vector3.zAxis, false)
			t:wait(0.3)
			t:jumpOnce(2)
			t:wait(0.3)
			t:check("on the 4-stud box", t.root.Position.Y > 6, string.format("ended at y %.1f", t.root.Position.Y))

			t:teleport(Vector3.new(-30, 4, 52), Vector3.zAxis)
			t:move(Vector3.zAxis, false)
			local highest = 0
			local t0 = os.clock()
			while os.clock() - t0 < 4 do
				local stats = t:jumpOnce(2)
				highest = math.max(highest, stats.maxY)
			end
			-- Standing on the ledge puts the root at 12; one more jump from there peaks at 19.2.
			t:check("scaled the 9-stud ledge", highest > 11.5, string.format("highest %.1f", highest))
			t:check("no fling", highest <= 12 + Config.JumpHeight + 0.6, string.format("highest %.1f", highest))
		end,
	},
	{
		name = "Fall gravity ramps up and caps at terminal velocity",
		run = function(t)
			t:stop()
			t.root.AssemblyLinearVelocity = Vector3.zero
			t.root.CFrame = CFrame.new(OPEN_AREA + Vector3.new(0, 300, 0))
			task.wait(0.1)
			local v1, t1 = t.root.AssemblyLinearVelocity.Y, os.clock()
			task.wait(0.2)
			local v2, t2 = t.root.AssemblyLinearVelocity.Y, os.clock()
			local measured = (v1 - v2) / (t2 - t1) / Workspace.Gravity
			local rampTime = math.max(Config.FallGravityRampTime, 1e-3)
			local function ramp(x: number): number
				return 1 + (Config.FallGravityMax - 1) * math.clamp(x / rampTime, 0, 1)
			end
			local expected = (ramp(0.1) + ramp(0.2) * 2 + ramp(0.3)) / 4
			t:near("gravity while ramping (x normal)", measured, expected, 0.15)
			local maxFall = 0
			t:waitFor(function()
				return t.motor:GetMode() ~= "Air"
			end, 8, function()
				maxFall = math.max(maxFall, -t.root.AssemblyLinearVelocity.Y)
			end)
			t:check("terminal velocity", maxFall <= Config.TerminalVelocity + 0.5 and maxFall >= Config.TerminalVelocity - 1,
				string.format("max fall %.2f (want %d)", maxFall, Config.TerminalVelocity))
		end,
	},
	{
		name = "Speeds scale with health",
		run = function(t)
			for _, share in { 1, 0.5, 0.1 } do
				local scale = speedScaleAt(share)
				t:setHealth(share)
				t:teleport(Vector3.new(-100, 4, -160), Vector3.zAxis)
				local walk = moveFor(t, false, 1.0, 0.4)
				t:stop()
				t:teleport(Vector3.new(-110, 4, -160), Vector3.zAxis)
				local run = moveFor(t, true, 1.4, 0.5)
				local jump = t:jumpOnce()
				t:stop()
				local label = string.format("%d%% HP", share * 100)
				t:near(label .. " walk", walk, Config.WalkSpeed * scale, 0.6)
				t:near(label .. " run", run, Config.RunSpeed * scale, 1)
				t:check(label .. " never faster in the air", jump.peakSpeed < Config.RunSpeed * scale + 1,
					string.format("air peak %.1f", jump.peakSpeed))
			end
			t:setHealth(1)
			t:teleport(Vector3.new(-130, 4, -160), Vector3.zAxis)
			moveFor(t, true, 1.2, 0.2)
			t:setHealth(0.1)
			local settled = moveFor(t, true, 0.6, 0.2)
			t:near("hit mid-run slows to the new run speed", settled, Config.RunSpeed * speedScaleAt(0.1), 1)
			t:setHealth(1)
			t:near("healing speeds back up", moveFor(t, true, 0.8, 0.2), Config.RunSpeed, 1)
		end,
	},
}

return {
	name = "Basics",
	description = "Speeds, jump heights, walls, ledges, falling, health speeds",
	tests = tests,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEBCC171045C44639B3E0A918A171DAB6"><Properties><string name="Name">Dash</string><ProtectedString name="Source"><![CDATA[--!strict
-- Dash suite: the four directions and their distances, dashing into obstacles never launching you,
-- and the cooldown. (A front dash's M1, the lunge, is in the Attacks suite.) Keys go through
-- Controls (Shift) with the camera aimed like a player's.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Harness = require(script.Parent.Parent.Harness)
local Config = require(ReplicatedStorage.Movement.MovementConfig)

type Context = Harness.Context

local LANE = Vector3.new(60, 4, -40)
local FORWARD = Vector3.zAxis
local RIGHT = Vector3.new(-1, 0, 0) -- right of a character looking +Z

-- Dashes from a standstill at `position` looking along `look`, holding `keys` (world direction).
-- Returns (started, flat movement, animations seen).
local function trial(t: Context, position: Vector3, look: Vector3, keys: Vector3): (boolean, Vector3, { [string]: boolean })
	t:teleport(position, look)
	t:aimCamera(look)
	t:waitDashReady()
	t.humanoid:Move(keys, false)
	t:frame()
	local start = t.root.Position
	t:press("Dash")
	local started = t.dash:IsBusy()
	local seen: { [string]: boolean } = {}
	local animator = t.humanoid:FindFirstChildOfClass("Animator")
	local t0 = os.clock()
	while os.clock() - t0 < 1.3 do
		if animator then
			for _, track in animator:GetPlayingAnimationTracks() do
				seen[if track.Animation then track.Animation.Name else "?"] = true
			end
		end
		t:frame()
	end
	t:stop()
	return started, (t.root.Position - start) * Vector3.new(1, 0, 1), seen
end

type Case = { name: string, keys: Vector3, want: number, anim: string, axis: Vector3 }
local CASES: { Case } = {
	{ name = "no keys -> front", keys = Vector3.zero, want = Config.FrontDashDistance, anim = "DashForward", axis = FORWARD },
	{ name = "W -> front", keys = FORWARD, want = Config.FrontDashDistance, anim = "DashForward", axis = FORWARD },
	{ name = "D -> right", keys = RIGHT, want = Config.SideDashDistance, anim = "DashRight", axis = RIGHT },
	{ name = "A -> left", keys = -RIGHT, want = Config.SideDashDistance, anim = "DashLeft", axis = -RIGHT },
	{ name = "S -> back", keys = -FORWARD, want = Config.SideDashDistance, anim = "DashBack", axis = -FORWARD },
	{ name = "W+A -> front", keys = (FORWARD - RIGHT).Unit, want = Config.FrontDashDistance, anim = "DashForward", axis = FORWARD },
	{ name = "S+D -> back", keys = (-FORWARD + RIGHT).Unit, want = Config.SideDashDistance, anim = "DashBack", axis = -FORWARD },
}

local tests: { Harness.Test } = {
	{
		name = "Directions, distances and animations",
		run = function(t)
			for _, case in CASES do
				local started, moved, seen = trial(t, LANE, FORWARD, case.keys)
				local distance = t.dash:GetLastDistance()
				local off = if moved.Magnitude > 0.1
					then math.deg(math.acos(math.clamp(moved.Unit:Dot(case.axis), -1, 1)))
					else 180
				t:check(case.name, started and math.abs(distance - case.want) <= 1 and seen[case.anim] == true and off < 4,
					string.format("%.2f studs (want %.1f), anim %s, %.1f deg off its axis", distance, case.want,
						if seen[case.anim] then "ok" else "MISSING", off))
			end
		end,
	},
	{
		name = "Dashing into obstacles never launches you",
		run = function(t)
			type Obstacle = { name: string, from: Vector3, look: Vector3, keys: Vector3, maxRise: number }
			local obstacles: { Obstacle } = {
				{ name = "vault box (vaults it)", from = Vector3.new(0, 4, 30), look = FORWARD, keys = Vector3.zero, maxRise = 3 + 1.2 },
				{ name = "jump box (steps up)", from = Vector3.new(-30, 4, 24), look = FORWARD, keys = Vector3.zero, maxRise = 4 + 1.2 },
				{ name = "tall wall", from = Vector3.new(22, 4, 56), look = Vector3.xAxis, keys = Vector3.zero, maxRise = 1.2 },
				{ name = "tall wall, diagonal", from = Vector3.new(24, 4, 46), look = Vector3.new(1, 0, 1).Unit, keys = Vector3.zero, maxRise = 1.2 },
				{ name = "vault box, side dash", from = Vector3.new(-12, 4, 40), look = -FORWARD, keys = Vector3.xAxis, maxRise = 1.2 },
			}
			for _, obstacle in obstacles do
				t:teleport(obstacle.from, obstacle.look)
				t:aimCamera(obstacle.look)
				t:waitDashReady()
				t.humanoid:Move(obstacle.keys, false)
				t:frame()
				local startY = t.root.Position.Y
				local maxY = startY
				t:press("Dash")
				-- Watch the highest point for a second (the condition never ends it early).
				t:waitFor(function()
					return false
				end, 1, function()
					maxY = math.max(maxY, t.root.Position.Y)
				end)
				t:check(obstacle.name, maxY - startY < obstacle.maxRise,
					string.format("rose %.2f (max %.1f), dash ended: %s", maxY - startY, obstacle.maxRise, t.dash:GetLastEndReason()))
				t:stop()
			end
		end,
	},
	{
		name = "Cooldown",
		run = function(t)
			t:teleport(LANE, FORWARD)
			t:aimCamera(FORWARD)
			t:waitDashReady()
			t:press("Dash")
			local first = t.dash:IsBusy()
			t:wait(Config.DashCooldown - 0.3)
			local early = t.dash:Request()
			t:wait(0.35)
			local after = t.dash:Request()
			t:check("one dash, then the cooldown", first and not early and after,
				string.format("first %s, at %.1fs %s, at %.1fs %s", tostring(first), Config.DashCooldown - 0.3,
					tostring(early), Config.DashCooldown + 0.05, tostring(after)))
		end,
	},
}

return {
	name = "Dash",
	description = "Directions, distances, obstacles, cooldown",
	tests = tests,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX44FDC4B08ACC4D1DB058CA2D09B37EDE"><Properties><string name="Name">Flow</string><ProtectedString name="Source"><![CDATA[--!strict
-- Flow suite: moves chaining into each other. Jump buffers (Space near the end of a vault / climb /
-- slide / dash jumps the moment it ends), dash-jumps keeping the dash's speed, a front dash handing
-- its speed to a vault, the slide-jump, and extra speed bleeding off.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Harness = require(script.Parent.Parent.Harness)
local Config = require(ReplicatedStorage.Movement.MovementConfig)

type Context = Harness.Context

local RUN = Config.RunSpeed
local LANE = Vector3.new(0, 4, -40)
local BACKWARD = -Vector3.zAxis

-- A quick Space tap that doesn't wait (it lifts 0.08 s later on its own).
local function tapJump(t: Context)
	t:press("Jump")
	task.delay(0.08, function()
		if t.jumpHeld then
			t:release("Jump")
		end
	end)
end

-- Runs `direction` from `start`; presses Space `pressAt` seconds into the move `busy` watches (nil =
-- never). Returns (a jump came out within 0.7 s after the move ended, how long the move lasted).
local function buffered(t: Context, start: Vector3, direction: Vector3, busy: () -> boolean, pressAt: number?, dashIt: boolean?): (boolean, number)
	t:teleport(start, direction)
	t:aimCamera(direction)
	t:move(direction, not dashIt)
	if dashIt then
		t:frame()
		t:press("Dash")
	end
	local t0 = os.clock()
	local startedAt: number?, endedAt: number? = nil, nil
	local pressed, jumped = false, false
	while os.clock() - t0 < 3 do
		t.humanoid:Move(direction, false)
		local now = os.clock()
		local isBusy = busy()
		if isBusy and not startedAt then
			startedAt = now
		end
		if startedAt and not endedAt and not isBusy then
			endedAt = now
		end
		if startedAt and pressAt and not pressed and isBusy and now - startedAt >= pressAt then
			tapJump(t)
			pressed = true
		end
		if endedAt then
			jumped = jumped or t.root.AssemblyLinearVelocity.Y > 30
			if now - endedAt > 0.7 then
				break
			end
		end
		t:frame()
	end
	t:stop()
	t:grounded(3)
	t:wait(0.2)
	return jumped, if startedAt and endedAt then endedAt - startedAt else -1
end

-- After a jump starts: (flat distance in the air, speed just after takeoff, speed at landing).
local function airDistance(t: Context, direction: Vector3): (number, number, number)
	local start = t.root.Position
	t:waitFor(function()
		return t.motor:GetMode() == "Air"
	end, 0.6)
	local takeoff, landing, sampled = 0, 0, false
	local t0 = os.clock()
	while t.motor:GetMode() ~= "Ground" and os.clock() - t0 < 3 do
		t.humanoid:Move(direction, false)
		if not sampled and os.clock() - t0 > 0.05 then
			takeoff = t:flatSpeed()
			sampled = true
		end
		landing = t:flatSpeed()
		t:frame()
	end
	return ((t.root.Position - start) * Vector3.new(1, 0, 1)).Magnitude, takeoff, landing
end

local tests: { Harness.Test } = {
	{
		name = "Jump buffers at the end of moves",
		run = function(t)
			t:block("ParkourTestLedge", Vector3.new(12, 6, 12), CFrame.new(-80, 3, -60))
			local function parkourBusy(): boolean
				return t.parkour:IsBusy()
			end
			local function dashBusy(): boolean
				return t.dash:IsBusy()
			end
			local v, vt = buffered(t, Vector3.new(0, 4, 18), Vector3.zAxis, parkourBusy, 0.08)
			t:check("Space near the end of a vault jumps on landing", v, string.format("vault lasted %.2fs", vt))
			t:check("a vault with no press doesn't jump", not (buffered(t, Vector3.new(0, 4, 18), Vector3.zAxis, parkourBusy, nil)))
			local c = buffered(t, Vector3.new(-80, 4, -80), Vector3.zAxis, parkourBusy, 0.3)
			t:check("Space near the end of a climb jumps on top", c)
			t:check("Space near the end of a slide jumps as you stand", (buffered(t, Vector3.new(0, 4, 58), Vector3.zAxis, parkourBusy, 0.35)))
			t:check("Space early in a slide queues a slide-jump", (buffered(t, Vector3.new(0, 4, 58), Vector3.zAxis, parkourBusy, 0.03)))
			t:waitDashReady()
			local d = buffered(t, LANE, BACKWARD, dashBusy, Config.FrontDashTime - 0.15, true)
			t:check("Space near the end of a dash jumps right after", d)
			t:waitDashReady()
			local de, det = buffered(t, LANE, BACKWARD, dashBusy, 0.03, true)
			t:check("Space early in a dash dash-jumps", de and det < Config.FrontDashTime - 0.2, string.format("dash lasted %.2fs", det))
		end,
	},
	{
		name = "Dash-jump keeps the dash's speed",
		run = function(t)
			t:teleport(LANE, BACKWARD)
			t:aimCamera(BACKWARD)
			t:move(BACKWARD, true)
			t:wait(1)
			tapJump(t)
			local runJump, runTakeoff = airDistance(t, BACKWARD)
			t:stop()
			t:waitDashReady()
			t:teleport(LANE, BACKWARD)
			t:aimCamera(BACKWARD)
			t:move(BACKWARD, true)
			t:frame()
			t:press("Dash")
			t:wait(0.15)
			tapJump(t)
			local dashJump, takeoff, landing = airDistance(t, BACKWARD)
			t:check("dash-jump takeoff is dash speed (capped)",
				t.dash:GetLastEndReason() == "jump" and takeoff > RUN + 10 and takeoff <= Config.MomentumMaxSpeed + 3,
				string.format("ended by %s, takeoff %.1f (running jump %.1f)", t.dash:GetLastEndReason(), takeoff, runTakeoff))
			t:check("it carries farther than a running jump", dashJump > runJump + 5,
				string.format("%.1f vs %.1f studs", dashJump, runJump))
			t:check("extra speed bleeds off slowly in the air", landing < takeoff and landing > RUN,
				string.format("takeoff %.1f -> landing %.1f", takeoff, landing))
			local settled = 0
			t:waitFor(function()
				return false
			end, 1.5, function()
				t:move(BACKWARD, true)
				settled = t:flatSpeed()
			end)
			t:near("on the ground it settles back to run speed", settled, RUN, 1.5)
		end,
	},
	{
		name = "Dash-jump variants",
		run = function(t)
			t:waitDashReady()
			t:teleport(LANE, BACKWARD)
			t:aimCamera(BACKWARD)
			t:move(BACKWARD, true)
			t:frame()
			t:press("Dash")
			tapJump(t)
			local _, instant = airDistance(t, BACKWARD)
			t:check("Space the instant a dash starts dash-jumps", t.dash:GetLastEndReason() == "jump" and instant > RUN + 10,
				string.format("takeoff %.1f", instant))
			t:stop()
			t:waitDashReady()
			t:teleport(LANE, BACKWARD)
			t:aimCamera(BACKWARD)
			local sideways = Vector3.new(-BACKWARD.Z, 0, BACKWARD.X)
			t:move(sideways, false)
			t:frame()
			t:press("Dash")
			t:wait(0.1)
			tapJump(t)
			local _, side = airDistance(t, sideways)
			t:check("a side dash dash-jumps", t.dash:GetLastEndReason() == "jump" and side > RUN, string.format("takeoff %.1f", side))
			t:stop()
			-- Off the JumpBox's edge (top y 4, ends at z 48), Space just after leaving it.
			t:waitDashReady()
			t:teleport(Vector3.new(-30, 8, 42), Vector3.zAxis)
			t:aimCamera(Vector3.zAxis)
			t:move(Vector3.zAxis, true)
			t:frame()
			t:press("Dash")
			t:waitFor(function()
				return t.humanoid.FloorMaterial == Enum.Material.Air
			end, 0.5)
			t:wait(0.05)
			local offAt = t.root.Position.Y
			tapJump(t)
			local rose = 0
			t:waitFor(function()
				return false
			end, 0.4, function()
				rose = math.max(rose, t.root.Position.Y - offAt)
			end)
			t:check("dashing off a ledge, Space just after still dash-jumps", t.dash:GetLastEndReason() == "jump" and rose > 3,
				string.format("rose %.1f after the edge", rose))
		end,
	},
	{
		name = "Front dash into a box vaults it at dash speed; slide-jump keeps slide speed",
		run = function(t)
			t:waitDashReady()
			t:teleport(Vector3.new(0, 4, 26), Vector3.zAxis)
			t:aimCamera(Vector3.zAxis)
			local vaults = t.parkour:GetCount("Vault")
			t:move(Vector3.zAxis, true)
			t:frame()
			t:press("Dash")
			local afterVault, sawVault = 0, false
			t:waitFor(function()
				return afterVault > 0
			end, 1.5, function()
				t:move(Vector3.zAxis, true)
				if t.parkour:IsBusy() then
					sawVault = true
				elseif sawVault then
					afterVault = t:flatSpeed()
				end
			end)
			t:check("dash hands its speed to the vault",
				t.parkour:GetCount("Vault") > vaults and t.dash:GetLastEndReason() == "move" and afterVault > RUN + 5 and afterVault <= Config.MomentumMaxSpeed + 3,
				string.format("ended by %s, speed after %.1f", t.dash:GetLastEndReason(), afterVault))
			t:stop()
			t:teleport(Vector3.new(0, 4, 60), Vector3.zAxis)
			local pressed, slideSeen = false, false
			local jumpedSpeed = -1
			local airSince: number? = nil
			t:waitFor(function()
				return jumpedSpeed >= 0
			end, 2.5, function()
				t:move(Vector3.zAxis, true)
				if t.parkour:IsBusy() and t.parkour:GetAction() == "Slide" then
					slideSeen = true
					if not pressed then
						tapJump(t)
						pressed = true
					end
				end
				if slideSeen and not t.parkour:IsBusy() and t.motor:GetMode() == "Air" then
					airSince = airSince or os.clock()
					if os.clock() - (airSince :: number) > 0.05 then
						jumpedSpeed = if t.root.AssemblyLinearVelocity.Y > 5 then t:flatSpeed() else 0
					end
				end
			end)
			local slideEnd = t.parkour:GetLastEndSpeed()
			t:check("slide-jump jumps out keeping slide speed", jumpedSpeed > 0 and jumpedSpeed >= slideEnd - 2,
				string.format("slide ended at %.1f, jumped at %.1f", slideEnd, jumpedSpeed))
		end,
	},
}

return {
	name = "Flow",
	description = "Jump buffers, dash-jumps, momentum hand-offs",
	tests = tests,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXAB19B0E9F9DE4A8F8D7BF290E8B5B6EB"><Properties><string name="Name">Landing</string><ProtectedString name="Source"><![CDATA[--!strict
-- Landing suite: the landing roll (when it happens, distance by fall height, momentum and aiming,
-- rolling off ledges and into walls, the roll-jump), long falls without a roll leaving you free
-- to act at once (there's no landing lag), plus the landing clips.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Harness = require(script.Parent.Parent.Harness)
local Config = require(ReplicatedStorage.Movement.MovementConfig)

type Context = Harness.Context

local OPEN = Vector3.new(-100, 4, -100)

type Drop = {
	rolled: boolean,
	rollDistance: number,
	rollDirection: Vector3,
	endSpeed: number,
	rise: number,
	jumpedAfter: boolean,
	fall: number,
	info: string,
}

-- Drops the character `height` studs above `ground` with `horizontal` speed.
-- style: "late" = Space ~0.08 s before touchdown; "early" = ~0.5 s before; "none"; "hold" = late and
-- kept held; "rolljump" = late + a fresh press near the end of the roll. `keys`: held during the drop.
local function drop(t: Context, ground: Vector3, height: number, horizontal: Vector3, style: string, keys: Vector3?): Drop
	t:teleport(ground, if horizontal.Magnitude > 0.1 then horizontal.Unit else Vector3.zAxis)
	local restY = t.root.Position.Y
	local rollsBefore = t.roll:GetTotalRolls()
	local move = keys or (if horizontal.Magnitude > 0.1 then horizontal.Unit else Vector3.zero)
	t.root.CFrame += Vector3.new(0, height, 0)
	t.root.AssemblyLinearVelocity = horizontal
	local pressed, released, boosted = false, false, false
	local pressAt = 0
	local t0 = os.clock()
	while t.motor:GetMode() ~= "Ground" or os.clock() - t0 < 0.15 do
		if os.clock() - t0 > 6 then
			break
		end
		t.humanoid:Move(move, false)
		-- Give the fall its speed once airborne (the teleport's ground frame would cap it).
		if not boosted and t.motor:GetMode() == "Air" then
			boosted = true
			t.root.AssemblyLinearVelocity = Vector3.new(horizontal.X, t.root.AssemblyLinearVelocity.Y, horizontal.Z)
			t.motor:ApplyMomentum(horizontal)
		end
		local vy = -t.root.AssemblyLinearVelocity.Y
		local above = t.root.Position.Y - restY
		local lead = if style == "early" then 0.5 elseif style == "none" then -1 else 0.08
		if not pressed and lead > 0 and vy > 1 and above <= vy * lead + 0.3 then
			t:press("Jump")
			pressed, pressAt = true, os.clock()
		end
		if pressed and not released and style ~= "hold" and os.clock() - pressAt > 0.08 then
			t:release("Jump")
			released = true
		end
		t:frame()
	end
	local landY, landPos = t.root.Position.Y, t.root.Position
	local rolled = t.roll:GetTotalRolls() > rollsBefore
	local maxY = landY
	local freshPressed = false
	local t1 = os.clock()
	while t.roll:IsRolling() and os.clock() - t1 < 2 do
		t.humanoid:Move(move, false)
		if pressed and not released and style ~= "hold" and os.clock() - pressAt > 0.08 then
			t:release("Jump")
			released = true
		end
		if style == "rolljump" and not freshPressed and os.clock() - t1 > Config.LandingRollTime - 0.1 then
			t:release("Jump")
			t:press("Jump")
			freshPressed = true
		end
		maxY = math.max(maxY, t.root.Position.Y)
		t:frame()
	end
	local offset = (t.root.Position - landPos) * Vector3.new(1, 0, 1)
	local endSpeed = t:flatSpeed()
	local jumpedAfter = false
	local t2 = os.clock()
	while os.clock() - t2 < 0.5 do
		t.humanoid:Move(move, false)
		if style == "hold" and os.clock() - pressAt > 1.2 and t.jumpHeld then
			t:release("Jump")
		end
		if style == "rolljump" and os.clock() - t2 > 0.1 and t.jumpHeld then
			t:release("Jump")
		end
		if t.motor:GetMode() == "Air" and t.root.Position.Y > landY + 1 then
			jumpedAfter = true
		end
		maxY = math.max(maxY, t.root.Position.Y)
		t:frame()
	end
	t:stop()
	t:waitFor(function()
		return t.motor:GetMode() == "Ground" and not t.roll:IsRolling()
	end, 4)
	return {
		rolled = rolled,
		rollDistance = offset.Magnitude,
		rollDirection = if offset.Magnitude > 0.5 then offset.Unit else Vector3.zero,
		endSpeed = endSpeed,
		rise = maxY - landY,
		jumpedAfter = jumpedAfter,
		fall = t.roll:GetLastFall(),
		info = t.roll:GetLastInfo(),
	}
end

local function bonus(fall: number): number
	return math.min(Config.LandingRollBaseDistance + (fall - Config.LandingRollMinFall) * Config.LandingRollDistancePerStud,
		Config.LandingRollMaxBonus)
end

local tests: { Harness.Test } = {
	{
		name = "When the roll happens",
		run = function(t)
			local a = drop(t, OPEN, 20, Vector3.zero, "late")
			t:check("drop 20 + press right before landing rolls", a.rolled and math.abs(a.rollDistance - bonus(a.fall)) < 2,
				string.format("%.1f studs (want %.1f), fall %.1f", a.rollDistance, bonus(a.fall), a.fall))
			t:check("no press: no roll", not drop(t, OPEN, 20, Vector3.zero, "none").rolled)
			local c = drop(t, OPEN, 20, Vector3.zero, "early")
			t:check("press too early: no roll", not c.rolled, c.info)
			local d = drop(t, OPEN, Config.JumpHeight - 0.5, Vector3.zero, "late")
			t:check("short fall + press: a buffered jump instead", not d.rolled and d.jumpedAfter, d.info)
			local e = drop(t, OPEN, 40, Vector3.zero, "late")
			t:check("higher fall rolls farther", e.rolled and e.rollDistance > a.rollDistance + 2,
				string.format("fall %.1f -> %.1f studs (vs %.1f)", e.fall, e.rollDistance, a.rollDistance))
		end,
	},
	{
		name = "Momentum, aiming and the roll-jump",
		run = function(t)
			local run = Config.RunSpeed
			local f = drop(t, OPEN, 20, Vector3.zAxis * run, "late")
			local want = run * Config.LandingRollTime + bonus(f.fall)
			t:check("momentum kept through the roll", f.rolled and f.endSpeed > run - 4 and math.abs(f.rollDistance - want) < 4,
				string.format("end speed %.1f, rolled %.1f (want ~%.1f)", f.endSpeed, f.rollDistance, want))
			local g = drop(t, OPEN, 20, Vector3.zero, "hold")
			t:check("holding Space through the roll doesn't jump", g.rolled and not g.jumpedAfter and g.rise < 1.5,
				string.format("jumped %s, rose %.1f", tostring(g.jumpedAfter), g.rise))
			local h = drop(t, OPEN, 20, Vector3.zAxis * 10, "rolljump")
			t:check("a fresh press at the end of the roll jumps out", h.rolled and h.jumpedAfter)
			local side = drop(t, OPEN, 20, Vector3.zAxis * run, "late", Vector3.xAxis)
			t:check("holding D rolls sideways", side.rolled and side.rollDirection:Dot(Vector3.xAxis) > 0.9,
				string.format("direction (%.2f, %.2f)", side.rollDirection.X, side.rollDirection.Z))
			local back = drop(t, OPEN, 20, Vector3.zAxis * run, "late", -Vector3.zAxis)
			t:check("rolling back against momentum keeps part of it",
				back.rolled and back.rollDirection:Dot(-Vector3.zAxis) > 0.9 and back.endSpeed > run * Config.LandingRollTurnKeep - 3,
				string.format("end speed %.1f", back.endSpeed))
		end,
	},
	{
		name = "Rolling off ledges and into walls",
		run = function(t)
			local box = drop(t, Vector3.new(-36, 8, 40), 16, Vector3.xAxis * 14, "late")
			t:check("rolling off a ledge ends the roll and keeps speed", box.rolled and box.endSpeed > 10,
				string.format("speed leaving %.1f", box.endSpeed))
			local wall = drop(t, Vector3.new(24, 4, 50), 20, Vector3.xAxis * 8, "late")
			t:check("rolling into a wall doesn't launch", wall.rolled and wall.rise < 1.5, string.format("rose %.1f", wall.rise))
		end,
	},
	{
		name = "A long fall without a roll: no landing lag",
		run = function(t)
			t:waitDashReady()
			t:teleport(OPEN, Vector3.zAxis)
			local record = t:recordAttribute("LocoAnim")
			t.root.CFrame += Vector3.new(0, 30, 0)
			t:grounded(6)
			t:frame()
			local dashed = t.dash:Request()
			t:check("you can dash straight away", dashed)
			t:waitFor(function()
				return not t.dash:IsBusy()
			end, 2)
			local jump = t:jumpOnce()
			t:check("and jump", jump.height > Config.JumpHeight * 0.7, string.format("%.1f studs", jump.height))
			local anims = table.concat(record(), " > ")
			t:check("no heavy landing clip", string.find(anims, "LandHeavy") == nil, anims)
		end,
	},
	{
		name = "Landing clips",
		run = function(t)
			t:teleport(OPEN, Vector3.zAxis)
			local record = t:recordAttribute("LocoAnim")
			t:jumpOnce()
			t:wait(0.3)
			local standing = table.concat(record(), " > ")
			t:check("standing jump lands with LandLight", string.find(standing, "Fall > LandLight") ~= nil
				or string.find(standing, "Jump > LandLight") ~= nil, standing)
			t:teleport(OPEN, Vector3.zAxis)
			t:move(Vector3.zAxis, true)
			t:wait(0.8)
			record = t:recordAttribute("LocoAnim")
			t:jumpOnce()
			t:wait(0.3)
			local running = table.concat(record(), " > ")
			t:check("running jump lands with LandRun, then back to Sprint", string.find(running, "LandRun > Sprint") ~= nil, running)
		end,
	},
	{
		name = "No dash during a roll",
		run = function(t)
			t:teleport(OPEN, Vector3.zAxis)
			local restY = t.root.Position.Y
			t.root.CFrame += Vector3.new(0, 20, 0)
			local dashed, sawRoll, pressed = false, false, false
			t:waitFor(function()
				return sawRoll and not t.roll:IsRolling()
			end, 4, function()
				local vy = -t.root.AssemblyLinearVelocity.Y
				if not pressed and vy > 1 and t.root.Position.Y - restY <= vy * 0.08 + 0.3 then
					t:press("Jump")
					pressed = true
				end
				if t.roll:IsRolling() then
					sawRoll = true
					if t.jumpHeld then
						t:release("Jump")
					end
					dashed = dashed or t.dash:Request()
				end
			end)
			t:check("rolled, and no dash started during it", sawRoll and not dashed)
		end,
	},
}

return {
	name = "Landing",
	description = "Landing roll, long falls, landing clips",
	tests = tests,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX07DE420012104C48B0D5D792E80C0454"><Properties><string name="Name">Moth</string><ProtectedString name="Source"><![CDATA[--!strict
-- Moth suite: the paper wings on the character, Left Ctrl (tap = wing flight, hold = charge +
-- throw, press in the air = suspend, hold with the lantern away = fly inside its light or to a
-- tagged opponent), M1 ending a flight, the throw landing where the preview said, and hits on the
-- training dummy (DummyStand). Ctrl goes through Controls ("Race").

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Harness = require(script.Parent.Parent.Harness)
local Config = require(ReplicatedStorage.Movement.MovementConfig)
local MothPartsData = require(ReplicatedStorage.Movement.MothPartsData)

type Context = Harness.Context

local BASE = Vector3.new(140, 4, -140)
local INWARD = Vector3.new(-1, 0, 1).Unit -- toward the middle of the map, so flights stay over it

local function aim(t: Context, direction: Vector3)
	local d = direction.Unit
	t.camera.CameraType = Enum.CameraType.Scriptable
	t.camera.CFrame = CFrame.lookAt(t.root.Position - d * 10, t.root.Position - d * 10 + d)
end

local function tapCtrl(t: Context)
	t:press("Race")
	task.wait(0.03)
	t:release("Race")
end

local function holdCtrl(t: Context, extra: number?)
	t:press("Race")
	task.wait(Config.LanternTapTime + (extra or 0.05))
end

local function asMoth(t: Context)
	t.character:SetAttribute("Race", "Moth")
	t.lantern:ResetForTest()
end

local tests: { Harness.Test } = {
	{
		name = "Paper wings and the lantern on the character",
		run = function(t)
			asMoth(t)
			t:teleport(BASE, INWARD)
			local wings = t.character:FindFirstChild("MothWings")
			local visible = 0
			if wings then
				for _, part in wings:GetChildren() do
					if part:IsA("BasePart") and part.Transparency < 1 then
						visible += 1
					end
				end
			end
			t:check("wings built from MothPartsData", wings ~= nil and visible == #MothPartsData.Parts,
				string.format("%d visible parts (data has %d)", visible, #MothPartsData.Parts))
			local torso = t.character:FindFirstChild("Torso") :: BasePart
			local motor = torso:FindFirstChild("RightForewing")
			t:check("wing bones are Motor6Ds (animations move them)", motor ~= nil and motor:IsA("Motor6D"))
			local lantern = t.character:FindFirstChild("Lantern")
			local core = if lantern and lantern:IsA("Model") then lantern.PrimaryPart else nil
			local hip = if core then torso.CFrame:PointToObjectSpace(core.Position) else Vector3.zero
			t:check("the lantern sits on the right hip, not glowing", core ~= nil and hip.X > 0.8 and hip.Y < -0.5 and core.Material ~= Enum.Material.Neon,
				string.format("torso-local %.1f, %.1f, %.1f", hip.X, hip.Y, hip.Z))
			t.character:SetAttribute("Race", "")
			tapCtrl(t)
			t:check("not a Moth: Ctrl does nothing", t.lantern:GetFlight() == nil and t.lantern:GetState() == "Hip", t.lantern:GetLastInfo())
			t.character:SetAttribute("Race", "Moth")
		end,
	},
	{
		name = "Wing flight (tap)",
		run = function(t)
			asMoth(t)
			t:teleport(BASE, INWARD)
			local direction = (INWARD + Vector3.new(0, 0.3, 0)).Unit
			aim(t, direction)
			local start = t.root.Position
			tapCtrl(t)
			local kind = t.lantern:GetFlight()
			t:waitFor(function()
				return t.lantern:GetFlight() == nil
			end, 1)
			local flown = t.root.Position - start
			local after = t.root.AssemblyLinearVelocity.Magnitude
			t:check("covers WingFlightDistance where the camera looks",
				kind == "Wings" and math.abs(flown.Magnitude - Config.WingFlightDistance) < 3 and flown.Unit:Dot(direction) > 0.95,
				string.format("flight %s, %.1f studs (want %d)", tostring(kind), flown.Magnitude, Config.WingFlightDistance))
			local flightSpeed = Config.WingFlightDistance / Config.WingFlightTime
			t:check("costs WingFlightCost stamina and keeps some momentum",
				math.abs((t.stamina:GetMax() - t.stamina:GetValue()) - Config.WingFlightCost) < 1 and after > flightSpeed * Config.WingFlightKeep * 0.6,
				string.format("stamina %d, speed after %.1f", t.stamina:GetValue(), after))
			t:grounded(8)
			t:teleport(BASE, INWARD)
			t.stamina:Set(t.stamina:GetMax())
			aim(t, direction)
			start = t.root.Position
			t:wait(Config.WingFlightCooldown)
			tapCtrl(t)
			t:wait(0.1)
			t:press("M1")
			local short = (t.root.Position - start).Magnitude
			t:check("M1 ends the flight early and swings", t.lantern:GetLastFlightEnd() == "m1" and short < Config.WingFlightDistance * 0.6
				and t.combat:GetPhase() ~= "Idle", string.format("ended by %s after %.1f studs, swing %s", t.lantern:GetLastFlightEnd(), short, t.combat:GetPhase()))
			t:grounded(8)
			t:teleport(BASE, INWARD)
			t.stamina:Set(t.stamina:GetMax())
			aim(t, direction)
			t:wait(Config.WingFlightCooldown)
			tapCtrl(t)
			t:wait(0.05)
			t:check("no dash while flying", not t.dash:Request())
		end,
	},
	{
		name = "Charge, throw, suspend, fly in the light, grab",
		run = function(t)
			asMoth(t)
			t:teleport(BASE, INWARD)
			aim(t, Vector3.new(INWARD.X, 0.1, INWARD.Z))
			t.lantern:SetAimForTest(t.root.Position + INWARD * 40 + Vector3.new(0, 8, 0))
			holdCtrl(t, 0)
			local charging = t.lantern:GetState() == "Charging"
			t:wait(0.2)
			local preview = t.camera:FindFirstChild("LanternThrowPreview")
			local dots = 0
			if preview then
				for _, d in preview:GetChildren() do
					if d:IsA("BasePart") and d.Name ~= "Target" and d.Transparency < 1 then
						dots += 1
					end
				end
			end
			local look = t.root.CFrame.LookVector
			local facing = Vector3.new(look.X, 0, look.Z).Unit:Dot(INWARD)
			t:check("while charging: throw path shown, body faces the aim", charging and dots >= 5 and facing > 0.9,
				string.format("%d path dots, facing dot %.2f", dots, facing))
			local before = t.root.Position
			t:release("Race")
			t:check("release throws and hides the path", t.lantern:GetState() == "Thrown" and t.camera:FindFirstChild("LanternThrowPreview") == nil)
			local weak = t.lantern:GetLastThrowSpeed()
			t:wait(0.25)
			t:check("throwing doesn't move you", (t.root.Position - before).Magnitude < 0.6)
			tapCtrl(t)
			local p0 = t.lantern:GetPosition()
			t:wait(0.8)
			t:check("press while it's in the air suspends it", t.lantern:GetState() == "Suspended" and (t.lantern:GetPosition() - p0).Magnitude < 0.05,
				"state " .. t.lantern:GetState())
			t.stamina:Set(t.stamina:GetMax())
			local lanternAt = t.lantern:GetPosition()
			aim(t, (t.root.Position - lanternAt) * Vector3.new(1, 0, 1) + Vector3.new(0, 2, 0))
			holdCtrl(t)
			local kind = t.lantern:GetFlight()
			local farthest = 0
			t:waitFor(function()
				return false
			end, 1.5, function()
				farthest = math.max(farthest, (t.root.Position - lanternAt).Magnitude)
			end)
			t:check("hold inside the light: free flight that can't leave the light", kind == "Free" and farthest <= Config.LanternLightRadius + 1.5,
				string.format("flight %s, farthest %.1f (radius %d)", tostring(kind), farthest, Config.LanternLightRadius))
			local speedBefore = 0
			t:waitFor(function()
				return t.lantern:GetState() == "Hip"
			end, 3, function()
				aim(t, t.lantern:GetPosition() - t.root.Position)
				speedBefore = t.root.AssemblyLinearVelocity.Magnitude
			end)
			local speedAfter = t.root.AssemblyLinearVelocity.Magnitude
			t:release("Race")
			t:check("flying into the lantern grabs it with a burst", t.lantern:GetState() == "Hip" and t.lantern:GetLastFlightEnd() == "grab" and speedAfter > speedBefore + 10,
				string.format("speed %.0f -> %.0f", speedBefore, speedAfter))
			holdCtrl(t)
			local blocked = t.lantern:GetState() ~= "Charging"
			t:release("Race")
			t:check("just grabbed: no throw during LanternGrabCooldown", blocked)
			t:check("a quick hold throws slowly", weak < Config.LanternThrowSpeedMin + 25, string.format("%.0f", weak))
			t:grounded(8)
		end,
	},
	{
		name = "No flight outside the light; lying lantern; walking into it",
		run = function(t)
			asMoth(t)
			t:teleport(BASE, INWARD)
			t.lantern:PlaceForTest(BASE + Vector3.new(0, 8, -(Config.LanternLightRadius + 10)), "Suspended")
			holdCtrl(t)
			local outside = t.lantern:GetFlight()
			t:release("Race")
			t:check("outside its light: no flight", outside == nil, t.lantern:GetLastInfo())
			t.lantern:PlaceForTest(BASE + Vector3.new(0, 8, -5), "Suspended")
			t:teleport(BASE + Vector3.new(0, 8, -5), INWARD)
			holdCtrl(t)
			local started = t.lantern:GetFlight() == "Free"
			t:teleport(BASE + Vector3.new(0, 8, -(Config.LanternLightRadius + 5)), INWARD)
			t:wait(0.05)
			local ended = t.lantern:GetFlight() == nil and t.lantern:GetLastFlightEnd() == "left_light"
			t:release("Race")
			t:check("leaving the light stops the flight", started and ended, t.lantern:GetLastInfo())
			t.lantern:PlaceForTest(BASE + INWARD * 10 + Vector3.new(0, -3.5, 0), "Dropped")
			holdCtrl(t)
			local lying = t.lantern:GetFlight()
			t:release("Race")
			t:check("lantern lying somewhere: no flight", lying == nil)
			t:teleport(BASE + INWARD * 9, INWARD)
			t:waitFor(function()
				return t.lantern:GetState() == "Hip"
			end, 1)
			t:check("walking into it puts it back on the hip", t.lantern:GetState() == "Hip")
		end,
	},
	{
		name = "The throw lands on the preview ring; hits and tags",
		run = function(t)
			asMoth(t)
			t:teleport(BASE, INWARD)
			t:wait(0.4)
			local floor = t.root.Position + INWARD * 30 + Vector3.new(0, -6, 0)
			local hit = Workspace:Raycast(floor + Vector3.new(0, 10, 0), Vector3.new(0, -30, 0))
			if hit then
				floor = hit.Position
			end
			aim(t, Vector3.new(INWARD.X, -0.3, INWARD.Z))
			t.lantern:SetAimForTest(floor)
			local predicted = t.lantern:PredictForTest(0.5)
			t.lantern:ThrowForTest(nil, 0.5)
			t:waitFor(function()
				return t.lantern:GetLastLanding() ~= nil
			end, 3)
			local landed = t.lantern:GetLastLanding()
			local miss = if predicted and landed then (landed - predicted).Magnitude else math.huge
			t:check("lands where the preview ring is", miss < 1, string.format("%.2f studs apart", miss))
			t:check("its first impact flashes", t.lantern:HasBurst())
			t.lantern:SetAimForTest(nil)

			local folder = Workspace:FindFirstChild("TrainingDummies")
			local dummy = folder and folder:FindFirstChild("DummyStand")
			if dummy and dummy:IsA("Model") then
				t:dummy("DummyStand")
			end
			local dummyRoot = dummy and dummy:FindFirstChild("HumanoidRootPart")
			local dummyHumanoid = dummy and dummy:FindFirstChildOfClass("Humanoid")
			if not (dummy and dummy:IsA("Model") and dummyRoot and dummyRoot:IsA("BasePart") and dummyHumanoid) then
				t:log("no training dummy (Workspace > TrainingDummies > DummyStand): hit checks skipped")
				return
			end
			t.lantern:ResetForTest()
			t:teleport(dummyRoot.Position + Vector3.new(0, 1, 24), -Vector3.zAxis)
			local hp0 = dummyHumanoid.Health
			aim(t, dummyRoot.Position - t.lantern:GetPosition())
			t.lantern:SetAimForTest(dummyRoot.Position)
			holdCtrl(t, Config.LanternChargeTime)
			t:release("Race")
			local strong = t.lantern:GetLastThrowSpeed()
			t:waitFor(function()
				return t.lantern:GetTagTarget() ~= nil
			end, 1.5)
			local tagged = t.lantern:GetTagTarget()
			t:near("full charge throws at LanternThrowSpeedMax", strong, Config.LanternThrowSpeedMax, 3)
			t:check("a hit tags them and deals LanternDamage", tagged == dummy and math.abs((hp0 - dummyHumanoid.Health) - Config.LanternDamage) < 0.01,
				string.format("health %.0f -> %.0f", hp0, dummyHumanoid.Health))
			t.stamina:Set(t.stamina:GetMax())
			holdCtrl(t)
			local kind = t.lantern:GetFlight()
			t:waitFor(function()
				return t.lantern:GetFlight() == nil
			end, 2)
			t:release("Race")
			local gap = (dummyRoot.Position - t.root.Position).Magnitude
			t:check("hold while they're tagged flies you to them", kind == "Tag" and gap < Config.TagFlyStopDistance + 1.5,
				string.format("flight %s, %.1f studs from them", tostring(kind), gap))
			t.lantern:SetAimForTest(nil)
			t.lantern:ResetForTest()
		end,
	},
}

return {
	name = "Moth",
	description = "Paper wings, wing flight, lantern throw / suspend / flight / tag",
	tests = tests,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX458831CC2F6D46729825C62B6083A1BD"><Properties><string name="Name">Parkour</string><ProtectedString name="Source"><![CDATA[--!strict
-- Auto parkour suite: sprinting into the course's VaultBox (3 high), JumpBox (4 high), MantleLedge
-- (9 high), a 6-stud ledge (made here), SlideGap and TallWall; angles and corners; a wall hop into a
-- ledge grab; no dash during a slide.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Harness = require(script.Parent.Parent.Harness)
local Config = require(ReplicatedStorage.Movement.MovementConfig)

type Context = Harness.Context

local ACTIONS = { "Vault", "StepUp", "Climb", "Slide" }
local RUN = Config.RunSpeed

type Run = {
	counts: { [string]: number },
	final: Vector3,
	maxY: number,
	speedAfter: number,
	yAfter: number,
	startMode: string,
	dashDuring: boolean,
	standingAfter: boolean,
	headingAfter: number, -- degrees, 0 = +Z, + = toward +X, 0.1 s after the move
	maxTurn: number, -- biggest one-frame facing change during a move (degrees)
}

local function angled(degrees: number): Vector3
	local r = math.rad(degrees)
	return Vector3.new(math.sin(r), 0, math.cos(r))
end

-- A 6-stud ledge in hand reach from the ground: x -86..-74, z -66..-54, top at y 6.
local function sixStudLedge(t: Context)
	t:block("ParkourTestLedge", Vector3.new(12, 6, 12), CFrame.new(-80, 3, -60))
end

local function sprintAt(t: Context, start: Vector3, direction: Vector3, duration: number, sprint: boolean, jumpAt: number?): Run
	t:teleport(start, direction)
	local before: { [string]: number } = {}
	for _, name in ACTIONS do
		before[name] = t.parkour:GetCount(name)
	end
	local maxY = t.root.Position.Y
	local speedAfter, yAfter, headingAfter, maxTurn = -1, -math.huge, 0, 0
	local endedAt: number? = nil
	local lastYaw: number? = nil
	local wasBusy, jumped, dashDuring = false, false, false
	local t0 = os.clock()
	while os.clock() - t0 < duration do
		t:move(direction, sprint)
		if jumpAt and not jumped and os.clock() - t0 >= jumpAt then
			t:press("Jump")
			jumped = true
		elseif jumped and t.jumpHeld then
			t:release("Jump")
		end
		local busy = t.parkour:IsBusy()
		if busy and t.parkour:GetAction() == "Slide" and not dashDuring then
			dashDuring = t.dash:Request()
		end
		if wasBusy and not busy then
			endedAt = os.clock()
		end
		if endedAt and speedAfter < 0 and os.clock() - endedAt >= 0.1 then
			local v = t.root.AssemblyLinearVelocity
			speedAfter = t:flatSpeed()
			yAfter = t.root.Position.Y
			headingAfter = math.deg(math.atan2(v.X, v.Z))
		end
		local look = t.root.CFrame.LookVector
		local yaw = math.deg(math.atan2(look.X, look.Z))
		if busy and lastYaw then
			maxTurn = math.max(maxTurn, math.abs((yaw - lastYaw + 180) % 360 - 180))
		end
		lastYaw = yaw
		wasBusy = busy
		maxY = math.max(maxY, t.root.Position.Y)
		t:frame()
	end
	local counts: { [string]: number } = {}
	for _, name in ACTIONS do
		counts[name] = t.parkour:GetCount(name) - before[name]
	end
	t:stop()
	t:waitFor(function()
		return not t.parkour:IsBusy() and t.motor:GetMode() == "Ground"
	end, 3)
	t:wait(0.2)
	return {
		counts = counts,
		final = t.root.Position,
		maxY = maxY,
		speedAfter = speedAfter,
		yAfter = yAfter,
		startMode = t.parkour:GetLastStartMode(),
		dashDuring = dashDuring,
		standingAfter = t.motor:GetMode() == "Ground",
		headingAfter = headingAfter,
		maxTurn = maxTurn,
	}
end

local function total(r: Run): number
	return r.counts.Vault + r.counts.StepUp + r.counts.Climb + r.counts.Slide
end

local function describe(t: Context, r: Run): string
	return string.format("V%d S%d C%d Sl%d, ended (%.0f, %.1f, %.0f), %s", r.counts.Vault, r.counts.StepUp, r.counts.Climb,
		r.counts.Slide, r.final.X, r.final.Y, r.final.Z, t.parkour:GetLastInfo())
end

-- Start point `back` studs in front of a face, angled so the body's middle meets it at hitX.
local function clipStart(hitX: number, faceZ: number, back: number, degrees: number): Vector3
	return Vector3.new(hitX - back * math.tan(math.rad(degrees)), 4, faceZ - back)
end

local tests: { Harness.Test } = {
	{
		name = "Vault",
		run = function(t)
			local v = sprintAt(t, Vector3.new(0, 4, 18), Vector3.zAxis, 1.8, true)
			t:check("sprint into the VaultBox vaults and keeps speed", v.counts.Vault == 1 and v.final.Z > 45 and v.speedAfter > RUN * 0.8,
				describe(t, v) .. string.format(", speed after %.1f", v.speedAfter))
			local w = sprintAt(t, Vector3.new(0, 4, 30), Vector3.zAxis, 1.5, false)
			t:check("walking into it does NOT vault", total(w) == 0 and w.final.Z < 39, describe(t, w))
			local a50 = sprintAt(t, Vector3.new(-12, 4, 28), angled(50), 1.4, true)
			t:check("50 degrees off head-on vaults and keeps its line", a50.counts.Vault == 1 and a50.final.Z > 41 and math.abs(a50.headingAfter - 50) < 12,
				describe(t, a50) .. string.format(", heading after %.0f", a50.headingAfter))
			local a70 = sprintAt(t, Vector3.new(-12, 4, 35), angled(70), 1.2, true)
			t:check("70 degrees along it: nothing, or one vault over its far corner", total(a70) == 0 or (a70.counts.Vault == 1 and total(a70) == 1),
				describe(t, a70))
			t:setHealth(0.2)
			local low = sprintAt(t, Vector3.new(0, 4, 18), Vector3.zAxis, 1.8, true)
			t:check("still works at 20% HP", low.counts.Vault == 1 and low.final.Z > 45, describe(t, low))
		end,
	},
	{
		name = "Step-up and climbs",
		run = function(t)
			local st = sprintAt(t, Vector3.new(-30, 4, 14), Vector3.zAxis, 1.6, true)
			t:check("sprint into the JumpBox steps up onto it", st.counts.StepUp == 1 and st.yAfter > 6.3, describe(t, st))
			local c = sprintAt(t, Vector3.new(-30, 4, 51), Vector3.zAxis, 1.4, true)
			t:check("sprint into the 9-stud ledge (out of reach) does NOT climb", total(c) == 0 and c.final.Z < 64, describe(t, c))
			local ac = sprintAt(t, Vector3.new(-30, 4, 58), Vector3.zAxis, 1.8, false, 0.05)
			t:check("jumping at the 9-stud ledge grabs and scales it", ac.counts.Climb == 1 and ac.startMode == "Air" and ac.yAfter > 11.3,
				describe(t, ac))
			local acs = sprintAt(t, Vector3.new(-30, 4, 51), Vector3.zAxis, 1.8, true, 0.3)
			t:check("sprint + jump at it grabs and scales it", acs.counts.Climb == 1 and acs.yAfter > 11.3, describe(t, acs))
			sixStudLedge(t)
			local c6 = sprintAt(t, Vector3.new(-80, 4, -80), Vector3.zAxis, 1.6, true)
			t:check("sprint into a 6-stud ledge climbs it and comes out running", c6.counts.Climb == 1 and c6.yAfter > 8.3 and c6.speedAfter > RUN - 4,
				describe(t, c6))
			local c45 = sprintAt(t, Vector3.new(-87, 4, -78), angled(40), 1.6, true)
			t:check("40 degrees off, it climbs turning smoothly", c45.counts.Climb == 1 and c45.yAfter > 8.3 and c45.maxTurn < 25,
				describe(t, c45) .. string.format(", biggest turn %.0f deg", c45.maxTurn))
			local against = sprintAt(t, Vector3.new(-80, 4, -66.8), Vector3.zAxis, 1.2, true)
			t:check("pressed against it from a standstill climbs", against.counts.Climb == 1 and against.yAfter > 8.3, describe(t, against))
			local tall = sprintAt(t, Vector3.new(20, 4, 56), Vector3.xAxis, 1.4, true)
			t:check("sprint into the 24-high TallWall does nothing", total(tall) == 0 and tall.final.X < 33, describe(t, tall))
		end,
	},
	{
		name = "Corners",
		run = function(t)
			sixStudLedge(t)
			local vc = sprintAt(t, Vector3.new(-1, 4, 32), angled(45), 1.4, true)
			t:check("at the VaultBox's corner: vaults", vc.counts.Vault == 1, describe(t, vc))
			local sc = sprintAt(t, Vector3.new(-29, 4, 25), angled(45), 1.4, true)
			t:check("at the JumpBox's corner: steps up or vaults the corner", (sc.counts.StepUp == 1 and sc.yAfter > 6.3) or sc.counts.Vault == 1,
				describe(t, sc))
			local cc = sprintAt(t, Vector3.new(-81, 4, -73), angled(45), 1.4, true)
			t:check("at the 6-stud ledge's corner: climbs", cc.counts.Climb == 1 and cc.yAfter > 8.3, describe(t, cc))
			local jc = sprintAt(t, Vector3.new(-26, 4, 60), angled(45), 1.6, false, 0.05)
			t:check("jumping at the 9-stud ledge's corner: scales it", jc.counts.Climb == 1 and jc.yAfter > 11.3, describe(t, jc))
			local v70 = sprintAt(t, clipStart(5.4, 39, 6, 70), angled(70), 1.6, true)
			t:check("clipping the VaultBox's end at 70 degrees vaults over the corner", v70.counts.Vault == 1, describe(t, v70))
			local v78 = sprintAt(t, clipStart(5.6, 39, 5, 78), angled(78), 1.6, true)
			t:check("... at 78 degrees too", v78.counts.Vault == 1, describe(t, v78))
			local b70 = sprintAt(t, clipStart(-34, 32, 6, 70), angled(70), 1.6, true)
			t:check("brushing along the JumpBox at 70 degrees does NOT step up at its end", total(b70) == 0, describe(t, b70))
			local c70 = sprintAt(t, clipStart(-74.6, -66, 6, 70), angled(70), 1.6, true)
			t:check("clipping the 6-stud ledge's end at 70 degrees climbs it", c70.counts.Climb == 1 and c70.maxY > 8.5, describe(t, c70))
		end,
	},
	{
		name = "Slide",
		run = function(t)
			local sl = sprintAt(t, Vector3.new(0, 4, 58), Vector3.zAxis, 2.0, true)
			t:check("sprint into the SlideGap slides under and stands up, no fling",
				sl.counts.Slide == 1 and sl.final.Z > 86 and sl.standingAfter and sl.maxY < 3.6 and sl.final.Y > 2.6,
				describe(t, sl) .. string.format(", highest root %.1f", sl.maxY))
			t:check("no dash during a slide", sl.counts.Slide == 1 and not sl.dashDuring)
			t:waitDashReady()
			local still = sprintAt(t, Vector3.new(0, 4, 74.5), Vector3.zAxis, 1.5, true)
			t:check("slide from a standstill at the gap's edge", still.counts.Slide == 1 and still.final.Z > 86 and still.maxY < 3.6, describe(t, still))
			local slant = sprintAt(t, Vector3.new(-3, 4, 62), angled(20), 2.0, true)
			t:check("slide at an angle never flings", slant.counts.Slide == 1 and slant.maxY < 3.6 and slant.standingAfter, describe(t, slant))
			local walk = sprintAt(t, Vector3.new(0, 4, 66), Vector3.zAxis, 1.5, false)
			t:check("walking into the gap does NOT slide", total(walk) == 0 and walk.final.Z < 76, describe(t, walk))
		end,
	},
	{
		name = "Wall hop into a ledge grab",
		run = function(t)
			-- 15 high: too tall to grab from a jump (7.2 + reach 6.5), but a wall run carries you in reach.
			t:block("FlowTestWall", Vector3.new(8, 15, 30), CFrame.new(-127, 7.5, -105))
			t:teleport(Vector3.new(-134, 4, -118), Vector3.zAxis)
			t:aimCamera(Vector3.zAxis)
			t:frame()
			local climbs = t.parkour:GetCount("Climb")
			local hops = t.hop:GetTotalHops()
			t:press("Jump")
			local maxY = t.root.Position.Y
			t:waitFor(function()
				return false
			end, 2.2, function()
				t.humanoid:Move(Vector3.new(1, 0, 1).Unit, false)
				maxY = math.max(maxY, t.root.Position.Y)
			end)
			t:release("Jump")
			t:stop()
			t:check("hops, grabs the top and climbs on",
				t.parkour:GetCount("Climb") - climbs == 1 and t.parkour:GetLastStartMode() == "WallRun" and maxY > 17.5,
				string.format("%d hop(s), climb started from %s, highest %.1f (on top = 18)", t.hop:GetTotalHops() - hops,
					t.parkour:GetLastStartMode(), maxY))
			t:waitFor(function()
				return t.motor:GetMode() == "Ground" and not t.parkour:IsBusy()
			end, 4)
		end,
	},
}

return {
	name = "Parkour",
	description = "Vault, step-up, climbs, corners, slide, wall hop into a ledge",
	tests = tests,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXBA78ADED10074810B5DB7178AE336D69"><Properties><string name="Name">ParkourSweep</string><ProtectedString name="Source"><![CDATA[--!strict
-- Parkour sweep (slow, ~3 minutes): many approaches at four obstacles (the 9-stud ledge, a 6-stud
-- ledge, the JumpBox, the VaultBox): straight, angled, strafing along the face, strafe-then-turn,
-- jumping at it, walking diagonally, the corner point from the front and the side; each at the
-- middle, near the corner and past it. Only runs that end BAD fail: hanging in the air, inside
-- geometry, flung, or retrying in a loop. Every run's outcome is in the test's log.

local Workspace = game:GetService("Workspace")

local Harness = require(script.Parent.Parent.Harness)

type Context = Harness.Context

type Target = { name: string, faceZ: number, xMin: number, xMax: number, top: number }
local TARGETS: { Target } = {
	{ name = "9-high", faceZ = 64, xMin = -38, xMax = -22, top = 9 },
	{ name = "6-high", faceZ = -66, xMin = -86, xMax = -74, top = 6 },
	{ name = "4-box", faceZ = 32, xMin = -38, xMax = -22, top = 4 },
	{ name = "vault-box", faceZ = 39, xMin = -6, xMax = 6, top = 3 },
}

local function dir(degrees: number): Vector3
	local r = math.rad(degrees)
	return Vector3.new(math.sin(r), 0, math.cos(r))
end

type Segment = { t: number, keys: Vector3, sprint: boolean, jump: boolean? }
type Style = { name: string, back: number, segments: { Segment }, vertex: string? }
local STYLES: { Style } = {
	{ name = "sprint straight", back = 12, segments = { { t = 1.6, keys = dir(0), sprint = true } } },
	{ name = "sprint 40deg", back = 12, segments = { { t = 1.6, keys = dir(40), sprint = true } } },
	{ name = "strafe along face (W+D)", back = 1.2, segments = { { t = 1.6, keys = dir(55), sprint = true } } },
	{ name = "strafe then turn in", back = 1.2, segments = { { t = 0.6, keys = dir(88), sprint = true }, { t = 1.0, keys = dir(30), sprint = true } } },
	{ name = "jump at it", back = 6, segments = { { t = 0.12, keys = dir(0), sprint = false }, { t = 1.6, keys = dir(0), sprint = false, jump = true } } },
	{ name = "walk diagonal", back = 3, segments = { { t = 1.6, keys = dir(45), sprint = false } } },
	{ name = "corner point from the front", back = 7, vertex = "inside", segments = { { t = 1.4, keys = dir(45), sprint = true } } },
	{ name = "corner point from the side", back = 7, vertex = "outside", segments = { { t = 1.4, keys = dir(-45), sprint = true } } },
}

local function parkourCount(t: Context): number
	local n = 0
	for _, name in { "Vault", "StepUp", "Climb", "Slide" } do
		n += t.parkour:GetCount(name)
	end
	return n
end

local function sweep(t: Context, target: Target)
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = { t.character }
	overlap.RespectCanCollide = true
	local bad, runs = 0, 0
	for _, style in STYLES do
		local offsets = {
			{ label = "middle", x = (target.xMin + target.xMax) / 2 },
			{ label = "near corner", x = target.xMax - 0.6 },
			{ label = "past corner", x = target.xMax + 0.8 },
		}
		for _, offset in offsets do
			local label, x = offset.label, offset.x
			if style.vertex and label ~= "middle" then
				continue
			end
			runs += 1
			local start = Vector3.new(x, 4, target.faceZ - style.back)
			if style.vertex == "inside" then
				start = Vector3.new(target.xMax - style.back, 4, target.faceZ - style.back)
			elseif style.vertex == "outside" then
				start = Vector3.new(target.xMax + style.back, 4, target.faceZ - style.back)
			end
			t:teleport(start, Vector3.zAxis)
			local before = parkourCount(t)
			local maxY = t.root.Position.Y
			local hang = 0
			for _, segment in style.segments do
				if segment.jump then
					t:press("Jump")
				end
				local t0 = os.clock()
				while os.clock() - t0 < segment.t do
					t:move(segment.keys, segment.sprint)
					if segment.jump and t.jumpHeld and os.clock() - t0 > 0.05 then
						t:release("Jump")
					end
					maxY = math.max(maxY, t.root.Position.Y)
					if t.motor:GetMode() == "Air" and t.root.AssemblyLinearVelocity.Magnitude < 0.8 then
						hang += 1 / 60
					end
					t:frame()
				end
			end
			t:stop()
			t:wait(0.6)
			local actions = parkourCount(t) - before
			local info = t.parkour:GetLastInfo()
			local problems: { string } = {}
			if actions > 1 and (string.find(info, "blocked") or string.find(info, "snagged")) then
				table.insert(problems, string.format("%d moves, retrying (%s)", actions, info))
			elseif actions > 0 and (string.find(info, "blocked") or string.find(info, "snagged")) then
				table.insert(problems, "move got " .. info)
			end
			if t.motor:GetMode() ~= "Ground" then
				table.insert(problems, "not on the ground after (" .. t.motor:GetMode() .. ")")
			end
			if hang > 0.3 then
				table.insert(problems, string.format("hung in the air %.1fs", hang))
			end
			if #Workspace:GetPartBoundsInBox(t.root.CFrame, Vector3.new(1.2, 1.6, 0.6), overlap) > 0 then
				table.insert(problems, "root inside geometry")
			end
			if maxY > target.top + 3 + 8 then
				table.insert(problems, string.format("flung to y %.1f", maxY))
			end
			local outcome = if actions == 0 then "none" else string.format("%d move(s), %s", actions, info)
			if #problems > 0 then
				bad += 1
				t:check(string.format("%s / %s", style.name, label), false, table.concat(problems, "; ") .. " (" .. outcome .. ")")
			else
				t:log(string.format("ok %s / %s: %s", style.name, label, outcome))
			end
		end
	end
	t:check(string.format("%d runs, none stuck / hanging / flung / looping", runs), bad == 0, string.format("%d bad", bad))
end

local tests: { Harness.Test } = {}
for _, target in TARGETS do
	table.insert(tests, {
		name = target.name,
		run = function(t: Context)
			if target.name == "6-high" then
				t:block("ParkourTestLedge", Vector3.new(12, 6, 12), CFrame.new(-80, 3, -60))
			end
			sweep(t, target)
		end,
	})
end

return {
	name = "ParkourSweep",
	description = "Slow: edge-case approaches at four obstacles",
	tests = tests,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXF805BCBAA3EE4949A35409C40F3ED1C4"><Properties><string name="Name">Performance</string><ProtectedString name="Source"><![CDATA[--!strict
-- Performance suite: frame times and each movement system's cost per frame (Perf) while standing,
-- sprinting in the open, sprinting along a wall, pressed against a too-tall ledge (parkour keeps
-- checking) and whipping the camera around. Fails if movement scripts cost more than
-- SCRIPT_BUDGET_MS per frame; the numbers are in the test's log either way.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Harness = require(script.Parent.Parent.Harness)
local Perf = require(ReplicatedStorage.Movement.Perf)

type Context = Harness.Context

local SCRIPT_BUDGET_MS = 1.0

local function scenario(t: Context, name: string, duration: number, start: Vector3?, facing: Vector3?, keys: Vector3?, sprint: boolean, each: ((number) -> ())?)
	if start and facing then
		t:teleport(start, facing)
		t:wait(0.3)
	end
	local frames: { number } = {}
	local connection = RunService.RenderStepped:Connect(function(dt: number)
		table.insert(frames, dt)
		if each then
			each(dt)
		end
	end)
	Perf.reset()
	Perf.enabled = true
	t:waitFor(function()
		return false
	end, duration, function()
		if keys then
			t:move(keys, sprint)
		end
	end)
	Perf.enabled = false
	connection:Disconnect()
	t:stop()
	local totals, counts = Perf.snapshot()
	local n = math.max(#frames, 1)
	table.sort(frames)
	local sum = 0
	for _, dt in frames do
		sum += dt
	end
	local scriptTotal = 0
	local parts = {}
	for system, seconds in totals do
		scriptTotal += seconds
		table.insert(parts, string.format("%s %.3f", system, seconds * 1000 / n))
	end
	table.sort(parts)
	local perFrame = scriptTotal * 1000 / n
	t:log(string.format("%s: %.0f fps avg, 95%% under %.1f ms, worst %.1f ms; parkour rays %.0f/frame",
		name, n / math.max(sum, 1e-6), (frames[math.max(1, math.floor(n * 0.95))] or 0) * 1000, (frames[n] or 0) * 1000,
		(counts["AutoParkour rays"] or 0) / n))
	t:log("  " .. table.concat(parts, ", "))
	t:check(name .. ": movement scripts under budget", perFrame <= SCRIPT_BUDGET_MS,
		string.format("%.3f ms/frame (budget %.1f)", perFrame, SCRIPT_BUDGET_MS))
end

local tests: { Harness.Test } = {
	{
		name = "Movement script cost per frame",
		run = function(t)
			scenario(t, "standing still", 2, Vector3.new(0, 4, -40), -Vector3.zAxis, nil, false)
			scenario(t, "sprinting in the open", 2, Vector3.new(0, 4, -20), -Vector3.zAxis, -Vector3.zAxis, true)
			local along = Vector3.new(math.sin(math.rad(20)), 0, math.cos(math.rad(20)))
			scenario(t, "sprinting along a wall", 1.6, Vector3.new(31.5, 4, 34), Vector3.zAxis, along, true)
			scenario(t, "pressed against a too-tall ledge", 2, Vector3.new(-30, 4, 60), Vector3.zAxis, Vector3.zAxis, true)
			t:teleport(Vector3.new(-100, 4, -100), Vector3.zAxis)
			t.camera.CameraType = Enum.CameraType.Scriptable
			local elapsed, lastFlick = 0, 0
			scenario(t, "whipping the camera around", 2, nil, nil, Vector3.zAxis, true, function(dt: number)
				elapsed += dt
				local turn = math.rad(180) * dt
				if elapsed - lastFlick >= 0.25 then
					lastFlick = elapsed
					turn += math.rad(120)
				end
				local c = t.camera.CFrame
				t.camera.CFrame = CFrame.new(c.Position) * CFrame.Angles(0, turn, 0) * c.Rotation
			end)
		end,
	},
}

return {
	name = "Performance",
	description = "Frame times and movement script cost per frame",
	tests = tests,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5040FE4B4ADA42779134B6CAF04DD213"><Properties><string name="Name">Truss</string><ProtectedString name="Source"><![CDATA[--!strict
-- Truss suite, on the course's FallTowerTruss (x -61..-59, z -1..1, 80 tall): the same climbing
-- speed however you get on, real jumps off it, no snapping back on, grabbing only on purpose, and
-- jump spam never beating climbing.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Harness = require(script.Parent.Parent.Harness)
local Config = require(ReplicatedStorage.Movement.MovementConfig)

type Context = Harness.Context

local CLIMBING = Enum.HumanoidStateType.Climbing

-- Average upward speed over `measure` seconds of climbing, after `settle` seconds on the truss.
local function climbSpeed(t: Context, settle: number, measure: number, timeout: number): number
	local sum, count = 0, 0
	local onSince: number? = nil
	t:waitFor(function()
		return onSince ~= nil and os.clock() - onSince >= settle + measure
	end, timeout, function()
		t.humanoid:Move(Vector3.zAxis, false)
		if t.humanoid:GetState() == CLIMBING then
			onSince = onSince or os.clock()
			if os.clock() - (onSince :: number) >= settle then
				sum += t.root.AssemblyLinearVelocity.Y
				count += 1
			end
		end
	end)
	return if count > 0 then sum / count else 0
end

local function tapJump(t: Context)
	t:press("Jump")
	task.delay(0.1, function()
		if t.jumpHeld then
			t:release("Jump")
		end
	end)
end

-- Whether the Humanoid grabs a truss (Climbing) within `duration` while `each` runs every frame.
local function grabsDuring(t: Context, duration: number, each: () -> ()): boolean
	return t:waitFor(function()
		return t.humanoid:GetState() == CLIMBING
	end, duration, each)
end

local tests: { Harness.Test } = {
	{
		name = "Same climbing speed however you get on",
		run = function(t)
			local want = Config.TrussClimbSpeed * t.motor:GetHealthSpeedScale()
			local tolerance = want * 0.2
			t:teleport(Vector3.new(-60, 4, -4), Vector3.zAxis)
			t:near("walking in", climbSpeed(t, 0.3, 0.5, 3), want, tolerance)
			t:teleport(Vector3.new(-60, 4, -16), Vector3.zAxis)
			t.motor:SetSprinting(true)
			t:near("sprinting in", climbSpeed(t, 0.3, 0.5, 3), want, tolerance)
			t.motor:SetSprinting(false)
			t:teleport(Vector3.new(-60, 4, -5), Vector3.zAxis)
			t.humanoid:Move(Vector3.zAxis, false)
			tapJump(t)
			t:near("grabbed mid-jump", climbSpeed(t, 0.3, 0.5, 3), want, tolerance)
			t:wait(0.6)
			local before = t.root.Position.Y
			t:stop()
			tapJump(t)
			local rose = 0
			t:waitFor(function()
				return false
			end, 0.35, function()
				rose = math.max(rose, t.root.Position.Y - before)
			end)
			t:check("jumping off high up is a real jump", rose > 2, string.format("rose %.1f", rose))
			t:near("getting back on after jumping off still climbs", climbSpeed(t, 0.3, 0.5, 3), want, tolerance)
		end,
	},
	{
		name = "No snapping back on; grabbing only on purpose",
		run = function(t)
			t:teleport(Vector3.new(-60, 4, -4), Vector3.zAxis)
			climbSpeed(t, 0.6, 0.1, 3)
			tapJump(t)
			local jumpedAt = os.clock()
			local snapped: number? = nil
			t:waitFor(function()
				return snapped ~= nil
			end, 1.2, function()
				t.humanoid:Move(Vector3.zAxis, false)
				if t.humanoid:GetState() == CLIMBING and os.clock() - jumpedAt > 0.05 then
					snapped = os.clock() - jumpedAt
				end
			end)
			t:check("after jumping off you can't snap straight back on", snapped == nil or (snapped :: number) >= Config.TrussRegrabDelay - 0.05,
				if snapped then string.format("grabbed again after %.2fs", snapped) else "not grabbed again")
			t:stop()
			t:grounded(4)

			t:teleport(Vector3.new(-60, 4, -2.3), Vector3.xAxis)
			t.root.CFrame += Vector3.new(0, 30, 0)
			t:check("falling past it with no keys doesn't grab", not grabsDuring(t, 1.2, function()
				t.humanoid:Move(Vector3.zero, false)
			end))
			t:grounded(3)
			t:teleport(Vector3.new(-68, 4, -2.2), Vector3.xAxis)
			t.motor:SetSprinting(true)
			t:check("running along it doesn't grab", not grabsDuring(t, 1.0, function()
				t.humanoid:Move(Vector3.xAxis, false)
			end))
			t:stop()
			t:waitDashReady()
			t:teleport(Vector3.new(-72, 4, -2.2), Vector3.xAxis)
			t:aimCamera(Vector3.xAxis)
			t.humanoid:Move(Vector3.xAxis, false)
			t:frame()
			t:press("Dash")
			t:check("dashing past it doesn't grab", not grabsDuring(t, 0.7, function() end))
			t:stop()
			t:teleport(Vector3.new(-60, 4, -4), Vector3.zAxis)
			climbSpeed(t, 0.6, 0.1, 3)
			tapJump(t)
			t:waitFor(function()
				return t.humanoid:GetState() ~= CLIMBING
			end, 0.5)
			t:check("jumping off and steering away never re-grabs", not grabsDuring(t, 1.5, function()
				t.humanoid:Move(-Vector3.zAxis, false)
			end))
		end,
	},
	{
		name = "Jump spam climbs no faster than climbing",
		run = function(t)
			local want = Config.TrussClimbSpeed * t.motor:GetHealthSpeedScale()
			t:teleport(Vector3.new(-60, 4, -4), Vector3.zAxis)
			climbSpeed(t, 0.5, 0.1, 3)
			local startY = t.root.Position.Y
			local lastPress = 0
			t:waitFor(function()
				return false
			end, 2.5, function()
				t.humanoid:Move(Vector3.zAxis, false)
				if os.clock() - lastPress > 0.15 then
					tapJump(t)
					lastPress = os.clock()
				end
			end)
			local gain = t.root.Position.Y - startY
			t:check("spamming jump", gain < want * 2.5 * 0.5, string.format("gained %.1f in 2.5 s (climbing gains %.1f)", gain, want * 2.5))
		end,
	},
}

return {
	name = "Truss",
	description = "Climb speed, jumping off, deliberate grabs",
	tests = tests,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8F2B7CAC357D488DAD840C6EC4722F2D"><Properties><string name="Name">WallHop</string><ProtectedString name="Source"><![CDATA[--!strict
-- Wall hop suite: when a hop happens (held / pressed Space, W+A / W+D into and along the wall) and
-- when it must not (a tap, W alone, parallel, straight in, away, the wall's very end), hops by
-- health, chaining up one wall, and zig-zagging an alley. Uses the tall wall (x 33..35, z 32..80,
-- 24 high) and Workspace > WallHopAlley (walls at x 100 and 114; made here if it's missing).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Harness = require(script.Parent.Parent.Harness)
local Config = require(ReplicatedStorage.Movement.MovementConfig)

type Context = Harness.Context

local INTO = Vector3.new(1, 0, 1).Unit -- wall at +X, running along +Z
local ALLEY_LEFT_X, ALLEY_RIGHT_X = 100, 114

-- style: "hold" = Space held from the jump; "tap" = a quick jump only; "airpress" = a quick jump,
-- then Space pressed again in the air at 0.3 s. Returns (hops, rise, movement along Z).
local function attempt(t: Context, style: string, keys: Vector3, duration: number, start: Vector3?, look: Vector3?): (number, number, number)
	t:teleport(start or Vector3.new(30, 4, 40), Vector3.zAxis)
	t:aimCamera(look or Vector3.zAxis)
	t:frame()
	local before = t.hop:GetTotalHops()
	local startY, startZ = t.root.Position.Y, t.root.Position.Z
	local maxY = startY
	t:press("Jump")
	local released, pressedAgain = false, false
	local t0 = os.clock()
	while os.clock() - t0 < duration do
		local since = os.clock() - t0
		if style ~= "hold" and not released and since > 0.08 then
			t:release("Jump")
			released = true
		end
		if style == "airpress" and not pressedAgain and since > 0.3 then
			t:press("Jump")
			pressedAgain = true
		end
		if pressedAgain and since > 0.38 and t.jumpHeld then
			t:release("Jump")
		end
		t.humanoid:Move(keys, false)
		maxY = math.max(maxY, t.root.Position.Y)
		t:frame()
	end
	t:stop()
	t:grounded(4)
	return t.hop:GetTotalHops() - before, maxY - startY, t.root.Position.Z - startZ
end

local function ensureAlley(t: Context)
	if Workspace:FindFirstChild("WallHopAlley") then
		return
	end
	for _, x in { ALLEY_LEFT_X, ALLEY_RIGHT_X } do
		t:block("AlleyWall", Vector3.new(2, 30, 64), CFrame.new(x, 15, 60))
	end
end

local function alternates(sides: string): boolean
	for i = 2, #sides do
		if string.sub(sides, i, i) == string.sub(sides, i - 1, i - 1) then
			return false
		end
	end
	return #sides > 0
end

-- Zig-zag across the alley with Space held. switchAt: seconds after a hop starts to turn the keys
-- toward the other wall (negative = that long AFTER the kick). Returns (hops, walls in order, rise).
local function zigzag(t: Context, switchAt: number): (number, string, number)
	local toRight, toLeft = Vector3.new(1, 0, 1).Unit, Vector3.new(-1, 0, 1).Unit
	t:teleport(Vector3.new(109, 4, 32), Vector3.zAxis)
	t:aimCamera(Vector3.zAxis)
	t:frame()
	local before = t.hop:GetTotalHops()
	local startY = t.root.Position.Y
	local maxY = startY
	local sides, keys, seen = "", toRight, 0
	local hopAt, kickAt, wasRunning = 0, 0, false
	t:press("Jump")
	local t0 = os.clock()
	while os.clock() - t0 < 4 do
		local now = os.clock()
		local total = t.hop:GetTotalHops() - before
		local onWall = t.hop:IsRunning()
		if total > seen then
			seen = total
			hopAt = now
			sides ..= if t.root.Position.X > (ALLEY_LEFT_X + ALLEY_RIGHT_X) / 2 then "R" else "L"
		end
		if wasRunning and not onWall then
			kickAt = now
		end
		wasRunning = onWall
		local side = string.sub(sides, -1)
		local away = if side == "R" then toLeft elseif side == "L" then toRight else keys
		if keys ~= away then
			local ready = if switchAt >= 0
				then now - hopAt >= switchAt
				else (not onWall and kickAt > hopAt and now - kickAt >= -switchAt)
			if ready then
				keys = away
			end
		end
		t.humanoid:Move(keys, false)
		maxY = math.max(maxY, t.root.Position.Y)
		if t.motor:GetMode() == "Ground" and now - t0 > 0.5 then
			break
		end
		t:frame()
	end
	t:stop()
	t:grounded(5)
	return t.hop:GetTotalHops() - before, sides, maxY - startY
end

local tests: { Harness.Test } = {
	{
		name = "When a hop happens",
		run = function(t)
			local hops, rise, along = attempt(t, "hold", INTO, 1.6)
			t:check("jump + HOLD Space into and along the wall hops", hops >= 1 and rise > Config.JumpHeight + 2,
				string.format("%d hop(s), rose %.1f, moved %.1f along", hops, rise, along))
			local pressed, pressRise = attempt(t, "airpress", INTO, 1.6)
			t:check("jump, then PRESS Space in the air hops once", pressed == 1 and pressRise > Config.JumpHeight + 2,
				string.format("%d hop(s), rose %.1f", pressed, pressRise))
			local backHops, _, backAlong = attempt(t, "hold", Vector3.new(1, 0, -1).Unit, 1.2, nil, -Vector3.zAxis)
			t:check("the hop goes the way the keys point", backHops >= 1 and backAlong < -3,
				string.format("%d hop(s), moved %.1f along Z (want negative)", backHops, backAlong))
		end,
	},
	{
		name = "When a hop must not happen",
		run = function(t)
			local tapped = attempt(t, "tap", INTO, 1.2)
			t:check("a tap jump into the wall", tapped == 0, string.format("%d hop(s): %s", tapped, t.hop:GetLastFailure()))
			local wOnly = attempt(t, "hold", INTO, 1.2, nil, INTO)
			t:check("W alone at an angle to the wall", wOnly == 0, string.format("%d hop(s): %s", wOnly, t.hop:GetLastFailure()))
			t:check("running parallel", attempt(t, "hold", Vector3.zAxis, 1.2) == 0)
			t:check("running straight in", attempt(t, "hold", Vector3.xAxis, 1.2) == 0)
			t:check("moving away", attempt(t, "hold", -Vector3.xAxis, 1.2) == 0)
			local atEnd = attempt(t, "hold", INTO, 0.5, Vector3.new(30, 4, 78.5))
			t:check("at the very end of the wall", atEnd == 0, string.format("%d hop(s): %s", atEnd, t.hop:GetLastFailure()))
		end,
	},
	{
		name = "Hops by health, chaining up one wall",
		run = function(t)
			local counts = {}
			for _, share in { 1, 0.5, 0.2 } do
				t:setHealth(share)
				table.insert(counts, t.hop:GetMaxHops())
			end
			t:setHealth(1)
			t:check("hops at 100% / 50% / 20% HP",
				counts[1] == Config.WallHopsHigh and counts[2] == Config.WallHopsMid and counts[3] == Config.WallHopsLow,
				string.format("%d / %d / %d", counts[1], counts[2], counts[3]))
			local chained, chainRise = attempt(t, "hold", INTO, 3)
			t:check("chain hops up one wall", chained >= 2 and chained <= Config.WallHopsHigh,
				string.format("%d hops (max %d), highest +%.1f", chained, Config.WallHopsHigh, chainRise))
		end,
	},
	{
		name = "Zig-zag across an alley",
		run = function(t)
			ensureAlley(t)
			-- Three hops carry you ~65 studs along and ~34 up: taller, longer walls for this test.
			for _, x in { ALLEY_LEFT_X, ALLEY_RIGHT_X } do
				t:block("AlleyTestExtension", Vector3.new(2, 60, 112), CFrame.new(x, 30, 84))
			end
			local cases = {
				{ label = "switch keys mid-run (leap)", switchAt = 0.08 },
				{ label = "switch keys 0.1 s after the kick", switchAt = -0.1 },
				{ label = "switch keys right at the kick", switchAt = Config.WallRunTime + 0.02 },
			}
			for _, case in cases do
				local hops, sides, rise = zigzag(t, case.switchAt)
				t:check(case.label, hops == Config.WallHopsHigh and alternates(sides),
					string.format("%d hops, walls %s, highest +%.1f", hops, sides, rise))
			end
		end,
	},
}

return {
	name = "WallHop",
	description = "When hops happen and don't, health, chaining, zig-zag",
	tests = tests,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6C1F01043A574CCD96473B0C39F89CD3"><Properties><string name="Name">Combat</string><ProtectedString name="Source"><![CDATA[--!strict
-- Combat suite: real fights against the training dummies, checked against the server's own state
-- (docs/DesignPlan.md "Combat core", docs/MoveData.md). Hits and damage, the 3-hit chain knocking
-- down and the get-up, the M1 gap (a buffered block stops M1 2), parries, blocking from behind,
-- counter-hits, burnout chip damage, the dagger -> 1 link and 1's cooldown, damage scaling,
-- server-owned stamina (overdraw, burnout, refill), and getting hit yourself: locked controls,
-- knockdown, tech roll.
--
-- The dummies stand at x = 80 facing -X (CombatServer / Dummies); t:dummy() resets one.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Harness = require(script.Parent.Parent.Harness)
local Config = require(ReplicatedStorage.Combat.CombatConfig)
local Moves = require(ReplicatedStorage.Combat.Moves)
local MovementConfig = require(ReplicatedStorage.Movement.MovementConfig)

type Context = Harness.Context

local RANGE = 3.2 -- studs in front of a dummy to stand for M1s

local function health(model: Model): number
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	return if humanoid then humanoid.Health else 0
end

local function waitIdle(t: Context)
	t:waitFor(function()
		return t.combat:GetPhase() == "Idle"
	end, 2)
end

-- Presses `action` and waits until the server has answered the move (or `timeout`).
local function swing(t: Context, action: any, timeout: number?): string
	t.combat.lastResult = ""
	t:press(action)
	t:waitFor(function()
		return t.combat:GetLastResult() ~= ""
	end, timeout or 0.5)
	return t.combat:GetLastResult()
end

local function moveDamage(id: string): number
	local move = Moves.Get(id)
	return if move then move.Damage else 0
end

local tests: { Harness.Test } = {
	{
		name = "An M1 hits a standing dummy",
		run = function(t)
			local dummy = t:dummy("DummyStand")
			t:faceDummy(dummy, RANGE)
			local before = health(dummy)
			local result = swing(t, "M1")
			t:check("the server says it hit", result == "Hit", result)
			t:wait(0.1)
			t:near("M1 1 damage", before - health(dummy), moveDamage("Sword.M1_1"), 0.01)
			local state = t:server(dummy).state
			t:check("the dummy is in hit stun", state == "Stunned", tostring(state))
			waitIdle(t)
			t:wait(0.5)
			t:check("the stun ends", t:server(dummy).state == "Idle", tostring(t:server(dummy).state))
		end,
	},
	{
		name = "The 3-hit chain knocks down, then the dummy gets up",
		run = function(t)
			local dummy = t:dummy("DummyStand")
			t:faceDummy(dummy, RANGE)
			local record = t:recordAttributeOn(dummy, "CombatState")
			local before = health(dummy)
			t:press("M1")
			t:wait(0.1)
			t:press("M1")
			t:wait(0.25)
			t:press("M1")
			t:waitFor(function()
				return dummy:GetAttribute("CombatState") == "Downed"
			end, 2)
			local total = moveDamage("Sword.M1_1") + moveDamage("Sword.M1_2") + moveDamage("Sword.M1_3")
			t:near("three hits of damage", before - health(dummy), total, 0.01)
			t:waitFor(function()
				return dummy:GetAttribute("CombatState") == "Idle"
			end, 2)
			local states = table.concat(record(), " > ")
			t:check("stun, stun, knocked down, on the floor, up", string.find(states, "Knockdown > Downed > Idle") ~= nil, states)
		end,
	},
	{
		name = "The M1 gap: a block held through the stun stops M1 2",
		run = function(t)
			local dummy = t:dummy("DummyBlockAfterHit", "BlockAfterHit")
			t:faceDummy(dummy, RANGE)
			local first = swing(t, "M1")
			t:check("M1 1 hits", first == "Hit", first)
			waitIdle(t)
			local staminaBefore = t:server(dummy).stamina
			local second = swing(t, "M1")
			t:check("M1 2 is blocked (the block started in the gap)", second == "Block", second)
			t:wait(0.1)
			local drained = staminaBefore - t:server(dummy).stamina
			t:near("blocking cost damage x BlockStaminaPerDamage", drained,
				moveDamage("Sword.M1_2") * Config.BlockStaminaPerDamage, 1)
			waitIdle(t)
		end,
	},
	{
		name = "Blocking only covers the front",
		run = function(t)
			local dummy = t:dummy("DummyBlock", "Block")
			t:faceDummy(dummy, RANGE)
			t:wait(0.1)
			t:check("from the front: blocked", swing(t, "M1") == "Block", t.combat:GetLastResult())
			waitIdle(t)
			t:wait(0.7)
			t.combat:ResetForTest()
			t:faceDummy(dummy, -RANGE) -- behind it
			t:check("from behind: it hits", swing(t, "M1") == "Hit", t.combat:GetLastResult())
			waitIdle(t)
		end,
	},
	{
		name = "Parry: the attacker is stuck, the defender gains stamina",
		run = function(t)
			local dummy = t:dummy("DummyParry", "Parry")
			t:faceDummy(dummy, RANGE)
			t:debug("DummyStamina", "DummyParry", 50)
			local result = swing(t, "M1")
			t:check("the swing is parried", result == "Parried", result)
			t:wait(0.05)
			local mine = t:server()
			t:check("you're stuck in the parried state", mine.state == "Parried" and t.combat:IsLocked(),
				string.format("server %s, locked %s", tostring(mine.state), tostring(t.combat:IsLocked())))
			t:near("the dummy gained ParryStaminaGain", t:server(dummy).stamina, 50 + Config.ParryStaminaGain, 1.5)
			t:wait(Config.ParryStun / 60 + 0.2)
			t:check("then you're free again", not t.combat:IsLocked())
		end,
	},
	{
		name = "Counter-hit: hitting a move's startup stuns longer and hurts more",
		run = function(t)
			local dummy = t:dummy("DummyStand")
			t:faceDummy(dummy, RANGE)
			local before = health(dummy)
			t:debug("DummyMove", "DummyStand", "Sword.One") -- 12 frames of startup
			local result = swing(t, "M1")
			t:check("the server calls it a counter-hit", result == "Counter", result)
			t:wait(0.1)
			t:near("counter-hit damage", before - health(dummy), moveDamage("Sword.M1_1") * Config.CounterHitDamage, 0.11)
			waitIdle(t)
		end,
	},
	{
		name = "Burnout: blocking overdraws, then blocked hits chip",
		run = function(t)
			local dummy = t:dummy("DummyBlock", "Block")
			t:faceDummy(dummy, RANGE)
			t:debug("DummyStamina", "DummyBlock", 3)
			swing(t, "M1")
			t:wait(0.1)
			t:check("the block overdrew: burnout", dummy:GetAttribute("Burnout") == true, tostring(dummy:GetAttribute("Burnout")))
			waitIdle(t)
			local before = health(dummy)
			local result = swing(t, "M1")
			t:wait(0.1)
			t:check("still blocked", result == "Block", result)
			t:near("chip damage in burnout", before - health(dummy), moveDamage("Sword.M1_2") * Config.BurnoutChip, 0.06)
			waitIdle(t)
		end,
	},
	{
		name = "Dagger -> 1 links, and 1 has a cooldown",
		run = function(t)
			local dummy = t:dummy("DummyStand")
			t:faceDummy(dummy, 2.6)
			local stab = swing(t, "M2")
			t:check("the stab hits", stab == "Hit", stab)
			local one = swing(t, "One", 0.8)
			t:check("1 cancels out of it and hits", one == "Hit", one)
			t:wait(0.1)
			local combo = t:server(dummy).comboHits
			t:check("both hits are one combo", combo == 2, tostring(combo))
			waitIdle(t)
			t:wait(0.6)
			t:press("One")
			t:check("1 again at once: on cooldown", t.combat:GetMoveId() == nil, tostring(t.combat:GetMoveId()))
		end,
	},
	{
		name = "Damage scaling",
		run = function(t)
			local scaling = t:debug("Scaling")
			t:check("the server answered", typeof(scaling) == "table")
			if typeof(scaling) ~= "table" then
				return
			end
			local plain, linked = scaling.plain, scaling.linked
			t:near("hits 1-3 are full damage", plain[3], 1, 1e-6)
			t:near("hit 4 is x ScalingPerHit", plain[4], Config.ScalingPerHit, 1e-6)
			t:near("hit 5 is x ScalingPerHit^2", plain[5], Config.ScalingPerHit ^ 2, 1e-6)
			t:near("never below ScalingMin", plain[10], math.max(Config.ScalingPerHit ^ 7, Config.ScalingMin), 1e-6)
			t:near("after a linker x AfterLinker", linked[2], Config.AfterLinker, 1e-6)
		end,
	},
	{
		name = "Stamina is the server's: overdraw, burnout, refill",
		run = function(t)
			if not t.lantern:IsMoth() then
				t:log("not a Moth: skipped")
				t:check("skipped", true)
				return
			end
			t:teleport(Vector3.new(-40, 4, -150), Vector3.zAxis)
			t.stamina:Set(10)
			t:wait(0.3)
			t:tap("Race") -- a wing burst costs more than 10: it still comes out (overdraw)
			t:wait(0.3)
			t:waitFor(function()
				return t.character:GetAttribute("Burnout") == true
			end, 1)
			t:check("and burns you out", t.character:GetAttribute("Burnout") == true)
			t:check("no stamina moves in burnout", not t.stamina:CanSpend())
			local refill = MovementConfig.StaminaMax / (Config.StaminaRegenGround * Config.BurnoutRegenScale)
			local started = os.clock()
			t:waitFor(function()
				return t.character:GetAttribute("Burnout") ~= true
			end, Config.StaminaRegenDelay + refill + 3)
			local took = os.clock() - started
			t:check("burnout ends only at a full meter", t.character:GetAttribute("Burnout") ~= true and t.stamina:GetValue() >= MovementConfig.StaminaMax - 1,
				string.format("%.1f s, stamina %d", took, t.stamina:GetValue()))
			t:near("refill time (burnout rate)", took, Config.StaminaRegenDelay + refill, 1.5)
		end,
	},
	{
		name = "Getting hit: locked controls, knockdown, tech roll",
		run = function(t)
			local dummy = t:dummy("DummyAttack", "Stand")
			t:faceDummy(dummy, RANGE)
			local record = t:recordAttribute("CombatState")
			t:debug("DummyMove", "DummyAttack", "Sword.M1_1")
			t:waitFor(function()
				return t.character:GetAttribute("Stunned") == true
			end, 1)
			t:check("you're stunned", t.combat:IsLocked())
			t:check("no dash while stunned", not t.dash:Request())
			t:press("M1")
			t:check("no attack while stunned", t.combat:GetMoveId() == nil)
			t:waitFor(function()
				return not t.combat:IsLocked()
			end, 1)
			-- The chain's third hit knocks you down.
			t:debug("DummyMove", "DummyAttack", "Sword.M1_2")
			t:wait(0.35)
			t:debug("DummyMove", "DummyAttack", "Sword.M1_3")
			t:waitFor(function()
				return t.character:GetAttribute("CombatState") == "Downed"
			end, 3)
			t:check("knocked down, then on the floor", t.character:GetAttribute("CombatState") == "Downed",
				table.concat(record(), " > "))
			t:check("invincible at first on the floor", t.character:GetAttribute("Invulnerable") == true)
			t:press("Dash")
			t:waitFor(function()
				return t.character:GetAttribute("CombatState") == "TechRoll"
			end, 0.5)
			t:check("Shift on the floor = tech roll", t.character:GetAttribute("CombatState") == "TechRoll",
				tostring(t.character:GetAttribute("CombatState")))
			t:waitFor(function()
				return not t.combat:IsLocked()
			end, 1)
			t:check("then you're up", not t.combat:IsLocked())
			t:debug("ResetDummy", "DummyAttack")
		end,
	},
}

return {
	name = "Combat",
	description = "Hits, chain, block, parry, counter-hit, burnout, links, scaling, stamina, knockdown",
	tests = tests,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXA2930F25B53F493CB071CD6DF05EEC1A"><Properties><string name="Name">Lotus</string><ProtectedString name="Source"><![CDATA[--!strict
-- Lotus suite: the Lotus Fungus against the training dummies, checked against the server
-- (docs/MoveData.md, "Lotus Fungus"). The meter and its stages (damage feeds it, the growth shows the
-- stage), every 2 / 3 / 4 variant, stage 3 costs and the whiff penalty, spores blocked from any
-- side, Infested and the wrap, the beam, the grabs (blocked / unblockable / uninterruptible), the
-- heal channel and the rip-out, the impale, the form, taking more damage at stage 3, follow-ups.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Harness = require(script.Parent.Parent.Harness)
local Config = require(ReplicatedStorage.Combat.CombatConfig)
local Moves = require(ReplicatedStorage.Combat.Moves)

type Context = Harness.Context

local function health(model: Model): number
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	return if humanoid then humanoid.Health else 0
end

local function meter(t: Context): number
	local value = t:server().lotus
	return if typeof(value) == "number" then value else -1
end

local function setMeter(t: Context, value: number)
	t:debug("SetLotus", value)
	t:wait(0.05)
end

local function fresh(t: Context)
	t:debug("ClearCooldowns")
	t.combat:ResetForTest()
end

local function waitIdle(t: Context, timeout: number?)
	t:waitFor(function()
		return t.combat:GetPhase() == "Idle"
	end, timeout or 3)
end

local function waitState(model: Model, state: string, timeout: number, t: Context): boolean
	return t:waitAttribute(model, "CombatState", state, timeout)
end

local function damageOf(id: string): number
	local move = Moves.Get(id)
	return if move then move.Damage else 0
end

-- Presses `action`, returns the server's answer (or "").
local function press(t: Context, action: any, timeout: number?): string
	t.combat.lastResult = ""
	t:press(action)
	t:waitFor(function()
		return t.combat:GetLastResult() ~= ""
	end, timeout or 0.8)
	return t.combat:GetLastResult()
end

local tests: { Harness.Test } = {
	{
		name = "The meter: stages, the growth, and damage feeding it",
		run = function(t)
			setMeter(t, 0)
			t:check("stage 1 at 0", t.character:GetAttribute("LotusStage") == 1)
			local fungus = t.character:FindFirstChild("Fungus")
			local function shown(): number
				local count = 0
				if fungus then
					for _, p in fungus:GetChildren() do
						if p:IsA("BasePart") and p.Transparency < 1 then
							count += 1
						end
					end
				end
				return count
			end
			local s1 = shown()
			setMeter(t, Config.Stage2At + 5)
			t:check("stage 2 from Stage2At", t.character:GetAttribute("LotusStage") == 2)
			local s2 = shown()
			setMeter(t, Config.Stage3At + 5)
			t:check("stage 3 from Stage3At", t.character:GetAttribute("LotusStage") == 3)
			local s3 = shown()
			t:check("the growth spreads with the stage", s1 > 0 and s2 > s1 and s3 > s2, string.format("%d / %d / %d pieces", s1, s2, s3))

			setMeter(t, 0)
			local dummy = t:dummy("DummyAttack", "Stand")
			t:faceDummy(dummy, 3.2)
			local hp0 = t.humanoid.Health
			t:debug("DummyMove", "DummyAttack", "Sword.M1_1")
			t:waitFor(function()
				return t.humanoid.Health < hp0
			end, 1)
			t:wait(0.1)
			local lost = hp0 - t.humanoid.Health
			t:near("taking damage feeds the meter (LotusPerDamage per HP)", meter(t), lost * Config.LotusPerDamage, 0.3)
			t:wait(0.6)
		end,
	},
	{
		name = "At stage 3 you take more damage",
		run = function(t)
			setMeter(t, Config.Stage3At + 10)
			local dummy = t:dummy("DummyAttack", "Stand")
			t:faceDummy(dummy, 3.2)
			local hp0 = t.humanoid.Health
			t:debug("DummyMove", "DummyAttack", "Sword.M1_1")
			t:waitFor(function()
				return t.humanoid.Health < hp0
			end, 1)
			t:near("x Stage3DamageTaken", hp0 - t.humanoid.Health, damageOf("Sword.M1_1") * Config.Stage3DamageTaken, 0.05)
			t:wait(0.6)
		end,
	},
	{
		name = "2 at stage 1: the strand stab hits and feeds the meter",
		run = function(t)
			setMeter(t, 0)
			local dummy = t:dummy("DummyStand")
			t:faceDummy(dummy, 5)
			local before = health(dummy)
			local result = press(t, "Two")
			t:check("it hits from 5 studs", result == "Hit", result)
			t:wait(0.1)
			t:near("its damage", before - health(dummy), damageOf("Lotus.Stab1"), 0.01)
			t:near("+10 meter on hit", meter(t), 10, 0.5)
			waitIdle(t)
		end,
	},
	{
		name = "2 at stage 2: the ground strand launches, through a block",
		run = function(t)
			setMeter(t, Config.Stage2At + 5)
			local dummy = t:dummy("DummyBlock", "Block")
			t:faceDummy(dummy, 10)
			t:press("Two")
			t:check("the move is the ground strand", t.combat:GetMoveId() == "Lotus.Strand2", tostring(t.combat:GetMoveId()))
			t:check("it launches them even blocking (unblockable)", waitState(dummy, "Launched", 1.5, t),
				tostring(dummy:GetAttribute("CombatState")))
			waitIdle(t)
		end,
	},
	{
		name = "2 at stage 3: costs meter, and a miss consumes you",
		run = function(t)
			setMeter(t, Config.Stage3At + 10)
			t:teleport(Vector3.new(-40, 4, -150), Vector3.zAxis)
			local hp0 = t.humanoid.Health
			local record = t:recordAttribute("CombatState")
			t:press("Two")
			t:check("the heavy stab", t.combat:GetMoveId() == "Lotus.Stab3", tostring(t.combat:GetMoveId()))
			t:wait(0.1)
			local move = Moves.Get("Lotus.Stab3")
			t:near("it cost its meter", meter(t), Config.Stage3At + 10 - (if move then move.MeterCost else 0), 0.5)
			t:waitFor(function()
				return t.humanoid.Health < hp0
			end, 2)
			t:near("the miss costs WhiffHealth", hp0 - t.humanoid.Health, Config.WhiffHealth, 0.01)
			t:wait(0.2)
			local states = table.concat(record(), " > ")
			t:check("and staggers you", string.find(states, "Stunned") ~= nil, states)
			t:near("which doesn't feed the meter", meter(t), Config.Stage3At + 10 - (if move then move.MeterCost else 0), 0.5)
			t:wait(0.5)
		end,
	},
	{
		name = "3: spores are blocked from any side; the fan Infests; a Lotus hit on the block wraps",
		run = function(t)
			setMeter(t, 0)
			local blocker = t:dummy("DummyBlock", "Block")
			t:faceDummy(blocker, -14) -- behind it
			local result = press(t, "Three", 1.2)
			t:check("a spore from behind is still blocked", result == "Block", result)
			waitIdle(t)

			fresh(t)
			setMeter(t, Config.Stage2At + 5)
			local target = t:dummy("DummyStand")
			t:faceDummy(target, 12)
			t:press("Three")
			t:check("the fan", t.combat:GetMoveId() == "Lotus.Spore2", tostring(t.combat:GetMoveId()))
			t:check("it Infests", t:waitAttribute(target, "Infested", true, 1.5))
			waitIdle(t)

			fresh(t)
			setMeter(t, 0)
			t:debug("DummyMode", "DummyStand", "Block")
			t:faceDummy(target, 5)
			t:wait(0.2)
			t:press("Two")
			t:check("a Lotus stab on their block wraps them (down)", waitState(target, "Downed", 1.2, t),
				tostring(target:GetAttribute("CombatState")))
			t:check("and uses Infested up", target:GetAttribute("Infested") ~= true)
			waitIdle(t)
		end,
	},
	{
		name = "3 at stage 3: the beam, through a block, knocks down",
		run = function(t)
			setMeter(t, Config.Stage3At + 15)
			local dummy = t:dummy("DummyBlock", "Block")
			t:faceDummy(dummy, 25)
			t:press("Three")
			t:check("the beam", t.combat:GetMoveId() == "Lotus.Beam3", tostring(t.combat:GetMoveId()))
			t:check("it knocks them down even blocking", waitState(dummy, "Knockdown", 1.5, t) or waitState(dummy, "Downed", 0.5, t),
				tostring(dummy:GetAttribute("CombatState")))
			waitIdle(t)
		end,
	},
	{
		name = "4: grabs (blocked = nothing; stage 2 unblockable, meter to 80; stage 3 can't be interrupted)",
		run = function(t)
			setMeter(t, 0)
			local blocker = t:dummy("DummyBlock", "Block")
			t:faceDummy(blocker, 3)
			local result = press(t, "Four")
			t:check("a blocked stage 1 grab", result == "Block", result)
			t:check("does nothing to them", blocker:GetAttribute("CombatState") ~= "Held", tostring(blocker:GetAttribute("CombatState")))
			waitIdle(t)

			fresh(t)
			setMeter(t, Config.Stage2At + 5)
			t:faceDummy(blocker, 3)
			local caught = press(t, "Four")
			t:check("the stage 2 grab goes through the block", caught == "Hit", caught)
			t:check("they're held", waitState(blocker, "Held", 0.5, t), tostring(blocker:GetAttribute("CombatState")))
			local move = Moves.Get("Lotus.Grab2")
			t:near("the meter jumps to SetMeter", meter(t), if move and move.SetMeter then move.SetMeter else 80, 0.5)
			waitIdle(t)
			t:wait(1)

			fresh(t)
			setMeter(t, Config.Stage3At + 15)
			local attacker = t:dummy("DummyAttack", "Stand")
			t:faceDummy(attacker, 3)
			t:press("Four")
			t:debug("DummyMove", "DummyAttack", "Sword.M1_1")
			t:wait(0.15)
			t:check("hit during its startup, the stage 3 grab keeps going", t:server().state == "Attacking", tostring(t:server().state))
			t:check("and catches them", waitState(attacker, "Held", 0.6, t), tostring(attacker:GetAttribute("CombatState")))
			waitIdle(t)
			t:wait(1)
		end,
	},
	{
		name = "R: hold to heal (feeds the meter), tap to rip it out",
		run = function(t)
			setMeter(t, 30)
			t:debug("SetHealth", 50)
			t:wait(0.1)
			t:press("R")
			t:check("holding R is the heal", t.combat:GetMoveId() == "Lotus.Heal", tostring(t.combat:GetMoveId()))
			t:wait(1.2)
			t:release("R")
			t:wait(0.3)
			t:near("a full channel heals HealHealth", t.humanoid.Health, 50 + Config.HealHealth, 0.6)
			t:near("and feeds HealMeter", meter(t), 30 + Config.HealMeter, 1)
			waitIdle(t)

			fresh(t)
			setMeter(t, 60)
			local hp0 = t.humanoid.Health
			t:press("R")
			t:wait(0.05)
			t:release("R")
			t:check("a tap is the rip-out", t.combat:GetMoveId() == "Lotus.RipOut", tostring(t.combat:GetMoveId()))
			t:wait(0.5)
			t:near("it costs RipOutHealth", hp0 - t.humanoid.Health, Config.RipOutHealth, 0.1)
			t:near("and RipOutMeter", meter(t), 60 - Config.RipOutMeter, 0.5)
			waitIdle(t)
		end,
	},
	{
		name = "2 against an airborne opponent: the impale",
		run = function(t)
			setMeter(t, 0)
			local dummy = t:dummy("DummyStand")
			t:faceDummy(dummy, 8)
			t:debug("LaunchDummy", "DummyStand", 12)
			t:wait(0.2)
			t:press("Two")
			t:check("the stab becomes the impale", t.combat:GetMoveId() == "Lotus.Impale1", tostring(t.combat:GetMoveId()))
			t:check("growth from the ground catches them", waitState(dummy, "Held", 1, t), tostring(dummy:GetAttribute("CombatState")))
			t:check("then drops them", waitState(dummy, "Knockdown", 1, t) or waitState(dummy, "Downed", 0.5, t))
			waitIdle(t)
		end,
	},
	{
		name = "Follow-ups: a spore right after a stab hit gets its bonus",
		run = function(t)
			setMeter(t, 0)
			local dummy = t:dummy("DummyStand")
			t:faceDummy(dummy, 5)
			local stab = press(t, "Two")
			t:check("the stab hits", stab == "Hit", stab)
			waitIdle(t)
			t:press("Three")
			t:wait(0.03)
			t:check("the spore counts as a follow-up", t:server().followUp == true)
			waitIdle(t)
		end,
	},
	{
		name = "G: the form at a full meter (free stage 3), meter to 20 after",
		run = function(t)
			setMeter(t, 50)
			t:press("G")
			t:check("not below a full meter", t.combat:GetMoveId() == nil)
			setMeter(t, Config.LotusMax)
			t:press("G")
			t:check("at a full meter it starts", t.combat:GetMoveId() == "Lotus.Form")
			t:check("the form", t:waitAttribute(t.character, "LotusForm", true, 1.5))
			waitIdle(t)
			t:teleport(Vector3.new(-40, 4, -150), Vector3.zAxis)
			local before = meter(t)
			t:press("Two")
			t:wait(0.1)
			t:near("stage 3 moves cost nothing in the form", meter(t), before, 0.5)
			t:check("it ends", t:waitAttribute(t.character, "LotusForm", false, Config.FormTime + 1))
			t:near("with the meter at FormMeterAfter", meter(t), Config.FormMeterAfter, 0.5)
		end,
	},
}

return {
	name = "Lotus",
	description = "Meter and stages, 2 / 3 / 4 variants, R, G, Infested, costs and misses",
	tests = tests,
}
]]></ProtectedString></Properties></Item></Item></Item><Item class="LocalScript" referent="RBX4B6B9C510EBD4FC5A3D8D66AEB46B255"><Properties><string name="Name">CombatFx</string><ProtectedString name="Source"><![CDATA[--!strict
-- CombatFx (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > CombatFx
--
-- Every combat effect, drawn on each client (docs/art/ArtDirection.md, "Effects"). Like the
-- animations, everything changes in steps (FX_RATE per second), never smooth tweens.
--   slash        a thin flat arc of plates on a move's active frames, shaped by its Fx.Arc
--   warning      a short flash on an attacker winding up an unblockable: yellow = parry it,
--                blue = can't block or parry, get out of the way
--   hit          3-5 white plates in a star (red on a counter-hit, plus "COUNTER"), a damage number
--   block        blue-white plates and a flat guard plate in front of the blocker
--   parry        a white flash plate and a ring that grows in steps
--   status       the name over the target ("DRAFTED") and pale wind plates
--   hit pause    both characters' animations hold still for the hit's hitstop
--   shake        the camera shakes in steps when your own character hits or is hit
--   dagger       other characters draw the dagger for dagger moves (your own: CombatClient)
--   burnout      the burnout loop plays on burnt-out characters
-- Sounds come from SoundConfig through Sfx (played locally, nothing relayed).
-- Moves start from the "Move" attribute the server sets ("LocalMove" for your own character, which
-- CombatClient sets the moment you press, so your own slashes don't wait for the server).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Combat = ReplicatedStorage:WaitForChild("Combat")
local Moves = require(Combat:WaitForChild("Moves"))
local CombatRemotes = require(Combat:WaitForChild("CombatRemotes"))
local WeaponModels = require(Combat:WaitForChild("WeaponModels"))
local Sfx = require(ReplicatedStorage:WaitForChild("Movement"):WaitForChild("Sfx"))

local player = Players.LocalPlayer
local FX_RATE = 20
local FRAME = 1 / 60
local MAX_DISTANCE = 200

local WHITE = Color3.new(1, 1, 1)
local SLASH_COLOR = Color3.fromRGB(235, 240, 255)
local COUNTER_COLOR = Color3.fromRGB(255, 70, 60)
local BLOCK_COLOR = Color3.fromRGB(150, 200, 255)
local YELLOW = Color3.fromRGB(255, 220, 40)
local BLUE = Color3.fromRGB(60, 140, 255)
local WIND_COLOR = Color3.fromRGB(215, 235, 240)

local folder = Instance.new("Folder")
folder.Name = "CombatFx"
folder.Parent = Workspace

-- PARTS -------------------------------------------------------------------------------------

type Piece = {
	part: Part,
	-- One entry per step: { cframe, size, transparency } (nil = keep).
	steps: { { cframe: CFrame?, size: Vector3?, transparency: number? } },
	index: number,
}

local pool: { Part } = {}
local pieces: { Piece } = {}
local rng = Random.new()

local function take(color: Color3, neon: boolean?): Part
	local part = table.remove(pool)
	if not part then
		local fresh = Instance.new("Part")
		fresh.Anchored = true
		fresh.CanCollide = false
		fresh.CanQuery = false
		fresh.CanTouch = false
		fresh.CastShadow = false
		fresh.TopSurface = Enum.SurfaceType.Smooth
		fresh.BottomSurface = Enum.SurfaceType.Smooth
		part = fresh
	end
	assert(part, "CombatFx: no part")
	part.Color = color
	part.Material = if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
	part.Transparency = 0
	part.Parent = folder
	return part
end

-- A part that goes through `steps` (one per FX step), then disappears.
local function piece(color: Color3, steps: { { cframe: CFrame?, size: Vector3?, transparency: number? } }, neon: boolean?)
	local part = take(color, neon)
	local first = steps[1]
	part.CFrame = first.cframe or CFrame.identity
	part.Size = first.size or Vector3.one
	part.Transparency = first.transparency or 0
	table.insert(pieces, { part = part, steps = steps, index = 1 })
end

local function stepPieces()
	for i = #pieces, 1, -1 do
		local p = pieces[i]
		p.index += 1
		local step = p.steps[p.index]
		if not step then
			p.part.Parent = nil
			table.insert(pool, p.part)
			table.remove(pieces, i)
		else
			if step.cframe then
				p.part.CFrame = step.cframe
			end
			if step.size then
				p.part.Size = step.size
			end
			if step.transparency then
				p.part.Transparency = step.transparency
			end
		end
	end
end

local function near(position: Vector3): boolean
	local camera = Workspace.CurrentCamera
	if not camera then
		return false
	end
	return (camera.CFrame.Position - position).Magnitude <= MAX_DISTANCE
end

local function rootOf(model: Model?): BasePart?
	local root = model and model:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

-- SLASHES -----------------------------------------------------------------------------------

-- Arc shapes in the character's space (+X right, +Y up, -Z forward): the plane (two unit axes),
-- the start and end angles (degrees), the radius and the centre.
type ArcShape = { u: Vector3, v: Vector3, from: number, to: number, radius: number, centre: Vector3 }
local ARCS: { [string]: ArcShape } = {
	Flat = { u = Vector3.xAxis, v = -Vector3.zAxis, from = -20, to = 200, radius = 3.8, centre = Vector3.new(0, 0.6, -0.6) },
	Backhand = { u = -Vector3.xAxis, v = -Vector3.zAxis, from = -20, to = 200, radius = 3.8, centre = Vector3.new(0, 0.4, -0.6) },
	Overhead = { u = Vector3.yAxis, v = -Vector3.zAxis, from = 10, to = 150, radius = 4, centre = Vector3.new(0.6, 0.4, -0.4) },
	Rising = { u = -Vector3.yAxis, v = -Vector3.zAxis, from = 10, to = 170, radius = 4, centre = Vector3.new(0.6, 0.6, -0.6) },
	Diagonal = { u = Vector3.new(1, 1, 0).Unit, v = -Vector3.zAxis, from = 0, to = 170, radius = 3.8, centre = Vector3.new(0, 0.4, -0.6) },
}

local function slash(root: BasePart, arc: string, heavy: boolean, hand: string)
	local base = root.CFrame
	if arc == "Thrust" or arc == "Stab" then
		local length = if arc == "Thrust" then 7 else 3.5
		local side = if hand == "Left" then -0.8 else 0.8
		local at = base * CFrame.new(side * 0.5, 0.3, -(1.5 + length / 2))
		piece(SLASH_COLOR, {
			{ cframe = at, size = Vector3.new(0.12, 0.5, length * 0.6), transparency = 0.2 },
			{ cframe = at, size = Vector3.new(0.12, 0.4, length), transparency = 0.35 },
			{ cframe = at, size = Vector3.new(0.1, 0.25, length), transparency = 0.6 },
		}, true)
		return
	end
	local shape = ARCS[arc]
	if not shape then
		return -- not a sword / dagger cut (the Lotus draws its own: LotusFx)
	end
	local segments = if heavy then 7 else 5
	local width = if heavy then 0.7 else 0.45
	local radius = shape.radius + (if heavy then 0.5 else 0)
	local normal = shape.u:Cross(shape.v)
	for i = 1, segments do
		local a0 = math.rad(shape.from + (shape.to - shape.from) * (i - 1) / segments)
		local a1 = math.rad(shape.from + (shape.to - shape.from) * i / segments)
		local p0 = shape.centre + (shape.u * math.cos(a0) + shape.v * math.sin(a0)) * radius
		local p1 = shape.centre + (shape.u * math.cos(a1) + shape.v * math.sin(a1)) * radius
		local mid = (p0 + p1) / 2
		local along = (p1 - p0)
		local length = along.Magnitude
		-- A thin plate lying in the arc's plane, its long side along the arc.
		local local_ = CFrame.fromMatrix(mid, along.Unit, normal, along.Unit:Cross(normal))
		local at = base * local_
		-- The tip of the arc (the later segments) shows first and lasts longest: a trail.
		local share = i / segments
		local t0 = 0.15 + (1 - share) * 0.35
		piece(SLASH_COLOR, {
			{ cframe = at, size = Vector3.new(length + 0.05, 0.08, width), transparency = t0 },
			{ cframe = at, size = Vector3.new(length + 0.05, 0.08, width * 0.8), transparency = t0 + 0.2 },
			{ cframe = at, size = Vector3.new(length + 0.05, 0.06, width * 0.5), transparency = t0 + 0.45 },
		}, true)
	end
end

-- The attacker's move started: warning flash now, slash on its first active frame.
local function onMoveStarted(character: Model, value: unknown)
	if typeof(value) ~= "string" then
		if character ~= player.Character then
			WeaponModels.SetDaggerDrawn(character, false)
		end
		return
	end
	local id = string.match(value, "^([^#]+)")
	local move = if id then Moves.Get(id) else nil
	local root = rootOf(character)
	if not move or not root or not near(root.Position) then
		return
	end
	if character ~= player.Character then
		WeaponModels.SetDaggerDrawn(character, move.Weapon == "Dagger")
	end
	if move.Guard ~= "Normal" then
		local highlight = Instance.new("Highlight")
		highlight.FillColor = if move.Guard == "Unblockable" then YELLOW else BLUE
		highlight.OutlineColor = highlight.FillColor
		highlight.DepthMode = Enum.HighlightDepthMode.Occluded
		highlight.FillTransparency = 0.2
		highlight.OutlineTransparency = 0
		highlight.Parent = character
		task.spawn(function()
			for _, t in { 0.2, 0.45, 0.2, 0.5, 0.75 } do
				highlight.FillTransparency = t
				task.wait(1 / 15)
			end
			highlight:Destroy()
		end)
	end
	local heavy = move.Fx.Swing == "SwordSwingHeavy"
	task.delay(move.Startup * FRAME, function()
		local current = character:GetAttribute(if character == player.Character then "LocalMove" else "Move")
		local liveRoot = rootOf(character)
		if current == value and liveRoot then
			slash(liveRoot, move.Fx.Arc, heavy, move.Fx.Hand)
		end
	end)
end

-- HITS, BLOCKS, PARRIES ---------------------------------------------------------------------

local function star(position: Vector3, color: Color3, count: number, size: number)
	for i = 1, count do
		local angle = (i / count) * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
		local spin = CFrame.new(position) * CFrame.Angles(rng:NextNumber(0, math.pi), rng:NextNumber(0, math.pi), angle)
		piece(color, {
			{ cframe = spin, size = Vector3.new(0.12, size * 0.6, 0.12), transparency = 0 },
			{ cframe = spin, size = Vector3.new(0.12, size, 0.12), transparency = 0.1 },
			{ cframe = spin, size = Vector3.new(0.08, size * 1.2, 0.08), transparency = 0.5 },
		}, true)
	end
end

local function ring(position: Vector3, facing: Vector3, color: Color3)
	local flat = Vector3.new(facing.X, 0, facing.Z)
	local look = if flat.Magnitude > 1e-3 then flat.Unit else Vector3.zAxis
	local base = CFrame.lookAlong(position, look)
	local count = 8
	for i = 1, count do
		local angle = (i / count) * math.pi * 2
		local steps = {}
		for s, radius in { 0.8, 1.6, 2.4, 3 } do
			local at = base * CFrame.Angles(0, 0, angle) * CFrame.new(0, radius, 0)
			table.insert(steps, { cframe = at, size = Vector3.new(radius * 0.7, 0.14, 0.14), transparency = (s - 1) * 0.22 })
		end
		piece(color, steps, true)
	end
	piece(WHITE, {
		{ cframe = base, size = Vector3.new(2.6, 2.6, 0.1), transparency = 0.1 },
		{ cframe = base, size = Vector3.new(3.4, 3.4, 0.1), transparency = 0.5 },
	}, true)
end

local function label(model: Model, text: string, color: Color3, size: number)
	local head = model:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(160, size + 6)
	gui.StudsOffset = Vector3.new(rng:NextNumber(-0.8, 0.8), 1.6, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 80
	local text_ = Instance.new("TextLabel")
	text_.Size = UDim2.fromScale(1, 1)
	text_.BackgroundTransparency = 1
	text_.Font = Enum.Font.Arcade
	text_.TextSize = size
	text_.Text = text
	text_.TextColor3 = color
	text_.TextStrokeTransparency = 0
	text_.Parent = gui
	gui.Parent = head
	task.spawn(function()
		for step = 1, 6 do
			gui.StudsOffset += Vector3.new(0, 0.25, 0)
			if step >= 4 then
				text_.TextTransparency = (step - 3) * 0.3
				text_.TextStrokeTransparency = (step - 3) * 0.3
			end
			task.wait(0.1)
		end
		gui:Destroy()
	end)
end

-- Hit pause for characters whose animations this client doesn't run (everyone else's; your own
-- are paused by CombatClient).
local function freeze(model: Model?, seconds: number)
	if not model or model == player.Character or seconds <= 0 then
		return
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	local held: { [AnimationTrack]: number } = {}
	for _, track in animator:GetPlayingAnimationTracks() do
		if track.Speed ~= 0 then
			held[track] = track.Speed
			track:AdjustSpeed(0)
		end
	end
	task.delay(seconds, function()
		for track, speed in held do
			if track.IsPlaying then
				track:AdjustSpeed(speed)
			end
		end
	end)
end

-- CAMERA SHAKE ------------------------------------------------------------------------------

local shakeUntil = 0
local shakeAmount = 0
local shakeOffset = CFrame.identity
local nextShakeStep = 0

local function shake(amount: number, seconds: number)
	shakeAmount = math.max(shakeAmount, amount)
	shakeUntil = math.max(shakeUntil, os.clock() + seconds)
end

RunService:BindToRenderStep("CombatShake", Enum.RenderPriority.Camera.Value + 1, function()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local now = os.clock()
	if now >= shakeUntil then
		shakeAmount = 0
		return
	end
	-- A new offset 30 times a second (stepped), shrinking as it ends.
	if now >= nextShakeStep then
		nextShakeStep = now + 1 / 30
		local a = shakeAmount * math.clamp((shakeUntil - now) / 0.2, 0.3, 1)
		shakeOffset = CFrame.new(rng:NextNumber(-a, a), rng:NextNumber(-a, a), 0)
			* CFrame.Angles(0, 0, math.rad(rng:NextNumber(-a, a) * 3))
	end
	camera.CFrame *= shakeOffset
end)

-- SERVER EVENTS -----------------------------------------------------------------------------

local remotes = CombatRemotes.Get()

remotes.Fx.OnClientEvent:Connect(function(info: { [string]: any })
	local kind: string = if typeof(info.type) == "string" then info.type else ""
	local isStatus = kind == "Status"
	local attacker: Model? = if typeof(info.attacker) == "Instance" and info.attacker:IsA("Model") then info.attacker else nil
	local target: Model? = if typeof(info.target) == "Instance" and info.target:IsA("Model") then info.target else nil
	local position: Vector3 = if typeof(info.position) == "Vector3" then info.position else Vector3.zero
	local hitstop: number = if typeof(info.hitstop) == "number" then info.hitstop else 0
	local mine = player.Character ~= nil and (attacker == player.Character or target == player.Character)
	local move = if typeof(info.move) == "string" then Moves.Get(info.move) else nil
	if kind == "Hitbox" then
		return -- HitboxViewer draws these
	end
	if not isStatus and not near(position) then
		return
	end
	if kind == "Hit" then
		local counter = info.counter == true
		local heavy = hitstop >= 5 * FRAME
		star(position, if counter then COUNTER_COLOR else WHITE, if heavy then 5 else 4, if heavy then 2.2 else 1.6)
		freeze(attacker, hitstop)
		freeze(target, hitstop)
		if target then
			local damage = if typeof(info.damage) == "number" then info.damage else 0
			label(target, string.format("%g", damage), if counter then COUNTER_COLOR else WHITE, 22)
			if counter then
				label(target, "COUNTER", COUNTER_COLOR, 18)
			end
			Sfx.PlayRemote(target, if move then move.Fx.Hit else "SwordHit", 1, 1, position)
			if counter then
				Sfx.PlayRemote(target, "CounterHit", 1, 1, position)
			end
		end
		if mine then
			shake(if heavy then 0.35 else 0.18, if heavy then 0.22 else 0.12)
		end
	elseif kind == "Block" then
		star(position, BLOCK_COLOR, 3, 1.2)
		local root = rootOf(target)
		if root then
			local at = root.CFrame * CFrame.new(0, 0.3, -1.4)
			piece(BLOCK_COLOR, {
				{ cframe = at, size = Vector3.new(2.6, 3, 0.1), transparency = 0.3 },
				{ cframe = at, size = Vector3.new(2.8, 3.2, 0.1), transparency = 0.6 },
			}, true)
		end
		freeze(attacker, hitstop)
		freeze(target, hitstop)
		if target then
			Sfx.PlayRemote(target, "Block", 1, 1, position)
			local chip = if typeof(info.chip) == "number" then info.chip else 0
			if chip > 0 then
				label(target, string.format("%g", math.floor(chip * 10 + 0.5) / 10), BLOCK_COLOR, 16)
			end
		end
		if mine then
			shake(0.08, 0.08)
		end
	elseif kind == "Parry" then
		local root = rootOf(target)
		ring(position, if root then root.CFrame.LookVector else Vector3.zAxis, WHITE)
		if target then
			Sfx.PlayRemote(target, "Parry", 1, 1, position)
			label(target, "PARRY", WHITE, 20)
		end
		if mine then
			shake(0.22, 0.15)
		end
	elseif kind == "Armour" then
		star(position, Color3.fromRGB(255, 170, 60), 3, 1.4)
		freeze(attacker, hitstop)
		freeze(target, hitstop)
	elseif kind == "Status" and target then
		local status = if typeof(info.status) == "string" then info.status else ""
		label(target, string.upper(status), WIND_COLOR, 20)
		local root = rootOf(target)
		if root and status == "Drafted" then
			for i = 1, 4 do
				local angle = i * math.pi / 2
				local base = root.CFrame * CFrame.Angles(0, angle, 0)
				local steps = {}
				for s = 0, 3 do
					local at = base * CFrame.new(1.8, -1.5 + s * 0.9, 0) * CFrame.Angles(0, 0, math.rad(20))
					table.insert(steps, { cframe = at, size = Vector3.new(0.1, 1.4, 0.5), transparency = 0.3 + s * 0.15 })
				end
				piece(WIND_COLOR, steps)
			end
		end
	end
end)

-- CHARACTERS --------------------------------------------------------------------------------

local watched: { [Model]: boolean } = {}

local function watch(character: Model)
	if watched[character] then
		return
	end
	watched[character] = true
	character:GetAttributeChangedSignal("Move"):Connect(function()
		if character ~= player.Character then
			onMoveStarted(character, character:GetAttribute("Move"))
		end
	end)
	character:GetAttributeChangedSignal("LocalMove"):Connect(function()
		if character == player.Character then
			onMoveStarted(character, character:GetAttribute("LocalMove"))
		end
	end)
	local function burnout()
		local on = character:GetAttribute("Burnout") == true
		pcall(Sfx.LoopRemote, character, "Burnout", on, 1, 1)
		if not on and character:GetAttribute("Stamina") ~= nil then
			pcall(Sfx.PlayRemote, character, "BurnoutRecover", 1, 1)
		end
	end
	character:GetAttributeChangedSignal("Burnout"):Connect(burnout)
	character.AncestryChanged:Connect(function()
		if not character:IsDescendantOf(game) then
			watched[character] = nil
		end
	end)
end

local function watchPlayer(p: Player)
	if p.Character then
		watch(p.Character)
	end
	p.CharacterAdded:Connect(watch)
end

for _, p in Players:GetPlayers() do
	watchPlayer(p)
end
Players.PlayerAdded:Connect(watchPlayer)

task.spawn(function()
	local dummies = Workspace:WaitForChild("TrainingDummies", 30)
	if not dummies then
		return
	end
	for _, model in dummies:GetChildren() do
		if model:IsA("Model") then
			watch(model)
		end
	end
	dummies.ChildAdded:Connect(function(model)
		if model:IsA("Model") then
			watch(model)
		end
	end)
end)

-- STEPS -------------------------------------------------------------------------------------

local accumulator = 0
RunService.Heartbeat:Connect(function(dt: number)
	accumulator += dt
	if accumulator >= 1 / FX_RATE then
		accumulator %= 1 / FX_RATE
		stepPieces()
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBXDA396A2D026B4B3B833C5D3CFB0AE2EC"><Properties><string name="Name">HitboxViewer</string><ProtectedString name="Source"><![CDATA[--!strict
-- HitboxViewer (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > HitboxViewer
--
-- Studio only. Settings menu (gear) > Debug > Hitbox view shows the SERVER's attack hitboxes (the boxes that actually decide hits, with
-- their lag padding): red while the box touches someone, orange otherwise, each shown for a
-- few frames. It asks the server to broadcast them (CombatServer, "CombatShowHitboxes").

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

if not RunService:IsStudio() then
	return
end

local SettingsMenu = require(script.Parent:WaitForChild("SettingsMenu"))
local CombatRemotes = require(ReplicatedStorage:WaitForChild("Combat"):WaitForChild("CombatRemotes"))

local SHOW_TIME = 0.1

local remotes = CombatRemotes.Get()
local shown = false

local folder = Instance.new("Folder")
folder.Name = "HitboxViewer"
folder.Parent = Workspace

SettingsMenu.AddToggle("Debug", "Hitbox view (server)", false, function(on: boolean)
	shown = on
	if not shown then
		folder:ClearAllChildren()
	end
	remotes.Debug:InvokeServer("ShowHitboxes", shown)
end)

remotes.Fx.OnClientEvent:Connect(function(info: { [string]: any })
	if not shown or info.type ~= "Hitbox" or typeof(info.cframe) ~= "CFrame" or typeof(info.size) ~= "Vector3" then
		return
	end
	local box = Instance.new("Part")
	box.Anchored = true
	box.CanCollide = false
	box.CanQuery = false
	box.CanTouch = false
	box.CastShadow = false
	box.Material = Enum.Material.ForceField
	box.Color = if info.hit then Color3.fromRGB(255, 40, 40) else Color3.fromRGB(255, 150, 40)
	box.Transparency = 0.3
	box.CFrame = info.cframe
	box.Size = info.size
	box.Parent = folder
	task.delay(SHOW_TIME, function()
		box:Destroy()
	end)
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBXA701F08BF1964EFAB481B9D08F2064FF"><Properties><string name="Name">LotusFx</string><ProtectedString name="Source"><![CDATA[--!strict
-- LotusFx (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > LotusFx
--
-- The Lotus Fungus effects, drawn on each client in the sculk palette (docs/art/ArtDirection.md),
-- stepped like everything else (FxPieces), never tweened:
--   stab 1       a dark strand shooting 9 studs out of the fungus hand
--   stab 3       a pale bone spike thrust out of the forearm
--   impale       a fungal patch spreading under the target during the wind-up ("Patch"), then bone
--                spikes erupting out of it
--   spores       low-poly spore balls flying (from the server's "Projectile" messages); the ground
--                strand is a trail of spikes racing along the floor; both burst where they end
--   beam         a dark shaft with a flickering cyan core for its 30 active frames
--   grab         growth swallowing the hand as it reaches; on a catch, tendrils to the victim
--   heal / rip   cyan specks rising / a chunk of growth torn off in debris; +HP / -HP labels
--   form         dark shells swelling around the body in steps, bursting when it ends
--   consumed     the fungus biting back: debris and a label
--   Infested     blobs growing over the victim's limbs in steps and pulsing while it lasts; the wrap
--                (their block hit by a Lotus move) covers them, then bursts
-- Moves start from the "Move" attribute (the server's) or "LocalMove" (your own, at once).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Combat = ReplicatedStorage:WaitForChild("Combat")
local Moves = require(Combat:WaitForChild("Moves"))
local CombatConfig = require(Combat:WaitForChild("CombatConfig"))
local CombatRemotes = require(Combat:WaitForChild("CombatRemotes"))
local FxPieces = require(Combat:WaitForChild("FxPieces"))
local Sfx = require(ReplicatedStorage:WaitForChild("Movement"):WaitForChild("Sfx"))

local player = Players.LocalPlayer
local FRAME = 1 / 60
local STEP = 1 / FxPieces.Rate
local MAX_DISTANCE = 220

local BASE = Color3.fromRGB(16, 20, 24)
local DARK_TEAL = Color3.fromRGB(15, 45, 54)
local GREEN = Color3.fromRGB(27, 58, 42)
local BLUE = Color3.fromRGB(22, 48, 90)
local CYAN = Color3.fromRGB(16, 152, 168)
local BONE = Color3.fromRGB(200, 194, 168)
local HEAL_TEXT = Color3.fromRGB(120, 230, 200)

local rng = Random.new()
local piece = FxPieces.Piece

local function near(position: Vector3): boolean
	local camera = Workspace.CurrentCamera
	if not camera then
		return false
	end
	return (camera.CFrame.Position - position).Magnitude <= MAX_DISTANCE
end

local function part(model: Model?, name: string): BasePart?
	local p = model and model:FindFirstChild(name)
	return if p and p:IsA("BasePart") then p else nil
end

-- The fungus hand (the bottom of the left arm), facing where the arm points.
local function handCFrame(model: Model): CFrame?
	local arm = part(model, "Left Arm")
	return if arm then arm.CFrame * CFrame.new(0, -1, 0) else nil
end

local function steps(count: number, fn: (i: number) -> FxPieces.Step): { FxPieces.Step }
	local out = {}
	for i = 1, count do
		table.insert(out, fn(i))
	end
	return out
end

local function label(model: Model, text: string, color: Color3)
	local head = part(model, "Head")
	if not head then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(180, 26)
	gui.StudsOffset = Vector3.new(0, 2.2, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 80
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.Arcade
	t.TextSize = 20
	t.Text = text
	t.TextColor3 = color
	t.TextStrokeTransparency = 0
	t.Parent = gui
	gui.Parent = head
	task.spawn(function()
		for i = 1, 6 do
			gui.StudsOffset += Vector3.new(0, 0.25, 0)
			if i >= 4 then
				t.TextTransparency = (i - 3) * 0.3
				t.TextStrokeTransparency = (i - 3) * 0.3
			end
			task.wait(0.1)
		end
		gui:Destroy()
	end)
end

-- A burst of palette debris (sphere shell + cubes) at `position`.
local function burst(position: Vector3, size: number)
	piece(BASE, {
		{ cframe = CFrame.new(position), size = Vector3.one * size, transparency = 0.2 },
		{ cframe = CFrame.new(position), size = Vector3.one * size * 1.6, transparency = 0.5 },
		{ cframe = CFrame.new(position), size = Vector3.one * size * 2.1, transparency = 0.8 },
	}, false, Enum.PartType.Ball)
	for i = 1, 6 do
		local direction = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0.2, 1), rng:NextNumber(-1, 1)).Unit
		local color = ({ BASE, GREEN, BLUE, DARK_TEAL, CYAN, BASE })[i]
		local cube = rng:NextNumber(0.2, 0.4)
		piece(color, steps(5, function(k)
			local at = position + direction * size * 0.4 * k - Vector3.new(0, 0.12 * k * k, 0)
			return { cframe = CFrame.new(at) * CFrame.Angles(k, k * 0.7, 0), size = Vector3.one * cube * (1 - k * 0.15), transparency = 0 }
		end), color == CYAN)
	end
end

-- MOVES ---------------------------------------------------------------------------------------

local function strand(model: Model, length: number, width: number, color: Color3, frames: number)
	local hand = handCFrame(model)
	local root = part(model, "HumanoidRootPart")
	if not hand or not root then
		return
	end
	local look = root.CFrame.LookVector
	local count = math.max(math.ceil(frames * FRAME / STEP), 3)
	piece(color, steps(count, function(i)
		local grow = math.min(i / 2, 1)
		local l = length * grow
		local at = CFrame.lookAlong(hand.Position + look * (l / 2), look)
		return { cframe = at, size = Vector3.new(width, width, l), transparency = if i == count then 0.6 else 0 }
	end))
	-- A glowing tip.
	piece(CYAN, steps(count, function(i)
		local grow = math.min(i / 2, 1)
		return { cframe = CFrame.new(hand.Position + look * length * grow), size = Vector3.one * (width * 1.3), transparency = 0 }
	end), true)
end

local function beam(model: Model, frames: number)
	local root = part(model, "HumanoidRootPart")
	if not root then
		return
	end
	local base = root.CFrame * CFrame.new(-0.6, 0.4, -31)
	local count = math.ceil(frames * FRAME / STEP)
	piece(BASE, steps(count, function(i)
		local w = if i % 2 == 0 then 3.6 else 4
		return { cframe = base, size = Vector3.new(w, w, 60), transparency = 0.35 }
	end))
	piece(CYAN, steps(count, function(i)
		local w = if i % 2 == 0 then 0.8 else 1.3
		return { cframe = base, size = Vector3.new(w, w, 60.2), transparency = 0.1 }
	end), true)
end

local function handCover(model: Model, frames: number)
	local hand = handCFrame(model)
	if not hand then
		return
	end
	local count = math.max(math.ceil(frames * FRAME / STEP), 2)
	piece(BASE, steps(count, function(i)
		local s = if i == 1 then 0.9 else 1.3
		return { cframe = hand, size = Vector3.one * s, transparency = 0 }
	end), false, Enum.PartType.Ball)
end

local function onMove(character: Model, value: unknown)
	if typeof(value) ~= "string" then
		return
	end
	local id = string.match(value, "^([^#]+)")
	local move = if id then Moves.Get(id) else nil
	local root = part(character, "HumanoidRootPart")
	if not move or move.Magic ~= "Lotus" or not root or not near(root.Position) then
		return
	end
	local arc = move.Fx.Arc
	local attribute = if character == player.Character then "LocalMove" else "Move"
	local function atActive(fn: () -> ())
		task.delay(move.Startup * FRAME, function()
			if character:GetAttribute(attribute) == value then
				fn()
			end
		end)
	end
	if arc == "Strand" then
		atActive(function()
			strand(character, 9, 0.45, BASE, move.Active + 6)
		end)
	elseif arc == "Spike" then
		atActive(function()
			strand(character, 10, 0.7, BONE, move.Active + 8)
		end)
	elseif arc == "Beam" then
		-- The charge: cyan specks drawn in toward the hand.
		local hand = handCFrame(character)
		if hand then
			for _ = 1, 5 do
				local from = hand.Position + Vector3.new(rng:NextNumber(-3, 3), rng:NextNumber(-1, 3), rng:NextNumber(-3, 3))
				piece(CYAN, steps(6, function(k)
					return { cframe = CFrame.new(from:Lerp(hand.Position, k / 6)), size = Vector3.one * 0.2, transparency = 0 }
				end), true)
			end
		end
		atActive(function()
			beam(character, move.Active)
		end)
	elseif arc == "Grab" then
		handCover(character, move.Startup + move.Active)
	elseif move.Id == "Lotus.Heal" then
		local count = math.ceil(move.Active * FRAME / STEP)
		local arm = part(character, "Left Arm")
		if arm then
			for i = 1, count, 2 do
				task.delay(i * STEP, function()
					if character:GetAttribute(attribute) ~= value then
						return
					end
					local from = arm.Position + Vector3.new(rng:NextNumber(-0.8, 0.8), -0.5, rng:NextNumber(-0.8, 0.8))
					piece(CYAN, steps(5, function(k)
						return { cframe = CFrame.new(from + Vector3.new(0, 0.4 * k, 0)), size = Vector3.one * 0.18, transparency = (k - 1) * 0.18 }
					end), true)
				end)
			end
		end
	end
end

-- SERVER EVENTS -------------------------------------------------------------------------------

local flying: { [number]: { FxPieces.Handle } } = {}

local function projectile(info: { [string]: any })
	local id = info.id
	local position: Vector3 = info.position
	local direction: Vector3 = info.direction
	local speed: number = info.speed
	local range: number = info.range
	if typeof(id) ~= "number" or typeof(position) ~= "Vector3" or typeof(direction) ~= "Vector3" or not near(position) then
		return
	end
	local count = math.max(math.ceil(range / speed / STEP), 1)
	local handles = {}
	if info.ground == true then
		-- The ground strand: spikes breaking out of the floor along its path, each lasting a moment.
		for i = 1, count do
			task.delay(i * STEP, function()
				if not flying[id] then
					return
				end
				local at = position + direction * speed * i * STEP
				for s = 1, 2 do
					local side = direction:Cross(Vector3.yAxis).Unit * (if s == 1 then 0.8 else -0.8)
					local tilt = CFrame.lookAlong(at + side, direction) * CFrame.Angles(math.rad(-60), 0, math.rad(if s == 1 then -20 else 20))
					piece(if s == 1 then BONE else BASE, {
						{ cframe = tilt * CFrame.new(0, 0.5, 0), size = Vector3.new(0.3, 1, 0.3), transparency = 0 },
						{ cframe = tilt * CFrame.new(0, 1.2, 0), size = Vector3.new(0.35, 2.4, 0.35), transparency = 0 },
						{ cframe = tilt * CFrame.new(0, 0.8, 0), size = Vector3.new(0.3, 1.6, 0.3), transparency = 0.4 },
					})
				end
			end)
		end
		flying[id] = handles
		return
	end
	-- A spore: a dark ball with a cyan core, stepping along its line.
	local ball = piece(DARK_TEAL, steps(count, function(i)
		return { cframe = CFrame.new(position + direction * speed * i * STEP) * CFrame.Angles(i, i * 0.5, 0), size = Vector3.one * 2, transparency = 0 }
	end), false, Enum.PartType.Ball)
	local core = piece(CYAN, steps(count, function(i)
		return { cframe = CFrame.new(position + direction * speed * i * STEP), size = Vector3.one * 0.7, transparency = 0 }
	end), true, Enum.PartType.Ball)
	for _, h in { ball, core } do
		if h then
			table.insert(handles, h)
		end
	end
	flying[id] = handles
	local attacker = info.attacker
	if typeof(attacker) == "Instance" and attacker:IsA("Model") then
		Sfx.PlayRemote(attacker, "SporeThrow", 1, 1, position)
	end
end

local function projectileEnd(info: { [string]: any })
	local id = info.id
	if typeof(id) ~= "number" then
		return
	end
	local handles = flying[id]
	flying[id] = nil
	if handles then
		for _, h in handles do
			FxPieces.Stop(h)
		end
	end
	if typeof(info.position) == "Vector3" and near(info.position) then
		burst(info.position, 1.2)
	end
end

local function patch(info: { [string]: any })
	local at: Vector3 = info.position
	local seconds: number = if typeof(info.seconds) == "number" then info.seconds else 0.2
	if typeof(at) ~= "Vector3" or not near(at) then
		return
	end
	local count = math.max(math.ceil(seconds / STEP), 2)
	local disc = CFrame.new(at + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, 0, math.rad(90))
	piece(BASE, steps(count + 8, function(i)
		local r = math.min(1.5 + i * 0.8, 5)
		return { cframe = disc, size = Vector3.new(0.1, r, r), transparency = if i > count + 5 then 0.5 else 0 }
	end), false, Enum.PartType.Cylinder)
	piece(CYAN, steps(count, function(i)
		return { cframe = CFrame.new(at + Vector3.new(0, 0.1, 0)), size = Vector3.new(0.3, 0.1, 0.3) * (1 + i * 0.3), transparency = 0 }
	end), true)
	-- The eruption, when the wind-up ends.
	task.delay(seconds, function()
		for i = 1, 5 do
			local angle = i / 5 * math.pi * 2
			local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * (if i == 5 then 0 else 1.4)
			-- Leaning in toward the middle a little.
			local lean = CFrame.Angles(offset.Z * 0.15, 0, -offset.X * 0.15)
			local color = if i % 2 == 0 then BONE else BASE
			piece(color, steps(10, function(k)
				local h = if k <= 3 then k * 5 else (if k >= 8 then (11 - k) * 5 else 15)
				return { cframe = CFrame.new(at + offset) * lean * CFrame.new(0, h / 2, 0), size = Vector3.new(0.5, h, 0.5), transparency = 0 }
			end))
		end
	end)
end

local function tendrils(attacker: Model, target: Model, seconds: number)
	local count = math.max(math.ceil(seconds / STEP), 2)
	for t = 1, 3 do
		piece(if t == 2 then CYAN else BASE, steps(count, function(i)
			local hand = handCFrame(attacker)
			local torso = part(target, "Torso")
			if not hand or not torso then
				return { transparency = 1 }
			end
			local from = hand.Position
			local to = torso.Position + Vector3.new(0, (t - 2) * 0.6, 0)
			local wobble = Vector3.new(0, math.sin(i + t) * 0.3, 0)
			local mid = (from + to) / 2 + wobble
			local length = (to - from).Magnitude
			return { cframe = CFrame.lookAlong(mid, (to - from).Unit), size = Vector3.new(0.18, 0.18, length), transparency = 0 }
		end), t == 2)
	end
end

-- Growth over a whole body, then burst (the wrap).
local function wrap(target: Model, seconds: number)
	local limbs = { "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg", "Head" }
	local count = math.max(math.ceil(seconds / STEP), 3)
	for _, name in limbs do
		local limb = part(target, name)
		if limb then
			for b = 1, 2 do
				local offset = Vector3.new(rng:NextNumber(-0.5, 0.5), rng:NextNumber(-0.8, 0.8), rng:NextNumber(-0.5, 0.5))
				piece(if b == 1 then BASE else DARK_TEAL, steps(count, function(i)
					local s = math.min(0.4 + i * 0.25, 1.3) + (if i % 4 < 2 then 0 else 0.1)
					return { cframe = limb.CFrame * CFrame.new(offset), size = Vector3.one * s, transparency = 0 }
				end), false, Enum.PartType.Ball)
			end
		end
	end
	task.delay(seconds, function()
		local torso = part(target, "Torso")
		if torso then
			burst(torso.Position, 3)
		end
	end)
end

local remotes = CombatRemotes.Get()
remotes.Fx.OnClientEvent:Connect(function(info: { [string]: any })
	local kind = if typeof(info.type) == "string" then info.type else ""
	local target: Model? = if typeof(info.target) == "Instance" and info.target:IsA("Model") then info.target else nil
	local attacker: Model? = if typeof(info.attacker) == "Instance" and info.attacker:IsA("Model") then info.attacker else nil
	if kind == "Projectile" then
		projectile(info)
	elseif kind == "ProjectileEnd" then
		projectileEnd(info)
	elseif kind == "Patch" then
		patch(info)
	elseif kind == "Hit" and attacker and target and typeof(info.move) == "string" then
		local move = Moves.Get(info.move)
		local grab = move and move.Grab
		if grab then
			tendrils(attacker, target, grab.Hold * FRAME)
		end
	elseif kind == "Lotus" and target then
		local what = info.what
		local torso = part(target, "Torso")
		local at = if torso then torso.Position else (if typeof(info.position) == "Vector3" then info.position else Vector3.zero)
		if not near(at) then
			return
		end
		if what == "Heal" then
			local share = if typeof(info.share) == "number" then info.share else 1
			label(target, string.format("+%g HP", math.floor(CombatConfig.HealHealth * share * 10 + 0.5) / 10), HEAL_TEXT)
			Sfx.PlayRemote(target, "FungusHeal", 1, 1, at)
		elseif what == "RipOut" then
			local arm = part(target, "Left Arm")
			burst(if arm then arm.Position else at, 1.2)
			label(target, string.format("-%d HP", CombatConfig.RipOutHealth), Color3.fromRGB(255, 120, 110))
			Sfx.PlayRemote(target, "FungusRip", 1, 1, at)
		elseif what == "Form" then
			for s = 1, 3 do
				piece(BASE, steps(8, function(i)
					local size = 3 + s * 1.2 + math.min(i, 4) * 0.5
					return { cframe = CFrame.new(at), size = Vector3.one * size, transparency = 0.55 + s * 0.1 + i * 0.03 }
				end), false, Enum.PartType.Ball)
			end
			label(target, "FORM", CYAN)
			Sfx.PlayRemote(target, "FungusForm", 1, 1, at)
		elseif what == "FormEnd" then
			burst(at, 2.5)
		elseif what == "Consumed" then
			burst(at, 1.8)
			label(target, "CONSUMED", Color3.fromRGB(255, 120, 110))
			Sfx.PlayRemote(target, "FungusRip", 0.8, 1, at)
		elseif what == "Wrap" then
			wrap(target, CombatConfig.WrapFrames * FRAME)
			label(target, "WRAPPED", CYAN)
			Sfx.PlayRemote(target, "FungusFeast", 1, 1, at)
		end
	end
end)

-- INFESTED ------------------------------------------------------------------------------------

type Infestation = { parts: { Part }, connection: RBXScriptConnection? }
local infested: { [Model]: Infestation } = {}

local function clearInfestation(model: Model, pop: boolean)
	local current = infested[model]
	if not current then
		return
	end
	infested[model] = nil
	if current.connection then
		current.connection:Disconnect()
	end
	for _, p in current.parts do
		if pop then
			burst(p.Position, 0.8)
		end
		p:Destroy()
	end
end

-- Blobs on the limbs (welded, local only), growing in steps, then pulsing until it ends.
local function infest(model: Model)
	clearInfestation(model, false)
	local state: Infestation = { parts = {}, connection = nil }
	infested[model] = state
	type Spot = { limb: string, at: Vector3 }
	local spots: { Spot } = {
		{ limb = "Left Arm", at = Vector3.new(-0.4, -0.2, 0.2) },
		{ limb = "Right Leg", at = Vector3.new(0.3, 0.3, -0.4) },
		{ limb = "Torso", at = Vector3.new(0.6, -0.4, -0.45) },
		{ limb = "Right Arm", at = Vector3.new(0.45, 0.4, 0) },
		{ limb = "Left Leg", at = Vector3.new(-0.2, -0.5, 0.45) },
	}
	for i, spot in spots do
		local limb = part(model, spot.limb)
		if limb then
			local blob = Instance.new("Part")
			blob.Shape = Enum.PartType.Ball
			blob.Size = Vector3.one * 0.3
			blob.Color = if i % 2 == 0 then DARK_TEAL else BASE
			blob.Material = Enum.Material.SmoothPlastic
			blob.CanCollide = false
			blob.CanQuery = false
			blob.CanTouch = false
			blob.Massless = true
			blob.CastShadow = false
			blob.CFrame = limb.CFrame * CFrame.new(spot.at)
			local weld = Instance.new("Weld")
			weld.Part0 = limb
			weld.Part1 = blob
			weld.C0 = CFrame.new(spot.at)
			weld.Parent = blob
			blob.Parent = model
			table.insert(state.parts, blob)
		end
	end
	local started = os.clock()
	local lastStep = -1
	state.connection = RunService.Heartbeat:Connect(function()
		local stepIndex = math.floor((os.clock() - started) / 0.15)
		if stepIndex == lastStep then
			return
		end
		lastStep = stepIndex
		local grown = math.min(0.3 + stepIndex * 0.15, 0.75)
		local pulse = if stepIndex > 3 and stepIndex % 3 == 0 then 0.12 else 0
		for _, blob in state.parts do
			blob.Size = Vector3.one * (grown + pulse)
		end
	end)
end

local function watch(model: Model)
	model:GetAttributeChangedSignal("Move"):Connect(function()
		if model ~= player.Character then
			onMove(model, model:GetAttribute("Move"))
		end
	end)
	model:GetAttributeChangedSignal("LocalMove"):Connect(function()
		if model == player.Character then
			onMove(model, model:GetAttribute("LocalMove"))
		end
	end)
	model:GetAttributeChangedSignal("Infested"):Connect(function()
		if model:GetAttribute("Infested") == true then
			infest(model)
		else
			clearInfestation(model, true)
		end
	end)
	model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(game) then
			clearInfestation(model, false)
		end
	end)
end

local function watchPlayer(p: Player)
	if p.Character then
		watch(p.Character)
	end
	p.CharacterAdded:Connect(watch)
end

for _, p in Players:GetPlayers() do
	watchPlayer(p)
end
Players.PlayerAdded:Connect(watchPlayer)

task.spawn(function()
	local dummies = Workspace:WaitForChild("TrainingDummies", 30)
	if not dummies then
		return
	end
	for _, model in dummies:GetChildren() do
		if model:IsA("Model") then
			watch(model)
		end
	end
	dummies.ChildAdded:Connect(function(model)
		if model:IsA("Model") then
			watch(model)
		end
	end)
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8E94DAC773794B719A2E3F763DC92A0B"><Properties><string name="Name">SettingsMenu</string><ProtectedString name="Source"><![CDATA[--!strict
-- SettingsMenu (ModuleScript)
-- Location: StarterPlayer > StarterPlayerScripts > SettingsMenu
--
-- The settings menu: a gear button in the top-right corner opens a panel of switches and buttons,
-- grouped in sections. Nothing uses function keys (Studio and the Roblox player both keep most of
-- them for themselves), so every debug tool lives here:
--   local SettingsMenu = require(script.Parent:WaitForChild("SettingsMenu"))
--   local setShown = SettingsMenu.AddToggle("Debug", "Hitbox view", false, function(on) ... end)
--   setShown(false) -- when the tool turns itself off (its own Close button), so the switch agrees
--   SettingsMenu.AddButton("Debug", "Animation gallery", function() ... end)
-- The UI is built on the first require; items show in the order they're added, sections in SECTIONS
-- order (unknown sections go last).

local Players = game:GetService("Players")

local SECTIONS = { "Game", "Debug" }

local BG = Color3.fromRGB(16, 16, 18)
local ROW = Color3.fromRGB(30, 30, 34)
local BORDER = Color3.fromRGB(70, 70, 76)
local TEXT = Color3.fromRGB(235, 235, 235)
local MUTED = Color3.fromRGB(150, 150, 156)
local ON = Color3.fromRGB(46, 160, 38)
local OFF = Color3.fromRGB(60, 60, 66)
local FONT = Font.new("rbxasset://fonts/families/Arimo.json", Enum.FontWeight.Bold)
local ROW_H = 30
local WIDTH = 260

local SettingsMenu = {}

local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "SettingsMenu"
gui.ResetOnSpawn = false
gui.DisplayOrder = 250

local function stroke(parent: GuiObject)
	local s = Instance.new("UIStroke")
	s.Color = BORDER
	s.Thickness = 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
end

local gear = Instance.new("TextButton")
gear.Name = "Gear"
gear.AnchorPoint = Vector2.new(1, 0)
gear.Position = UDim2.new(1, -10, 0, 6)
gear.Size = UDim2.fromOffset(34, 34)
gear.BackgroundColor3 = BG
gear.BackgroundTransparency = 0.2
gear.BorderSizePixel = 0
gear.AutoButtonColor = true
gear.FontFace = FONT
gear.TextSize = 22
gear.TextColor3 = TEXT
gear.Text = "⚙"
gear.Parent = gui
stroke(gear)

local panel = Instance.new("ScrollingFrame")
panel.Name = "Panel"
panel.AnchorPoint = Vector2.new(1, 0)
panel.Position = UDim2.new(1, -10, 0, 46)
panel.Size = UDim2.new(0, WIDTH, 0.7, 0)
panel.BackgroundColor3 = BG
panel.BackgroundTransparency = 0.1
panel.BorderSizePixel = 0
panel.ScrollBarThickness = 4
panel.AutomaticCanvasSize = Enum.AutomaticSize.Y
panel.CanvasSize = UDim2.new()
panel.Visible = false
panel.Parent = gui
stroke(panel)

local list = Instance.new("UIListLayout")
list.SortOrder = Enum.SortOrder.LayoutOrder
list.Padding = UDim.new(0, 4)
list.Parent = panel
local padding = Instance.new("UIPadding")
padding.PaddingLeft = UDim.new(0, 8)
padding.PaddingRight = UDim.new(0, 10)
padding.PaddingTop = UDim.new(0, 8)
padding.PaddingBottom = UDim.new(0, 8)
padding.Parent = panel

gear.Activated:Connect(function()
	panel.Visible = not panel.Visible
end)

-- Sections -----------------------------------------------------------------------------------------

local sectionOrder: { [string]: number } = {}
local sectionCount: { [string]: number } = {}

local function sectionIndex(section: string): number
	local known = table.find(SECTIONS, section)
	if known then
		return known
	end
	if not sectionOrder[section] then
		local n = #SECTIONS
		for _ in sectionOrder do
			n += 1
		end
		sectionOrder[section] = n + 1
	end
	return sectionOrder[section]
end

-- LayoutOrder for the next item of a section (its header comes first).
local function nextOrder(section: string): number
	local base = sectionIndex(section) * 1000
	if not sectionCount[section] then
		sectionCount[section] = 0
		local header = Instance.new("TextLabel")
		header.Name = section
		header.LayoutOrder = base
		header.Size = UDim2.new(1, 0, 0, 22)
		header.BackgroundTransparency = 1
		header.FontFace = FONT
		header.TextSize = 13
		header.TextColor3 = MUTED
		header.TextXAlignment = Enum.TextXAlignment.Left
		header.Text = string.upper(section)
		header.Parent = panel
	end
	sectionCount[section] += 1
	return base + sectionCount[section]
end

local function row(section: string, label: string): TextButton
	local button = Instance.new("TextButton")
	button.Name = label
	button.LayoutOrder = nextOrder(section)
	button.Size = UDim2.new(1, 0, 0, ROW_H)
	button.BackgroundColor3 = ROW
	button.BorderSizePixel = 0
	button.AutoButtonColor = true
	button.FontFace = FONT
	button.TextSize = 14
	button.TextColor3 = TEXT
	button.TextXAlignment = Enum.TextXAlignment.Left
	button.Text = "  " .. label
	button.Parent = panel
	return button
end

-- Items --------------------------------------------------------------------------------------------

-- A switch. onChange runs on every change (not for the initial value). Returns a setter that moves
-- the switch without calling onChange, for when the tool turns itself on or off.
function SettingsMenu.AddToggle(section: string, label: string, initial: boolean, onChange: (boolean) -> ()): (boolean) -> ()
	local button = row(section, label)
	local switch = Instance.new("Frame")
	switch.AnchorPoint = Vector2.new(1, 0.5)
	switch.Position = UDim2.new(1, -6, 0.5, 0)
	switch.Size = UDim2.fromOffset(34, 16)
	switch.BorderSizePixel = 0
	switch.Parent = button
	local knob = Instance.new("Frame")
	knob.AnchorPoint = Vector2.new(0, 0.5)
	knob.Size = UDim2.fromOffset(14, 14)
	knob.BackgroundColor3 = TEXT
	knob.BorderSizePixel = 0
	knob.Parent = switch

	local value = initial
	local function show()
		switch.BackgroundColor3 = if value then ON else OFF
		knob.Position = if value then UDim2.new(1, -15, 0.5, 0) else UDim2.new(0, 1, 0.5, 0)
	end
	show()
	button.Activated:Connect(function()
		value = not value
		show()
		onChange(value)
	end)
	return function(on: boolean)
		value = on
		show()
	end
end

-- A plain button (runs onPress each click). Returns the button so the caller can relabel it.
function SettingsMenu.AddButton(section: string, label: string, onPress: () -> ()): TextButton
	local button = row(section, label)
	button.TextXAlignment = Enum.TextXAlignment.Center
	button.Text = label
	button.Activated:Connect(onPress)
	return button
end

function SettingsMenu.Close()
	panel.Visible = false
end

gui.Parent = player:WaitForChild("PlayerGui")

return SettingsMenu
]]></ProtectedString></Properties></Item></Item>
