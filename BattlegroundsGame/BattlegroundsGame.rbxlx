		Recovery = 20,
		Damage = 7,
		Projectile = { Speed = 60, Range = 30, Radius = 2, Ground = true },
		OnHit = { Kind = "Launch", Launch = 22 },
		Guard = "Unblockable",
		Cooldown = 8,
		CooldownGroup = "Lotus.Two",
		Hitstop = 5,
		Fx = { Arc = "GroundStrand" },
	}),
	lotus({
		Id = "Lotus.Stab3",
		Name = "Heavy stab (stage 3)",
		Slot = "Two",
		Stage = 3,
		Animation = "LotusHeavyStab",
		Startup = 14,
		Active = 4,
		Recovery = 20,
		Damage = 14,
		Hitbox = { Size = Vector3.new(2.5, 2.5, 10), Forward = 6 },
		OnHit = { Kind = "Stun", Stun = 30, Knockback = 4 },
		OnBlock = 8,
		BlockPush = 15,
		Armour = 1,
		Cooldown = 6,
		CooldownGroup = "Lotus.Two",
		MeterCost = 15,
		WhiffPenalty = true,
		RefundOnCounter = true,
		Hitstop = 7,
		Motion = { Step = 2 },
		Fx = { Arc = "Spike", Swing = "FungusHeavy", Hit = "FungusHitHeavy" },
	}),
	lotus({
		Id = "Lotus.Impale1",
		Name = "Impale (stage 1)",
		Slot = "Two",
		Stage = 1,
		Animation = "LotusImpale",
		Startup = 12,
		Active = 3,
		Recovery = 20,
		Damage = 8, -- x1.6 of the stage 1 stab
		Hitbox = { Size = Vector3.new(4, 26, 4), Forward = 0 }, -- a column up from the patch
		Targeted = true,
		HeldFrames = 20,
		OnHit = { Kind = "Impale", Knockback = 4 },
		OnBlock = -6,
		Cooldown = 4,
		CooldownGroup = "Lotus.Two",
		MeterGain = 10,
		Hitstop = 5,
		Fx = { Arc = "Impale" },
	}),
	lotus({
		Id = "Lotus.Impale3",
		Name = "Impale (stage 3)",
		Slot = "Two",
		Stage = 3,
		Animation = "LotusImpale",
		Startup = 12,
		Active = 3,
		Recovery = 20,
		Damage = 22.4, -- x1.6 of the stage 3 stab
		Hitbox = { Size = Vector3.new(5, 28, 5), Forward = 0 },
