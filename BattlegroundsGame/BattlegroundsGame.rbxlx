					<UniqueId name="UniqueId">02ef6e543fe1adde0acd19b0000003fc</UniqueId>
				<ProtectedString name="Source"><![CDATA[--!strict
-- MothPartsData (ModuleScript, ReplicatedStorage > Movement > MothPartsData)
-- GENERATED by tools/models/moth_wings.py. Don't edit by hand: change the script and rerun it.
-- Paper wings (thin plates) and rod antennae. Joints: bone Motor6Ds (C0 relative to Part0).
-- Parts: visual pieces, CFrame relative to their bone. Texture: an uploaded image id, or "".

export type Joint = { Name: string, Part0: string, C0: CFrame }
export type PartSpec = { Bone: string, Name: string, Class: string, Shape: string, Size: Vector3, CFrame: CFrame, Color: Color3, Material: Enum.Material, Texture: string }

local Joints: { Joint } = {
	{ Name = "RightForewing", Part0 = "Torso", C0 = CFrame.new(0.25000, 0.45000, 0.62000, 0.92493, -0.06468, -0.37461, 0.06976, 0.99756, 0.00000, 0.37369, -0.02613, 0.92718) },
	{ Name = "LeftForewing", Part0 = "Torso", C0 = CFrame.new(-0.25000, 0.45000, 0.62000, 0.92493, 0.06468, 0.37461, -0.06976, 0.99756, 0.00000, -0.37369, -0.02613, 0.92718) },
	{ Name = "RightHindwing", Part0 = "Torso", C0 = CFrame.new(0.25000, -0.20000, 0.66000, 0.86128, 0.09052, -0.50000, -0.10453, 0.99452, 0.00000, 0.49726, 0.05226, 0.86603) },
	{ Name = "LeftHindwing", Part0 = "Torso", C0 = CFrame.new(-0.25000, -0.20000, 0.66000, 0.86128, -0.09052, 0.50000, 0.10453, 0.99452, 0.00000, -0.49726, 0.05226, 0.86603) },
	{ Name = "RightAntenna", Part0 = "Head", C0 = CFrame.new(0.30000, 0.50000, -0.20000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000) },
	{ Name = "LeftAntenna", Part0 = "Head", C0 = CFrame.new(-0.30000, 0.50000, -0.20000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000) },
}

local Parts: { PartSpec } = {
	{ Bone = "RightForewing", Name = "Wing", Class = "Part", Shape = "Block", Size = Vector3.new(3.1000, 1.0500, 0.0500), CFrame = CFrame.new(1.50652, 0.83013, 0.00000, 0.93969, -0.34202, 0.00000, 0.34202, 0.93969, 0.00000, 0.00000, 0.00000, 1.00000), Color = Color3.fromRGB(214, 204, 178), Material = Enum.Material.SmoothPlastic, Texture = "" },
	{ Bone = "LeftForewing", Name = "Wing", Class = "Part", Shape = "Block", Size = Vector3.new(3.1000, 1.0500, 0.0500), CFrame = CFrame.new(-1.50652, 0.83013, 0.00000, 0.93969, 0.34202, 0.00000, -0.34202, 0.93969, 0.00000, 0.00000, 0.00000, 1.00000), Color = Color3.fromRGB(214, 204, 178), Material = Enum.Material.SmoothPlastic, Texture = "" },
	{ Bone = "RightHindwing", Name = "Wing", Class = "Part", Shape = "Block", Size = Vector3.new(2.3000, 0.8000, 0.0500), CFrame = CFrame.new(1.16584, -0.37821, 0.00000, 0.97030, 0.24192, 0.00000, -0.24192, 0.97030, 0.00000, 0.00000, 0.00000, 1.00000), Color = Color3.fromRGB(186, 174, 146), Material = Enum.Material.SmoothPlastic, Texture = "" },
	{ Bone = "LeftHindwing", Name = "Wing", Class = "Part", Shape = "Block", Size = Vector3.new(2.3000, 0.8000, 0.0500), CFrame = CFrame.new(-1.16584, -0.37821, 0.00000, 0.97030, -0.24192, 0.00000, 0.24192, 0.97030, 0.00000, 0.00000, 0.00000, 1.00000), Color = Color3.fromRGB(186, 174, 146), Material = Enum.Material.SmoothPlastic, Texture = "" },
	{ Bone = "RightAntenna", Name = "Rod", Class = "Part", Shape = "Block", Size = Vector3.new(0.1000, 0.8000, 0.1000), CFrame = CFrame.new(0.11025, 0.38450, 0.00000, 0.96126, 0.27564, 0.00000, -0.27564, 0.96126, 0.00000, 0.00000, 0.00000, 1.00000), Color = Color3.fromRGB(58, 50, 44), Material = Enum.Material.SmoothPlastic, Texture = "" },
	{ Bone = "LeftAntenna", Name = "Rod", Class = "Part", Shape = "Block", Size = Vector3.new(0.1000, 0.8000, 0.1000), CFrame = CFrame.new(-0.11025, 0.38450, 0.00000, 0.96126, -0.27564, 0.00000, 0.27564, 0.96126, 0.00000, 0.00000, 0.00000, 1.00000), Color = Color3.fromRGB(58, 50, 44), Material = Enum.Material.SmoothPlastic, Texture = "" },
	{ Bone = "RightAntenna", Name = "Tip", Class = "Part", Shape = "Block", Size = Vector3.new(0.0800, 0.6000, 0.0800), CFrame = CFrame.new(0.28567, 0.99625, -0.18470, 0.96126, 0.21721, 0.16970, -0.27564, 0.75748, 0.59181, 0.00000, -0.61566, 0.78801), Color = Color3.fromRGB(58, 50, 44), Material = Enum.Material.SmoothPlastic, Texture = "" },
	{ Bone = "LeftAntenna", Name = "Tip", Class = "Part", Shape = "Block", Size = Vector3.new(0.0800, 0.6000, 0.0800), CFrame = CFrame.new(-0.28567, 0.99625, -0.18470, 0.96126, -0.21721, -0.16970, 0.27564, 0.75748, 0.59181, 0.00000, -0.61566, 0.78801), Color = Color3.fromRGB(58, 50, 44), Material = Enum.Material.SmoothPlastic, Texture = "" },
}

return { Joints = Joints, Parts = Parts }
]]></ProtectedString></Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXAF709AA0E216460E88B5DF8E4706B1F1">
