					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">AnimationConfig</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">02ef6e543fe1adde0acd19b0000003f3</UniqueId>
				<ProtectedString name="Source"><![CDATA[--!strict
-- AnimationConfig (ModuleScript)
-- Location: ReplicatedStorage > Movement > AnimationConfig
--
-- Which animation plays for each movement, and how its playback speed follows your speed.
--
-- PUBLISHED IDS: paste each animation's ID here after publishing it (either "rbxassetid://123"
-- or just the number). While an ID is empty, Studio playtests use the KeyframeSequence of the
-- same name from ServerStorage > RBX_ANIMSAVES > AnimRig_R6 instead, so any edit you save in
-- the Animation Editor shows up the next time you press Play. Those Studio copies only work in
-- Studio: a live server needs every ID filled in.

local AnimationConfig = {
	Ids = {
		Idle = "",
		WalkForward = "",
		Sprint = "",
		Jump = "",
		Fall = "",
		Climb = "",
		-- Transitions Animate plays between the loops above.
		WalkStart = "",
		SprintStart = "",
		SprintTurn = "",
		LandLight = "",
		LandRun = "",
		DashForward = "",
		DashLeft = "",
		DashRight = "",
		DashBack = "",
		DashPunch = "",
		-- Played by WallHop by which side the wall is on (Right = wall on your right).
		WallRunRight = "",
		WallRunLeft = "",
		WallHopRight = "",
		WallHopLeft = "",
		-- Optional: played by LandingRoll if it exists.
		LandingRoll = "",
		-- Optional: played by AutoParkour if they exist ("Vault" also plays for a step-up).
		Vault = "",
		LedgeClimb = "",
		Slide = "",
		-- Moth race (Lantern): wings rest loop, flights, lantern.
		MothWings = "",
		MothWingFlight = "",
		MothFly = "",
		LanternCharge = "",
		LanternThrow = "",
		LanternSuspend = "",
		-- Sword M1 chain (the placeholder M1 plays these until the combat system exists).
		M1Swing1 = "",
		M1Swing2 = "",
		M1Swing3 = "",
	} :: { [string]: string },

	-- Where Studio playtests read unpublished animations from.
	StudioRigName = "AnimRig_R6",
	StudioAnimationsFolder = "StudioAnimations",

	-- Crossfade between animations, in seconds. 0 = snap, to match the constant-easing style.
	FadeTime = 0,

	-- Ground speeds (studs/s) the animations were made for. At these speeds they play at
	-- normal rate; faster or slower movement speeds them up or slows them down.
	WalkAnimSpeed = 14,
	SprintAnimSpeed = 26,
	-- Climb speed (studs/s) that plays the climb at normal rate. Standing still on a truss
	-- freezes the climb pose; climbing down plays it backward.
	ClimbAnimSpeed = 10,
	MinPlaybackRate = 0.5,
	MaxPlaybackRate = 1.6,

	-- Below this ground speed you're standing still (Idle).
	IdleSpeed = 1,

	-- Short drops (stairs, small ledges) don't switch to Fall until you've been airborne this
	-- long, or you're falling faster than FallSpeedThreshold.
	FallDelay = 0.12,
	FallSpeedThreshold = 12,

	-- HEAD LOOK -------------------------------------------------------------
	-- The head turns a little toward where your camera points. Other players see it too.
	-- OFF at Isaac's request (Sep 26). Set to true to bring it back; everything below still works.
	-- It's meant to be subtle, and it moves in steps like the animations instead of gliding.
	HeadLookEnabled = false,
	-- Share of the camera's angle the head follows (1 = look straight where the camera looks).
	HeadYawScale = 0.3,
	HeadPitchScale = 0.3,
	-- Furthest the head turns left/right and up/down from the body, in degrees.
	HeadMaxYaw = 25,
	HeadMaxPitch = 12,
	-- The head jumps to a new angle at most this often (seconds), then holds it.
	-- Matches the ~0.1 s pose rate of the animations.
	HeadStepInterval = 0.12,
	-- Changes smaller than this (degrees) are ignored, so the head doesn't twitch.
	HeadMinStep = 2,
	-- How often your head direction is sent to the server (per second).
	HeadLookSendRate = 10,
}

return AnimationConfig
]]></ProtectedString></Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXD6F64E8E068D4BEEBC66E2E1709F8937">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- AnimationLibrary (ModuleScript)
-- Location: ReplicatedStorage > Movement > AnimationLibrary
--
-- Turns an animation name into an Animation object. Uses the published ID from
-- AnimationConfig when there is one; otherwise, in Studio only, registers the KeyframeSequence
-- of that name (copied into ReplicatedStorage by StudioAnimationMirror) as a temporary ID.

local KeyframeSequenceProvider = game:GetService("KeyframeSequenceProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(script.Parent.AnimationConfig)

local AnimationLibrary = {}

local cache: { [string]: Animation } = {}
local warned: { [string]: boolean } = {}

local function warnOnce(name: string, message: string)
	if not warned[name] then
		warned[name] = true
		warn("[AnimationLibrary] " .. message)
	end
end

local function normalize(id: string): string
	if string.match(id, "^%d+$") then
		return "rbxassetid://" .. id
	end
	return id
end

local function studioId(name: string): string?
	local folder = ReplicatedStorage:WaitForChild(Config.StudioAnimationsFolder, 10)
	if not folder then
		warnOnce(name, "No published ID for " .. name .. " and the Studio animation copies never arrived.")
		return nil
	end
	local sequence = folder:FindFirstChild(name)
	if not sequence or not sequence:IsA("KeyframeSequence") then
		warnOnce(
			name,
			`No published ID for {name}, and no KeyframeSequence named {name} in ServerStorage > RBX_ANIMSAVES > {Config.StudioRigName}.`
		)
		return nil
	end
	local ok, result = pcall(function()
		return KeyframeSequenceProvider:RegisterKeyframeSequence(sequence)
	end)
	if not ok then
		warnOnce(name, `Couldn't register the Studio copy of {name}: {result}`)
		return nil
	end
	return result
end

-- Returns the Animation for `name`, or nil (with a warning) if it isn't available.
function AnimationLibrary.Get(name: string): Animation?
	local cached = cache[name]
	if cached then
		return cached
	end

	local id = Config.Ids[name]
	local animationId: string?
	if id and id ~= "" then
		animationId = normalize(id)
	elseif RunService:IsStudio() then
		animationId = studioId(name)
	else
		warnOnce(name, `No published ID for {name}. Fill it in in AnimationConfig.`)
	end
	if not animationId then
		return nil
	end

	local animation = Instance.new("Animation")
	animation.Name = name
	animation.AnimationId = animationId
	cache[name] = animation
	return animation
end

return AnimationLibrary
]]></ProtectedString>
