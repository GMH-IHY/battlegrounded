					<UniqueId name="UniqueId">02ef6e543fe1adde0acd19b0000003e7</UniqueId>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Animate (LocalScript)
-- Location: StarterPlayer > StarterCharacterScripts > Animate
--
-- Plays the movement animations. It's named "Animate" on purpose: Roblox only adds its own
-- default Animate script when the character doesn't already have one, so this replaces it.
--
-- LOOPS: every frame one loop is picked from the character's state:
--   climbing        -> Climb (speed follows climb speed; frozen when still, reversed going down)
--   just jumped     -> Jump (until you start dropping)
--   in the air      -> Fall
--   on the ground   -> Idle / WalkForward / Sprint (the walk plays in reverse when moving backward
--                      in shift lock). Walk and Sprint keep their step timing when switching.
--
-- TRANSITIONS: when the state changes, a short clip plays in the loop's place first, so the body
-- never jumps straight from one loop into another (all poses snap; the clips add the in-betweens):
--   standing -> walking / running   WalkStart / SprintStart (end on the loop's first pose)
--   sharp turn while running         SprintTurn
--   landing                          LandRun (landing while moving), LandLight (standing)
-- A clip gives way as soon as it no longer fits: moving again cuts a stop or a standing landing,
-- stopping cuts a start, and leaving the ground or grabbing a truss cuts any of them. Stopping
-- from a run goes straight to Idle (no skid).
--
-- The playing locomotion animation's name is mirrored to the character attribute "LocoAnim"
-- (tests and debug tools read it).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local movementFolder = ReplicatedStorage:WaitForChild("Movement")
movementFolder:WaitForChild("AnimationConfig")
movementFolder:WaitForChild("AnimationLibrary")
movementFolder:WaitForChild("CharacterMotor")

local Config = require(ReplicatedStorage.Movement.AnimationConfig)
local AnimationLibrary = require(ReplicatedStorage.Movement.AnimationLibrary)
local CharacterMotor = require(ReplicatedStorage.Movement.CharacterMotor)
local Perf = require(ReplicatedStorage.Movement.Perf)

local character = script.Parent :: Model
local humanoid = character:WaitForChild("Humanoid") :: Humanoid
local root = character:WaitForChild("HumanoidRootPart") :: BasePart

local animator = humanoid:FindFirstChildOfClass("Animator")
if not animator then
	local created = Instance.new("Animator")
	created.Parent = humanoid
	animator = created
end
assert(animator, "Animate: no Animator")

local LOOPS = { "Idle", "WalkForward", "Sprint", "Jump", "Fall", "Climb" }
local CLIPS = { "WalkStart", "SprintStart", "SprintTurn", "LandLight", "LandRun" }
-- Animations that share a stride; switching between them keeps the step timing.
local STRIDE: { [string]: boolean } = {
	WalkForward = true,
	Sprint = true,
}
local MOVING: { [string]: boolean } = {
	WalkForward = true,
	Sprint = true,
}
local JUMP_HOLD = 0.6 -- longest the Jump animation can stay up before Fall takes over
local NO_ANIMATION_STATES: { [Enum.HumanoidStateType]: boolean } = {
	[Enum.HumanoidStateType.Dead] = true,
	[Enum.HumanoidStateType.Physics] = true,
	[Enum.HumanoidStateType.Ragdoll] = true,
	[Enum.HumanoidStateType.FallingDown] = true,
	[Enum.HumanoidStateType.PlatformStanding] = true,
	[Enum.HumanoidStateType.Seated] = true,
}

-- How each clip gives way (see the header).
type ClipRule = { cutWhenMoving: boolean, cutWhenStopped: boolean }
local CLIP_RULES: { [string]: ClipRule } = {
	WalkStart = { cutWhenMoving = false, cutWhenStopped = true },
	SprintStart = { cutWhenMoving = false, cutWhenStopped = true },
	SprintTurn = { cutWhenMoving = false, cutWhenStopped = true },
	LandRun = { cutWhenMoving = false, cutWhenStopped = true },
	LandLight = { cutWhenMoving = true, cutWhenStopped = false },
}

local tracks: { [string]: AnimationTrack } = {}
for _, name in LOOPS do
	local animation = AnimationLibrary.Get(name)
	if animation then
		tracks[name] = animator:LoadAnimation(animation)
	end
end
for _, name in CLIPS do
	local animation = AnimationLibrary.Get(name)
	if animation then
		local track = animator:LoadAnimation(animation)
		track.Looped = false
		track.Priority = Enum.AnimationPriority.Movement
		tracks[name] = track
	end
end

local current: string? = nil -- the loop playing
local clip: string? = nil -- the transition clip playing in the loop's place
local lastLoop: string? = nil -- the loop picked last frame (even while a clip covered it)
local lastSpeed = 0 -- horizontal speed last frame
local lastMove = Vector3.zero -- move direction last frame
local lastTurnAt = -math.huge
local pendingLanding: CharacterMotor.LandingInfo? = nil
local pendingLandingAt = -math.huge
local jumpStartedAt = -math.huge
local airborneSince: number? = nil
local connections: { RBXScriptConnection } = {}
local motor: CharacterMotor.CharacterMotor? = nil
local stopListening: (() -> ())? = nil

-- A landing is used within this long, even if the Humanoid still says "falling" for a frame.
local LANDING_MEMORY = 0.15
-- A tiny landing (a step down) doesn't play a landing clip.
local LAND_MIN_FALL = 2.5
local LAND_MIN_IMPACT = 30
-- A turn sharper than this (cos of the angle between move directions) while running plays SprintTurn.
local TURN_COS = math.cos(math.rad(110))
local TURN_MIN_SPEED = 16
local TURN_COOLDOWN = 0.35

local function clampRate(rate: number): number
	return math.clamp(rate, Config.MinPlaybackRate, Config.MaxPlaybackRate)
end

local function publish(name: string?)
	if character:GetAttribute("LocoAnim") ~= name then
		character:SetAttribute("LocoAnim", name)
	end
end

local function stopClip()
	if clip then
		local track = tracks[clip]
		if track then
			track:Stop(0)
		end
		clip = nil
	end
end

local function startClip(name: string): boolean
	local track = tracks[name]
	if not track then
		return false
	end
	stopClip()
	if current then
		local loopTrack = tracks[current]
		if loopTrack then
			loopTrack:Stop(0)
		end
		current = nil
	end
	clip = name
	track:Play(0, 1, 1)
	publish(name)
	return true
end

local function play(name: string?, speed: number, fresh: boolean)
	if name == current then
		local track = if name then tracks[name] else nil
		if track and track.Speed ~= speed then
			track:AdjustSpeed(speed)
		end
		return
	end

	local oldTrack = if current then tracks[current] else nil
	local newTrack = if name then tracks[name] else nil
	local phase: number? = nil
	if not fresh and oldTrack and current and name and STRIDE[current] and STRIDE[name] and oldTrack.Length > 0 then
		phase = oldTrack.TimePosition / oldTrack.Length
	end

	if oldTrack then
		oldTrack:Stop(Config.FadeTime)
	end
	current = name
	if newTrack then
		newTrack:Play(Config.FadeTime, 1, speed)
		if phase and newTrack.Length > 0 then
			newTrack.TimePosition = phase * newTrack.Length
		end
	end
	publish(name)
end

local function chooseGround(velocity: Vector3): (string, number)
	local flat = Vector3.new(velocity.X, 0, velocity.Z)
	local speed = flat.Magnitude
	if speed < Config.IdleSpeed then
		return "Idle", 1
	end

	-- Angle of travel relative to where the VISIBLE body faces: 0 = forward, +90 = right,
	-- -90 = left, +-180 = back. In shift lock the visible body is twisted toward A/D
	-- (ShiftLock's "BodyTurn"), so strafing counts as walking forward and a backward move
	-- plays the walk in reverse.
	local bodyTurn = character:GetAttribute("BodyTurn")
	local facing = root.CFrame
	if typeof(bodyTurn) == "number" then
		facing *= CFrame.Angles(0, bodyTurn, 0)
	end
	local localVelocity = facing:VectorToObjectSpace(flat)
	local angle = math.deg(math.atan2(localVelocity.X, -localVelocity.Z))
	local absAngle = math.abs(angle)

	-- In shift lock, ShiftLock decides what counts as backward (the body is turned toward the
	-- key side while backing up, so the angle alone can't tell).
	if character:GetAttribute("ShiftLock") == true then
		absAngle = if character:GetAttribute("MoveBackward") == true then 180 else 0
	end

	if character:GetAttribute("Sprinting") == true and absAngle <= 67.5 then
		return "Sprint", clampRate(speed / Config.SprintAnimSpeed)
	end

	local rate = clampRate(speed / Config.WalkAnimSpeed)
	if absAngle >= 112.5 then
		return "WalkForward", -rate
	end
	return "WalkForward", rate
end

local function choose(): (string?, number)
	local state = humanoid:GetState()
	if NO_ANIMATION_STATES[state] then
		airborneSince = nil
		return nil, 1
	end

	local velocity = root.AssemblyLinearVelocity
	local now = os.clock()

	if state == Enum.HumanoidStateType.Climbing then
		airborneSince = nil
		return "Climb", math.clamp(velocity.Y / Config.ClimbAnimSpeed, -Config.MaxPlaybackRate, Config.MaxPlaybackRate)
	end

	local airborne = state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping
	if airborne then
		airborneSince = airborneSince or now
		local sinceJump = now - jumpStartedAt
		local jumpTrack = tracks.Jump
		local jumpStillPlaying = current ~= "Jump" or (if jumpTrack then jumpTrack.IsPlaying else false)
		if sinceJump < JUMP_HOLD and jumpStillPlaying and (velocity.Y > 0 or sinceJump < 0.12) then
			return "Jump", 1
		end
		local airTime = now - (airborneSince :: number)
		if current == "Fall" or current == "Jump" or airTime >= Config.FallDelay or velocity.Y < -Config.FallSpeedThreshold then
			return "Fall", 1
		end
		-- A short drop: keep whatever was playing.
		local keep = current or lastLoop or "Idle"
		local track = tracks[keep]
		return keep, if track then track.Speed else 1
	end

	airborneSince = nil
	return chooseGround(velocity)
end

-- Which clip (if any) the change from last frame's loop to this one calls for.
local function transitionFor(loop: string?, speed: number, move: Vector3, now: number): string?
	local landing = pendingLanding
	pendingLanding = nil
	if landing and not landing.handled and character:GetAttribute("Parkour") == nil then
		if landing.fall >= LAND_MIN_FALL or landing.impact >= LAND_MIN_IMPACT then
			return if loop and MOVING[loop] then "LandRun" else "LandLight"
		end
	end
	if lastLoop == "Idle" and loop == "Sprint" then
		return "SprintStart"
	end
	if lastLoop == "Idle" and loop == "WalkForward" and speed > 0 then
		return "WalkStart"
	end
	if loop == "Sprint" and lastLoop == "Sprint" and lastSpeed >= TURN_MIN_SPEED and now - lastTurnAt > TURN_COOLDOWN then
		if move.Magnitude > 0.5 and lastMove.Magnitude > 0.5 and move.Unit:Dot(lastMove.Unit) < TURN_COS then
			lastTurnAt = now
			return "SprintTurn"
		end
	end
	return nil
end

local function step()
	if not motor then
		motor = CharacterMotor.Get(character)
		if motor then
			stopListening = motor:OnLanded(function(info: CharacterMotor.LandingInfo)
				pendingLanding = info
				pendingLandingAt = os.clock()
			end)
		end
	end

	local now = os.clock()
	local loop, speed = choose()
	local velocity = root.AssemblyLinearVelocity
	local flatSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	local move = humanoid.MoveDirection
	local grounded = loop == "Idle" or (loop ~= nil and MOVING[loop] == true)

	if pendingLanding and now - pendingLandingAt > LANDING_MEMORY then
		pendingLanding = nil
	end
	local wanted = if grounded then transitionFor(loop, speed, move, now) else nil
	if wanted then
		startClip(wanted)
	end

	local fresh = false
	if clip then
		local rule = CLIP_RULES[clip]
		local track = tracks[clip]
		local finished = track == nil or not track.IsPlaying
		local cut = not grounded
			or (rule.cutWhenMoving and loop ~= nil and MOVING[loop] == true)
			or (rule.cutWhenStopped and loop == "Idle")
		if finished or cut then
			stopClip()
			fresh = true -- a clip ends on the loop's first pose: start the loop from there
		end
	end

	lastLoop = loop
	lastSpeed = flatSpeed
	lastMove = move
	if clip then
		return
	end
	play(loop, speed, fresh)
end

table.insert(
	connections,
	humanoid.StateChanged:Connect(function(_old: Enum.HumanoidStateType, new: Enum.HumanoidStateType)
		if new == Enum.HumanoidStateType.Jumping then
			jumpStartedAt = os.clock()
			-- Restart the jump even if it was already playing (buffered / quick re-jumps).
			if current == "Jump" then
				current = nil
				local track = tracks.Jump
				if track then
					track:Stop(0)
				end
			end
		end
	end)
)

table.insert(
	connections,
	RunService.Heartbeat:Connect(function()
		local t0 = if Perf.enabled then os.clock() else 0
		step()
		if Perf.enabled then
			Perf.add("Animate", os.clock() - t0)
		end
	end)
)

local function cleanup()
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	if stopListening then
		stopListening()
		stopListening = nil
	end
	for _, track in tracks do
		track:Stop(0)
	end
end

script.Destroying:Connect(cleanup)
humanoid.Died:Connect(cleanup)
]]></ProtectedString></Properties>
			</Item>
			<Item class="LocalScript" referent="RBX322E6E054FE64052BCBA45A4F47A74FD">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<token name="RunContext">0</token>
					<string name="ScriptGuid">{158A72AD-6E54-422C-8FF5-E69E58A804CC}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">MovementController</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">02ef6e543fe1adde0acd19b0000003e8</UniqueId>
				<ProtectedString name="Source"><![CDATA[--!strict
-- MovementController (LocalScript)
-- Location: StarterPlayer > StarterCharacterScripts > MovementController
--
-- Reads player input and feeds it to this character's CharacterMotor and Dash.
-- Double-tap W: run. Space: jump; in the air press it again (or keep holding it) while moving
-- into and along a wall to wall hop; press it right before landing from a high fall to roll.
-- Sprinting into obstacles vaults / climbs / slides automatically (AutoParkour). Shift: dash.
-- Combat keys go to CombatClient (the server decides the hits): M1 (left click), M2 (right click,
-- the dagger), 1 (the sword's 1), F (hold = block, press = parry try), and the Lotus Fungus: 2 / 3 / 4
-- (stab / spore / grab of your meter stage), R (hold = heal, tap = rip out), G (the stage 3 form).
-- An attack during a side / back
-- dash, late in a landing roll or in a Moth flight cuts straight into it, keeping your momentum; a
-- front dash's (or a run's) M1 is the lunge. While the server has you stunned nothing moves you;
-- Shift while knocked down is a tech roll.
-- Left Ctrl: race special (Moth: tap = wing flight, hold = charge + throw the lantern, press while it's in
-- the air = suspend it, hold with it away = fly to it / to a tagged opponent). Race specials spend Stamina.
-- Tab: shift lock (ShiftLock script).
-- A fresh copy runs every time the character spawns.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local movementFolder = ReplicatedStorage:WaitForChild("Movement")
movementFolder:WaitForChild("CharacterMotor")
movementFolder:WaitForChild("MovementConfig")
movementFolder:WaitForChild("Dash")
movementFolder:WaitForChild("WallHop")
movementFolder:WaitForChild("LandingRoll")
movementFolder:WaitForChild("AutoParkour")
movementFolder:WaitForChild("Stamina")
movementFolder:WaitForChild("Lantern")
movementFolder:WaitForChild("Sfx")
movementFolder:WaitForChild("Controls")
local combatFolder = ReplicatedStorage:WaitForChild("Combat")
combatFolder:WaitForChild("CombatClient")

local CharacterMotor = require(ReplicatedStorage.Movement.CharacterMotor)
local Config = require(ReplicatedStorage.Movement.MovementConfig)
local Dash = require(ReplicatedStorage.Movement.Dash)
local WallHop = require(ReplicatedStorage.Movement.WallHop)
local LandingRoll = require(ReplicatedStorage.Movement.LandingRoll)
local AutoParkour = require(ReplicatedStorage.Movement.AutoParkour)
local Stamina = require(ReplicatedStorage.Movement.Stamina)
local Lantern = require(ReplicatedStorage.Movement.Lantern)
local Sfx = require(ReplicatedStorage.Movement.Sfx)
local Controls = require(ReplicatedStorage.Movement.Controls)
local CombatClient = require(ReplicatedStorage.Combat.CombatClient)

local DASH_KEYS: { [Enum.KeyCode]: boolean } = {
	[Enum.KeyCode.LeftShift] = true,
	[Enum.KeyCode.RightShift] = true,
}
local RACE_SPECIAL_KEY = Enum.KeyCode.LeftControl
local BLOCK_KEY = Enum.KeyCode.F
local ONE_KEY = Enum.KeyCode.One
-- The magic system's keys (the Lotus Fungus): 2 / 3 / 4, R, G.
local MAGIC_KEYS: { [Enum.KeyCode]: string } = {
	[Enum.KeyCode.Two] = "Two",
	[Enum.KeyCode.Three] = "Three",
	[Enum.KeyCode.Four] = "Four",
	[Enum.KeyCode.R] = "R",
	[Enum.KeyCode.G] = "G",
}

local character = script.Parent
assert(character and character:IsA("Model"), "MovementController must be in StarterCharacterScripts")

local motor = CharacterMotor.new(character)
local forwardHeld = false
local dash = Dash.new(character, motor, function()
	return forwardHeld
end)
-- Each movement is blocked while another one owns the body. Parkour is created last but looked
-- up lazily, so the earlier ones can check it too.
local parkour: AutoParkour.AutoParkour? = nil
local function parkourBusy(): boolean
	return parkour ~= nil and parkour:IsBusy()
end
-- Race specials (Moth lantern flight) own the body too; looked up lazily like parkour.
local raceSpecial: Lantern.Lantern? = nil
local function raceSpecialBusy(): boolean
	return raceSpecial ~= nil and raceSpecial:IsBusy()
end
local wallHop = WallHop.new(character, motor, function()
	return dash:IsBusy() or parkourBusy() or raceSpecialBusy()
end)
local landingRoll = LandingRoll.new(character, motor, function()
	return dash:IsBusy() or wallHop:IsRunning() or parkourBusy() or raceSpecialBusy()
end)
local autoParkour = AutoParkour.new(character, motor, function()
	-- A front dash doesn't block parkour: parkour takes it over (see the dash hook below). Nor
	-- does a wall run: a ledge in reach during it gets grabbed (wall run hook).
	return (dash:IsBusy() and not dash:IsFrontDashing()) or landingRoll:IsRolling() or raceSpecialBusy()
end)
local stamina = Stamina.new(character, motor)
local moth = Lantern.new(character, motor, stamina, function()
	return dash:IsBusy() or wallHop:IsRunning() or parkourBusy() or landingRoll:IsRolling()
end)
raceSpecial = moth
-- Getting hit (or starting an attack) stops whatever movement move is running.
local combat = CombatClient.new(character, motor, {
	interruptMovement = function()
		if dash:IsBusy() then
			dash:Cancel()
		end
		landingRoll:Cancel()
		wallHop:Cancel()
		if autoParkour:IsBusy() then
			autoParkour:Cancel()
		end
		moth:CancelCharge()
		moth:Cancel()
	end,
})
autoParkour:SetWallRunHook({
	isRunning = function()
		return wallHop:IsRunning()
	end,
	handOff = function()
		wallHop:Cancel()
	end,
})
autoParkour:SetDashHook({
	isDashing = function()
		return dash:IsFrontDashing()
	end,
	velocity = function()
		return dash:GetCurrentVelocity()
	end,
	handOff = function()
		dash:HandOff()
	end,
})
parkour = autoParkour
local connections: { RBXScriptConnection } = {}
local lastForwardTap = -math.huge
local lastDeniedAt = -math.huge

-- INPUT ----------------------------------------------------------------------
-- Every key is a named action (Controls), so the in-Studio tests press the same code the keyboard does.

-- An attack key: what it does depends on what the body is doing (see the header).
local function pressAttack(slot: string)
	if combat:IsLocked() then
		return
	end
	if moth:CancelCharge() or moth:OnM1() then
		combat:Press(slot)
		return
	end
	if dash:IsFrontDashing() then
		-- A front dash's M1 is the running lunge (other attacks just cut the dash).
		dash:CancelIntoAttack(true)
		combat:Press(slot, slot == "M1")
		return
	end
	if dash:CancelIntoAttack() or landingRoll:CancelIntoAttack() then
		combat:Press(slot)
		return
	end
	if dash:IsBusy() or landingRoll:IsRolling() or wallHop:IsRunning() or parkourBusy() then
		return
	end
	combat:Press(slot)
end

local function pressM1()
	pressAttack("M1")
end

local function pressM2()
	pressAttack("M2")
end

local function pressOne()
	pressAttack("One")
end

-- The Lotus keys (2 / 3 / 4 / G). R also needs its release (heal channel / rip-out tap).
local function magicPress(slot: string): () -> ()
	return function()
		pressAttack(slot)
	end
end

local function releaseR()
	combat:Release("R")
end

local function pressBlock()
	combat:SetBlock(true)
end

local function releaseBlock()
	combat:SetBlock(false)
end

local function pressDash()
	if combat:PressDash() then
		return -- a tech roll, or stunned
	end
	moth:CancelCharge()
	local started = dash:Request()
	if started and combat:IsAttacking() then
		combat:Cancel() -- dashing out of an attack's recovery
	end
	if not started and dash:GetCooldownRemaining() > 0.15 then
		-- Pressed while it's still recharging: a short "no" (not spammable).
		local now = os.clock()
		if now - lastDeniedAt > 0.5 then
			lastDeniedAt = now
			Sfx.Play(character, "Denied", { volume = 0.7 })
		end
	end
end

local function pressForward()
	forwardHeld = true
	local now = os.clock()
	if now - lastForwardTap <= Config.DoubleTapWindow then
		motor:SetSprinting(true)
	end
	lastForwardTap = now
end

local function releaseForward()
	forwardHeld = false
	motor:SetSprinting(false)
end

local function pressJump()
	motor:SetJumpHeld(true) -- kept even while stunned: Space held picks the launcher
	if combat:IsLocked() then
		return
	end
	if combat:TryJumpCancel() then
		return -- the launcher's follow-up jump
	end
	moth:CancelCharge()
	local madeJump = motor:RequestJump()
	wallHop:OnJumpPressed(madeJump)
	landingRoll:OnJumpPressed(madeJump)
	-- Pressed near the end of a dash or parkour move: jump right as it ends.
	dash:OnJumpPressed()
	autoParkour:OnJumpPressed()
end

local function releaseJump()
	motor:SetJumpHeld(false)
end

local function nothing() end

Controls.Register(character, {
	press = {
		Jump = pressJump,
		Dash = pressDash,
		Race = function()
			if not combat:IsLocked() then
				moth:Press()
			end
		end,
		Forward = pressForward,
		M1 = pressM1,
		M2 = pressM2,
		One = pressOne,
		Block = pressBlock,
		Two = magicPress("Two"),
		Three = magicPress("Three"),
		Four = magicPress("Four"),
		R = magicPress("R"),
		G = magicPress("G"),
	},
	release = {
		Jump = releaseJump,
		Dash = nothing,
		Race = function()
			moth:Release()
		end,
		Forward = releaseForward,
		M1 = nothing,
		M2 = nothing,
		One = nothing,
		Block = releaseBlock,
		Two = nothing,
		Three = nothing,
		Four = nothing,
		R = releaseR,
		G = nothing,
	},
})

table.insert(
	connections,
	UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
		if gameProcessed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			pressM1()
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			pressM2()
		elseif input.KeyCode == ONE_KEY then
			pressOne()
		elseif MAGIC_KEYS[input.KeyCode] then
			pressAttack(MAGIC_KEYS[input.KeyCode])
		elseif input.KeyCode == BLOCK_KEY then
			pressBlock()
		elseif DASH_KEYS[input.KeyCode] then
			pressDash()
		elseif input.KeyCode == RACE_SPECIAL_KEY then
			if not combat:IsLocked() then
				moth:Press()
			end
		elseif input.KeyCode == Enum.KeyCode.W then
			pressForward()
		elseif input.KeyCode == Enum.KeyCode.Space then
			pressJump()
		end
	end)
)

-- Releases are handled even when "gameProcessed" so a key can't get stuck (e.g. opening chat).
table.insert(
	connections,
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.W then
			releaseForward()
		elseif input.KeyCode == Enum.KeyCode.Space then
			releaseJump()
		elseif input.KeyCode == RACE_SPECIAL_KEY then
			moth:Release()
		elseif input.KeyCode == BLOCK_KEY then
			releaseBlock()
		elseif input.KeyCode == Enum.KeyCode.R then
			releaseR()
		end
	end)
)

table.insert(
	connections,
	UserInputService.WindowFocusReleased:Connect(function()
		releaseForward()
		releaseJump()
		releaseBlock()
		releaseR()
		moth:Release()
	end)
)

-- CLEANUP --------------------------------------------------------------------

local function cleanup()
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	Controls.Unregister(character)
	combat:Destroy()
	moth:Destroy()
	stamina:Destroy()
	autoParkour:Destroy()
	landingRoll:Destroy()
	wallHop:Destroy()
	dash:Destroy()
	motor:Destroy()
end

script.Destroying:Connect(cleanup)
local humanoid = character:FindFirstChildOfClass("Humanoid")
if humanoid then
	humanoid.Died:Connect(cleanup)
end
]]></ProtectedString></Properties>
