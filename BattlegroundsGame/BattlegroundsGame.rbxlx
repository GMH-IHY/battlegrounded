	}),
	lotus({
		Id = "Lotus.Grab2",
		Name = "Grab (stage 2)",
		Slot = "Four",
		Stage = 2,
		Animation = "LotusGrab",
		AnimSpeed = 16 / 20,
		Startup = 20,
		Active = 3,
		Recovery = 26,
		Damage = 10,
		Hitbox = { Size = Vector3.new(4, 5, 4), Forward = 2.5 },
		Grab = { Hold = 20, Throw = 10 },
		OnHit = { Kind = "Grab" },
		Guard = "Unparryable",
		SetMeter = 80,
		Cooldown = 10,
		CooldownGroup = "Lotus.Four",
		FollowUpReach = 2,
		Fx = { Arc = "Grab", Swing = "FungusSwing", Hit = "FungusFeast" },
	}),
	lotus({
		Id = "Lotus.Grab3",
		Name = "Grab (stage 3)",
