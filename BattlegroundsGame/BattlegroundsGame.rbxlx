]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX1E849A7C022F4F50BF63DE58BA7D56CD"><Properties><string name="Name">MoveTypes</string><ProtectedString name="Source"><![CDATA[--!strict
-- MoveTypes (ModuleScript)
-- Location: ReplicatedStorage > Combat > MoveTypes
--
-- The shape of a move's data (MoveSets > Sword, Dagger, ...). Frames are at 60 per second.
--
--   Startup / Active / Recovery   frames before the first active frame / with the hitbox out /
--                                 after it. WhiffRecovery (optional) replaces Recovery on a miss.
--   Hitbox                        Size in studs, centred Forward studs in front of the root and Up
--                                 studs above it. It follows the attacker.
--   OnHit                         Kind: Stun (Stun frames; Hang = the target hangs in the air),
--                                 Knockdown (knocked back Knockback studs), Launch (sent Launch studs
--                                 up), Spike (driven into the floor). Knockback on a Stun = pushback.
--   OnBlock                       frame advantage when blocked (+ = the attacker acts first).
--   Guard                         Normal, Unblockable (yellow flash: parry it) or Unparryable (blue
--                                 flash: can't be blocked or parried, dash out of the way).
--   Air                           only in the air; the attacker hangs while it plays.
--   Chain                         its place in the M1 chain (1-3), 0 for anything else.
--   CancelInto                    moves this one can cancel into once it has hit.
--   JumpCancel                    once it has hit, its recovery can be cut by jumping into an air move
--                                 (the launcher's follow-up).
--   Linker                        moves after it in the combo do x AfterLinker damage (CombatConfig).
--   CrossUp                       a front block only counts on its last active frame, so it can get
--                                 behind a blocker before it's decided (the lunge).
--   Motion                        Step studs forward over the startup, Lunge studs over the active
--                                 frames (the attacker's own client moves them).
--   Buildup                       status build-up on the target when it hits.
--   Fx                            the slash drawn on the active frames (CombatFx).
--
-- Magic moves (Lotus) add:
--   Magic / Stage                 which magic system and which meter stage picks it (Loadout)
--   MeterCost / MeterGain         meter spent when it starts (stage 3) / gained when it hits
--   SetMeter                      on hit the meter jumps to this (stage 2 grab)
--   WhiffPenalty                  missing it costs HP and staggers you (stage 3 moves)
--   Projectile                    fired on the first active frame instead of a hitbox: Count shots in
--                                 a Spread fan, Speed studs/s, Range studs, Radius; Ground = it runs
--                                 along the floor and only hits people on it (the stage 2 strand)
--   Grab                          on hit the target is held Hold frames, then thrown Throw studs
--   Targeted                      the hitbox erupts from the ground under the nearest airborne
--                                 opponent in front (the impale), holding them HeldFrames
--   Channel                       active frames are a channel the key's release can end (R heal)
--   AnyBlockSide                  a block stops it from any side (spores)
--   Status                        applies this status on hit ("Infested")
--   BlockStun / BlockPush         blockstun frames (projectiles, which have no attacker frames) /
--                                 pushback studs on block
--   HyperArmour                   can't be interrupted during startup
--   AnimSpeed                     plays the animation at this speed (moves sharing one animation)
--   FollowUpStun / FollowUpReach  bonus when started within FollowUpWindow of a different Lotus key
--                                 landing a hit (CombatConfig)
--   CounterStun                   hit stun on a counter-hit, replacing the usual bonus
--   RefundOnCounter               a counter-hit gives the meter cost back (stage 3 stab)

export type Guard = "Normal" | "Unblockable" | "Unparryable"
export type HitKind = "Stun" | "Knockdown" | "Launch" | "Spike" | "Grab" | "Impale" | "None"
export type Slot = "M1" | "M2" | "One" | "Two" | "Three" | "Four" | "R" | "G"
export type Arc =
	"Flat"
	| "Backhand"
	| "Overhead"
	| "Rising"
	| "Thrust"
	| "Diagonal"
	| "Stab"
	-- Lotus (CombatFx draws the fungus for these)
	| "Strand"
	| "GroundStrand"
	| "Spike"
	| "Impale"
	| "Spore"
	| "Beam"
	| "Grab"
	| "None"

export type Hitbox = { Size: Vector3, Forward: number, Up: number }
export type OnHit = { Kind: HitKind, Stun: number, Knockback: number, Launch: number, Hang: boolean }
export type Motion = { Step: number, Lunge: number }
export type Fx = { Arc: Arc, Hand: "Right" | "Left", Swing: string, Hit: string }
export type Projectile = { Speed: number, Range: number, Radius: number, Count: number, Spread: number, Ground: boolean }
export type Grab = { Hold: number, Throw: number }

export type Move = {
	Id: string,
	Name: string,
	Slot: Slot,
	Weapon: string,
	Animation: string,
	Startup: number,
	Active: number,
	Recovery: number,
	WhiffRecovery: number?,
	Damage: number,
	Hitbox: Hitbox,
	OnHit: OnHit,
	OnBlock: number,
	Guard: Guard,
	Air: boolean,
	Chain: number,
	Cooldown: number,
	CooldownGroup: string,
	CancelInto: { string },
	JumpCancel: boolean,
	Linker: boolean,
	CrossUp: boolean,
	Armour: number,
	Buildup: number,
	Hitstop: number,
	Motion: Motion,
	Fx: Fx,
	-- Magic.
	Magic: string?,
	Stage: number,
	MeterCost: number,
	MeterGain: number,
	SetMeter: number?,
	WhiffPenalty: boolean,
	Projectile: Projectile?,
	Grab: Grab?,
	Targeted: boolean,
	HeldFrames: number,
	Channel: boolean,
	AnyBlockSide: boolean,
	Status: string?,
	BlockStun: number,
	BlockPush: number,
	HyperArmour: boolean,
	AnimSpeed: number,
	FollowUpStun: number,
	FollowUpReach: number,
	CounterStun: number?,
	RefundOnCounter: boolean,
}

local MoveTypes = {}

-- Fills in the defaults, so a move set lists only what's special about each move.
function MoveTypes.Define(t: { [string]: any }): Move
	local onHit = t.OnHit or {}
	local motion = t.Motion or {}
	local fx = t.Fx or {}
	local move: Move = {
		Id = t.Id,
		Name = t.Name or t.Id,
		Slot = t.Slot,
		Weapon = t.Weapon,
		Animation = t.Animation,
		Startup = t.Startup,
		Active = t.Active,
		Recovery = t.Recovery,
		WhiffRecovery = t.WhiffRecovery,
		Damage = t.Damage,
		Hitbox = if t.Hitbox
			then { Size = t.Hitbox.Size, Forward = t.Hitbox.Forward, Up = t.Hitbox.Up or 0 }
			else { Size = Vector3.one, Forward = 0, Up = 0 },
		OnHit = {
			Kind = onHit.Kind or "Stun",
			Stun = onHit.Stun or 0,
			Knockback = onHit.Knockback or 0,
			Launch = onHit.Launch or 0,
			Hang = onHit.Hang == true,
		},
		OnBlock = t.OnBlock or 0,
		Guard = t.Guard or "Normal",
		Air = t.Air == true,
		Chain = t.Chain or 0,
		Cooldown = t.Cooldown or 0,
		CooldownGroup = t.CooldownGroup or t.Id,
		CancelInto = t.CancelInto or {},
		JumpCancel = t.JumpCancel == true,
		Linker = t.Linker == true,
		CrossUp = t.CrossUp == true,
		Armour = t.Armour or 0,
		Buildup = t.Buildup or 0,
		Hitstop = t.Hitstop or 4,
		Motion = { Step = motion.Step or 0, Lunge = motion.Lunge or 0 },
		Fx = {
			Arc = fx.Arc or "Flat",
			Hand = fx.Hand or "Right",
			Swing = fx.Swing or "SwordSwing",
			Hit = fx.Hit or "SwordHit",
		},
		Magic = t.Magic,
		Stage = t.Stage or 0,
		MeterCost = t.MeterCost or 0,
		MeterGain = t.MeterGain or 0,
		SetMeter = t.SetMeter,
		WhiffPenalty = t.WhiffPenalty == true,
		Projectile = if t.Projectile
			then {
				Speed = t.Projectile.Speed,
				Range = t.Projectile.Range,
				Radius = t.Projectile.Radius or 1,
				Count = t.Projectile.Count or 1,
				Spread = t.Projectile.Spread or 0,
				Ground = t.Projectile.Ground == true,
			}
			else nil,
		Grab = if t.Grab then { Hold = t.Grab.Hold, Throw = t.Grab.Throw } else nil,
		Targeted = t.Targeted == true,
		HeldFrames = t.HeldFrames or 0,
		Channel = t.Channel == true,
		AnyBlockSide = t.AnyBlockSide == true,
		Status = t.Status,
		BlockStun = t.BlockStun or 12,
		BlockPush = t.BlockPush or 0,
		HyperArmour = t.HyperArmour == true,
		AnimSpeed = t.AnimSpeed or 1,
		FollowUpStun = t.FollowUpStun or 0,
		FollowUpReach = t.FollowUpReach or 0,
		CounterStun = t.CounterStun,
		RefundOnCounter = t.RefundOnCounter == true,
	}
	assert(move.Id and move.Slot and move.Animation and move.Startup and move.Damage, "MoveTypes.Define: incomplete move")
	return move
end

return MoveTypes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXB11E84BC258B431BA72D96F46A0D820C"><Properties><string name="Name">Moves</string><ProtectedString name="Source"><![CDATA[--!strict
-- Moves (ModuleScript)
-- Location: ReplicatedStorage > Combat > Moves
--
-- Every move of every move set (MoveSets > *), by Id, plus the frame math both the server (hits)
-- and the attacker's client (animation, movement) use, so they agree on every phase.

local MoveTypes = require(script.Parent.MoveTypes)

export type Move = MoveTypes.Move
export type Phase = "Startup" | "Active" | "Recovery" | "Done"

local Moves = {}

local byId: { [string]: Move } = {}
local all: { Move } = {}

for _, module in script.Parent:WaitForChild("MoveSets"):GetChildren() do
	if module:IsA("ModuleScript") then
		local set = (require :: any)(module) :: { Move }
		for _, move in set do
			assert(byId[move.Id] == nil, "Moves: two moves share the id " .. move.Id)
			byId[move.Id] = move
			table.insert(all, move)
		end
	end
end
table.sort(all, function(a, b)
	return a.Id < b.Id
end)

Moves.FRAME = 1 / 60

function Moves.Get(id: string): Move?
	return byId[id]
end

function Moves.All(): { Move }
	return all
end

-- Frames from the start to the end of the move (whiff = the miss recovery).
function Moves.Total(move: Move, whiff: boolean?): number
	local recovery = if whiff and move.WhiffRecovery then move.WhiffRecovery else move.Recovery
	return move.Startup + move.Active + recovery
end

-- The phase at `frame` frames into the move (0 = the first frame).
function Moves.PhaseAt(move: Move, frame: number, whiff: boolean?): Phase
	if frame < move.Startup then
		return "Startup"
	elseif frame < move.Startup + move.Active then
		return "Active"
	elseif frame < Moves.Total(move, whiff) then
		return "Recovery"
	end
	return "Done"
end

-- The hitbox's centre for an attacker standing at `root`.
function Moves.HitboxCFrame(move: Move, root: CFrame): CFrame
	return root * CFrame.new(0, move.Hitbox.Up, -move.Hitbox.Forward)
end

return Moves
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX91C22FE1E953414A9F464EC6CFF373AE"><Properties><string name="Name">Reactions</string><ProtectedString name="Source"><![CDATA[--!strict
-- Reactions (ModuleScript)
-- Location: ReplicatedStorage > Combat > Reactions
--
-- How a character reacts to what the server says happened to it: the hit stun flinch, being
-- pushed back, hanging in the air, launched, knocked down, spiked, blocking a hit, parrying,
-- getting parried, lying on the floor and getting up, and the Lotus ones: held by a grab or an
-- impale, wrapped in growth (Infested), consumed by your own missed stage 3 move. It runs where the character's physics and
-- animations are owned: the player's own client (CombatClient) or the server for a dummy.
--
--   reactions:React(info)   the server's Hit message (HitResolver builds it)
-- It also follows the character's "CombatState" and "Guard" attributes (set by the server): the
-- block pose while the guard is up, Downed / GetUp / TechRoll, and letting go of the body when a
-- stun ends.
-- Every reaction first holds still for the hit pause (info.hitstop), then moves.

local CombatBody = require(script.Parent.CombatBody)
local CombatAnimator = require(script.Parent.CombatAnimator)

local Reactions = {}
Reactions.__index = Reactions

-- Reaction animations that end when the stun ends.
local STUN_ANIMS = { "HitStun1", "HitStun2", "HitAir", "BlockImpact", "Parried", "Launched", "LotusHeld", "LotusConsumed" }

type Data = {
	character: Model,
	humanoid: Humanoid,
	root: BasePart,
	body: CombatBody.CombatBody,
	anim: CombatAnimator.CombatAnimator,
	version: number,
	lastState: string,
	connections: { RBXScriptConnection },
	-- Called when a reaction starts (the owner cancels its own move, dash, etc.).
	onInterrupt: (() -> ())?,
}

export type Reactions = typeof(setmetatable({} :: Data, Reactions))

function Reactions.new(character: Model, body: CombatBody.CombatBody, anim: CombatAnimator.CombatAnimator, onInterrupt: (() -> ())?): Reactions
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	local root = character:WaitForChild("HumanoidRootPart") :: BasePart
	local self = setmetatable({
		character = character,
		humanoid = humanoid,
		root = root,
		body = body,
		anim = anim,
		version = 0,
		lastState = "Idle",
		connections = {},
		onInterrupt = onInterrupt,
	} :: Data, Reactions)
	table.insert(self.connections, character:GetAttributeChangedSignal("CombatState"):Connect(function()
		self:_onState()
	end))
	table.insert(self.connections, character:GetAttributeChangedSignal("Guard"):Connect(function()
		self.anim:Hold("BlockHold", character:GetAttribute("Guard") == true)
	end))
	return self
end

local function airborne(humanoid: Humanoid): boolean
	local state = humanoid:GetState()
	return state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping
end

-- After the hit pause, unless a newer reaction replaced this one.
function Reactions._after(self: Reactions, seconds: number, fn: () -> ())
	local version = self.version
	if seconds <= 0 then
		fn()
		return
	end
	task.delay(seconds, function()
		if self.version == version then
			fn()
		end
	end)
end

function Reactions.React(self: Reactions, info: { [string]: any })
	local kind = info.kind
	local hitstop = if typeof(info.hitstop) == "number" then info.hitstop else 0
	local velocity: Vector3 = if typeof(info.velocity) == "Vector3" then info.velocity else Vector3.zero
	if kind == "Parry" then
		self.anim:Play("Parry")
		return
	end
	if kind == "Armour" then
		self.anim:Freeze(hitstop)
		return
	end
	self.version += 1
	if self.onInterrupt then
		self.onInterrupt()
	end
	local body = self.body
	-- Hold still through the hit pause.
	if hitstop > 0 then
		body:Hang(hitstop)
	end

	if kind == "Stun" then
		local hang = info.hang == true or airborne(self.humanoid)
		self.anim:Play(if hang then "HitAir" else (if typeof(info.anim) == "string" then info.anim else "HitStun1"))
		self.anim:Freeze(hitstop)
		local stun = if typeof(info.stun) == "number" then info.stun else 0.25
		self:_after(hitstop, function()
			if hang then
				body:Hang(stun, Vector3.new(velocity.X, 0, velocity.Z) * 0.15)
			else
				body:Push(velocity, if typeof(info.push) == "number" then info.push else 0.15, true)
			end
		end)
	elseif kind == "Block" then
		self.anim:Hold("BlockHold", true)
		self.anim:Play("BlockImpact")
		self:_after(hitstop, function()
			body:Push(velocity, if typeof(info.push) == "number" then info.push else 0.15, true)
		end)
	elseif kind == "Parried" then
		self.anim:Play("Parried")
		body:Push(-self.root.CFrame.LookVector * 10, 0.2, true)
	elseif kind == "Launch" then
		self.anim:Play("Launched")
		self.anim:Freeze(hitstop)
		local stun = if typeof(info.stun) == "number" then info.stun else 0.8
		self:_after(hitstop, function()
			-- Straight up, and no steering while helpless (the flat velocity is held at 0).
			body:Launch(velocity, stun)
		end)
	elseif kind == "Knockdown" or kind == "Spike" then
		self.anim:Play("Knockback")
		self.anim:Freeze(hitstop)
		self:_after(hitstop, function()
			body:Launch(velocity, 0.05)
			-- Keep flying the same way until the landing (the server says Downed).
			body:Push(Vector3.new(velocity.X, 0, velocity.Z), 3)
		end)
	elseif kind == "Downed" then
		self.anim:Freeze(hitstop)
	elseif kind == "Held" then
		-- Caught by a grab or an impale: held still until the server throws / drops them.
		self.anim:Play("LotusHeld")
		local hold = if typeof(info.stun) == "number" then info.stun else 0.5
		self:_after(hitstop, function()
			body:Hang(hold)
		end)
	elseif kind == "Wrapped" then
		-- Infested and caught blocking a Lotus move: wrapped in growth, down on the spot.
		body:Release()
		self.anim:Play("Downed")
	elseif kind == "Consumed" then
		-- Your own stage 3 move missed: the fungus bites back.
		body:Release()
		self.anim:Play("LotusConsumed")
	end
end

-- Follows the server's state for the character.
function Reactions._onState(self: Reactions)
	local state = self.character:GetAttribute("CombatState")
	local was = self.lastState
	self.lastState = if typeof(state) == "string" then state else "Idle"
	if state == "Downed" then
		self.body:Release()
		self.anim:Play("Downed")
	elseif state == "TechRoll" then
		self.anim:Play("TechRoll")
	elseif state == "Idle" or state == "Blocking" or state == "Attacking" then
		if was == "Downed" then
			self.anim:Play("GetUp")
		elseif was ~= "TechRoll" then
			for _, name in STUN_ANIMS do
				self.anim:StopMove(name)
			end
		end
		if was == "Stunned" or was == "Launched" or was == "Parried" or was == "Blockstun" or was == "Knockdown" or was == "Held" then
			self.body:Release()
		end
	end
end

function Reactions.Destroy(self: Reactions)
	for _, connection in self.connections do
		connection:Disconnect()
	end
	table.clear(self.connections)
end

return Reactions
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX67EFAF17EE8A4D92B14DE659CEC882B3"><Properties><string name="Name">WeaponModels</string><ProtectedString name="Source"><![CDATA[--!strict
-- WeaponModels (ModuleScript)
-- Location: ReplicatedStorage > Combat > WeaponModels
--
-- Builds the sword and the dagger out of parts (data: WeaponModelsData, generated by
-- tools/models/weapons.py) and puts them on an R6 character. Call Attach on the SERVER so everyone
-- sees them:  WeaponModels.Attach(character)
--
--   Right Arm > SwordGrip   an invisible bone on a Motor6D (a wrist): animations key it to turn the
--                           blade. Unkeyed, the blade points along the arm's forward.
--   Torso > Sheath          the scabbard on the left hip.
--   Dagger                  welded to the hip (sheathed) or to the left hand (drawn). Drawing is a
--                           local change each client makes itself (SetDaggerDrawn): CombatClient
--                           for your own character right away, CombatFx for everyone else's.
-- Every piece is massless, never collides and can't be hit, so weapons don't change movement or
-- hitboxes.

local Data = require(script.Parent.WeaponModelsData)

local WeaponModels = {}

local FOLDER = "Weapons"

local function quiet(part: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
end

local function makeRoot(name: string, cframe: CFrame, parent: Instance): Part
	local root = Instance.new("Part")
	root.Name = name
	root.Size = Vector3.new(0.2, 0.2, 0.2)
	root.Transparency = 1
	quiet(root)
	root.CFrame = cframe
	root.Parent = parent
	return root
end

local function build(group: string, root: BasePart, parent: Instance)
	for _, spec in Data.Parts do
		if spec.Bone == group then
			local part = Instance.new("Part")
			part.Name = group .. spec.Name
			part.Size = spec.Size
			part.Color = spec.Color
			part.Material = spec.Material
			quiet(part)
			part.CFrame = root.CFrame * spec.CFrame
			local weld = Instance.new("Weld")
			weld.Part0 = root
			weld.Part1 = part
			weld.C0 = spec.CFrame
			weld.Parent = part
			part.Parent = parent
		end
	end
end

local function limb(character: Model, name: string): BasePart
	local part = character:FindFirstChild(name)
	assert(part and part:IsA("BasePart"), "WeaponModels: character has no " .. name)
	return part
end

function WeaponModels.Detach(character: Model)
	local old = character:FindFirstChild(FOLDER)
	if old then
		old:Destroy()
	end
	for _, joint in Data.Joints do
		local part0 = character:FindFirstChild(joint.Part0)
		local motor = part0 and part0:FindFirstChild(joint.Name)
		if motor and motor:IsA("Motor6D") then
			motor:Destroy()
		end
	end
end

function WeaponModels.Attach(character: Model): Model
	WeaponModels.Detach(character)
	local model = Instance.new("Model")
	model.Name = FOLDER

	-- The sword on its animated grip bone.
	for _, joint in Data.Joints do
		local part0 = limb(character, joint.Part0)
		local bone = makeRoot(joint.Name, part0.CFrame * joint.C0, model)
		local motor = Instance.new("Motor6D")
		motor.Name = joint.Name
		motor.Part0 = part0
		motor.Part1 = bone
		motor.C0 = joint.C0
		motor.Parent = part0 -- like the other R6 joints, so the Animator finds it
		build(joint.Name, bone, model)
	end

	-- The scabbard, and the dagger sheathed in it.
	for _, name in { "Sheath", "Dagger" } do
		local mount = Data.Mounts[if name == "Dagger" then "DaggerHip" else name]
		local part0 = limb(character, mount.Part0)
		local root = makeRoot(name .. "Root", part0.CFrame * mount.C0, model)
		local weld = Instance.new("Weld")
		weld.Name = "Mount"
		weld.Part0 = part0
		weld.Part1 = root
		weld.C0 = mount.C0
		weld.Parent = root
		build(name, root, model)
	end

	model.Parent = character
	return model
end

-- Moves the dagger between the hip and the left hand, on this machine only.
function WeaponModels.SetDaggerDrawn(character: Model, drawn: boolean)
	local model = character:FindFirstChild(FOLDER)
	local root = model and model:FindFirstChild("DaggerRoot")
	local weld = root and root:FindFirstChild("Mount")
	if not (weld and weld:IsA("Weld")) then
		return
	end
	local mount = Data.Mounts[if drawn then "DaggerHand" else "DaggerHip"]
	local part0 = character:FindFirstChild(mount.Part0)
	if part0 and part0:IsA("BasePart") and (weld.Part0 ~= part0 or weld.C0 ~= mount.C0) then
		weld.Part0 = part0
		weld.C0 = mount.C0
	end
end

return WeaponModels
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXA348C1E27D3343FA9B8DD97E59FF8762"><Properties><string name="Name">WeaponModelsData</string><ProtectedString name="Source"><![CDATA[--!strict
-- WeaponModelsData (ModuleScript, ReplicatedStorage > Combat > WeaponModelsData)
-- GENERATED by tools/models/weapons.py. Don't edit by hand: change the script and rerun it.
-- Joints: animated bone Motor6Ds (C0 relative to Part0). Mounts: weld frames the dagger and
-- sheath are attached with. Parts: CFrame relative to their group's frame (Bone = the group).

export type Joint = { Name: string, Part0: string, C0: CFrame }
export type PartSpec = { Bone: string, Name: string, Class: string, Shape: string, Size: Vector3, CFrame: CFrame, Color: Color3, Material: Enum.Material, Texture: string }

local Joints: { Joint } = {
	{ Name = "SwordGrip", Part0 = "Right Arm", C0 = CFrame.new(0.00000, -0.80000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, -0.42262, 0.90631, 0.00000, -0.90631, -0.42262) },
}

local Mounts: { [string]: Joint } = {
	DaggerHand = { Name = "DaggerHand", Part0 = "Left Arm", C0 = CFrame.new(0.00000, -0.80000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, -0.42262, 0.90631, 0.00000, -0.90631, -0.42262) },
	DaggerHip = { Name = "DaggerHip", Part0 = "Torso", C0 = CFrame.new(-1.12000, -0.45000, 0.10000, 1.00000, 0.00000, 0.00000, 0.00000, -0.96593, -0.25882, 0.00000, 0.25882, -0.96593) },
	Sheath = { Name = "Sheath", Part0 = "Torso", C0 = CFrame.new(-1.12000, -0.45000, 0.10000, 1.00000, 0.00000, 0.00000, 0.00000, -0.96593, -0.25882, 0.00000, 0.25882, -0.96593) },
}

local Parts: { PartSpec } = {
	{ Bone = "SwordGrip", Name = "Grip", Class = "Part", Shape = "Block", Size = Vector3.new(0.2400, 0.8000, 0.2400), CFrame = CFrame.new(0.00000, 0.05000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000), Color = Color3.fromRGB(92, 60, 40), Material = Enum.Material.SmoothPlastic, Texture = "" },
	{ Bone = "SwordGrip", Name = "Pommel", Class = "Part", Shape = "Block", Size = Vector3.new(0.3400, 0.3000, 0.3400), CFrame = CFrame.new(0.00000, -0.45000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000), Color = Color3.fromRGB(70, 72, 80), Material = Enum.Material.SmoothPlastic, Texture = "" },
	{ Bone = "SwordGrip", Name = "Guard", Class = "Part", Shape = "Block", Size = Vector3.new(1.1000, 0.2000, 0.3000), CFrame = CFrame.new(0.00000, 0.55000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000), Color = Color3.fromRGB(70, 72, 80), Material = Enum.Material.SmoothPlastic, Texture = "" },
	{ Bone = "SwordGrip", Name = "Blade", Class = "Part", Shape = "Block", Size = Vector3.new(0.4200, 3.0000, 0.1000), CFrame = CFrame.new(0.00000, 2.15000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000), Color = Color3.fromRGB(200, 204, 210), Material = Enum.Material.SmoothPlastic, Texture = "" },
	{ Bone = "SwordGrip", Name = "Fuller", Class = "Part", Shape = "Block", Size = Vector3.new(0.1400, 2.5000, 0.1200), CFrame = CFrame.new(0.00000, 2.00000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000), Color = Color3.fromRGB(140, 146, 156), Material = Enum.Material.SmoothPlastic, Texture = "" },
	{ Bone = "SwordGrip", Name = "Tip", Class = "Part", Shape = "Block", Size = Vector3.new(0.3000, 0.3000, 0.1000), CFrame = CFrame.new(0.00000, 3.65000, 0.00000, 0.70711, -0.70711, 0.00000, 0.70711, 0.70711, 0.00000, 0.00000, 0.00000, 1.00000), Color = Color3.fromRGB(200, 204, 210), Material = Enum.Material.SmoothPlastic, Texture = "" },
	{ Bone = "Dagger", Name = "Grip", Class = "Part", Shape = "Block", Size = Vector3.new(0.2000, 0.5500, 0.2000), CFrame = CFrame.new(0.00000, 0.00000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000), Color = Color3.fromRGB(58, 38, 28), Material = Enum.Material.SmoothPlastic, Texture = "" },
	{ Bone = "Dagger", Name = "Pommel", Class = "Part", Shape = "Block", Size = Vector3.new(0.2600, 0.2000, 0.2600), CFrame = CFrame.new(0.00000, -0.33000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000), Color = Color3.fromRGB(70, 72, 80), Material = Enum.Material.SmoothPlastic, Texture = "" },
	{ Bone = "Dagger", Name = "Guard", Class = "Part", Shape = "Block", Size = Vector3.new(0.5000, 0.1000, 0.2000), CFrame = CFrame.new(0.00000, 0.32000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000), Color = Color3.fromRGB(70, 72, 80), Material = Enum.Material.SmoothPlastic, Texture = "" },
	{ Bone = "Dagger", Name = "Blade", Class = "Part", Shape = "Block", Size = Vector3.new(0.2800, 1.0000, 0.0700), CFrame = CFrame.new(0.00000, 0.87000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000), Color = Color3.fromRGB(200, 204, 210), Material = Enum.Material.SmoothPlastic, Texture = "" },
	{ Bone = "Dagger", Name = "Tip", Class = "Part", Shape = "Block", Size = Vector3.new(0.2000, 0.2000, 0.0700), CFrame = CFrame.new(0.00000, 1.37000, 0.00000, 0.70711, -0.70711, 0.00000, 0.70711, 0.70711, 0.00000, 0.00000, 0.00000, 1.00000), Color = Color3.fromRGB(200, 204, 210), Material = Enum.Material.SmoothPlastic, Texture = "" },
	{ Bone = "Sheath", Name = "Scabbard", Class = "Part", Shape = "Block", Size = Vector3.new(0.3600, 1.2000, 0.1600), CFrame = CFrame.new(0.00000, 0.85000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000), Color = Color3.fromRGB(92, 60, 40), Material = Enum.Material.SmoothPlastic, Texture = "" },
}

return { Joints = Joints, Mounts = Mounts, Parts = Parts }
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXAF12F547D8004CBCB78ADC7BFCA6B0D8"><Properties><string name="Name">FighterCollision</string><ProtectedString name="Source"><![CDATA[--!strict
-- FighterCollision (ModuleScript)
-- Location: ReplicatedStorage > Combat > FighterCollision
--
-- Puts every part of a character in the "Fighters" collision group (registered by the
-- CollisionGroups script): fighters pass through each other but not through the world. Parts
-- added later (colliders movement creates) join too. A part another system moved to its own group
-- (the parkour slide) is left alone.

local PhysicsService = game:GetService("PhysicsService")

local GROUP = "Fighters"

local FighterCollision = {}

local function join(part: Instance)
	if part:IsA("BasePart") and part.CollisionGroup == "Default" then
		part.CollisionGroup = GROUP
	end
end

function FighterCollision.Apply(character: Model)
	local ok, registered = pcall(function()
		return PhysicsService:IsCollisionGroupRegistered(GROUP)
	end)
	if not (ok and registered) then
		return
	end
	for _, descendant in character:GetDescendants() do
		join(descendant)
	end
	character.DescendantAdded:Connect(join)
end

return FighterCollision
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7601F67A07194140966284566DFCBA97"><Properties><string name="Name">FungusData</string><ProtectedString name="Source"><![CDATA[--!strict
-- FungusData (ModuleScript, ReplicatedStorage > Combat > FungusData)
-- GENERATED by tools/models/fungus.py. Don't edit by hand: change the script and rerun it.
-- The Lotus Fungus growth: every piece, the limb it grows on (CFrame relative to that limb) and
-- the meter stage it appears at.

