-- FungusParts (ModuleScript)
-- Location: ReplicatedStorage > Combat > FungusParts
--
-- The Lotus Fungus growing on a character (data: FungusData, generated by tools/models/fungus.py).
-- The SERVER builds it once (Attach) and shows the pieces of the current meter stage and below
-- (SetStage); the change replicates, so the growth snaps from stage to stage for everyone, never
-- swelling smoothly (docs/art/ArtDirection.md). The hand always stays bare.
-- Every piece is massless, never collides and can't be hit.

local Data = require(script.Parent.FungusData)

local FungusParts = {}

local FOLDER = "Fungus"
local GLOW = Color3.fromRGB(16, 152, 168)
local GLOW_FORM = Color3.fromRGB(90, 230, 240)

local function quiet(part: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
end

function FungusParts.Attach(character: Model): Model
	local old = character:FindFirstChild(FOLDER)
	if old then
		old:Destroy()
	end
	local model = Instance.new("Model")
	model.Name = FOLDER
	for i, spec in Data.Parts do
		local limb = character:FindFirstChild(spec.Limb)
		if limb and limb:IsA("BasePart") then
			local part = Instance.new("Part")
			part.Name = string.format("%s%d", spec.Name, i)
			part.Shape = if spec.Shape == "Ball" then Enum.PartType.Ball else Enum.PartType.Block
			part.Size = spec.Size
			part.Color = spec.Color
			part.Material = if spec.Neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
			quiet(part)
			part.CFrame = limb.CFrame * spec.CFrame
			part.Transparency = 1
			part:SetAttribute("Stage", spec.Stage)
			part:SetAttribute("Glow", spec.Neon)
			local weld = Instance.new("Weld")
			weld.Part0 = limb
			weld.Part1 = part
			weld.C0 = spec.CFrame
			weld.Parent = part
			part.Parent = model
		end
	end
	model:SetAttribute("Stage", 0)
	model.Parent = character
	return model
end

-- Shows the growth of `stage` (0 = none) and below. form = the stage 3 form: the glowing specks
-- burn brighter.
function FungusParts.SetStage(character: Model, stage: number, form: boolean?)
	local model = character:FindFirstChild(FOLDER)
	if not model then
		return
	end
	local key = stage + (if form then 10 else 0)
	if model:GetAttribute("Stage") == key then
		return
	end
	model:SetAttribute("Stage", key)
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") then
			local partStage = part:GetAttribute("Stage")
			local shown = typeof(partStage) == "number" and partStage <= stage
			part.Transparency = if shown then 0 else 1
			if part:GetAttribute("Glow") == true then
				part.Color = if form then GLOW_FORM else GLOW
			end
		end
	end
end

return FungusParts
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX793B8D22697C4F4CA93C45DAE0D0195B"><Properties><string name="Name">FxPieces</string><ProtectedString name="Source"><![CDATA[--!strict
-- FxPieces (ModuleScript)
-- Location: ReplicatedStorage > Combat > FxPieces
--
-- Stepped effect parts for client effect scripts (LotusFx): a part goes through a list of steps
-- (CFrame / size / transparency), one per FX step (Rate per second), then disappears. Nothing
-- tweens: every change is a snap, like the animations (docs/art/ArtDirection.md). Parts are pooled.
--   FxPieces.Piece(color, steps, neon?, shape?)   start one; returns a handle
--   FxPieces.Stop(handle)                          end it at the next step
--   FxPieces.Rate                                   steps per second

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

export type Step = { cframe: CFrame?, size: Vector3?, transparency: number? }

type Piece = { part: Part, steps: { Step }, index: number }
export type Handle = Piece

local FxPieces = {}
FxPieces.Rate = 20

local folder: Folder? = nil
local pool: { Part } = {}
local pieces: { Piece } = {}

local function holder(): Folder
	local existing = folder
	if existing and existing.Parent then
		return existing
	end
	local created = Instance.new("Folder")
	created.Name = "FxPieces"
	created.Parent = Workspace
	folder = created
	return created
end

local function take(): Part
	local part = table.remove(pool)
	if part then
		return part
	end
	local fresh = Instance.new("Part")
	fresh.Anchored = true
	fresh.CanCollide = false
	fresh.CanQuery = false
	fresh.CanTouch = false
	fresh.CastShadow = false
	fresh.TopSurface = Enum.SurfaceType.Smooth
	fresh.BottomSurface = Enum.SurfaceType.Smooth
	return fresh
end

function FxPieces.Piece(color: Color3, steps: { Step }, neon: boolean?, shape: Enum.PartType?): Handle?
	if #steps == 0 then
		return nil
	end
	local part = take()
	part.Shape = shape or Enum.PartType.Block
	part.Color = color
	part.Material = if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
	local first = steps[1]
	part.CFrame = first.cframe or CFrame.identity
	part.Size = first.size or Vector3.one
	part.Transparency = first.transparency or 0
	part.Parent = holder()
	local piece = { part = part, steps = steps, index = 1 }
	table.insert(pieces, piece)
	return piece
end

function FxPieces.Stop(handle: Handle)
	handle.index = #handle.steps
end

local function step()
	for i = #pieces, 1, -1 do
		local p = pieces[i]
		p.index += 1
		local s = p.steps[p.index]
		if not s then
			p.part.Parent = nil
			table.insert(pool, p.part)
			table.remove(pieces, i)
		else
			if s.cframe then
				p.part.CFrame = s.cframe
			end
			if s.size then
				p.part.Size = s.size
			end
			if s.transparency then
				p.part.Transparency = s.transparency
			end
		end
	end
end

local accumulator = 0
RunService.Heartbeat:Connect(function(dt: number)
	accumulator += dt
	local interval = 1 / FxPieces.Rate
	if accumulator >= interval then
		accumulator %= interval
		step()
	end
end)

return FxPieces
]]></ProtectedString></Properties></Item></Item></Item>
	<Item class="ServerScriptService" referent="RBX51B39FA96D324B598976D134CE9C7262">
