		Hitstop = 7,
		Fx = { Arc = "Impale", Swing = "FungusHeavy", Hit = "FungusHitHeavy" },
	}),

	-- 3: SPORE -------------------------------------------------------------------------------------
	lotus({
		Id = "Lotus.Spore1",
		Name = "Spore (stage 1)",
		Slot = "Three",
		Stage = 1,
		Animation = "LotusSporeFlick",
