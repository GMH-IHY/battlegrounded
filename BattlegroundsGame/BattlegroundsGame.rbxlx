	<Item class="Folder" referent="RBXD0FFBB2796804853B9A0AD8C4AC06083"><Properties><string name="Name">Combat</string></Properties><Item class="ModuleScript" referent="RBX40D5AC39929246DCBADED28E0A70C3F0"><Properties><string name="Name">Dummies</string><ProtectedString name="Source"><![CDATA[--!strict
-- Dummies (ModuleScript)
-- Location: ServerScriptService > Combat > Dummies
--
-- Training dummies: R6 fighters the server runs itself (its own physics and animations), in
-- Workspace > TrainingDummies. Each has a mode (attribute "DummyMode"; the Studio test panel can
-- change it):
--   Stand          takes hits
--   Block          always blocking
--   BlockAfterHit  blocks as soon as it can after being hit: it shows the M1 gap (M1 2 gets
--                  blocked) and that a blocked M1 3 is your turn to lose
--   Parry          parries anything it sees coming (one try per parry lockout)
--   Attack         walks nothing, but swings the M1 chain at anyone close, over and over
-- Health comes back DummyResetTime seconds after the last hit; they never die. A label over each
-- shows its mode, state and the last combo (hits, damage).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Combat = ReplicatedStorage:WaitForChild("Combat")
local Config = require(Combat:WaitForChild("CombatConfig"))
local CombatBody = require(Combat:WaitForChild("CombatBody"))
local CombatAnimator = require(Combat:WaitForChild("CombatAnimator"))
local Reactions = require(Combat:WaitForChild("Reactions"))
local WeaponModels = require(Combat:WaitForChild("WeaponModels"))
local FighterCollision = require(Combat:WaitForChild("FighterCollision"))
local Fighter = require(script.Parent:WaitForChild("Fighter"))

type Fighter = Fighter.Fighter

local FRAME = 1 / Config.FPS

export type Dummy = {
	name: string,
	home: CFrame,
	model: Model,
	fighter: Fighter,
	body: CombatBody.CombatBody,
	anim: CombatAnimator.CombatAnimator,
	reactions: Reactions.Reactions,
	label: TextLabel,
	lastRun: string?,
	nextAttack: number,
	chainLeft: number,
	parryRelease: number,
	shownHits: number,
	shownDamage: number,
}

local Dummies = {}

-- name -> (mode, position). They face -X, toward someone walking in from the course.
local LAYOUT = {
	{ name = "DummyStand", mode = "Stand", position = Vector3.new(80, 3, 40) },
	{ name = "DummyBlock", mode = "Block", position = Vector3.new(80, 3, 52) },
	{ name = "DummyBlockAfterHit", mode = "BlockAfterHit", position = Vector3.new(80, 3, 64) },
	{ name = "DummyParry", mode = "Parry", position = Vector3.new(80, 3, 76) },
	{ name = "DummyAttack", mode = "Attack", position = Vector3.new(80, 3, 88) },
}
Dummies.Modes = { "Stand", "Block", "BlockAfterHit", "Parry", "Attack" }

local COLORS = {
	Head = Color3.fromRGB(196, 170, 120),
	Torso = Color3.fromRGB(150, 118, 78),
	Limbs = Color3.fromRGB(176, 146, 100),
}

local list: { Dummy } = {}
local folder: Folder? = nil

local function build(name: string, cframe: CFrame): Model
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = COLORS.Head
	description.TorsoColor = COLORS.Torso
	description.LeftArmColor = COLORS.Limbs
	description.RightArmColor = COLORS.Limbs
	description.LeftLegColor = COLORS.Limbs
	description.RightLegColor = COLORS.Limbs
	local model = Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R6)
	model.Name = name
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.BreakJointsOnDeath = false
	humanoid.AutoRotate = false
	model:PivotTo(cframe)
	model:SetAttribute("Race", "None")
	model:SetAttribute("Element", "Wind")
	return model
end

local function makeLabel(model: Model): TextLabel
	local head = model:FindFirstChild("Head") :: BasePart
	local gui = Instance.new("BillboardGui")
	gui.Name = "DummyLabel"
	gui.Size = UDim2.fromOffset(220, 44)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 60
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Arcade
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.Parent = gui
	gui.Parent = head
	return label
end

function Dummies.Spawn(hooks: Fighter.Hooks, register: (Model, Fighter) -> ()): { Dummy }
	local holder = Instance.new("Folder")
	holder.Name = "TrainingDummies"
	holder.Parent = Workspace
	folder = holder
	for _, spec in LAYOUT do
		local home = CFrame.lookAlong(spec.position, -Vector3.xAxis)
		local model = build(spec.name, home)
		model:SetAttribute("DummyMode", spec.mode)
		model.Parent = holder
		WeaponModels.Attach(model)
		FighterCollision.Apply(model)
		local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
		root:SetNetworkOwner(nil)
		local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
		local fighter = Fighter.new(model, nil, hooks)
		local body = CombatBody.new(model, nil)
		local anim = CombatAnimator.new(humanoid)
		local dummy: Dummy = {
			name = spec.name,
			home = home,
			model = model,
			fighter = fighter,
			body = body,
			anim = anim,
			reactions = Reactions.new(model, body, anim),
			label = makeLabel(model),
			lastRun = nil,
			nextAttack = 0,
			chainLeft = 0,
			parryRelease = 0,
			shownHits = 0,
			shownDamage = 0,
		}
		table.insert(list, dummy)
		register(model, fighter)
	end
	return list
end

function Dummies.Get(name: string): Dummy?
	for _, dummy in list do
		if dummy.name == name then
			return dummy
		end
	end
	return nil
end

function Dummies.All(): { Dummy }
	return list
end

-- Back to full health, home, neutral.
function Dummies.Reset(dummy: Dummy)
	local fighter = dummy.fighter
	fighter:Interrupt()
	fighter:SetState("Idle")
	fighter:SetBlock(false)
	fighter.combo = { hits = 0, launches = 0, afterLinker = false, damage = 0 }
	fighter:SetStamina(Config.StaminaMax)
	fighter.buildup = 0
	fighter.draftedUntil = 0
	fighter.parryLockUntil = 0
	fighter:SetMeter(0)
	fighter.formActive = false
	fighter.infestedUntil = 0
	dummy.body:Release()
	dummy.anim:Stop()
	dummy.shownHits, dummy.shownDamage = 0, 0
	dummy.chainLeft = 0
	dummy.nextAttack = os.clock() + 0.5
	fighter.humanoid.Health = fighter.humanoid.MaxHealth
	dummy.model:PivotTo(dummy.home)
	fighter.root.AssemblyLinearVelocity = Vector3.zero
end

-- The nearest living player character within `range`, and its fighter.
local function nearestPlayer(dummy: Dummy, range: number, fighterOf: (Model) -> Fighter?): Fighter?
	local best: Fighter? = nil
	local bestDistance = range
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local other = if character then fighterOf(character) else nil
		if other and other.humanoid.Health > 0 then
			local distance = (other.root.Position - dummy.fighter.root.Position).Magnitude
			if distance < bestDistance then
				best, bestDistance = other, distance
			end
		end
	end
	return best
end

local function think(dummy: Dummy, now: number, fighterOf: (Model) -> Fighter?)
	local fighter = dummy.fighter
	local mode = dummy.model:GetAttribute("DummyMode")
	if mode == "Block" then
		fighter:SetBlock(true)
	elseif mode == "BlockAfterHit" then
		fighter:SetBlock(now - fighter.lastHitAt < 1.2)
	elseif mode == "Parry" then
		if fighter.blockHeld and now >= dummy.parryRelease then
			fighter:SetBlock(false)
		end
		if not fighter.blockHeld and not fighter:IsLocked() then
			-- Someone near is about to hit: press F so the window covers their first active frame.
			for _, player in Players:GetPlayers() do
				local character = player.Character
				local other = if character then fighterOf(character) else nil
				local run = other and other.run
				if other and run and (other.root.Position - fighter.root.Position).Magnitude < 14 then
					local untilActive = run.move.Startup - other:MoveFrame()
					if untilActive >= 0 and untilActive <= 3 then
						fighter:SetBlock(true)
						dummy.parryRelease = now + 8 * FRAME
						break
					end
				end
			end
		end
	elseif mode == "Attack" then
		fighter:SetBlock(false)
		local target = nearestPlayer(dummy, 9, fighterOf)
		if target and fighter.state == "Idle" and now >= dummy.nextAttack then
			local toward = target.root.Position - fighter.root.Position
			local flat = Vector3.new(toward.X, 0, toward.Z)
			if flat.Magnitude > 0.1 then
				fighter.root.CFrame = CFrame.lookAlong(fighter.root.Position, flat.Unit)
			end
			if dummy.chainLeft <= 0 then
				dummy.chainLeft = 3
			end
			local chain = 4 - dummy.chainLeft
			local id = if chain == 1 then "Sword.M1_1" elseif chain == 2 then "Sword.M1_2" else "Sword.M1_3"
			if fighter:RequestMove(id, 0) == "" then
				dummy.chainLeft -= 1
				dummy.nextAttack = if dummy.chainLeft <= 0 then now + 1.6 else now
			else
				dummy.chainLeft = 0
			end
		end
	else
		fighter:SetBlock(false)
	end
end

-- Every frame, after the fighters stepped.
function Dummies.Step(now: number, fighterOf: (Model) -> Fighter?)
	for _, dummy in list do
		local fighter = dummy.fighter
		think(dummy, now, fighterOf)
		-- Play the move the server started for it.
		local run = fighter.run
		if run then
			local key = run.move.Id .. ":" .. tostring(run)
			if dummy.lastRun ~= key then
				dummy.lastRun = key
				dummy.anim:Play(run.move.Animation)
				-- The move's step forward (players' clients do this for themselves).
				local step = run.move.Motion.Step
				if step > 0 then
					local seconds = math.max(run.move.Startup, 1) * FRAME
					local look = fighter.root.CFrame.LookVector
					dummy.body:Push(Vector3.new(look.X, 0, look.Z).Unit * (step / seconds), seconds)
				end
			end
		else
			dummy.lastRun = nil
		end
		if fighter.combo.hits > 0 then
			dummy.shownHits, dummy.shownDamage = fighter.combo.hits, fighter.combo.damage
		end
		-- Heal up a while after the last hit.
		if now - fighter.lastHitAt > Config.DummyResetTime and fighter.humanoid.Health < fighter.humanoid.MaxHealth
			and not fighter:IsLocked()
		then
			fighter.humanoid.Health = fighter.humanoid.MaxHealth
		end
		-- Knocked far away: back home once it's free again.
		if fighter.state == "Idle" and (fighter.root.Position - dummy.home.Position).Magnitude > 40 then
			Dummies.Reset(dummy)
		end
		local mode = dummy.model:GetAttribute("DummyMode")
		dummy.label.Text = string.format("%s  [%s]\ncombo %d hits  %.1f dmg  HP %d", tostring(mode), fighter.state,
			dummy.shownHits, dummy.shownDamage, math.floor(fighter.humanoid.Health + 0.5))
	end
end

function Dummies.Folder(): Folder?
	return folder
end

return Dummies
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX569396794FFB4A8495644AF640BF214E"><Properties><string name="Name">Fighter</string><ProtectedString name="Source"><![CDATA[--!strict
-- Fighter (ModuleScript)
-- Location: ServerScriptService > Combat > Fighter
--
-- The server's record of one character in a fight (a player or a training dummy): its state
-- machine, the move it's running, blocking and parrying, stamina and burnout, cooldowns, the M1
-- chain, the combo it's taking, status build-up, and the Lotus Fungus (meter, stages, the form,
-- Infested). The server owns all of it; clients only ask (CombatServer) and animate. HitResolver
-- decides what a hit does; Projectiles flies the shots; this module keeps the state.
--
-- States ("CombatState" attribute):
--   Idle        free to act
--   Blocking    guard up (F held, BlockStartup frames after the press)
--   Attacking   running a move (its phase is the move's frame math, Moves.PhaseAt)
--   Stunned     hit stun (can't act); a held F becomes a block the frame it ends
--   Blockstun   blocked a hit: guard stays up, can't act
--   Parried     your attack got parried
--   Launched    sent up by a launcher: helpless for LaunchStun frames, then free in the air
--   Knockdown   knocked down and flying until landing
--   Downed      on the floor for GetUpFrames (invincible at first); Shift = tech roll
--   TechRoll    rolling out of a knockdown (invincible)
--   Held        caught by a grab or an impale: held still, then thrown / dropped (heldThrow)
-- Every frame (Step) the timers run, a move's active frames look for targets, stamina refills,
-- build-up drains, and the attributes clients read are published.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Combat = ReplicatedStorage:WaitForChild("Combat")
local Config = require(Combat:WaitForChild("CombatConfig"))
local Moves = require(Combat:WaitForChild("Moves"))
local Loadout = require(Combat:WaitForChild("Loadout"))
local FungusParts = require(Combat:WaitForChild("FungusParts"))

type Move = Moves.Move

export type State =
	"Idle"
	| "Blocking"
	| "Attacking"
	| "Stunned"
	| "Blockstun"
	| "Parried"
	| "Launched"
	| "Knockdown"
	| "Downed"
	| "TechRoll"
	| "Held"
	| "Dead"

-- States where you can't act (the "Stunned" attribute clients lock their controls on).
local LOCKED: { [string]: boolean } = {
	Stunned = true,
	Blockstun = true,
	Parried = true,
	Launched = true,
	Knockdown = true,
	Downed = true,
	TechRoll = true,
	Held = true,
	Dead = true,
}
-- Being hit in these states continues the combo.
local IN_COMBO: { [string]: boolean } = {
	Stunned = true,
	Launched = true,
	Knockdown = true,
	Downed = true,
	Held = true,
}

local FRAME = 1 / Config.FPS

export type Run = {
	move: Move,
	seq: number,
	elapsed: number, -- seconds into the move, not counting hit pause
	pauseUntil: number,
	lastFrame: number, -- the last frame already processed
	hitTargets: { [Model]: boolean },
	result: string?, -- "Hit" / "Counter" / "Block" / "Armour" once it touched someone
	hitConfirmed: boolean, -- landed a real hit (cancels open up)
	armour: number,
	costPaid: number, -- meter this move cost (refunded by a stage 3 stab's counter-hit)
	followUp: boolean, -- started right after a different Lotus key hit (the move's FollowUp bonus)
	aimPoint: Vector3?, -- where a Targeted move erupts
	projectiles: number, -- shots still flying (a miss is only a miss once they're all gone)
}

-- What touched: a melee hitbox (run = the attacker's move) or a projectile.
export type Hit = {
	move: Move,
	seq: number,
	run: Run?,
	frame: number,
	lastActive: boolean,
	origin: Vector3, -- where the hit comes from (the attacker, or the projectile)
	direction: Vector3?, -- a projectile's flight direction
	projectile: boolean,
	followUp: boolean,
}

export type Combo = {
	hits: number,
	launches: number,
	afterLinker: boolean,
	damage: number,
}

export type Hooks = {
	-- Tell the owning client (or the dummy controller) to react: stun, knockback, block, parried...
	react: (fighter: Fighter, info: { [string]: any }) -> (),
	-- Tell the attacker's client how its move went.
	result: (fighter: Fighter, seq: number, result: string, hitstop: number, advantage: number?) -> (),
	-- Effects for everyone.
	fx: (info: { [string]: any }) -> (),
	-- Every other fighter, for hit detection.
	all: () -> { Fighter },
	fighterOf: (model: Model) -> Fighter?,
	resolve: (attacker: Fighter, target: Fighter, hit: Hit) -> string?,
	-- Fire a move's projectiles (Projectiles).
	shoot: (fighter: Fighter, run: Run) -> (),
}

local Fighter = {}
Fighter.__index = Fighter

type Data = {
	character: Model,
	humanoid: Humanoid,
	root: BasePart,
	player: Player?,
	isDummy: boolean,
	hooks: Hooks,

	state: State,
	stateUntil: number,
	run: Run?,
	queued: { moveId: string, seq: number }?,
	cooldowns: { [string]: number },
	chain: number,
	chainEndedAt: number,

	blockHeld: boolean,
	blockPressedAt: number,
	parryUntil: number,
	parryLockUntil: number,

	stamina: number,
	burnout: boolean,
	lastSpend: number,
	spendWindow: { { at: number, amount: number } },

	combo: Combo,
	knockSince: number,
	downExtra: number,
	invulnerableUntil: number,
	lastHitAt: number,

	element: string,
	buildup: number,
	buildupAt: number,
	buildupLockUntil: number,
	draftedUntil: number,

	lotus: number,
	formUntil: number,
	formActive: boolean,
	infestedUntil: number,
	lastLotusHit: { slot: string, at: number }?,
	heldThrow: Vector3?,

	castParams: RaycastParams,
	published: { [string]: any },
	lastStep: number,
	lastResult: string,
	lastAdvantage: number?,
}

export type Fighter = typeof(setmetatable({} :: Data, Fighter))

function Fighter.new(character: Model, player: Player?, hooks: Hooks): Fighter
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	local root = character:WaitForChild("HumanoidRootPart") :: BasePart
	local castParams = RaycastParams.new()
	castParams.FilterType = Enum.RaycastFilterType.Exclude
	castParams.FilterDescendantsInstances = { character }
	castParams.RespectCanCollide = true
	local element = character:GetAttribute("Element")
	local self = setmetatable({
		character = character,
		humanoid = humanoid,
		root = root,
		player = player,
		isDummy = player == nil,
		hooks = hooks,

		state = "Idle" :: State,
		stateUntil = 0,
		run = nil,
		queued = nil,
		cooldowns = {},
		chain = 0,
		chainEndedAt = -math.huge,

		blockHeld = false,
		blockPressedAt = -math.huge,
		parryUntil = 0,
		parryLockUntil = 0,

		stamina = Config.StaminaMax,
		burnout = false,
		lastSpend = -math.huge,
		spendWindow = {},

		combo = { hits = 0, launches = 0, afterLinker = false, damage = 0 },
		knockSince = 0,
		downExtra = 0,
		invulnerableUntil = 0,
		lastHitAt = -math.huge,

		element = if typeof(element) == "string" then element else "Wind",
		buildup = 0,
		buildupAt = -math.huge,
		buildupLockUntil = 0,
		draftedUntil = 0,

		lotus = 0,
		formUntil = 0,
		formActive = false,
		infestedUntil = 0,
		lastLotusHit = nil,
		heldThrow = nil,

		castParams = castParams,
		published = {},
		lastStep = os.clock(),
		lastResult = "",
		lastAdvantage = nil,
	} :: Data, Fighter)
	humanoid.MaxHealth = Config.MaxHealth
	humanoid.Health = Config.MaxHealth
	self:_publish()
	return self
end

-- INFO ------------------------------------------------------------------------------------------

function Fighter.IsLocked(self: Fighter): boolean
	return LOCKED[self.state] == true
end

function Fighter.IsInCombo(self: Fighter): boolean
	return IN_COMBO[self.state] == true
end

function Fighter.GuardUp(self: Fighter): boolean
	return self.state == "Blocking" or self.state == "Blockstun"
end

function Fighter.IsInvulnerable(self: Fighter, now: number): boolean
	return now < self.invulnerableUntil
end

-- Can this fighter parry right now (a window open, and free to act)?
function Fighter.ParryOpen(self: Fighter, now: number): boolean
	return now <= self.parryUntil and (self.state == "Idle" or self.state == "Blocking")
end

-- LOTUS ------------------------------------------------------------------------------------------

function Fighter.IsForm(self: Fighter): boolean
	return self.formActive
end

-- The meter's stage (1-3); the form is always stage 3.
function Fighter.LotusStage(self: Fighter): number
	if self.formActive or self.lotus >= Config.Stage3At then
		return 3
	elseif self.lotus >= Config.Stage2At then
		return 2
	end
	return 1
end

function Fighter.AddMeter(self: Fighter, amount: number)
	self.lotus = math.clamp(self.lotus + amount, 0, Config.LotusMax)
end

function Fighter.SetMeter(self: Fighter, value: number)
	self.lotus = math.clamp(value, 0, Config.LotusMax)
end

function Fighter.IsInfested(self: Fighter): boolean
	return os.clock() < self.infestedUntil
end

-- Takes `amount` HP (x Stage3DamageTaken at stage 3). feeds = the loss feeds the fungus (a hit taken;
-- not your own rip-out or a miss consuming you). Dummies never drop below 1. Returns the HP lost.
function Fighter.TakeDamage(self: Fighter, amount: number, feeds: boolean): number
	if amount <= 0 then
		return 0
	end
	if feeds and self:LotusStage() == 3 then
		amount *= Config.Stage3DamageTaken
	end
	local floor = if self.isDummy then 1 else 0
	local before = self.humanoid.Health
	self.humanoid.Health = math.max(before - amount, floor)
	local lost = before - self.humanoid.Health
	if feeds then
		self:AddMeter(lost * Config.LotusPerDamage)
	end
	return lost
end

function Fighter.Heal(self: Fighter, amount: number)
	self.humanoid.Health = math.min(self.humanoid.Health + amount, self.humanoid.MaxHealth)
end

-- The frame the current move is on (or -1).
function Fighter.MoveFrame(self: Fighter): number
	local run = self.run
	return if run then math.floor(run.elapsed / FRAME + 1e-6) else -1
end

function Fighter.MovePhase(self: Fighter): string
	local run = self.run
	if not run then
		return "None"
	end
	return Moves.PhaseAt(run.move, self:MoveFrame(), not run.hitConfirmed and run.result == nil)
end

-- Frames left in the current move after `frame` (0 when none).
function Fighter.FramesLeft(self: Fighter, frame: number): number
	local run = self.run
	if not run then
		return 0
	end
	return math.max(Moves.Total(run.move, false) - frame - 1, 0)
end

-- Standing on something (the server's own look: a ray down from the root)?
function Fighter.Grounded(self: Fighter): boolean
	local velocity = self.root.AssemblyLinearVelocity
	if velocity.Y > 2 then
		return false
	end
	local reach = self.humanoid.HipHeight + self.root.Size.Y / 2 + 1.6
	return Workspace:Raycast(self.root.Position, Vector3.new(0, -reach, 0), self.castParams) ~= nil
end

function Fighter.FacingDot(self: Fighter, from: Vector3): number
	local look = self.root.CFrame.LookVector
	local toward = from - self.root.Position
	local flatLook = Vector3.new(look.X, 0, look.Z)
	local flatToward = Vector3.new(toward.X, 0, toward.Z)
	if flatLook.Magnitude < 1e-3 or flatToward.Magnitude < 1e-3 then
		return 1
	end
	return flatLook.Unit:Dot(flatToward.Unit)
end

-- STATE ------------------------------------------------------------------------------------------

function Fighter.SetState(self: Fighter, state: State, seconds: number?)
	self.state = state
	self.stateUntil = if seconds then os.clock() + seconds else 0
end

-- Ends whatever move is running (hit out of it, parried, died).
function Fighter.Interrupt(self: Fighter)
	self.run = nil
	self.queued = nil
end

-- The state to go back to when a timer ends.
function Fighter._neutral(self: Fighter)
	if self.humanoid.Health <= 0 then
		self:SetState("Dead")
	elseif self.blockHeld and os.clock() - self.blockPressedAt >= Config.BlockStartup * FRAME then
		self:SetState("Blocking")
	else
		self:SetState("Idle")
	end
end

-- MOVES ------------------------------------------------------------------------------------------

-- Why a move can't start right now ("" = it can).
function Fighter.CanStart(self: Fighter, move: Move, now: number): string
	if self.humanoid.Health <= 0 then
		return "dead"
	end
	local channel = self.run
	if self.state == "Attacking" and channel and channel.move.Channel and table.find(channel.move.CancelInto, move.Id) then
		return "" -- a heal tap turning into the rip-out (they share a cooldown)
	end
	local ready = self.cooldowns[move.CooldownGroup]
	if ready and now < ready - 0.1 then
		return "cooldown"
	end
	if move.Magic == "Lotus" and move.Stage > 0 and move.Stage ~= self:LotusStage() then
		return "stage"
	end
	if move.Id == "Lotus.Form" and (self.lotus < Config.LotusMax or self.formActive) then
		return "meter not full"
	end
	if move.Chain > 1 then
		local current = self.run
		local fromRun = current ~= nil and current.move.Chain == move.Chain - 1
		local fromChain = self.chain == move.Chain - 1 and now - self.chainEndedAt <= Config.ChainWindow + 0.15
		if not (fromRun or fromChain) then
			return "chain"
		end
	end
	if self.state == "Idle" then
		return ""
	end
	if self.state == "Attacking" then
		local run = self.run
		if run then
			if run.hitConfirmed and table.find(run.move.CancelInto, move.Id) then
				return "" -- cancel on hit
			end
			if run.hitConfirmed and run.move.JumpCancel and move.Air then
				return "" -- the launcher's jump follow-up
			end
			if run.move.Channel and table.find(run.move.CancelInto, move.Id) then
				return "" -- a heal tap turning into the rip-out
			end
			local left = self:FramesLeft(self:MoveFrame())
			if left <= Config.ServerBuffer then
				return "queue"
			end
		end
		return "busy"
	end
	return "state " .. self.state
end

-- Starts `moveId` (the client already picked it). Returns "" or why not; "queue" = kept and started
-- when the current move ends.
function Fighter.RequestMove(self: Fighter, moveId: string, seq: number): string
	local move = Moves.Get(moveId)
	if not move then
		return "unknown move"
	end
	if not Loadout.CanPick(move.Slot, move.Id) then
		return "not in loadout"
	end
	local now = os.clock()
	local why = self:CanStart(move, now)
	if why == "queue" then
		self.queued = { moveId = moveId, seq = seq }
		return "queue"
	end
	if why ~= "" then
		return why
	end
	self:_start(move, seq, now)
	return ""
end

function Fighter._start(self: Fighter, move: Move, seq: number, now: number)
	local previous = self.run
	if previous and previous.move.Chain > 0 then
		self.chain = previous.move.Chain
		self.chainEndedAt = now
	end
	self.run = {
		move = move,
		seq = seq,
		elapsed = 0,
		pauseUntil = 0,
		lastFrame = -1,
		hitTargets = {},
		result = nil,
		hitConfirmed = false,
		armour = move.Armour,
		costPaid = 0,
		followUp = false,
		aimPoint = nil,
		projectiles = 0,
	}
	local run = self.run :: Run
	-- Stage 3 moves spend meter (free in the form).
	if move.MeterCost > 0 and not self.formActive then
		run.costPaid = math.min(move.MeterCost, self.lotus)
		self:AddMeter(-move.MeterCost)
	end
	local last = self.lastLotusHit
	if move.Magic and last and last.slot ~= move.Slot and now - last.at <= Config.FollowUpWindow then
		run.followUp = true
	end
	if move.Targeted then
		run.aimPoint = self:_impaleAim()
		self.hooks.fx({ type = "Patch", attacker = self.character, position = run.aimPoint, seconds = move.Startup * FRAME, move = move.Id })
	end
	self.queued = nil
	self.parryUntil = 0
	if move.Cooldown > 0 then
		self.cooldowns[move.CooldownGroup] = now + move.Cooldown
	end
	if move.Chain > 0 then
		self.chain = move.Chain
		self.chainEndedAt = math.huge -- running
	end
	self:SetState("Attacking")
	self.character:SetAttribute("Move", move.Id .. "#" .. seq)
end

function Fighter._endRun(self: Fighter)
	local run = self.run
	self.run = nil
	if run and run.move.WhiffPenalty and run.result == nil and run.projectiles <= 0 then
		self:Consume()
		return
	end
	if run and run.move.Chain > 0 then
		self.chain = if run.move.Chain >= 3 then 0 else run.move.Chain
		self.chainEndedAt = os.clock()
	elseif run and run.move.Id == "Sword.Lunge" then
		self.chain = 0
	end
	if self.state == "Attacking" then
		self:_neutral()
	end
	local queued = self.queued
	self.queued = nil
	if queued then
		local why = if self.state == "Idle" then self:RequestMove(queued.moveId, queued.seq) else "state " .. self.state
		if why ~= "" and why ~= "queue" then
			-- The client already started it: tell it to stop.
			self.hooks.result(self, queued.seq, "Reject", 0)
		end
	end
end

-- Pauses the running move for `seconds` (hit pause).
function Fighter.PauseMove(self: Fighter, seconds: number)
	local run = self.run
	if run then
		run.pauseUntil = math.max(run.pauseUntil, os.clock() + seconds)
	end
end

function Fighter._stepMove(self: Fighter, now: number, dt: number)
	local run = self.run
	if not run then
		return
	end
	if now < run.pauseUntil then
		return
	end
	run.elapsed += dt
	local frame = self:MoveFrame()
	local move = run.move
	local whiff = run.result == nil
	local total = Moves.Total(move, whiff)
	-- Every frame between the last processed one and this one (a slow server frame can skip one).
	local activeStart, activeEnd = move.Startup, move.Startup + move.Active - 1
	local hasHitbox = move.OnHit.Kind ~= "None" and move.Projectile == nil
	for f = run.lastFrame + 1, frame do
		if f == activeStart then
			self:_activate(run)
			if self.run ~= run then
				return
			end
		end
		if hasHitbox and f >= activeStart and f <= activeEnd then
			self:_checkHits(f, f == activeEnd)
			if self.run ~= run then
				return -- parried out of it
			end
		end
		if move.Channel and f == activeEnd then
			self:EndChannel(true)
		end
	end
	run.lastFrame = frame
	if frame >= total then
		self:_endRun()
	end
end

function Fighter._checkHits(self: Fighter, frame: number, lastActive: boolean)
	local run = self.run
	if not run then
		return
	end
	local move = run.move
	local cframe
	if move.Targeted then
		local at = run.aimPoint or self.root.Position
		cframe = CFrame.new(at + Vector3.new(0, move.Hitbox.Size.Y / 2, 0))
	else
		local reach = if run.followUp then move.FollowUpReach else 0
		cframe = self.root.CFrame * CFrame.new(0, move.Hitbox.Up, -(move.Hitbox.Forward + reach / 2))
	end
	local size = move.Hitbox.Size + Vector3.one * (Config.HitboxPad * 2)
	if run.followUp and move.FollowUpReach > 0 then
		size += Vector3.new(0, 0, move.FollowUpReach)
	end
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	local others: { Instance } = {}
	for _, other in self.hooks.all() do
		if other.character ~= self.character and other.humanoid.Health > 0 then
			table.insert(others, other.character)
		end
	end
	params.FilterDescendantsInstances = others
	local found: { [Model]: boolean } = {}
	for _, part in Workspace:GetPartBoundsInBox(cframe, size, params) do
		local model = part:FindFirstAncestorOfClass("Model")
		while model and not model:FindFirstChildOfClass("Humanoid") do
			model = model:FindFirstAncestorOfClass("Model")
		end
		if model and not found[model] and not run.hitTargets[model] then
			found[model] = true
		end
	end
	self.hooks.fx({ type = "Hitbox", cframe = cframe, size = size, hit = next(found) ~= nil })
	for model in found do
		local target = self.hooks.fighterOf(model)
		if target and self.run == run then
			local outcome = self.hooks.resolve(self, target, {
				move = move,
				seq = run.seq,
				run = run,
				frame = frame,
				lastActive = lastActive,
				origin = self.root.Position,
				direction = nil,
				projectile = false,
				followUp = run.followUp,
			})
			if outcome then
				run.hitTargets[model] = true
			end
		end
	end
end

-- The move's first active frame: shots fly, the rip-out and the form happen.
function Fighter._activate(self: Fighter, run: Run)
	local move = run.move
	if move.Projectile then
		self.hooks.shoot(self, run)
	elseif move.Id == "Lotus.RipOut" then
		self:TakeDamage(Config.RipOutHealth, false)
		self:AddMeter(-Config.RipOutMeter)
		self.hooks.fx({ type = "Lotus", what = "RipOut", target = self.character, position = self.root.Position })
	elseif move.Id == "Lotus.Form" then
		self.formActive = true
		self.formUntil = os.clock() + Config.FormTime
		self.hooks.fx({ type = "Lotus", what = "Form", target = self.character, position = self.root.Position })
	end
end

-- The heal channel ends: `full` = it ran its whole length, otherwise R was let go (the share
-- channelled counts). The move goes on to its recovery.
function Fighter.EndChannel(self: Fighter, full: boolean)
	local run = self.run
	if not run or not run.move.Channel or run.result == "Channelled" then
		return
	end
	local move = run.move
	local channelled = math.clamp(self:MoveFrame() - move.Startup + 1, 0, move.Active)
	local share = if full then 1 else channelled / move.Active
	run.result = "Channelled"
	self:Heal(Config.HealHealth * share)
	self:AddMeter(Config.HealMeter * share)
	-- Skip to the recovery.
	run.elapsed = math.max(run.elapsed, (move.Startup + move.Active) * FRAME)
	run.lastFrame = math.max(run.lastFrame, move.Startup + move.Active - 1)
	self.hooks.fx({ type = "Lotus", what = "Heal", target = self.character, position = self.root.Position, share = share })
end

-- R let go.
function Fighter.ReleaseKey(self: Fighter, slot: string)
	local run = self.run
	if slot == "R" and run and run.move.Channel then
		self:EndChannel(false)
	end
end

-- A missed stage 3 move consumes you: HP that doesn't feed the meter, and a stagger.
function Fighter.Consume(self: Fighter)
	self:TakeDamage(Config.WhiffHealth, false)
	self:Interrupt()
	self:SetState("Stunned", Config.WhiffStagger * FRAME)
	self.hooks.react(self, { kind = "Consumed", stun = Config.WhiffStagger * FRAME, hitstop = 0 })
	self.hooks.fx({ type = "Lotus", what = "Consumed", target = self.character, position = self.root.Position })
end

-- A projectile of this fighter's finished (hit or gone).
function Fighter.ProjectileDone(self: Fighter, seq: number)
	local run = self.run
	if run and run.seq == seq then
		run.projectiles = math.max(run.projectiles - 1, 0)
	end
end

-- Where the impale erupts: the floor under the nearest airborne opponent in front within
-- ImpaleRange, else the floor ImpaleRange / 2 ahead.
function Fighter._impaleAim(self: Fighter): Vector3
	local look = self.root.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z).Unit
	local best: Vector3? = nil
	local bestDistance = Config.ImpaleRange
	for _, other in self.hooks.all() do
		if other.character ~= self.character and other.humanoid.Health > 0 and not other:Grounded() then
			local offset = other.root.Position - self.root.Position
			local flat = Vector3.new(offset.X, 0, offset.Z)
			if flat.Magnitude < bestDistance and (flat.Magnitude < 1 or flat.Unit:Dot(flatLook) > 0.3) then
				best, bestDistance = other.root.Position, flat.Magnitude
			end
		end
	end
	local above = best or (self.root.Position + flatLook * (Config.ImpaleRange / 2))
	local ground = Workspace:Raycast(above, Vector3.new(0, -Config.ImpaleFloorSearch, 0), self.castParams)
	return if ground then ground.Position else above - Vector3.new(0, 3, 0)
end

-- BLOCK AND PARRY ------------------------------------------------------------------------------

function Fighter.SetBlock(self: Fighter, held: boolean)
	local now = os.clock()
	if held == self.blockHeld then
		return
	end
	self.blockHeld = held
	if held then
		self.blockPressedAt = now
		-- A fresh press while free to act opens a parry window (unless a whiffed one locked it out).
		if (self.state == "Idle" or self.state == "Blocking") and now >= self.parryLockUntil then
			local ping = 0
			local player = self.player
			if player then
				ping = math.min(player:GetNetworkPing(), Config.ParryPingAllowance)
			end
			self.parryUntil = now + Config.ParryWindow * FRAME + ping
		end
		if self.state == "Idle" and Config.BlockStartup <= 0 then
			self:SetState("Blocking")
		end
	else
		if self.state == "Blocking" then
			self:SetState("Idle")
		end
	end
end

-- A parry landed: the window is used up (no whiff lockout).
function Fighter.ConsumeParry(self: Fighter)
	self.parryUntil = 0
end

-- STAMINA ------------------------------------------------------------------------------------------

-- Takes `amount` even if there isn't enough (overdraw): at 0 you're in burnout.
function Fighter.DrainStamina(self: Fighter, amount: number)
	if amount <= 0 then
		return
	end
	self.stamina -= amount
	self.lastSpend = os.clock()
	if self.stamina <= 0 then
		self.stamina = 0
		self.burnout = true
	end
end

-- A voluntary spend (race mobility, from the client). Nothing in burnout; limited per second.
function Fighter.SpendStamina(self: Fighter, amount: number): boolean
	if self.burnout or amount <= 0 or amount ~= amount then
		return false
	end
	local now = os.clock()
	local recent = 0
	for i = #self.spendWindow, 1, -1 do
		local entry = self.spendWindow[i]
		if now - entry.at > 1 then
			table.remove(self.spendWindow, i)
		else
			recent += entry.amount
		end
	end
	if recent + amount > Config.StaminaSpendRateLimit then
		return false
	end
	table.insert(self.spendWindow, { at = now, amount = amount })
	self:DrainStamina(amount)
	return true
end

function Fighter.GainStamina(self: Fighter, amount: number)
	self.stamina = math.min(self.stamina + amount, Config.StaminaMax)
end

function Fighter.SetStamina(self: Fighter, value: number)
	self.stamina = math.clamp(value, 0, Config.StaminaMax)
	self.burnout = self.stamina <= 0
	self.lastSpend = os.clock() -- counts as a change: the refill waits its delay
end

function Fighter._stepStamina(self: Fighter, now: number, dt: number)
	if self.stamina >= Config.StaminaMax then
		self.stamina = Config.StaminaMax
		self.burnout = false
		return
	end
	if now - self.lastSpend < Config.StaminaRegenDelay then
		return
	end
	local rate = if self:Grounded() then Config.StaminaRegenGround else Config.StaminaRegenAir
	if self.burnout then
		rate *= Config.BurnoutRegenScale
	end
	self.stamina = math.min(self.stamina + rate * dt, Config.StaminaMax)
	if self.stamina >= Config.StaminaMax then
		self.burnout = false
	end
end

-- STATUS BUILD-UP --------------------------------------------------------------------------------

-- Adds build-up from an attacker whose element is `element`. Returns the status that triggered, if any.
function Fighter.AddBuildup(self: Fighter, amount: number, element: string): string?
	local now = os.clock()
	if amount <= 0 or now < self.buildupLockUntil then
		return nil
	end
	self.buildup = math.min(self.buildup + amount, Config.BuildupMax)
	self.buildupAt = now
	if self.buildup < Config.BuildupMax then
		return nil
	end
	self.buildup = 0
	self.buildupLockUntil = now + Config.BuildupLockout
	if element == "Wind" then
		self.draftedUntil = now + Config.DraftedTime
		return "Drafted"
	end
	return nil
end

function Fighter.IsDrafted(self: Fighter): boolean
	return os.clock() < self.draftedUntil
end

function Fighter.UseDrafted(self: Fighter)
	self.draftedUntil = 0
end

function Fighter._stepBuildup(self: Fighter, now: number, dt: number)
	if self.buildup > 0 and now - self.buildupAt > Config.BuildupDrainDelay then
		self.buildup = math.max(self.buildup - Config.BuildupDrain * dt, 0)
	end
end

-- KNOCKDOWNS -------------------------------------------------------------------------------------

function Fighter.Knock(self: Fighter, state: State, seconds: number?, downExtraFrames: number?)
	self:Interrupt()
	self:SetState(state, seconds)
	self.knockSince = os.clock()
	self.downExtra = downExtraFrames or 0
end

-- Shift while downed: roll out.
function Fighter.TechRoll(self: Fighter): boolean
	if self.state ~= "Downed" then
		return false
	end
	local seconds = Config.TechRollFrames * FRAME
	self:SetState("TechRoll", seconds)
	self.invulnerableUntil = os.clock() + seconds
	return true
end

function Fighter._stepTimers(self: Fighter, now: number)
	local state = self.state
	if state == "Dead" then
		return
	end
	if self.humanoid.Health <= 0 then
		self:Interrupt()
		self:SetState("Dead")
		return
	end
	if state == "Knockdown" then
		local airborne = now - self.knockSince
		local landed = airborne >= Config.MinAirborne * FRAME and self:Grounded()
		if landed or airborne >= Config.MaxAirborne * FRAME then
			local frames = Config.GetUpFrames + self.downExtra
			self:SetState("Downed", frames * FRAME)
			self.invulnerableUntil = now + Config.GetUpInvincible * FRAME
		end
		return
	end
	if state == "Held" and now >= self.stateUntil then
		-- Thrown by the grab / dropped by the impale.
		local throw = self.heldThrow or Vector3.new(0, 20, 0)
		self.heldThrow = nil
		self:Knock("Knockdown")
		self.hooks.react(self, { kind = "Knockdown", velocity = throw, hitstop = 0 })
		return
	end
	if (state == "Stunned" or state == "Blockstun" or state == "Parried" or state == "Launched" or state == "Downed" or state == "TechRoll")
		and now >= self.stateUntil
	then
		if state ~= "Blockstun" then
			self.combo = { hits = 0, launches = 0, afterLinker = false, damage = 0 }
		end
		self:_neutral()
		return
	end
	if state == "Idle" and self.blockHeld and now - self.blockPressedAt >= Config.BlockStartup * FRAME then
		self:SetState("Blocking")
	elseif state == "Blocking" and not self.blockHeld then
		self:SetState("Idle")
	end
	-- A parry window that ran out without a parry: no new window for a while.
	if self.parryUntil > 0 and now > self.parryUntil then
		self.parryLockUntil = self.parryUntil + Config.ParryWhiffLockout * FRAME
		self.parryUntil = 0
	end
end

-- EVERY FRAME ------------------------------------------------------------------------------------

function Fighter.Step(self: Fighter, now: number)
	local dt = math.min(now - self.lastStep, 0.1)
	self.lastStep = now
	if self.formActive and now >= self.formUntil then
		self.formActive = false
		self:SetMeter(Config.FormMeterAfter)
		self.hooks.fx({ type = "Lotus", what = "FormEnd", target = self.character, position = self.root.Position })
	end
	self:_stepTimers(now)
	if self.state == "Attacking" then
		self:_stepMove(now, dt)
	elseif self.run then
		self.run = nil
	end
	if self.state ~= "Attacking" and self.character:GetAttribute("Move") ~= nil then
		self.character:SetAttribute("Move", nil)
	end
	self:_stepStamina(now, dt)
	self:_stepBuildup(now, dt)
	self:_publish()
end

function Fighter._set(self: Fighter, name: string, value: any)
	if self.published[name] ~= value then
		self.published[name] = value
		self.character:SetAttribute(name, value)
	end
end

function Fighter._publish(self: Fighter)
	local now = os.clock()
	self:_set("CombatState", self.state)
	self:_set("Stunned", self:IsLocked())
	self:_set("Guard", self:GuardUp())
	self:_set("Stamina", math.floor(self.stamina + 0.5))
	self:_set("StaminaMax", Config.StaminaMax)
	self:_set("Burnout", self.burnout)
	self:_set("Buildup", math.floor(self.buildup + 0.5))
	self:_set("Drafted", now < self.draftedUntil)
	self:_set("Invulnerable", now < self.invulnerableUntil)
	self:_set("ComboHits", self.combo.hits)
	self:_set("ComboDamage", math.floor(self.combo.damage * 10 + 0.5) / 10)
	self:_set("Lotus", math.floor(self.lotus + 0.5))
	self:_set("LotusStage", self:LotusStage())
	if not self.isDummy then
		FungusParts.SetStage(self.character, self:LotusStage(), self.formActive)
	end
	self:_set("LotusForm", self.formActive)
	self:_set("Infested", now < self.infestedUntil)
	for group, ready in self.cooldowns do
		-- Attribute names allow letters, digits and _ only: "Sword.One" -> "Cooldown_Sword_One".
		-- The value is the server clock (Workspace:GetServerTimeNow) when it's ready again.
		local left = ready - now
		self:_set("Cooldown_" .. string.gsub(group, "%W", "_"), if left > 0 then Workspace:GetServerTimeNow() + left else nil)
	end
end

-- A snapshot for the Studio test panel.
function Fighter.Snapshot(self: Fighter): { [string]: any }
	local run = self.run
	return {
		state = self.state,
		move = if run then run.move.Id else nil,
		lotus = self.lotus,
		stage = self:LotusStage(),
		form = self.formActive,
		infested = self:IsInfested(),
		followUp = if run then run.followUp else false,
		frame = self:MoveFrame(),
		phase = self:MovePhase(),
		stamina = self.stamina,
		burnout = self.burnout,
		health = self.humanoid.Health,
		comboHits = self.combo.hits,
		comboDamage = self.combo.damage,
		launches = self.combo.launches,
		buildup = self.buildup,
		drafted = self:IsDrafted(),
		chain = self.chain,
		blockHeld = self.blockHeld,
		parryOpen = self:ParryOpen(os.clock()),
		invulnerable = self:IsInvulnerable(os.clock()),
		lastResult = self.lastResult,
		lastAdvantage = self.lastAdvantage,
	}
end

return Fighter
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX514FAA0D5B614623B8E3CE9A20DD7D81"><Properties><string name="Name">HitResolver</string><ProtectedString name="Source"><![CDATA[--!strict
-- HitResolver (ModuleScript)
-- Location: ServerScriptService > Combat > HitResolver
--
-- What happens when an attacker's active hitbox, or one of its projectiles, touches a target
-- (docs/DesignPlan.md, "Combat core"; docs/MoveData.md). In order:
--   invincible target (get-up, tech roll)          nothing (it may still hit on a later active frame)
--   parry window open, facing the hit              PARRY: the attacker is stuck ParryStun frames (a
--                                                  projectile just dies), the defender gets stamina and
--                                                  build-up on the attacker
--   guard up, facing the hit, blockable move       BLOCK: stamina drain (overdraw = burnout, burnout =
--                                                  chip damage), blockstun sized so the attacker ends at
--                                                  the move's OnBlock advantage, pushback. A blocked grab
--                                                  does nothing. A Lotus move hitting an Infested
--                                                  target's block WRAPS them (knocked down).
--   armour on the target's move                    ARMOUR: damage, no stun (hyper armour: any number of
--                                                  hits during its startup)
--   otherwise                                      HIT: counter-hit if the target was starting a move (a
--                                                  heal channel counts); combo count, shrinking stun,
--                                                  damage scaling, juggle limit, Drafted, Lotus meter,
--                                                  statuses, knockback / launch / spike / grab / impale
-- Both characters freeze for the hit pause, and the move's own clock stops meanwhile, so the
-- frame advantage stays what the move data says.
-- Returns what happened ("Hit", "Counter", "Block", "Parry", "Armour") or nil when nothing did.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Combat = ReplicatedStorage:WaitForChild("Combat")
local Config = require(Combat:WaitForChild("CombatConfig"))
local Fighter = require(script.Parent:WaitForChild("Fighter"))

type Fighter = Fighter.Fighter

local FRAME = 1 / Config.FPS
local HIT_ANIMS = { "HitStun1", "HitStun2" }

local HitResolver = {}

local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return if f.Magnitude > 1e-3 then f.Unit else Vector3.zero
end

-- Launch speed for a height, under the place's gravity.
local function riseSpeed(height: number): number
	return math.sqrt(2 * Workspace.Gravity * math.max(height, 0))
end

function HitResolver.Scale(combo: Fighter.Combo): number
	local scale = 1
	if combo.hits >= Config.ScalingFrom then
		scale = math.max(Config.ScalingPerHit ^ (combo.hits - Config.ScalingFrom + 1), Config.ScalingMin)
	end
	if combo.afterLinker then
		scale *= Config.AfterLinker
	end
	return scale
end

-- The attacker's move this hit belongs to, if it's still running (projectiles can outlive it).
local function liveRun(attacker: Fighter, hit: Fighter.Hit): Fighter.Run?
	local run = attacker.run
	if run and run.seq == hit.seq and run.move == hit.move then
		return run
	end
	return nil
end

function HitResolver.Resolve(attacker: Fighter, target: Fighter, hit: Fighter.Hit): string?
	local move = hit.move
	local run = liveRun(attacker, hit)
	if not hit.projectile and not run then
		return nil
	end
	local now = os.clock()
	if target.state == "Dead" or target:IsInvulnerable(now) then
		return nil
	end
	-- Plain strings (the type checker narrows the Guard union wrongly across these checks).
	local guard: string = move.Guard
	local parryable = guard ~= "Unparryable"
	local blockable = guard == "Normal"
	local fromFront = move.AnyBlockSide or target:FacingDot(hit.origin) > -0.05
	local hitPoint = target.root.Position:Lerp(hit.origin, 0.35) + Vector3.new(0, 0.5, 0)
	local away = flat(target.root.Position - hit.origin)
	if away == Vector3.zero then
		away = flat(attacker.root.CFrame.LookVector)
	end
	local push = if hit.direction then flat(hit.direction) else flat(attacker.root.CFrame.LookVector)
	local isSpore = move.Fx.Arc == "Spore"

	-- PARRY ------------------------------------------------------------------------------------
	if target:ParryOpen(now) and fromFront and parryable then
		target:ConsumeParry()
		target:GainStamina(Config.ParryStaminaGain)
		local status = attacker:AddBuildup(Config.BuildupParry, target.element)
		target.lastResult = "Parry"
		attacker.lastResult = "Parried"
		if not hit.projectile then
			attacker:Interrupt()
			attacker:SetState("Parried", Config.ParryStun * FRAME)
			attacker.hooks.react(attacker, { kind = "Parried", stun = Config.ParryStun * FRAME, hitstop = 0, attacker = target.character })
		end
		attacker.hooks.result(attacker, hit.seq, "Parried", 0)
		target.hooks.react(target, { kind = "Parry", attacker = attacker.character })
		attacker.hooks.fx({ type = "Parry", attacker = attacker.character, target = target.character, position = hitPoint, move = move.Id })
		if status then
			attacker.hooks.fx({ type = "Status", target = attacker.character, status = status })
		end
		return "Parry"
	end

	-- BLOCK ------------------------------------------------------------------------------------
	if target:GuardUp() and fromFront and blockable then
		if move.CrossUp and not hit.lastActive then
			return nil -- decided on the last active frame: it may still get behind the guard
		end
		if move.Grab then
			-- A blocked grab does nothing: the attacker is left in its long recovery.
			if run then
				run.result = run.result or "Block"
			end
			attacker.lastResult = "Block"
			attacker.hooks.result(attacker, hit.seq, "Block", 0)
			attacker.hooks.fx({ type = "Block", attacker = attacker.character, target = target.character, position = hitPoint, hitstop = 0, move = move.Id })
			return "Block"
		end
		if move.Magic == "Lotus" and not isSpore and target:IsInfested() then
			-- Infested: the growth wraps them instead.
			target.infestedUntil = 0
			target:TakeDamage(move.Damage, true)
			target:Interrupt()
			target:SetState("Downed", Config.WrapFrames * FRAME)
			target.invulnerableUntil = 0
			if run then
				run.result = "Hit"
				run.hitConfirmed = true
			end
			attacker.lastResult = "Hit"
			attacker.hooks.result(attacker, hit.seq, "Hit", 0)
			target.hooks.react(target, { kind = "Wrapped", stun = Config.WrapFrames * FRAME, hitstop = 0, attacker = attacker.character })
			attacker.hooks.fx({ type = "Lotus", what = "Wrap", attacker = attacker.character, target = target.character, position = target.root.Position })
			return "Hit"
		end
		local chip = if target.burnout then move.Damage * Config.BurnoutChip else 0
		target:DrainStamina(move.Damage * Config.BlockStaminaPerDamage)
		if chip > 0 then
			target:TakeDamage(chip, false)
		end
		local hitstop = Config.BlockHitstop * FRAME
		local blockstun = if run
			then math.max(attacker:FramesLeft(hit.frame >= 0 and hit.frame or attacker:MoveFrame()) + move.OnBlock, 1)
			else move.BlockStun
		target:Interrupt()
		target:SetState("Blockstun", hitstop + blockstun * FRAME)
		if run then
			attacker:PauseMove(hitstop)
			run.result = run.result or "Block"
		end
		attacker.lastResult = "Block"
		attacker.lastAdvantage = move.OnBlock
		target.lastResult = "Blocked"
		local pushback = if move.BlockPush > 0 then move.BlockPush else Config.BlockPushback
		attacker.hooks.result(attacker, hit.seq, "Block", hitstop, move.OnBlock)
		target.hooks.react(target, {
			kind = "Block",
			stun = blockstun * FRAME,
			hitstop = hitstop,
			velocity = push * (pushback * 2 / 0.15),
			push = 0.15,
			chip = chip,
			burnout = target.burnout,
			attacker = attacker.character,
		})
		attacker.hooks.fx({
			type = "Block",
			attacker = attacker.character,
			target = target.character,
			position = hitPoint,
			hitstop = hitstop,
			chip = chip,
			move = move.Id,
		})
		return "Block"
	end

	-- ARMOUR -----------------------------------------------------------------------------------
	local targetRun = target.run
	local targetPhase = target:MovePhase()
	local armoured = targetRun ~= nil
		and (
			(targetRun.armour > 0 and (targetPhase == "Startup" or targetPhase == "Active"))
			or (targetRun.move.HyperArmour and targetPhase == "Startup")
		)
	if targetRun and armoured then
		if not targetRun.move.HyperArmour then
			targetRun.armour -= 1
		end
		target:TakeDamage(move.Damage, true)
		local hitstop = move.Hitstop * FRAME
		if run then
			attacker:PauseMove(hitstop)
			run.result = run.result or "Armour"
		end
		target:PauseMove(hitstop)
		attacker.lastResult = "Armour"
		attacker.hooks.result(attacker, hit.seq, "Armour", hitstop)
		target.hooks.react(target, { kind = "Armour", hitstop = hitstop, attacker = attacker.character })
		attacker.hooks.fx({ type = "Armour", attacker = attacker.character, target = target.character, position = hitPoint, hitstop = hitstop, move = move.Id })
		return "Armour"
	end

	-- HIT --------------------------------------------------------------------------------------
	local counter = target.state == "Attacking" and (targetPhase == "Startup" or targetPhase == "Active")
	local grounded = target:Grounded()
	if not target:IsInCombo() then
		target.combo = { hits = 0, launches = 0, afterLinker = false, damage = 0 }
	end
	local combo = target.combo
	combo.hits += 1
	local damage = move.Damage * HitResolver.Scale(combo) * (if counter then Config.CounterHitDamage else 1)
	damage = math.floor(damage * 10 + 0.5) / 10
	if move.Linker then
		combo.afterLinker = true
	end
	local dealt = target:TakeDamage(damage, true)
	combo.damage += dealt
	target.lastHitAt = now

	local hitstop = move.Hitstop * FRAME
	local result = if counter then "Counter" else "Hit"
	if run then
		attacker:PauseMove(hitstop)
		run.result = result
		run.hitConfirmed = true
	end
	attacker.lastResult = result
	target.lastResult = "Hit"

	-- Lotus: the meter, follow-ups, statuses.
	if move.Magic == "Lotus" then
		local slot: string = move.Slot
		attacker.lastLotusHit = { slot = slot, at = now }
		if move.MeterGain > 0 then
			attacker:AddMeter(move.MeterGain)
		end
		if move.SetMeter then
			attacker:SetMeter(move.SetMeter)
		end
		if counter and move.RefundOnCounter and run and run.costPaid > 0 then
			attacker:AddMeter(run.costPaid)
		end
	end
	if move.Status == "Infested" then
		target.infestedUntil = now + Config.InfestedTime
		attacker.hooks.fx({ type = "Status", target = target.character, status = "Infested" })
	end

	local onHit = move.OnHit
	local kind: string = onHit.Kind
	local info: { [string]: any } = {
		kind = kind,
		hitstop = hitstop,
		attacker = attacker.character,
		counter = counter,
		damage = dealt,
		anim = HIT_ANIMS[(combo.hits - 1) % #HIT_ANIMS + 1],
	}
	local downed = target.state == "Downed"
	if downed then
		-- On the floor: the hit lands (down slams are allowed as often as you like) but they stay
		-- down, and the get-up clock keeps running, so it can't loop.
		kind = "Downed"
		info.kind = kind
		attacker.lastAdvantage = nil
	elseif kind == "Launch" and combo.launches >= Config.LaunchesPerCombo then
		kind = "Knockdown" -- juggle limit: a second launch is a plain knockdown
		info.kind = kind
		info.juggled = true
	end

	if kind == "Stun" then
		local stun
		if counter and move.CounterStun then
			stun = move.CounterStun
		else
			stun = onHit.Stun + (if counter then Config.CounterHitStun else 0)
		end
		if hit.followUp then
			stun += move.FollowUpStun
		end
		stun = math.max(stun - Config.StunDecay * (combo.hits - 1), Config.MinStun)
		target:Interrupt()
		target:SetState("Stunned", hitstop + stun * FRAME)
		info.stun = stun * FRAME
		info.hang = onHit.Hang or not grounded and move.Air
		info.velocity = push * (onHit.Knockback * 2 / 0.15)
		info.push = 0.15
		attacker.lastAdvantage = if run then stun - attacker:FramesLeft(if hit.frame >= 0 then hit.frame else attacker:MoveFrame()) else nil
	elseif kind == "Launch" then
		combo.launches += 1
		local height = onHit.Launch
		if target:IsDrafted() then
			height *= Config.DraftedLaunchScale
			target:UseDrafted()
			info.drafted = true
		end
		target:Knock("Launched", hitstop + Config.LaunchStun * FRAME)
		info.velocity = Vector3.new(0, riseSpeed(height), 0)
		info.stun = Config.LaunchStun * FRAME
		attacker.lastAdvantage = nil
	elseif kind == "Knockdown" or kind == "Spike" then
		local extra = 0
		if target:IsDrafted() then
			extra = Config.DraftedDownFrames
			target:UseDrafted()
			info.drafted = true
		end
		target:Knock("Knockdown", nil, extra)
		target.knockSince = now + hitstop
		if kind == "Spike" then
			info.velocity = Vector3.new(0, -110, 0) + push * 8
		else
			local distance = if onHit.Knockback > 0 then onHit.Knockback else 10
			info.velocity = away * (distance / 0.42) + Vector3.new(0, 34, 0)
		end
		attacker.lastAdvantage = nil
	elseif kind == "Grab" or kind == "Impale" then
		-- Held still (a grab's feast, an impale's spike), then thrown / dropped: a knockdown.
		local frames, throw
		local grab = move.Grab
		if grab then
			frames = grab.Hold
			throw = away * (grab.Throw / 0.42) + Vector3.new(0, 30, 0)
		else
			frames = move.HeldFrames
			throw = away * (math.max(onHit.Knockback, 2) / 0.42) + Vector3.new(0, 10, 0)
		end
		target:Interrupt()
		target:SetState("Held", hitstop + frames * FRAME)
		target.heldThrow = throw
		info.kind = "Held"
		info.stun = frames * FRAME
		info.how = kind
		attacker.lastAdvantage = nil
	end

	local status = target:AddBuildup(if counter then math.max(move.Buildup, Config.BuildupCounterHit) else move.Buildup, attacker.element)

	attacker.hooks.result(attacker, hit.seq, result, if run then hitstop else 0, attacker.lastAdvantage)
	target.hooks.react(target, info)
	attacker.hooks.fx({
		type = "Hit",
		attacker = attacker.character,
		target = target.character,
		position = hitPoint,
		hitstop = hitstop,
		counter = counter,
		damage = dealt,
		kind = kind,
		move = move.Id,
		combo = combo.hits,
	})
	if status then
		attacker.hooks.fx({ type = "Status", target = target.character, status = status })
	end
	return result
end

return HitResolver
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX73774D737A61405B9F45336777C6EB84"><Properties><string name="Name">Projectiles</string><ProtectedString name="Source"><![CDATA[--!strict
-- Projectiles (ModuleScript)
-- Location: ServerScriptService > Combat > Projectiles
--
-- Shots that fly on their own once a move fires them (Move.Projectile): the Lotus spores and the
-- stage 2 ground strand. The server moves each one every frame, stops it at walls, and hands any
-- fighter it touches to HitResolver (one target per shot). Clients draw them from two Fx messages
-- (CombatFx): "Projectile" when it's fired (start, direction, speed, range) and "ProjectileEnd".
--
--   Count shots spread evenly over Spread degrees, Speed studs/s, gone after Range studs.
--   Ground = it runs along the floor (following it up and down) and only hits people on the floor
--   or lying on it; it stops where the floor ends.

local Workspace = game:GetService("Workspace")

local Fighter = require(script.Parent:WaitForChild("Fighter"))

type Fighter = Fighter.Fighter

type Shot = {
	id: number,
	owner: Fighter,
	hit: Fighter.Hit,
	position: Vector3,
	direction: Vector3,
	speed: number,
	range: number,
	travelled: number,
	radius: number,
	ground: boolean,
}

local Projectiles = {}

local shots: { Shot } = {}
local nextId = 0
local FLOOR_REACH = 8 -- a ground shot looks this far up / down for the floor ahead

local function worldParams(): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore: { Instance } = {}
	for _, name in { "TrainingDummies", "CombatFx", "MovementFx", "HitboxViewer" } do
		local folder = Workspace:FindFirstChild(name)
		if folder then
			table.insert(ignore, folder)
		end
	end
	params.FilterDescendantsInstances = ignore
	params.RespectCanCollide = true
	return params
end

local function isCharacterPart(part: BasePart): boolean
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		if model:FindFirstChildOfClass("Humanoid") then
			return true
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return false
end

-- A ray that ignores characters (they're hit by the overlap check, not stopped at).
local function castWorld(origin: Vector3, direction: Vector3, params: RaycastParams): RaycastResult?
	for _ = 1, 4 do
		local result = Workspace:Raycast(origin, direction, params)
		if not result or not isCharacterPart(result.Instance) then
			return result
		end
		local list = params.FilterDescendantsInstances
		table.insert(list, result.Instance)
		params.FilterDescendantsInstances = list
	end
	return nil
end

-- Fires `run`'s move from `owner`.
function Projectiles.Fire(owner: Fighter, run: Fighter.Run)
	local move = run.move
	local spec = move.Projectile
	if not spec then
		return
	end
	local look = owner.root.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	flatLook = if flatLook.Magnitude > 1e-3 then flatLook.Unit else Vector3.zAxis
	local params = worldParams()
	for i = 1, spec.Count do
		local angle = if spec.Count > 1 then -spec.Spread / 2 + spec.Spread * (i - 1) / (spec.Count - 1) else 0
		local direction = CFrame.Angles(0, math.rad(angle), 0):VectorToWorldSpace(flatLook)
		local start
		if spec.Ground then
			local floor = castWorld(owner.root.Position + flatLook * 1.5, Vector3.new(0, -FLOOR_REACH, 0), params)
			start = if floor then floor.Position + Vector3.new(0, 0.5, 0) else owner.root.Position - Vector3.new(0, 2.5, 0)
		else
			-- From the left hand, a little out in front.
			start = owner.root.CFrame * Vector3.new(-1, 0.4, -1.5)
		end
		nextId += 1
		local shot: Shot = {
			id = nextId,
			owner = owner,
			hit = {
				move = move,
				seq = run.seq,
				run = nil,
				frame = -1,
				lastActive = true,
				origin = start,
				direction = direction,
				projectile = true,
				followUp = run.followUp,
			},
			position = start,
			direction = direction,
			speed = spec.Speed,
			range = spec.Range,
			travelled = 0,
			radius = spec.Radius,
			ground = spec.Ground,
		}
		table.insert(shots, shot)
		run.projectiles += 1
		owner.hooks.fx({
			type = "Projectile",
			id = shot.id,
			attacker = owner.character,
			move = move.Id,
			position = start,
			direction = direction,
			speed = spec.Speed,
			range = spec.Range,
			ground = spec.Ground,
		})
	end
end

local function finish(index: number, shot: Shot)
	table.remove(shots, index)
	shot.owner:ProjectileDone(shot.hit.seq)
	shot.owner.hooks.fx({ type = "ProjectileEnd", id = shot.id, position = shot.position })
end

-- Every frame.
function Projectiles.Step(dt: number)
	if #shots == 0 then
		return
	end
	local params = worldParams()
	for i = #shots, 1, -1 do
		local shot = shots[i]
		local owner = shot.owner
		local stepLength = math.min(shot.speed * dt, shot.range - shot.travelled)
		local nextPosition = shot.position + shot.direction * stepLength
		local stopped = false
		if shot.ground then
			-- Follow the floor: look for it around the next spot; no floor (or a wall) ends it.
			local floor = castWorld(nextPosition + Vector3.new(0, FLOOR_REACH / 2, 0), Vector3.new(0, -FLOOR_REACH, 0), params)
			if floor then
				nextPosition = floor.Position + Vector3.new(0, 0.5, 0)
			else
				stopped = true
			end
		else
			local wall = castWorld(shot.position, nextPosition - shot.position, params)
			if wall then
				nextPosition = wall.Position
				stopped = true
			end
		end
		shot.travelled += stepLength
		shot.position = nextPosition
		shot.hit.origin = nextPosition

		-- Who it touches.
		local overlap = OverlapParams.new()
		overlap.FilterType = Enum.RaycastFilterType.Include
		local others: { Instance } = {}
		for _, other in owner.hooks.all() do
			if other.character ~= owner.character and other.humanoid.Health > 0 then
				table.insert(others, other.character)
			end
		end
		overlap.FilterDescendantsInstances = others
		local centre = if shot.ground then nextPosition + Vector3.new(0, 1.5, 0) else nextPosition
		local done = false
		for _, part in Workspace:GetPartBoundsInRadius(centre, shot.radius + 0.5, overlap) do
			local model = part:FindFirstAncestorOfClass("Model")
			while model and not model:FindFirstChildOfClass("Humanoid") do
				model = model:FindFirstAncestorOfClass("Model")
			end
			local target = if model then owner.hooks.fighterOf(model) else nil
			if target then
				local onFloor = target:Grounded() or target.state == "Downed"
				if not shot.ground or onFloor then
					if owner.hooks.resolve(owner, target, shot.hit) then
						done = true
						break
					end
				end
			end
		end
		if done or stopped or shot.travelled >= shot.range then
			finish(i, shot)
		end
	end
end

return Projectiles
]]></ProtectedString></Properties></Item></Item><Item class="Script" referent="RBX8367711550BD4BD2953964709512D79F"><Properties><string name="Name">CombatServer</string><ProtectedString name="Source"><![CDATA[--!strict
-- CombatServer (Script)
-- Location: ServerScriptService > CombatServer
--
-- Runs combat. The server owns every hit, resource and cooldown (docs/DesignPlan.md):
--   * a Fighter (Combat > Fighter) for every player character and every training dummy
--   * the combat remotes (ReplicatedStorage > Remotes > Combat, see CombatRemotes)
--   * every frame: each fighter's timers, moves, hitboxes (HitResolver), stamina, build-up
--   * gives every character the sword, the dagger (WeaponModels) and the Lotus Fungus (FungusParts)
--     until the loadout menu exists
--   * flies projectiles (Projectiles: spores, the ground strand)
-- Clients only ask: "start this move", "F is down", "R let go", "tech roll", "I spent stamina".
--
-- Studio only: the Debug remote (test panel helpers) and hitbox broadcasting
-- (ReplicatedStorage attribute "CombatShowHitboxes", toggled by the hitbox viewer in the settings menu).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local IS_STUDIO = RunService:IsStudio()

local Combat = ReplicatedStorage:WaitForChild("Combat")
local CombatRemotes = require(Combat:WaitForChild("CombatRemotes"))
local WeaponModels = require(Combat:WaitForChild("WeaponModels"))
local FighterCollision = require(Combat:WaitForChild("FighterCollision"))
local FungusParts = require(Combat:WaitForChild("FungusParts"))
local Config = require(Combat:WaitForChild("CombatConfig"))

local ServerCombat = script.Parent:WaitForChild("Combat")
local Fighter = require(ServerCombat:WaitForChild("Fighter"))
local HitResolver = require(ServerCombat:WaitForChild("HitResolver"))
local Projectiles = require(ServerCombat:WaitForChild("Projectiles"))
local Dummies = require(ServerCombat:WaitForChild("Dummies"))

type Fighter = Fighter.Fighter

local remotes = CombatRemotes.Create()
local fighters: { [Model]: Fighter } = {}
local dummyByModel: { [Model]: Dummies.Dummy } = {}

local function reject(player: Player, why: string)
	if IS_STUDIO then
		warn(string.format("[Combat] %s: %s", player.Name, why))
	end
end

local hooks: Fighter.Hooks = {
	react = function(fighter: Fighter, info: { [string]: any })
		local player = fighter.player
		if player then
			remotes.Hit:FireClient(player, info)
		else
			local dummy = dummyByModel[fighter.character]
			if dummy then
				dummy.reactions:React(info)
			end
		end
	end,
	result = function(fighter: Fighter, seq: number, result: string, hitstop: number, advantage: number?)
		local player = fighter.player
		if player then
			remotes.Result:FireClient(player, seq, result, hitstop, advantage)
		end
	end,
	fx = function(info: { [string]: any })
		if info.type == "Hitbox" then
			if IS_STUDIO and ReplicatedStorage:GetAttribute("CombatShowHitboxes") == true then
				remotes.Fx:FireAllClients(info)
			end
			return
		end
		remotes.Fx:FireAllClients(info)
	end,
	all = function(): { Fighter }
		local out = {}
		for _, fighter in fighters do
			table.insert(out, fighter)
		end
		return out
	end,
	fighterOf = function(model: Model): Fighter?
		return fighters[model]
	end,
	resolve = HitResolver.Resolve,
	shoot = function(fighter: Fighter, run: Fighter.Run)
		Projectiles.Fire(fighter, run)
	end,
}

local function register(model: Model, fighter: Fighter)
	fighters[model] = fighter
end

-- PLAYERS -------------------------------------------------------------------------------------

local function onCharacter(player: Player, character: Model)
	character:WaitForChild("HumanoidRootPart", 10)
	character:WaitForChild("Right Arm", 10)
	character:WaitForChild("Left Arm", 10)
	character:WaitForChild("Torso", 10)
	if not character.Parent then
		return
	end
	if character:GetAttribute("Element") == nil then
		character:SetAttribute("Element", "Wind")
	end
	local ok, err = pcall(WeaponModels.Attach, character)
	if not ok then
		warn("[Combat] couldn't attach the weapons: " .. tostring(err))
	end
	character:WaitForChild("Head", 10)
	local grown, why = pcall(FungusParts.Attach, character)
	if not grown then
		warn("[Combat] couldn't grow the fungus: " .. tostring(why))
	end
	character:SetAttribute("Magic", "Lotus")
	FighterCollision.Apply(character)
	fighters[character] = Fighter.new(character, player, hooks)
	character.AncestryChanged:Connect(function()
		if not character:IsDescendantOf(game) then
			fighters[character] = nil
		end
	end)
end

local function onPlayer(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
end

Players.PlayerAdded:Connect(onPlayer)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayer, player)
end

local function fighterOfPlayer(player: Player): Fighter?
	local character = player.Character
	return if character then fighters[character] else nil
end

-- REMOTES -------------------------------------------------------------------------------------

remotes.Move.OnServerEvent:Connect(function(player: Player, moveId: unknown, seq: unknown)
	if typeof(moveId) ~= "string" or typeof(seq) ~= "number" or #moveId > 40 then
		return
	end
	local fighter = fighterOfPlayer(player)
	if not fighter then
		return
	end
	local why = fighter:RequestMove(moveId, seq)
	if why ~= "" and why ~= "queue" then
		reject(player, string.format("%s refused: %s", moveId, why))
		remotes.Result:FireClient(player, seq, "Reject", 0)
	end
end)

remotes.Block.OnServerEvent:Connect(function(player: Player, held: unknown)
	local fighter = fighterOfPlayer(player)
	if fighter and typeof(held) == "boolean" then
		fighter:SetBlock(held)
	end
end)

remotes.Release.OnServerEvent:Connect(function(player: Player, slot: unknown)
	local fighter = fighterOfPlayer(player)
	if fighter and typeof(slot) == "string" then
		fighter:ReleaseKey(slot)
	end
end)

remotes.Tech.OnServerEvent:Connect(function(player: Player)
	local fighter = fighterOfPlayer(player)
	if fighter then
		fighter:TechRoll()
	end
end)

remotes.Stamina.OnServerEvent:Connect(function(player: Player, amount: unknown)
	local fighter = fighterOfPlayer(player)
	if fighter and typeof(amount) == "number" and amount > 0 and amount <= Config.StaminaMax then
		fighter:SpendStamina(amount)
	end
end)

-- Studio test helpers (the in-Studio test panel). Does nothing on a live server.
remotes.Debug.OnServerInvoke = function(player: Player, op: unknown, a: unknown, b: unknown): any
	if not IS_STUDIO or typeof(op) ~= "string" then
		return nil
	end
	local own = fighterOfPlayer(player)
	local function dummyNamed(name: unknown): Dummies.Dummy?
		return if typeof(name) == "string" then Dummies.Get(name) else nil
	end
	if op == "State" then
		local model = if typeof(a) == "Instance" and a:IsA("Model") then a else player.Character
		local fighter = if model then fighters[model] else nil
		return if fighter then fighter:Snapshot() else nil
	elseif op == "SetStamina" and own and typeof(a) == "number" then
		own:SetStamina(a)
	elseif op == "SetHealth" and own and typeof(a) == "number" then
		own.humanoid.Health = math.clamp(a, 1, own.humanoid.MaxHealth)
	elseif op == "ClearCooldowns" and own then
		table.clear(own.cooldowns)
		own.chain = 0
	elseif op == "Reset" and own then
		own:Interrupt()
		own:SetState("Idle")
		own:SetStamina(Config.StaminaMax)
		table.clear(own.cooldowns)
		own.chain = 0
		own.buildup = 0
		own.draftedUntil = 0
		own.parryLockUntil = 0
		own.humanoid.Health = own.humanoid.MaxHealth
		own:SetMeter(0)
		own.formActive = false
		own.infestedUntil = 0
	elseif op == "DummyMode" then
		local dummy = dummyNamed(a)
		if dummy and typeof(b) == "string" and table.find(Dummies.Modes, b) then
			dummy.model:SetAttribute("DummyMode", b)
			dummy.fighter:SetBlock(false)
			return true
		end
	elseif op == "ResetDummy" then
		local dummy = dummyNamed(a)
		if dummy then
			Dummies.Reset(dummy)
			if typeof(b) == "CFrame" then
				dummy.model:PivotTo(b)
			end
			return true
		end
	elseif op == "DummyMove" then
		local dummy = dummyNamed(a)
		if dummy and typeof(b) == "string" then
			return dummy.fighter:RequestMove(b, 0)
		end
	elseif op == "DummyBlock" then
		local dummy = dummyNamed(a)
		if dummy and typeof(b) == "boolean" then
			dummy.fighter:SetBlock(b)
			return true
		end
	elseif op == "DummyStamina" then
		local dummy = dummyNamed(a)
		if dummy and typeof(b) == "number" then
			dummy.fighter:SetStamina(b)
			return true
		end
	elseif op == "SetLotus" and own and typeof(a) == "number" then
		own:SetMeter(a)
		own.formActive = false
	elseif op == "DummyLotus" then
		local dummy = dummyNamed(a)
		if dummy and typeof(b) == "number" then
			dummy.fighter:SetMeter(b)
			return true
		end
	elseif op == "LaunchDummy" then
		-- Throws a dummy straight up (tests that need an airborne target).
		local dummy = dummyNamed(a)
		if dummy then
			local height = if typeof(b) == "number" then b else 20
			dummy.fighter:Knock("Launched", 1.2)
			dummy.reactions:React({ kind = "Launch", velocity = Vector3.new(0, math.sqrt(2 * workspace.Gravity * height), 0), stun = 1.2, hitstop = 0 })
			return true
		end
	elseif op == "Scaling" then
		-- Damage scale by combo hit number (1-10), without and with a linker earlier in the combo.
		local plain, linked = {}, {}
		for hits = 1, 10 do
			plain[hits] = HitResolver.Scale({ hits = hits, launches = 0, afterLinker = false, damage = 0 })
			linked[hits] = HitResolver.Scale({ hits = hits, launches = 0, afterLinker = true, damage = 0 })
		end
		return { plain = plain, linked = linked }
	elseif op == "ShowHitboxes" then
		ReplicatedStorage:SetAttribute("CombatShowHitboxes", a == true)
		return true
	end
	return nil
end

-- DUMMIES -------------------------------------------------------------------------------------

for _, dummy in Dummies.Spawn(hooks, register) do
	dummyByModel[dummy.model] = dummy
end

-- EVERY FRAME ---------------------------------------------------------------------------------

local function fighterOf(model: Model): Fighter?
	return fighters[model]
end

local lastBeat = os.clock()
RunService.Heartbeat:Connect(function()
	local now = os.clock()
	Projectiles.Step(math.min(now - lastBeat, 0.1))
	lastBeat = now
	for model, fighter in fighters do
		if model.Parent then
			fighter:Step(now)
		end
	end
	Dummies.Step(now, fighterOf)
end)
