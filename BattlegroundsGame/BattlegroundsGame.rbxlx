					<UniqueId name="UniqueId">02ef6e543fe1adde0acd19b000000402</UniqueId>
				<ProtectedString name="Source"><![CDATA[--!strict
-- WallHop (ModuleScript)
-- Location: ReplicatedStorage > Movement > WallHop
--
-- JJS-style wall hopping for one character (client side, next to CharacterMotor and Dash).
--
--   Start: in the air with Space held (or pressed a moment ago) and your input pointing INTO a
--          wall AND ALONG it at the same time (W+D / W+A toward a wall, the JJS input). Running
--          parallel to a wall or straight into it does NOT hop: parkour must be intentional.
--          v3 edge cases (Isaac, Sep 26):
--            * The run ALWAYS goes the way your input points along the wall, never from your
--              momentum or the camera, so you can't hop the opposite way you're going.
--            * The wall must continue ahead of you (no hop that instantly runs off a corner or the
--              wall's end), there must be headroom (no hop under a ceiling), and other characters
--              don't count as walls.
--            * With two walls in reach (alley, inner corner), the one your input points into most
--              is used.
--            * Turning your input to point the other way along the wall mid-run kicks you off
--              immediately (you change direction instead of being carried the old way).
--          v4 (Isaac, Sep 26):
--            * Just jumping into a wall does NOT hop. After leaving the ground you either keep
--              HOLDING Space from the jump, or PRESS Space again in the air. The press that made
--              the jump doesn't count.
--            * A press slightly before reaching the wall (0.25 s) or slightly after leaving it
--              (0.12 s, "wall coyote time") still hops.
--            * Kick strength follows your keys when you leave the wall: still pointing into it
--              = small push (climb the same wall); along it = medium; pointing AWAY (toward the
--              other wall of an alley) = big push across, so zig-zagging reaches the other side.
--              Pointing away mid-run kicks you off right then; pointing away within
--              WallHopLateLeap after the kick still upgrades it to the big push.
--            * The run keeps your speed along the wall if you arrive faster than the run speed.
--          v5 (Isaac, Sep 26): the KEYS must be a forward key plus a side key (W+D / W+A),
--            checked relative to the camera. Before, only the world direction was checked, so W
--            alone at an angle to a wall counted as "into and along" and hopped.
--            * "Holding" means held longer than a tap (WallHopHoldTime), so a quick jump while
--              standing right next to a wall doesn't hop either. A press just before landing is a
--              buffered jump, not a hop press; a coyote jump press isn't one either.
--   Run:   you run along the wall and upward for WallRunTime (the wall holds you up).
--   Kick:  you jump off, away from the wall, carrying your speed along it. Holding Space and
--          steering back into a wall chains another hop.
--   Hops per airtime depend on health (MovementConfig: 3 / 2 / 1). Landing refills them.
--   Characters at least WallHopScaleFrom times normal size hop proportionally faster/farther.
--
-- Animations: plays "WallRunRight" / "WallRunLeft" while running and "WallHopRight" /
-- "WallHopLeft" on the kick, by which side the wall is on (Right = wall on your right). Each loads
-- only if it exists (AnimationConfig.Ids or a Studio KeyframeSequence); without it the normal
-- jump / fall animations show.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(script.Parent.MovementConfig)
local Perf = require(script.Parent.Perf)
local AnimConfig = require(script.Parent.AnimationConfig)
local CharacterMotor = require(script.Parent.CharacterMotor)
local AnimationLibrary = require(script.Parent.AnimationLibrary)
local Sfx = require(script.Parent.Sfx)

-- Surfaces with |normal.Y| below this count as walls.
local WALL_MAX_NORMAL_Y = 0.3

local function flatten(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

type Phase = "Idle" | "Running"
type Candidate = { hit: RaycastResult, normal: Vector3, into: number, along: Vector3 }

local WallHop = {}
WallHop.__index = WallHop

type WallHopData = {
	character: Model,
	humanoid: Humanoid,
	root: BasePart,
	motor: CharacterMotor.CharacterMotor,
	isBlocked: () -> boolean,
	attachment: Attachment,
	velocity: LinearVelocity,
	align: AlignOrientation,
	castParams: RaycastParams,
	tracks: { [string]: AnimationTrack },
	connections: { RBXScriptConnection },
	destroyed: boolean,
	scale: number,

	phase: Phase,
	runStart: number,
	wallNormal: Vector3,
	runDirection: Vector3,
	runSpeed: number,
	hopsUsed: number,
	lastKick: number,
	kickNormal: Vector3,
	kickPush: number,
	lateLeapOpen: boolean,
	lastWall: Instance?,
	lastPress: number,
	holdStart: number,
	recent: Candidate?,
	recentAt: number,
	totalHops: number,
	wallSide: string,
	runTrack: AnimationTrack?,
	lastFailure: string,
}

export type WallHop = typeof(setmetatable({} :: WallHopData, WallHop))

local active: { [Model]: WallHop } = {}

-- Only loads animations that actually exist, so a missing one doesn't spam warnings.
local function animationExists(name: string): boolean
	local id = AnimConfig.Ids[name]
	if id and id ~= "" then
		return true
	end
	if RunService:IsStudio() then
		local folder = ReplicatedStorage:FindFirstChild(AnimConfig.StudioAnimationsFolder)
		return folder ~= nil and folder:FindFirstChild(name) ~= nil
	end
	return false
end

-- `isBlocked` returns true while something else owns the character (a dash, an attack).
function WallHop.new(character: Model, motor: CharacterMotor.CharacterMotor, isBlocked: () -> boolean): WallHop
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	local root = character:WaitForChild("HumanoidRootPart") :: BasePart

	local attachment = Instance.new("Attachment")
	attachment.Name = "WallHopAttachment"
	attachment.Parent = root

	local velocity = Instance.new("LinearVelocity")
	velocity.Name = "WallRunVelocity"
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	velocity.MaxForce = math.huge
	velocity.Enabled = false
	velocity.Parent = root

	local align = Instance.new("AlignOrientation")
	align.Name = "WallRunFacing"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = attachment
	align.RigidityEnabled = true
	align.Enabled = false
	align.Parent = root

	local castParams = RaycastParams.new()
	castParams.FilterType = Enum.RaycastFilterType.Exclude
	castParams.FilterDescendantsInstances = { character }
	castParams.RespectCanCollide = true

	local tracks: { [string]: AnimationTrack } = {}
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if animator then
		for _, name in { "WallRunRight", "WallRunLeft", "WallHopRight", "WallHopLeft" } do
			if animationExists(name) then
				local animation = AnimationLibrary.Get(name)
				if animation then
					local track = animator:LoadAnimation(animation)
					track.Priority = Enum.AnimationPriority.Action
					tracks[name] = track
				end
			end
		end
	end

	-- Size relative to a normal R6 character (root part is 2 studs tall).
	local sizeRatio = root.Size.Y / 2
	local scale = if sizeRatio >= Config.WallHopScaleFrom then sizeRatio else 1

	local self = setmetatable({
		character = character,
		humanoid = humanoid,
		root = root,
		motor = motor,
		isBlocked = isBlocked,
		attachment = attachment,
		velocity = velocity,
		align = align,
		castParams = castParams,
		tracks = tracks,
		connections = {},
		destroyed = false,
		scale = scale,

		phase = "Idle" :: Phase,
		runStart = 0,
		wallNormal = Vector3.zero,
		runDirection = Vector3.zero,
		runSpeed = 0,
		hopsUsed = 0,
		lastKick = -math.huge,
		kickNormal = Vector3.zero,
		kickPush = 0,
		lateLeapOpen = false,
		lastWall = nil,
		lastPress = -math.huge,
		holdStart = -math.huge,
		recent = nil,
		recentAt = -math.huge,
		totalHops = 0,
		wallSide = "Right",
		runTrack = nil,
		lastFailure = "",
	}, WallHop)

	table.insert(
		self.connections,
		RunService.PreSimulation:Connect(function(dt: number)
			if Perf.enabled then
				local t0 = os.clock()
				self:_step(dt)
				Perf.add("WallHop", os.clock() - t0)
			else
				self:_step(dt)
			end
		end)
	)
	table.insert(
		self.connections,
		humanoid.Died:Connect(function()
			self:Destroy()
		end)
	)

	active[character] = self
	character:SetAttribute("WallRunning", false)
	return self
end

function WallHop.Get(character: Model): WallHop?
	return active[character]
end

-- Call on every Space press. `madeJump` = this press made a jump (on the ground, or a coyote jump
-- just after walking off a ledge). Only airborne presses that did NOT make a jump count as a hop
-- press, so jumping into a wall alone never hops.
function WallHop.OnJumpPressed(self: WallHop, madeJump: boolean?)
	local now = os.clock()
	self.holdStart = now
	if not madeJump and self.motor:GetMode() == "Air" then
		self.lastPress = now
	end
end

-- Hops allowed this airtime at the current health.
function WallHop.GetMaxHops(self: WallHop): number
	local share = self.humanoid.Health / math.max(self.humanoid.MaxHealth, 1)
	if share > 2 / 3 then
		return Config.WallHopsHigh
	elseif share > 1 / 3 then
		return Config.WallHopsMid
	end
	return Config.WallHopsLow
end

function WallHop.GetHopsLeft(self: WallHop): number
	return math.max(self:GetMaxHops() - self.hopsUsed, 0)
end

function WallHop.IsRunning(self: WallHop): boolean
	return self.phase == "Running"
end

-- Total hops since spawn (tests).
function WallHop.GetTotalHops(self: WallHop): number
	return self.totalHops
end

-- Why the last attempt near a wall didn't hop (debug overlay / tests).
function WallHop.GetLastFailure(self: WallHop): string
	return self.lastFailure
end

local function isCharacterPart(instance: Instance): boolean
	local model = instance:FindFirstAncestorOfClass("Model")
	return model ~= nil and model:FindFirstChildOfClass("Humanoid") ~= nil
end

-- Casts from chest and knee height; both must hit the same kind of wall.
function WallHop._castWall(self: WallHop, origin: Vector3, direction: Vector3): RaycastResult?
	local chest = Workspace:Raycast(origin, direction, self.castParams)
	if not chest or math.abs(chest.Normal.Y) >= WALL_MAX_NORMAL_Y or isCharacterPart(chest.Instance) then
		return nil
	end
	local low = Workspace:Raycast(origin - Vector3.new(0, self.root.Size.Y * 0.75, 0), direction, self.castParams)
	if not low or math.abs(low.Normal.Y) >= WALL_MAX_NORMAL_Y then
		return nil
	end
	return chest
end

-- Every wall around the body within reach that the input points into AND along.
-- Returns the one the input points into most.
function WallHop._findWall(self: WallHop, move: Vector3): Candidate?
	local root = self.root
	local reach = root.Size.X / 2 + Config.WallHopReach * self.scale
	local best: Candidate? = nil
	local sawWall = false
	for i = 0, 7 do
		local direction = CFrame.Angles(0, i * math.pi / 4, 0):VectorToWorldSpace(move) * reach
		local hit = self:_castWall(root.Position, direction)
		if hit then
			sawWall = true
			local normal = flatten(hit.Normal)
			if normal.Magnitude > 1e-3 then
				normal = normal.Unit
				local into = -move:Dot(normal)
				local along = move + normal * into
				if into >= Config.WallHopIntoMin and along.Magnitude >= Config.WallHopAlongMin then
					if not best or into > best.into then
						best = { hit = hit, normal = normal, into = into, along = along.Unit }
					end
				elseif not best then
					self.lastFailure = if into < Config.WallHopIntoMin
						then "input not pointing into the wall"
						else "input not pointing along the wall"
				end
			end
		end
	end
	if not sawWall then
		self.lastFailure = "no wall in reach"
	end
	return best
end

-- The wall has to continue ahead in the run direction, and there has to be headroom.
function WallHop._roomToRun(self: WallHop, candidate: Candidate): boolean
	local root = self.root
	local reach = root.Size.X / 2 + Config.WallHopReach * self.scale + 0.5
	local ahead = root.Position + candidate.along * Config.WallHopAheadCheck * self.scale
	if not self:_castWall(ahead, -candidate.normal * reach) then
		self.lastFailure = "wall ends ahead"
		return false
	end
	local headroom = Workspace:Raycast(root.Position, Vector3.yAxis * Config.WallHopHeadroom * self.scale, self.castParams)
	if headroom then
		self.lastFailure = "no headroom"
		return false
	end
	return true
end

function WallHop._step(self: WallHop, _dt: number)
	if self.destroyed then
		return
	end
	local mode = self.motor:GetMode()
	if self.phase == "Idle" then
		if mode == "Air" then
			self:_lateLeap()
		end
		if mode == "Ground" then
			self.lateLeapOpen = false
			self.hopsUsed = 0
			-- A press just before landing is a buffered jump, not a hop press.
			self.lastPress = -math.huge
			self.recent = nil
		end
		self:_tryStart(mode)
	else
		self:_stepRun()
	end
end

-- Keys turned away from the wall just AFTER the kick (a normal reaction time) still get the full
-- push across, so zig-zag timing doesn't have to be frame perfect.
function WallHop._lateLeap(self: WallHop)
	if not self.lateLeapOpen then
		return
	end
	if os.clock() - self.lastKick > Config.WallHopLateLeap then
		self.lateLeapOpen = false
		return
	end
	local move = flatten(self.humanoid.MoveDirection)
	if move.Magnitude < 0.1 or move.Unit:Dot(self.kickNormal) <= Config.WallHopLeapAway then
		return
	end
	self.lateLeapOpen = false
	local extra = Config.WallHopPushAway * self.scale - self.kickPush
	if extra <= 0 then
		return
	end
	local velocity = self.root.AssemblyLinearVelocity
	local horizontal = flatten(velocity) + self.kickNormal * extra
	self.root.AssemblyLinearVelocity = Vector3.new(horizontal.X, velocity.Y, horizontal.Z)
	self.motor:ApplyMomentum(horizontal)
end

-- True when the held keys are a forward key plus a side key (W+A / W+D), judged relative to the
-- camera like the keys themselves (the world direction alone can't tell W from W+D).
function WallHop._diagonalKeys(self: WallHop, move: Vector3): boolean
	local camera = Workspace.CurrentCamera
	local look = if camera then flatten(camera.CFrame.LookVector) else flatten(self.root.CFrame.LookVector)
	if look.Magnitude < 1e-3 then
		look = flatten(self.root.CFrame.LookVector)
	end
	look = look.Unit
	local right = Vector3.new(-look.Z, 0, look.X)
	return move:Dot(look) >= Config.WallHopKeyMin and math.abs(move:Dot(right)) >= Config.WallHopKeyMin
end

function WallHop._tryStart(self: WallHop, mode: string)
	if mode ~= "Air" or self.isBlocked() or self.humanoid.Health <= 0 or self:GetHopsLeft() <= 0 then
		self.recent = nil
		return
	end
	local now = os.clock()
	local move = flatten(self.humanoid.MoveDirection)
	local candidate: Candidate? = nil
	local diagonal = move.Magnitude >= 0.1 and self:_diagonalKeys(move.Unit)
	if move.Magnitude >= 0.1 then
		candidate = self:_findWall(move.Unit)
		if candidate and not diagonal then
			-- W alone (or A / D alone) can point into and along a wall when the camera is at an
			-- angle to it. The JJS input is a forward key AND a side key: W+D / W+A.
			self.lastFailure = "hold W + A or D toward the wall (W alone doesn't hop)"
			candidate = nil
		end
	end
	-- Remember the last usable wall for a moment (a press just after leaving it still hops).
	if candidate then
		self.recent = candidate
		self.recentAt = now
	elseif diagonal and self.recent and now - self.recentAt <= Config.WallHopCoyote then
		candidate = self.recent
	end
	if not candidate then
		return
	end
	-- Space: HELD (longer than a tap, so a quick jump next to a wall doesn't hop), or pressed
	-- again while airborne a moment ago.
	local holding = self.motor:IsJumpHeld() and now - self.holdStart >= Config.WallHopHoldTime
	if not holding and now - self.lastPress > Config.WallHopPressBuffer then
		self.lastFailure = "jumped into the wall: press Space again or hold it"
		return
	end
	local sinceKick = now - self.lastKick
	if sinceKick < Config.WallHopRegrabOther then
		return
	end
	-- The same wall again needs a little longer, so one wall isn't hopped twice by accident.
	if candidate.hit.Instance == self.lastWall and sinceKick < Config.WallHopRegrab then
		return
	end
	if not self:_roomToRun(candidate) then
		return
	end
	self.lastFailure = ""
	self.lastWall = candidate.hit.Instance
	self.lastPress = -math.huge -- one press, one hop
	self.recent = nil
	self:_startRun(candidate.normal, candidate.along)
end

function WallHop._startRun(self: WallHop, normal: Vector3, along: Vector3)
	self.phase = "Running"
	self.runStart = os.clock()
	self.wallNormal = normal
	self.runDirection = along
	-- Which side of the body the wall is on (the body faces along the wall while running).
	local right = along:Cross(Vector3.yAxis)
	self.wallSide = if (-normal):Dot(right) >= 0 then "Right" else "Left"
	-- Keep your speed along the wall if you arrive faster than the run speed.
	local arriving = self.root.AssemblyLinearVelocity:Dot(along)
	self.runSpeed = math.max(Config.WallRunSpeed * self.scale, math.min(arriving, Config.WallRunMaxSpeed * self.scale))
	self.hopsUsed += 1
	self.totalHops += 1

	self.motor:Suspend()
	self.humanoid.AutoRotate = false
	self.velocity.VectorVelocity = self:_runVelocity()
	self.velocity.Enabled = true
	self.align.CFrame = CFrame.lookAlong(Vector3.zero, along)
	self.align.Enabled = true
	self.character:SetAttribute("WallRunning", true)

	local track = self:_sidedTrack("WallRun")
	self.runTrack = track
	if track then
		track:Play(0)
	end
end

-- "WallRun" / "WallHop" for the side the wall is on (e.g. "WallRunRight").
function WallHop._sidedTrack(self: WallHop, base: string): AnimationTrack?
	return self.tracks[base .. self.wallSide]
end

function WallHop._stopRunTrack(self: WallHop)
	local track = self.runTrack
	if track and track.IsPlaying then
		track:Stop(0)
	end
	self.runTrack = nil
end

function WallHop._runVelocity(self: WallHop): Vector3
	local s = self.scale
	-- A small pull into the wall keeps the body against it while running.
	return self.runDirection * self.runSpeed + Vector3.yAxis * Config.WallRunRise * s - self.wallNormal * 2
end

function WallHop._stepRun(self: WallHop)
	local elapsed = os.clock() - self.runStart
	-- Kick off when the time is up, the wall ends, or the input turns back the other way along it.
	local stillOnWall = Workspace:Raycast(
		self.root.Position,
		-self.wallNormal * (self.root.Size.X / 2 + Config.WallHopReach * self.scale + 0.5),
		self.castParams
	) ~= nil
	local move = flatten(self.humanoid.MoveDirection)
	local reversed = move.Magnitude > 0.1 and move.Unit:Dot(self.runDirection) < -0.3
	-- Keys pointing away from the wall = leap off now (toward the other wall of an alley).
	local leaping = move.Magnitude > 0.1 and move.Unit:Dot(self.wallNormal) > Config.WallHopLeapAway
	if elapsed >= Config.WallRunTime or not stillOnWall or reversed or leaping or self.isBlocked() then
		self:_kick()
		return
	end
	self.velocity.VectorVelocity = self:_runVelocity()
end

function WallHop._kick(self: WallHop)
	if self.phase ~= "Running" then
		return
	end
	self.phase = "Idle"
	self.lastKick = os.clock()
	self.velocity.Enabled = false
	self.align.Enabled = false
	self.humanoid.AutoRotate = true
	self.character:SetAttribute("WallRunning", false)
	self:_stopRunTrack()

	local s = self.scale
	local gravity = Workspace.Gravity
	local up = math.sqrt(2 * gravity * Config.WallHopHeight * s)
	-- Push away from the wall by where your keys point as you leave it: into the wall = small (to
	-- climb the same wall), along = medium, away = big (across an alley to the other wall).
	local move = flatten(self.humanoid.MoveDirection)
	local away = if move.Magnitude > 0.1 then move.Unit:Dot(self.wallNormal) else 0
	local push
	if away >= 0 then
		push = Config.WallHopPush + (Config.WallHopPushAway - Config.WallHopPush) * math.min(away / 0.7, 1)
	else
		push = Config.WallHopPush + (Config.WallHopPushInto - Config.WallHopPush) * math.min(-away / 0.7, 1)
	end
	self.kickNormal = self.wallNormal
	self.kickPush = push * s
	self.lateLeapOpen = true
	local carry = math.max(Config.WallHopCarry * s, self.runSpeed * 0.85)
	local horizontal = self.wallNormal * push * s + self.runDirection * carry
	self.root.AssemblyLinearVelocity = horizontal + Vector3.yAxis * up

	-- Hand back to the motor: it keeps this speed in the air, and may rise above a normal jump.
	self.motor:ApplyMomentum(horizontal)
	self.motor:AllowLaunch(0.6)
	self.motor:Resume()

	local hopTrack = self:_sidedTrack("WallHop")
	if hopTrack then
		hopTrack:Play(0)
	end
	Sfx.Play(self.character, "WallKick")
	Sfx.Play(self.character, "Jump", { volume = 0.7, speed = 1.1 })
end

-- Ends a wall run early without kicking (e.g. getting hit, once combat exists).
function WallHop.Cancel(self: WallHop)
	if self.phase ~= "Running" then
		return
	end
	self.phase = "Idle"
	self.velocity.Enabled = false
	self.align.Enabled = false
	self.humanoid.AutoRotate = true
	self.character:SetAttribute("WallRunning", false)
	self:_stopRunTrack()
	self.motor:Resume()
end

function WallHop.Destroy(self: WallHop)
	if self.destroyed then
		return
	end
	self:Cancel()
	self.destroyed = true
	for _, connection in self.connections do
		connection:Disconnect()
	end
	table.clear(self.connections)
	self.velocity:Destroy()
	self.align:Destroy()
	self.attachment:Destroy()
	if active[self.character] == self then
		active[self.character] = nil
	end
end

return WallHop
]]></ProtectedString></Properties>
			</Item>
		<Item class="ModuleScript" referent="RBX81D435DC6F30453481F04B0A8CC3458A">
        <Properties>
          <string name="Name">LanternFx</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- LanternFx (ModuleScript)
-- Location: ReplicatedStorage > Movement > LanternFx
--
-- Client-side lantern visuals shared by the owner (Lantern.luau) and everyone else (LanternViewer):
-- a smooth local copy of a server lantern, its light sphere, and the impact burst.
-- The server lantern is never moved from the client (moving it while it's still welded to the
-- character drags the character with it); it's only hidden with LocalTransparencyModifier.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(script.Parent.MovementConfig)

local LanternFx = {}

LanternFx.GLOW = Color3.fromRGB(120, 240, 255)
LanternFx.CORE_OFF = Color3.fromRGB(46, 110, 118)

-- Hides / shows a server lantern (and its light sphere) on this client only.
function LanternFx.hideServer(model: Model, hidden: boolean)
	local value = if hidden then 1 else 0
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = value
		end
	end
	local ref = model:FindFirstChild("LightSphereRef")
	if ref and ref:IsA("ObjectValue") and ref.Value and ref.Value:IsA("BasePart") then
		ref.Value.LocalTransparencyModifier = value
	end
end

-- A local, anchored copy of a server lantern (no welds, not queryable) plus its own light sphere.
function LanternFx.makeCopy(model: Model, name: string): Model
	local copy = Instance.new("Model")
	copy.Name = name
	local core = model.PrimaryPart
	local coreCopy: BasePart? = nil
	for _, d in model:GetChildren() do
		if d:IsA("BasePart") then
			local p = d:Clone()
			for _, j in p:GetChildren() do
				if j:IsA("JointInstance") or j:IsA("WeldConstraint") or j:IsA("Constraint") then
					j:Destroy()
				end
			end
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Transparency = 0
			p.LocalTransparencyModifier = 0
			if core then
				-- Keep the pieces where they are relative to the core.
				p:SetAttribute("Offset", core.CFrame:ToObjectSpace(d.CFrame))
			end
			p.Parent = copy
			if d == core then
				coreCopy = p
			end
		end
	end
	if coreCopy then
		copy.PrimaryPart = coreCopy
	end
	local sphere = Instance.new("Part")
	sphere.Name = "LightSphere"
	sphere.Shape = Enum.PartType.Ball
	sphere.Size = Vector3.one * Config.LanternLightRadius * 2
	sphere.Color = LanternFx.GLOW
	sphere.Material = Enum.Material.ForceField
	sphere.Anchored = true
	sphere.CanCollide = false
	sphere.CanQuery = false
	sphere.CanTouch = false
	sphere.CastShadow = false
	sphere.Transparency = 1
	sphere.Parent = copy
	copy.Parent = Workspace
	return copy
end

-- Places a copy: `cf` for the core; the other pieces keep their offsets; the sphere is centred.
function LanternFx.placeCopy(copy: Model, cf: CFrame)
	for _, p in copy:GetChildren() do
		if p:IsA("BasePart") then
			if p.Name == "LightSphere" then
				p.CFrame = CFrame.new(cf.Position)
			else
				local offset = p:GetAttribute("Offset")
				p.CFrame = if typeof(offset) == "CFrame" then cf * offset else cf
			end
		end
	end
end

-- Lit (glowing core) while thrown or hanging; the light sphere only while hanging.
function LanternFx.styleCopy(copy: Model, state: string)
	local lit = state == "Thrown" or state == "Suspended"
	local core = copy.PrimaryPart
	if core then
		core.Material = if lit then Enum.Material.Neon else Enum.Material.SmoothPlastic
		core.Color = if lit then LanternFx.GLOW else LanternFx.CORE_OFF
	end
	local sphere = copy:FindFirstChild("LightSphere")
	if sphere and sphere:IsA("BasePart") then
		sphere.Transparency = if state == "Suspended" then 0.82 else 1
	end
end

-- The orientation for a copy at `position`: upright when still, nose along `velocity` while flying.
function LanternFx.pose(position: Vector3, velocity: Vector3?, flying: boolean): CFrame
	if flying and velocity and velocity.Magnitude > 1 then
		local look = velocity.Unit
		local up = if math.abs(look.Y) > 0.95 then Vector3.zAxis else Vector3.yAxis
		return CFrame.lookAt(position, position + look, up)
	end
	return CFrame.new(position)
end

-- The impact burst: a quick flash of the lantern's light (radius = LanternBurstRadius).
function LanternFx.burst(position: Vector3)
	local radius = Config.LanternBurstRadius
	local flash = Instance.new("Part")
	flash.Name = "LanternBurst"
	flash.Shape = Enum.PartType.Ball
	flash.Material = Enum.Material.Neon
	flash.Color = LanternFx.GLOW
	flash.Size = Vector3.one
	flash.CFrame = CFrame.new(position)
	flash.Anchored = true
	flash.CanCollide = false
	flash.CanQuery = false
	flash.CanTouch = false
	flash.CastShadow = false
	flash.Transparency = 0.3
	local light = Instance.new("PointLight")
	light.Color = LanternFx.GLOW
	light.Range = radius * 1.5
	light.Brightness = 4
	light.Parent = flash
	flash.Parent = Workspace.CurrentCamera or Workspace
	local duration = 0.3
	local start = os.clock()
	local connection: RBXScriptConnection? = nil
	connection = RunService.RenderStepped:Connect(function()
		local t = math.clamp((os.clock() - start) / duration, 0, 1)
		flash.Size = Vector3.one * (radius * 2 * (0.3 + 0.7 * t))
		flash.Transparency = 0.3 + 0.7 * t
		light.Brightness = 4 * (1 - t)
		if t >= 1 then
			flash:Destroy()
			if connection then
				connection:Disconnect()
			end
		end
	end)
end

return LanternFx
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX3A64BD92BA3E4A04B2D2E1EA8ED3B624">
        <Properties>
          <string name="Name">LanternPhysics</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- LanternPhysics (ModuleScript)
-- Location: ReplicatedStorage > Movement > LanternPhysics
--
-- The thrown lantern's flight, shared by everything that needs it so they always agree:
--   * the owner's throw preview (dots + ring) and the real throw (Lantern.luau) run the SAME fixed
--     steps, so the lantern lands where the ring is (unless someone walks into it);
--   * other players' clients (LanternViewer) replay the same arc from the throw's start values;
--   * the server uses the same numbers to check reports.
-- The flight is a plain projectile: launch velocity + constant gravity (Workspace.Gravity x
-- LanternThrowGravity). Positions are exact for constant gravity, so the step size only decides how
-- often we check for collisions, not where the lantern is.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Config = require(script.Parent.MovementConfig)

local LanternPhysics = {}

LanternPhysics.STEP = 1 / 60
-- World collision size (radius) and how close to a character counts as a hit (radius, generous so
-- moving / jumping targets are fair to hit).
LanternPhysics.WORLD_RADIUS = 0.45
LanternPhysics.CHARACTER_RADIUS = 1.1

export type Hit = {
	kind: "World" | "Character",
	position: Vector3, -- where the lantern's centre is at the moment of contact
	normal: Vector3,
	instance: Instance,
	character: Model?,
}

function LanternPhysics.gravity(): number
	return Workspace.Gravity * Config.LanternThrowGravity
end

-- Position / velocity `t` seconds after launch.
function LanternPhysics.at(origin: Vector3, velocity: Vector3, gravity: number, t: number): (Vector3, Vector3)
	local pos = origin + velocity * t - Vector3.new(0, 0.5 * gravity * t * t, 0)
	local vel = velocity - Vector3.new(0, gravity * t, 0)
	return pos, vel
end

-- Launch velocity with `speed` that passes through `target` (the flatter of the two arcs). If the
-- target is out of reach at that speed, throws at the angle that gets closest (max range toward it).
function LanternPhysics.solve(from: Vector3, target: Vector3, speed: number, gravity: number): Vector3
	local delta = target - from
	local flat = Vector3.new(delta.X, 0, delta.Z)
	local dx = flat.Magnitude
	local dy = delta.Y
	if dx < 1e-3 then
		-- Straight up / down.
		return Vector3.new(0, if dy >= 0 then speed else -speed, 0)
	end
	local dir = flat / dx
	local v2 = speed * speed
	local disc = v2 * v2 - gravity * (gravity * dx * dx + 2 * dy * v2)
	local angle: number
	if disc >= 0 then
		angle = math.atan((v2 - math.sqrt(disc)) / (gravity * dx))
	else
		-- Out of reach: the max-range angle for a target at this slope.
		angle = math.pi / 4 + math.atan2(dy, dx) / 2
	end
	return dir * (speed * math.cos(angle)) + Vector3.new(0, speed * math.sin(angle), 0)
end

-- Every living character except `owner` (players and NPC dummies). Used as the Include list for
-- character hits and the Exclude list for world hits.
function LanternPhysics.characters(owner: Model?): { Model }
	local list: { Model } = {}
	local seen: { [Model]: boolean } = {}
	for _, player in Players:GetPlayers() do
		local c = player.Character
		if c and c ~= owner and c.Parent then
			seen[c] = true
			table.insert(list, c)
		end
	end
	for _, child in Workspace:GetChildren() do
		if child:IsA("Model") and child ~= owner and not seen[child] then
			local humanoid = child:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health > 0 and child:FindFirstChild("HumanoidRootPart") then
				table.insert(list, child)
			end
		end
	end
	return list
end

export type Casts = {
	world: RaycastParams,
	characters: RaycastParams?,
}

-- Cast params for a flight: the world (collidable parts only; characters, the owner and `extra`
-- ignored) and, if `hitCharacters`, the other characters.
function LanternPhysics.params(owner: Model?, extra: { Instance }?, hitCharacters: boolean): Casts
	local others = LanternPhysics.characters(owner)
	local ignore: { Instance } = {}
	if owner then
		table.insert(ignore, owner)
	end
	for _, c in others do
		table.insert(ignore, c)
	end
	if extra then
		for _, e in extra do
			table.insert(ignore, e)
		end
	end
	local world = RaycastParams.new()
	world.FilterType = Enum.RaycastFilterType.Exclude
	world.FilterDescendantsInstances = ignore
	world.RespectCanCollide = true
	local chars: RaycastParams? = nil
	if hitCharacters and #others > 0 then
		local p = RaycastParams.new()
		p.FilterType = Enum.RaycastFilterType.Include
		local include: { Instance } = {}
		for _, c in others do
			table.insert(include, c)
		end
		p.FilterDescendantsInstances = include
		p.RespectCanCollide = false
		chars = p
	end
	return { world = world, characters = chars }
end

local function characterOf(part: Instance): Model?
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid then
			return model
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end
LanternPhysics.characterOf = characterOf

-- What the lantern runs into moving from `from` by `delta` (nil = nothing). A living character that's
-- reached first wins over the world.
function LanternPhysics.cast(from: Vector3, delta: Vector3, casts: Casts): Hit?
	if delta.Magnitude < 1e-5 then
		return nil
	end
	local best: Hit? = nil
	local bestDist = math.huge
	local w = Workspace:Spherecast(from, LanternPhysics.WORLD_RADIUS, delta, casts.world)
	if w then
		bestDist = w.Distance
		best = {
			kind = "World",
			position = from + delta.Unit * w.Distance,
			normal = w.Normal,
			instance = w.Instance,
			character = nil,
		}
	end
	if casts.characters then
		local c = Workspace:Spherecast(from, LanternPhysics.CHARACTER_RADIUS, delta, casts.characters)
		if c and c.Distance <= bestDist then
			local who = characterOf(c.Instance)
			local humanoid = if who then who:FindFirstChildOfClass("Humanoid") else nil
			if who and humanoid and humanoid.Health > 0 then
				best = {
					kind = "Character",
					position = from + delta.Unit * c.Distance,
					normal = c.Normal,
					instance = c.Instance,
					character = who,
				}
			end
		end
	end
	return best
end

-- The whole predicted flight (for the preview): points every step until it hits something or
-- `maxTime` runs out. Returns (points, hit?).
function LanternPhysics.predict(
	origin: Vector3,
	velocity: Vector3,
	gravity: number,
	casts: Casts,
	maxTime: number
): ({ Vector3 }, Hit?)
	local points = { origin }
	local step = LanternPhysics.STEP
	local prev = origin
	local t = 0
	while t < maxTime do
		t += step
		local pos = LanternPhysics.at(origin, velocity, gravity, t)
		local hit = LanternPhysics.cast(prev, pos - prev, casts)
		if hit then
			table.insert(points, hit.position)
			return points, hit
		end
		table.insert(points, pos)
		prev = pos
	end
	return points, nil
end

-- True if nothing solid is between `a` and `b` (characters and `ignore` don't block).
function LanternPhysics.clearLine(a: Vector3, b: Vector3, casts: Casts): boolean
	return Workspace:Raycast(a, b - a, casts.world) == nil
end

return LanternPhysics
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXA7453DC2E11743D587E79BDF85234C45"><Properties><string name="Name">Controls</string><ProtectedString name="Source"><![CDATA[--!strict
-- Controls (ModuleScript)
-- Location: ReplicatedStorage > Movement > Controls
--
-- The movement keys as named actions, so the keyboard and the tests go through the same code.
-- MovementController registers the actions for its character; the keyboard handlers call them,
-- and the in-Studio tests (StarterPlayerScripts > Tests) call them the same way:
--   Controls.Get(character).press.Dash()
-- Actions: Jump (Space), Dash (Shift), Race (Left Ctrl), Forward (W), M1 (left click),
-- M2 (right click: the secondary weapon), One (1: the weapon ability), Block (F: hold to block,
-- a fresh press is a parry try), and the magic keys Two, Three, Four (2 / 3 / 4), R (hold = heal,
-- tap = rip out) and G. A press without a release is fine for one-shot actions.
--
-- The Humanoid's own jump (Humanoid.Jump while Space is held) comes from Roblox's control script,
-- not from here: tests that hold Jump set Humanoid.Jump themselves.

export type ActionName =
	"Jump"
	| "Dash"
	| "Race"
	| "Forward"
	| "M1"
	| "M2"
	| "One"
	| "Block"
	| "Two"
	| "Three"
	| "Four"
	| "R"
	| "G"
export type ActionSet = {
	Jump: () -> (),
	Dash: () -> (),
	Race: () -> (),
	Forward: () -> (),
	M1: () -> (),
	M2: () -> (),
	One: () -> (),
	Block: () -> (),
	Two: () -> (),
	Three: () -> (),
	Four: () -> (),
	R: () -> (),
	G: () -> (),
}
export type Actions = { press: ActionSet, release: ActionSet }

local Controls = {}

local registry: { [Model]: Actions } = {}

function Controls.Register(character: Model, actions: Actions)
	registry[character] = actions
end

function Controls.Unregister(character: Model)
	registry[character] = nil
end

function Controls.Get(character: Model): Actions?
	return registry[character]
end

return Controls
]]></ProtectedString></Properties></Item></Item>
		<Item class="Folder" referent="RBX7050CE8A3DEA458CB468B596BB06B8A2">
			<Properties>
				<Color3 name="IconTint">
					<R>0</R>
					<G>0</G>
					<B>0</B>
				</Color3>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">Remotes</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">02ef6e543fe1adde0acd19b000000403</UniqueId>
			</Properties>
			<Item class="RemoteEvent" referent="RBX21A7965EE25D4A72AE7B08CDE5A6124C">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">DashPunch</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">02ef6e543fe1adde0acd19b000000404</UniqueId>
				</Properties>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX0EB7ED904C7A4AF5BA337CEC6E8E0CEC"><Properties><string name="Name">Combat</string></Properties><Item class="ModuleScript" referent="RBXD04A90DA9E984966867F569178B96D36"><Properties><string name="Name">CombatAnimator</string><ProtectedString name="Source"><![CDATA[--!strict
-- CombatAnimator (ModuleScript)
-- Location: ReplicatedStorage > Combat > CombatAnimator
--
-- Plays one character's combat animations (attacks, block, parry, hit reactions) on its
-- Animator. Used where the character's animations are owned: the player's own client
-- (CombatClient) or the server for a training dummy. Everything snaps (fade 0), like the rest.
--
--   anim:Play(name, speed?)   stops the combat animation playing, plays `name` from the start
--   anim:Hold(name, on)       a looped pose layered under the others (BlockHold)
--   anim:Stop()               stops everything this module started
--   anim:Freeze(seconds)      hit pause: every playing track holds still, then carries on

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AnimationLibrary = require(ReplicatedStorage:WaitForChild("Movement"):WaitForChild("AnimationLibrary"))

local CombatAnimator = {}
CombatAnimator.__index = CombatAnimator

type Data = {
	animator: Animator,
	tracks: { [string]: AnimationTrack },
	current: string?,
	holds: { [string]: boolean },
	frozenUntil: number,
	frozen: { [AnimationTrack]: number },
}

export type CombatAnimator = typeof(setmetatable({} :: Data, CombatAnimator))

function CombatAnimator.new(humanoid: Humanoid): CombatAnimator
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		local created = Instance.new("Animator")
		created.Parent = humanoid
		animator = created
	end
	assert(animator, "CombatAnimator: no Animator")
	return setmetatable({
		animator = animator,
		tracks = {},
		current = nil,
		holds = {},
		frozenUntil = 0,
		frozen = {},
	} :: Data, CombatAnimator)
end

function CombatAnimator._track(self: CombatAnimator, name: string): AnimationTrack?
	local track = self.tracks[name]
	if track then
		return track
	end
	local animation = AnimationLibrary.Get(name)
	if not animation then
		return nil
	end
	local loaded = self.animator:LoadAnimation(animation)
	loaded.Priority = Enum.AnimationPriority.Action
	self.tracks[name] = loaded
	return loaded
end

function CombatAnimator.Play(self: CombatAnimator, name: string, speed: number?): AnimationTrack?
	local current = self.current
	if current and current ~= name then
		local old = self.tracks[current]
		if old and old.IsPlaying then
			old:Stop(0)
		end
	end
	local track = self:_track(name)
	self.current = name
	if track then
		track:Play(0, 1, speed or 1)
		-- Starting over from the first frame even when it was already playing.
		track.TimePosition = 0
	end
	return track
end

function CombatAnimator.GetCurrent(self: CombatAnimator): string?
	local current = self.current
	if current then
		local track = self.tracks[current]
		if track and track.IsPlaying then
			return current
		end
	end
	return nil
end

-- Stops `name` if it's the one playing (or anything, with no name).
function CombatAnimator.StopMove(self: CombatAnimator, name: string?)
	local current = self.current
	if current and (name == nil or name == current) then
		local track = self.tracks[current]
		if track and track.IsPlaying then
			track:Stop(0)
		end
		self.current = nil
	end
end

function CombatAnimator.Hold(self: CombatAnimator, name: string, on: boolean)
	if (self.holds[name] == true) == on then
		return
	end
	self.holds[name] = on
	local track = self:_track(name)
	if not track then
		return
	end
	if on then
		track.Looped = true
		track:Play(0, 1, 1)
	else
		track:Stop(0)
	end
end

function CombatAnimator.Stop(self: CombatAnimator)
	for name, track in self.tracks do
		if track.IsPlaying then
			track:Stop(0)
		end
		self.holds[name] = nil
	end
	self.current = nil
end

-- Hit pause: holds every playing animation on this character for `seconds`.
function CombatAnimator.Freeze(self: CombatAnimator, seconds: number)
	local now = os.clock()
	self.frozenUntil = math.max(self.frozenUntil, now + seconds)
	for _, track in self.animator:GetPlayingAnimationTracks() do
		if self.frozen[track] == nil and track.Speed ~= 0 then
			self.frozen[track] = track.Speed
			track:AdjustSpeed(0)
		end
	end
	task.delay(seconds, function()
		if os.clock() + 1e-3 < self.frozenUntil then
			return
		end
		for track, speed in self.frozen do
			if track.IsPlaying then
				track:AdjustSpeed(speed)
			end
		end
		table.clear(self.frozen)
	end)
end

return CombatAnimator
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX1135904020BA46C8A9450BC2C4FBB8D1"><Properties><string name="Name">CombatBody</string><ProtectedString name="Source"><![CDATA[--!strict
-- CombatBody (ModuleScript)
-- Location: ReplicatedStorage > Combat > CombatBody
--
-- Moves a character's body for combat: pushback, knockback, launches, hanging in the air, an
-- attacker's step and lunge, the tech roll. It must run where the character's physics is owned:
-- the player's own client (CombatClient) or the server for a training dummy.
--
--   body:Push(velocity, duration, decay?)  hold a flat velocity for `duration` seconds (gravity
--                                          still acts); decay = it slows to 0 over the time
--   body:Hang(duration, velocity?)         hold the whole velocity (default: still, so you float)
--   body:Launch(velocity)                  throw the body (gravity takes over at once)
--   body:Face(direction?)                  hold the facing (nil lets go)
--   body:Release()                         stop everything now
--
-- While it holds the body, the CharacterMotor (if any) is suspended under its own key and the
-- Humanoid doesn't auto-rotate. When it lets go the motor picks up the body's velocity.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CharacterMotor = require(ReplicatedStorage:WaitForChild("Movement"):WaitForChild("CharacterMotor"))

local SUSPEND_KEY = "Combat"

type Mode = "None" | "Plane" | "Vector"

local CombatBody = {}
CombatBody.__index = CombatBody

type Data = {
	character: Model,
	humanoid: Humanoid,
	root: BasePart,
	motor: CharacterMotor.CharacterMotor?,
	attachment: Attachment,
	velocity: LinearVelocity,
	align: AlignOrientation,
	connection: RBXScriptConnection?,
	mode: Mode,
	target: Vector3,
	startedAt: number,
	endsAt: number,
	decay: boolean,
	facing: boolean,
	destroyed: boolean,
}

export type CombatBody = typeof(setmetatable({} :: Data, CombatBody))

function CombatBody.new(character: Model, motor: CharacterMotor.CharacterMotor?): CombatBody
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	local root = character:WaitForChild("HumanoidRootPart") :: BasePart

	local attachment = Instance.new("Attachment")
	attachment.Name = "CombatBodyAttachment"
	attachment.Parent = root

	local velocity = Instance.new("LinearVelocity")
	velocity.Name = "CombatVelocity"
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.MaxForce = math.huge
	velocity.Enabled = false
	velocity.Parent = root

	local align = Instance.new("AlignOrientation")
	align.Name = "CombatFacing"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = attachment
	align.RigidityEnabled = true
	align.Enabled = false
	align.Parent = root

	local self = setmetatable({
		character = character,
		humanoid = humanoid,
		root = root,
		motor = motor,
		attachment = attachment,
		velocity = velocity,
		align = align,
		connection = nil,
		mode = "None" :: Mode,
		target = Vector3.zero,
		startedAt = 0,
		endsAt = 0,
		decay = false,
		facing = false,
		destroyed = false,
	} :: Data, CombatBody)
	self.connection = RunService.PreSimulation:Connect(function()
		self:_step()
	end)
	return self
end

function CombatBody.IsActive(self: CombatBody): boolean
	return self.mode ~= "None"
end

function CombatBody._take(self: CombatBody)
	if self.motor then
		self.motor:Suspend(SUSPEND_KEY)
	end
	self.humanoid.AutoRotate = false
end

function CombatBody._letGo(self: CombatBody)
	if self.motor then
		self.motor:ApplyMomentum(self.root.AssemblyLinearVelocity)
		self.motor:Resume(SUSPEND_KEY)
	end
	if not self.facing then
		self.humanoid.AutoRotate = true
	end
end

function CombatBody.Push(self: CombatBody, flat: Vector3, duration: number, decay: boolean?)
	flat = Vector3.new(flat.X, 0, flat.Z)
	self.mode = "Plane"
	self.target = flat
	self.decay = decay == true
	self.startedAt = os.clock()
	self.endsAt = self.startedAt + duration
	self.velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	self.velocity.PrimaryTangentAxis = Vector3.xAxis
	self.velocity.SecondaryTangentAxis = Vector3.zAxis
	self.velocity.PlaneVelocity = Vector2.new(flat.X, flat.Z)
	self.velocity.Enabled = true
	self:_take()
end

function CombatBody.Hang(self: CombatBody, duration: number, velocity: Vector3?)
	local v = velocity or Vector3.zero
	self.mode = "Vector"
	self.target = v
	self.decay = false
	self.startedAt = os.clock()
	self.endsAt = self.startedAt + duration
	self.velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	self.velocity.VectorVelocity = v
	self.velocity.Enabled = true
	self.root.AssemblyLinearVelocity = v
	self:_take()
end

-- Throws the body: the flat part is held for `hold` seconds (so the Humanoid's ground friction
-- can't eat it on the first frames), the vertical part is left to gravity.
function CombatBody.Launch(self: CombatBody, velocity: Vector3, hold: number?)
	if self.motor then
		self.motor:AllowLaunch(1.5)
	end
	-- Off the floor first, or the Humanoid's floor snap swallows the upward speed.
	if velocity.Y > 0 then
		self.humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	end
	self.root.AssemblyLinearVelocity = velocity
	self:Push(Vector3.new(velocity.X, 0, velocity.Z), hold or 0.1)
end

function CombatBody.Face(self: CombatBody, direction: Vector3?)
	if direction and Vector3.new(direction.X, 0, direction.Z).Magnitude > 1e-3 then
		local flat = Vector3.new(direction.X, 0, direction.Z).Unit
		self.align.CFrame = CFrame.lookAlong(Vector3.zero, flat)
		self.align.Enabled = true
		self.facing = true
		self.humanoid.AutoRotate = false
		-- Snap the body round now (a soft lock-on shouldn't be a slow turn).
		local position = self.root.Position
		self.root.CFrame = CFrame.lookAlong(position, flat)
	else
		self.align.Enabled = false
		self.facing = false
		if self.mode == "None" then
			self.humanoid.AutoRotate = true
		end
	end
end

function CombatBody.Release(self: CombatBody)
	if self.mode == "None" then
		return
	end
	self.mode = "None"
	self.velocity.Enabled = false
	self:_letGo()
end

function CombatBody._step(self: CombatBody)
	if self.mode == "None" or self.destroyed then
		return
	end
	local now = os.clock()
	if now >= self.endsAt then
		self:Release()
		return
	end
	if self.mode == "Plane" and self.decay then
		local share = 1 - (now - self.startedAt) / math.max(self.endsAt - self.startedAt, 1e-3)
		local v = self.target * math.max(share, 0)
		self.velocity.PlaneVelocity = Vector2.new(v.X, v.Z)
	end
end

function CombatBody.Destroy(self: CombatBody)
	if self.destroyed then
		return
	end
	self:Release()
	self.destroyed = true
	if self.connection then
		self.connection:Disconnect()
		self.connection = nil
	end
	self.velocity:Destroy()
	self.align:Destroy()
	self.attachment:Destroy()
end

return CombatBody
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXE8E3175662AE4D359C9A32E4C1F7FA69"><Properties><string name="Name">CombatClient</string><ProtectedString name="Source"><![CDATA[--!strict
-- CombatClient (ModuleScript)
-- Location: ReplicatedStorage > Combat > CombatClient
--
-- Your own character's side of combat, on your client (MovementController creates it). The
-- server decides every hit (CombatServer); this module makes pressing a key feel instant:
--   * picks the move a key makes right now (Loadout: chain position, air, running, Space held),
--     plays it, moves you with it (step, lunge, hanging in the air), and asks the server to run it
--   * clicking during a swing queues the next M1; a move that hit can cancel into its follow-ups
--     (M1 / dagger -> 1), and the launcher's recovery can be jumped out of (JumpCancel)
--   * F: block while held, a fresh press is also a parry try (the server times the window)
--   * reacts to the server: a refused move stops; a hit pauses the swing (hit pause); getting hit,
--     blocking, being parried or knocked down plays out through Reactions
--   * while the server says you're stunned ("Stunned" attribute) you can't move, jump or act;
--     Shift while downed is a tech roll
-- The move's phase is mirrored to the attribute "AttackPhase" (Startup / Active / Recovery) that
-- Dash reads (no dashing out of a wind-up or a hit), and "LocalMove" (CombatFx draws your own
-- slashes from it without waiting for the server).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Movement = ReplicatedStorage:WaitForChild("Movement")
local CharacterMotor = require(Movement:WaitForChild("CharacterMotor"))
local MovementConfig = require(Movement:WaitForChild("MovementConfig"))
local Sfx = require(Movement:WaitForChild("Sfx"))

local Config = require(script.Parent.CombatConfig)
local Moves = require(script.Parent.Moves)
local Loadout = require(script.Parent.Loadout)
local CombatBody = require(script.Parent.CombatBody)
local CombatAnimator = require(script.Parent.CombatAnimator)
local CombatRemotes = require(script.Parent.CombatRemotes)
local Reactions = require(script.Parent.Reactions)
local WeaponModels = require(script.Parent.WeaponModels)
local FighterCollision = require(script.Parent.FighterCollision)

type Move = Moves.Move

local FRAME = 1 / Config.FPS

export type Phase = "Idle" | "Startup" | "Active" | "Recovery"

export type Hooks = {
	-- Stop whatever movement move is running (getting hit, a move cancelling a dash).
	interruptMovement: () -> (),
}

type Current = {
	move: Move,
	seq: number,
	elapsed: number,
	pauseUntil: number,
	result: string?,
	queued: string?,
	phase: Phase,
	look: Vector3,
}

local CombatClient = {}
CombatClient.__index = CombatClient

type Data = {
	character: Model,
	humanoid: Humanoid,
	root: BasePart,
	motor: CharacterMotor.CharacterMotor,
	hooks: Hooks,
	body: CombatBody.CombatBody,
	anim: CombatAnimator.CombatAnimator,
	reactions: Reactions.Reactions,
	remotes: CombatRemotes.Remotes,
	connections: { RBXScriptConnection },

	seq: number,
	current: Current?,
	chain: number,
	chainEndedAt: number,
	cooldowns: { [string]: number },
	cooldownTotals: { [string]: number },
	blockHeld: boolean,
	locked: boolean,
	swings: number,
	lastResult: string,
	lastMove: string,
	lastAdvantage: number?,
	destroyed: boolean,
}

export type CombatClient = typeof(setmetatable({} :: Data, CombatClient))

local active: { [Model]: CombatClient } = {}

function CombatClient.new(character: Model, motor: CharacterMotor.CharacterMotor, hooks: Hooks): CombatClient
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	local root = character:WaitForChild("HumanoidRootPart") :: BasePart
	local body = CombatBody.new(character, motor)
	local anim = CombatAnimator.new(humanoid)
	local self: CombatClient
	local reactions = Reactions.new(character, body, anim, function()
		self:_interrupted()
	end)
	self = setmetatable({
		character = character,
		humanoid = humanoid,
		root = root,
		motor = motor,
		hooks = hooks,
		body = body,
		anim = anim,
		reactions = reactions,
		remotes = CombatRemotes.Get(),
		connections = {},

		seq = 0,
		current = nil,
		chain = 0,
		chainEndedAt = -math.huge,
		cooldowns = {},
		cooldownTotals = {},
		blockHeld = false,
		locked = false,
		swings = 0,
		lastResult = "",
		lastMove = "",
		lastAdvantage = nil,
		destroyed = false,
	} :: Data, CombatClient)

	table.insert(self.connections, RunService.Heartbeat:Connect(function(dt: number)
		self:_step(dt)
	end))
	table.insert(self.connections, self.remotes.Result.OnClientEvent:Connect(function(seq: number, result: string, hitstop: number, advantage: number?)
		if result ~= "Reject" then
			self.lastAdvantage = advantage
		end
		self:_onResult(seq, result, hitstop)
	end))
	table.insert(self.connections, self.remotes.Hit.OnClientEvent:Connect(function(info: { [string]: any })
		self.reactions:React(info)
	end))
	table.insert(self.connections, character:GetAttributeChangedSignal("Stunned"):Connect(function()
		self:_updateLock()
	end))
	active[character] = self
	-- Your own client simulates your body, so its parts (and colliders movement adds) need the
	-- group here too: fighters pass through each other.
	FighterCollision.Apply(character)
	self:_updateLock()
	return self
end

function CombatClient.Get(character: Model): CombatClient?
	return active[character]
end

-- INFO ---------------------------------------------------------------------------------------

function CombatClient.IsLocked(self: CombatClient): boolean
	return self.locked
end

function CombatClient.IsAttacking(self: CombatClient): boolean
	return self.current ~= nil
end

function CombatClient.GetPhase(self: CombatClient): Phase
	local current = self.current
	return if current then current.phase else "Idle"
end

function CombatClient.GetMoveId(self: CombatClient): string?
	local current = self.current
	return if current then current.move.Id else nil
end

-- The chain position of the M1 playing (or the last one).
function CombatClient.GetIndex(self: CombatClient): number
	local current = self.current
	if current and current.move.Chain > 0 then
		return current.move.Chain
	end
	return self.chain
end

function CombatClient.GetSwingCount(self: CombatClient): number
	return self.swings
end

function CombatClient.GetLastResult(self: CombatClient): string
	return self.lastResult
end

function CombatClient.GetLastMove(self: CombatClient): string
	return self.lastMove
end

-- Frame advantage of your last move that hit or was blocked (nil for knockdowns / launches).
function CombatClient.GetLastAdvantage(self: CombatClient): number?
	return self.lastAdvantage
end

function CombatClient.GetFrame(self: CombatClient): number
	local current = self.current
	return if current then math.floor(current.elapsed / FRAME + 1e-6) else -1
end

function CombatClient.GetCooldown(self: CombatClient, group: string): number
	local ready = self.cooldowns[group]
	return if ready then math.max(ready - os.clock(), 0) else 0
end

-- The full length of the cooldown last started in `group` (the variants of a key differ).
function CombatClient.GetCooldownTotal(self: CombatClient, group: string): number
	return self.cooldownTotals[group] or 1
end

function CombatClient.IsBlocking(self: CombatClient): boolean
	return self.blockHeld
end

-- PICKING A MOVE ------------------------------------------------------------------------------

function CombatClient._context(self: CombatClient, lunge: boolean?): Loadout.Context
	local now = os.clock()
	local current = self.current
	local chain
	if current and current.move.Chain > 0 then
		chain = if current.move.Chain < 3 then current.move.Chain + 1 else 1
	else
		chain = Loadout.NextChain(self.chain, now - self.chainEndedAt, Config.ChainWindow)
	end
	local mode = self.motor:GetMode()
	local air = mode == "Air"
		or (mode ~= "Ground" and self.humanoid.FloorMaterial == Enum.Material.Air)
	local speed = Vector3.new(self.root.AssemblyLinearVelocity.X, 0, self.root.AssemblyLinearVelocity.Z).Magnitude
	local running = lunge == true or (self.motor:IsSprinting() and speed > MovementConfig.WalkSpeed * 1.2)
	local stage = self.character:GetAttribute("LotusStage")
	return {
		air = air,
		running = running and not air,
		spaceHeld = self.motor:IsJumpHeld(),
		chain = chain,
		stage = if typeof(stage) == "number" then stage else 1,
		targetAirborne = self:_airborneTargetAhead(),
		rip = false,
	}
end

-- A key press: "M1", "M2" or "One". lunge = came from a front dash (the running M1).
-- Returns whether something started or was queued.
function CombatClient.Press(self: CombatClient, slot: string, lunge: boolean?): boolean
	if self.destroyed or self.locked or self.humanoid.Health <= 0 then
		return false
	end
	if self.blockHeld then
		return false
	end
	local ctx = self:_context(lunge)
	local id = Loadout.Pick(slot, ctx)
	local move = if id then Moves.Get(id) else nil
	if not move then
		return false
	end
	local current = self.current
	if current then
		local landed = current.result == "Hit" or current.result == "Counter"
		local cancel = landed and table.find(current.move.CancelInto, move.Id) ~= nil
		if not cancel then
			if slot == "M1" and current.move.Chain > 0 and current.move.Chain < 3 and move.Chain > 0 then
				current.queued = "M1"
				return true
			end
			return false
		end
	end
	if self:GetCooldown(move.CooldownGroup) > 0 then
		Sfx.Play(self.character, "Denied", { volume = 0.7 })
		return false
	end
	if move.Id == "Lotus.Form" then
		local meter = self.character:GetAttribute("Lotus")
		if typeof(meter) ~= "number" or meter < Config.LotusMax or self.character:GetAttribute("LotusForm") == true then
			Sfx.Play(self.character, "Denied", { volume = 0.7 })
			return false
		end
	end
	self:_start(move)
	return true
end

-- A move key let go. R: a quick tap (within RipOutFrames of pressing) turns the heal into the
-- rip-out; later, it ends the heal channel (the share channelled counts, on the server).
function CombatClient.Release(self: CombatClient, slot: string)
	if slot ~= "R" or self.destroyed then
		return
	end
	local current = self.current
	if not current or not current.move.Channel then
		return
	end
	local frame = math.floor(current.elapsed / FRAME + 1e-6)
	if frame < Config.RipOutFrames then
		local rip = Moves.Get("Lotus.RipOut")
		if rip then
			self:_start(rip)
		end
		return
	end
	self.remotes.Release:FireServer("R")
	local move = current.move
	current.elapsed = math.max(current.elapsed, (move.Startup + move.Active) * FRAME)
end

-- Space during a launcher that hit: jump straight up after them.
function CombatClient.TryJumpCancel(self: CombatClient): boolean
	local current = self.current
	if not current or not current.move.JumpCancel or current.phase ~= "Recovery" then
		return false
	end
	if current.result ~= "Hit" and current.result ~= "Counter" then
		return false
	end
	self:_finish(false)
	local height = current.move.OnHit.Launch * 0.9
	self.motor:AllowLaunch(1.5)
	self.humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	local v = self.root.AssemblyLinearVelocity
	self.root.AssemblyLinearVelocity = Vector3.new(v.X, math.sqrt(2 * Workspace.Gravity * height), v.Z)
	return true
end

-- Is there an airborne opponent in front within the impale's range?
function CombatClient._airborneTargetAhead(self: CombatClient): boolean
	local look = self.root.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z).Unit
	for _, model in self:_opponents() do
		local root = model:FindFirstChild("HumanoidRootPart")
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
			local state = humanoid:GetState()
			local flying = state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping
			local offset = root.Position - self.root.Position
			local flat = Vector3.new(offset.X, 0, offset.Z)
			if flying and flat.Magnitude <= Config.ImpaleRange and (flat.Magnitude < 1 or flat.Unit:Dot(flatLook) > 0.3) then
				return true
			end
		end
	end
	return false
end

-- Every other character that could be fought (players and training dummies).
function CombatClient._opponents(self: CombatClient): { Model }
	local candidates: { Model } = {}
	for _, player in Players:GetPlayers() do
		if player.Character and player.Character ~= self.character then
			table.insert(candidates, player.Character)
		end
	end
	local dummies = Workspace:FindFirstChild("TrainingDummies")
	if dummies then
		for _, model in dummies:GetChildren() do
			if model:IsA("Model") then
				table.insert(candidates, model)
			end
		end
	end
	return candidates
end

-- The nearest other fighter in front, for the soft lock.
function CombatClient._aimTarget(self: CombatClient): Vector3?
	local look = self.root.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z).Unit
	local best: Vector3? = nil
	local bestDistance = Config.AimAssistRange
	local cosLimit = math.cos(math.rad(Config.AimAssistAngle))
	for _, model in self:_opponents() do
		local root = model:FindFirstChild("HumanoidRootPart")
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
			local offset = root.Position - self.root.Position
			local flat = Vector3.new(offset.X, 0, offset.Z)
			local distance = flat.Magnitude
			if distance < bestDistance and distance > 0.5 and flat.Unit:Dot(flatLook) >= cosLimit then
				best, bestDistance = flat.Unit, distance
			end
		end
	end
	return best
end

function CombatClient._start(self: CombatClient, move: Move)
	local previous = self.current
	if previous then
		self:_finish(true)
	end
	self.hooks.interruptMovement()
	self.seq += 1
	self.swings += 1
	self.lastMove = move.Id
	self.lastResult = ""
	local look = self:_aimTarget() or Vector3.new(self.root.CFrame.LookVector.X, 0, self.root.CFrame.LookVector.Z).Unit
	self.current = {
		move = move,
		seq = self.seq,
		elapsed = 0,
		pauseUntil = 0,
		result = nil,
		queued = nil,
		phase = "Startup",
		look = look,
	}
	if move.Cooldown > 0 then
		self.cooldowns[move.CooldownGroup] = os.clock() + move.Cooldown
		self.cooldownTotals[move.CooldownGroup] = move.Cooldown
	end
	self.remotes.Move:FireServer(move.Id, self.seq)
	self.character:SetAttribute("AttackPhase", "Startup")
	self.character:SetAttribute("LocalMove", move.Id .. "#" .. self.seq)
	self.motor:SetSpeedScale("Attack", Config.AttackMoveSpeedScale)
	self.motor:SetJumpLock("Attack", true)
	self.body:Face(look)
	if move.Weapon == "Dagger" then
		WeaponModels.SetDaggerDrawn(self.character, true)
	end
	if move.Air then
		self.body:Hang(Moves.Total(move, true) * FRAME)
	elseif move.Motion.Step > 0 then
		local seconds = math.max(move.Startup, 1) * FRAME
		self.body:Push(look * (move.Motion.Step / seconds), seconds)
	elseif move.Motion.Lunge > 0 then
		-- Still sliding from the run while winding up.
		local seconds = move.Startup * FRAME
		self.body:Push(look * MovementConfig.RunSpeed, seconds, true)
	end
	self.anim:Play(move.Animation, move.AnimSpeed)
end

-- Ends the current move. interrupted = it didn't play out (a cancel, a hit, a refusal).
function CombatClient._finish(self: CombatClient, interrupted: boolean)
	local current = self.current
	if not current then
		return
	end
	self.current = nil
	local move = current.move
	if move.Chain > 0 then
		self.chain = if move.Chain >= 3 then 0 else move.Chain
		self.chainEndedAt = os.clock()
	elseif move.Id == "Sword.Lunge" then
		self.chain = 0
	end
	if interrupted then
		self.anim:StopMove(move.Animation)
	end
	if move.Weapon == "Dagger" then
		WeaponModels.SetDaggerDrawn(self.character, false)
	end
	self.character:SetAttribute("AttackPhase", nil)
	self.character:SetAttribute("LocalMove", nil)
	self.motor:SetSpeedScale("Attack", nil)
	self.motor:SetJumpLock("Attack", false)
	self.body:Face(nil)
	if not self.locked then
		self.body:Release()
	end
	if not interrupted and current.queued and not self.locked then
		self:Press(current.queued)
	end
end

-- Stops the move (a dash out of its recovery).
function CombatClient.Cancel(self: CombatClient)
	self:_finish(true)
end

function CombatClient._interrupted(self: CombatClient)
	self:_finish(true)
	self.hooks.interruptMovement()
end

-- EVERY FRAME ------------------------------------------------------------------------------

function CombatClient._step(self: CombatClient, dt: number)
	local current = self.current
	if not current or self.destroyed then
		return
	end
	if os.clock() < current.pauseUntil then
		return
	end
	current.elapsed += dt
	local move = current.move
	local frame = math.floor(current.elapsed / FRAME + 1e-6)
	local whiff = current.result == nil
	local phase = Moves.PhaseAt(move, frame, whiff)
	if phase == "Done" then
		self:_finish(false)
		return
	end
	if phase ~= current.phase then
		current.phase = phase :: Phase
		self.character:SetAttribute("AttackPhase", phase)
		if phase == "Recovery" and move.Channel then
			self.anim:StopMove(move.Animation) -- the heal loop ends with the channel
		end
		if phase == "Active" then
			Sfx.Play(self.character, move.Fx.Swing, { volume = 0.8 })
			if move.Motion.Lunge > 0 then
				local seconds = move.Active * FRAME
				self.body:Push(current.look * (move.Motion.Lunge / seconds), seconds)
			end
		end
	end
end

function CombatClient._onResult(self: CombatClient, seq: number, result: string, hitstop: number)
	local current = self.current
	if not current or current.seq ~= seq then
		if result ~= "Reject" then
			self.lastResult = result
		end
		return
	end
	if result == "Reject" then
		self.lastResult = "Reject"
		self.cooldowns[current.move.CooldownGroup] = nil
		self:_finish(true)
		return
	end
	self.lastResult = result
	current.result = current.result or result
	if hitstop > 0 then
		current.pauseUntil = os.clock() + hitstop
		self.anim:Freeze(hitstop)
	end
	local grab = current.move.Grab
	if grab and (result == "Hit" or result == "Counter") then
		-- Caught them: feast for the hold.
		local animation = current.move.Animation
		self.anim:Play("LotusFeast")
		task.delay(hitstop + grab.Hold * FRAME, function()
			self.anim:StopMove("LotusFeast")
			local now = self.current
			if now and now.seq == seq then
				self.anim:StopMove(animation)
			end
		end)
	end
end

-- STUN -------------------------------------------------------------------------------------

function CombatClient._updateLock(self: CombatClient)
	local locked = self.character:GetAttribute("Stunned") == true
	if locked == self.locked then
		return
	end
	self.locked = locked
	self.motor:SetSpeedScale("Stun", if locked then 0 else nil)
	self.motor:SetJumpLock("Stun", locked)
	if locked then
		self:_finish(true)
	end
	self:_updateBlockMovement()
end

-- BLOCK ------------------------------------------------------------------------------------

function CombatClient._updateBlockMovement(self: CombatClient)
	local blocking = self.blockHeld and not self.locked
	self.motor:SetSpeedScale("Block", if blocking then Config.BlockMoveSpeedScale else nil)
	self.motor:SetJumpLock("Block", blocking)
	if blocking then
		self.motor:SetSprinting(false)
	end
end

function CombatClient.SetBlock(self: CombatClient, held: boolean)
	if held == self.blockHeld or self.destroyed then
		return
	end
	self.blockHeld = held
	self.remotes.Block:FireServer(held)
	if held and not self.locked and not self.current then
		self.anim:Hold("BlockHold", true)
	elseif not held then
		self.anim:Hold("BlockHold", false)
	end
	self:_updateBlockMovement()
end

-- Shift. Returns true when combat used it (tech roll, or stunned: no dash).
function CombatClient.PressDash(self: CombatClient): boolean
	local state = self.character:GetAttribute("CombatState")
	if state == "Downed" then
		self.remotes.Tech:FireServer()
		local move = self.humanoid.MoveDirection
		local look = self.root.CFrame.LookVector
		local direction = if move.Magnitude > 0.1 then move.Unit else -Vector3.new(look.X, 0, look.Z).Unit
		self.body:Push(direction * Config.TechRollSpeed, Config.TechRollFrames * FRAME)
		return true
	end
	return self.locked
end

-- Tests: no cooldowns, chain back to the start.
function CombatClient.ResetForTest(self: CombatClient)
	self:_finish(true)
	table.clear(self.cooldowns)
	table.clear(self.cooldownTotals)
	self.chain = 0
	self.chainEndedAt = -math.huge
	self.lastResult = ""
	self.lastAdvantage = nil
end

function CombatClient.Destroy(self: CombatClient)
	if self.destroyed then
		return
	end
	self:_finish(true)
	self.destroyed = true
	for _, connection in self.connections do
		connection:Disconnect()
	end
	table.clear(self.connections)
	self.reactions:Destroy()
	self.body:Destroy()
	self.anim:Stop()
	if active[self.character] == self then
		active[self.character] = nil
	end
end

return CombatClient
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXDD3F464F760440428F4371D611FD08E4"><Properties><string name="Name">CombatConfig</string><ProtectedString name="Source"><![CDATA[--!strict
-- CombatConfig (ModuleScript)
-- Location: ReplicatedStorage > Combat > CombatConfig
--
-- The global combat rules (docs/MoveData.md, "Global rules" and "Stamina"). Frame counts are at
-- 60 per second. Each move's own numbers live in MoveSets (Sword, Dagger).

local CombatConfig = {
	FPS = 60,

	MaxHealth = 100,

	-- BLOCK AND PARRY (F) ----------------------------------------------------------------------
	-- Holding F blocks from this many frames after the press. A press during stun is kept: you
	-- block the moment the stun ends. Blocking only covers the front half (the attacker must be
	-- in front of you).
	BlockStartup = 1,
	-- Each press of F while you can act opens a parry window. A hit landing in it is parried.
	ParryWindow = 6,
	-- A window that ends without parrying anything means no new window for this many frames
	-- (holding F still blocks), so mashing F doesn't parry.
	ParryWhiffLockout = 20,
	-- Extra window for the defender's ping (seconds, capped): the press left their machine that
	-- much earlier than the server saw it.
	ParryPingAllowance = 0.05,
	-- Your attack got parried: you're stuck this long (frames), the defender is free at once.
	ParryStun = 20,
	-- Walking speed while blocking (share of walk speed).
	BlockMoveSpeedScale = 0.4,
	-- How far a blocked hit pushes the blocker back (studs).
	BlockPushback = 2.5,

	-- HITS ---------------------------------------------------------------------------------------
	-- A hit on someone in the startup or active frames of their own move.
	CounterHitStun = 8,
	CounterHitDamage = 1.2,
	-- Each hit after the first in a combo takes this much off the stun (frames), down to MinStun.
	StunDecay = 2,
	MinStun = 6,
	-- Damage scaling: from the ScalingFrom-th hit of a combo, x ScalingPerHit per hit, never
	-- below ScalingMin. Moves after a linker (sword 1) do x AfterLinker.
	ScalingFrom = 4,
	ScalingPerHit = 0.85,
	ScalingMin = 0.4,
	AfterLinker = 0.8,
	-- Hit pause (frames): both characters freeze on a hit so it lands. Moves can set their own.
	Hitstop = 4,
	BlockHitstop = 3,
	-- Every hitbox is this much bigger on each side on the server (small lag compensation).
	HitboxPad = 0.75,

	-- KNOCKDOWNS ---------------------------------------------------------------------------------
	-- One launch per combo; any later launch is a normal knockdown.
	LaunchesPerCombo = 1,
	-- A launched target is helpless this long (frames), then can act again in the air.
	LaunchStun = 50,
	-- On the floor after a knockdown lands (frames), invincible for the first GetUpInvincible.
	-- Dash (Shift) on the floor = tech roll: TechRollFrames of invincible roll, then you're up.
	GetUpFrames = 30,
	GetUpInvincible = 10,
	TechRollFrames = 14,
	TechRollSpeed = 36, -- studs/s
	-- A knockdown ends at the latest this long after the hit (frames), landed or not.
	MaxAirborne = 240,
	-- The first frames after a knockdown hit never count as landing (the target leaves the floor).
	MinAirborne = 8,

	-- STAMINA (the Drive gauge) --------------------------------------------------------------------
	StaminaMax = 100,
	-- Refill per second, after StaminaRegenDelay seconds without spending.
	StaminaRegenDelay = 0.9,
	StaminaRegenGround = 15,
	StaminaRegenAir = 6,
	-- Blocking a hit costs damage x this.
	BlockStaminaPerDamage = 2.5,
	ParryStaminaGain = 10,
	-- Burnout: after overdrawing. No stamina actions; blocked hits deal this share as chip damage;
	-- refills this much faster; ends only when the meter is full again.
	BurnoutChip = 0.25,
	BurnoutRegenScale = 1.25,
	-- Stamina a client may spend per second through the Stamina remote (race mobility). Anything
	-- beyond is ignored.
	StaminaSpendRateLimit = 120,

	-- STATUS BUILD-UP ------------------------------------------------------------------------------
	-- Each fighter has a bar for the element of whoever builds it. Winning exchanges fill it.
	BuildupMax = 100,
	BuildupParry = 40,
	BuildupCounterHit = 35,
	-- Drains this much per second once nobody has landed an M1 or Q on them for BuildupDrainDelay.
	BuildupDrain = 15,
	BuildupDrainDelay = 2,
	-- After a status triggers, the bar can't fill for this long (seconds).
	BuildupLockout = 6,
	-- Wind's status. Drafted: the next launch goes x DraftedLaunchScale as high, or the next
	-- knockdown keeps you down DraftedDownFrames longer. Lasts DraftedTime seconds or until used.
	DraftedTime = 5,
	DraftedLaunchScale = 1.5,
	DraftedDownFrames = 36,

	-- M1 CHAIN -------------------------------------------------------------------------------------
	-- After an M1 ends, the next click continues the chain within this long (seconds); later, the
	-- chain starts over. After the third hit it always starts over.
	ChainWindow = 0.6,
	-- Walking speed while attacking (share of walk speed).
	AttackMoveSpeedScale = 0.45,
	-- A request that arrives this many frames before the current move ends is kept and started
	-- the moment it can (the server's view of timing is a little behind the attacker's).
	ServerBuffer = 8,
	-- Soft lock: an attack started with an opponent within this range and this angle of where you
	-- face turns you toward them.
	AimAssistRange = 12,
	AimAssistAngle = 70,

	-- LOTUS FUNGUS (docs/MoveData.md) -------------------------------------------------------------
	LotusMax = 100,
	-- Stage 2 from this much meter, stage 3 from Stage3At.
	Stage2At = 40,
	Stage3At = 80,
	-- Taking damage feeds the fungus: meter per HP lost.
	LotusPerDamage = 0.5,
	-- R held: the heal channel. A full channel (its Active frames) gives HealHealth and HealMeter;
	-- letting go early gives the share you channelled. Letting go within RipOutFrames of pressing is a
	-- tap: rip it out instead (-RipOutHealth, -RipOutMeter).
	HealHealth = 6,
	HealMeter = 20,
	RipOutFrames = 10,
	RipOutHealth = 10,
	RipOutMeter = 25,
	-- At stage 3 (or in the form) you take this much more damage.
	Stage3DamageTaken = 1.25,
	-- Missing a stage 3 move: HP lost (never feeds the meter) and a stagger (frames).
	WhiffHealth = 8,
	WhiffStagger = 20,
	-- G: the stage 3 form lasts this long (seconds); stage 3 moves cost no meter meanwhile. After it the
	-- meter is FormMeterAfter.
	FormTime = 8,
	FormMeterAfter = 20,
	-- Follow-ups: a Lotus move started this soon (seconds) after a different Lotus key landed a hit gets
	-- its FollowUpStun / FollowUpReach bonus.
	FollowUpWindow = 1,
	-- Infested (the stage 2 spores): the next Lotus move (not a spore) that hits their block wraps them
	-- in growth: knocked down WrapFrames. Lasts InfestedTime seconds or until used.
	InfestedTime = 6,
	WrapFrames = 60,
	-- The impale finds an airborne opponent in front within this range (studs).
	ImpaleRange = 25,
	-- How far below the target the impale looks for the floor its growth erupts from (studs).
	ImpaleFloorSearch = 40,

	-- TRAINING DUMMIES -------------------------------------------------------------------------------
	-- Health comes back this long after the last hit (seconds).
	DummyResetTime = 3,
}

return CombatConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9FD36DE6544E4FBEB04FBD874DD243F8"><Properties><string name="Name">CombatRemotes</string><ProtectedString name="Source"><![CDATA[--!strict
-- CombatRemotes (ModuleScript)
-- Location: ReplicatedStorage > Combat > CombatRemotes
--
-- The combat remotes, in ReplicatedStorage > Remotes > Combat. The server creates them
-- (CombatRemotes.Create, from CombatServer); clients wait for them (CombatRemotes.Get).
--
-- Client -> server
--   Move(moveId, seq)             start a move (seq numbers your moves, for Result)
--   Block(held)                   F pressed (true) / released (false)
--   Release(slot)                 a move key let go (R: ends the heal channel)
--   Tech()                        Shift while downed: tech roll
--   Stamina(amount)               race mobility spent stamina (the server owns the meter)
--   Debug(op, ...)                Studio only: test helpers (see CombatServer)
-- Server -> one client
--   Result(seq, result, hitstop, advantage?)
--                                 your move: "Reject", "Hit", "Counter", "Block", "Parried", "Armour",
--                                 with its frame advantage when it has one (hit stun or block)
--   Hit(info)                     you got hit / blocked / parried / knocked: react (CombatClient)
-- Server -> everyone
--   Fx(info)                      hits, blocks, parries, statuses for effects (CombatFx)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local CombatRemotes = {}

export type Remotes = {
	Move: RemoteEvent,
	Block: RemoteEvent,
	Release: RemoteEvent,
	Tech: RemoteEvent,
	Stamina: RemoteEvent,
	Result: RemoteEvent,
	Hit: RemoteEvent,
	Fx: RemoteEvent,
	Debug: RemoteFunction,
}

local EVENTS = { "Move", "Block", "Release", "Tech", "Stamina", "Result", "Hit", "Fx" }

local cached: Remotes? = nil

local function collect(folder: Instance): Remotes
	local out: { [string]: Instance } = {}
	for _, name in EVENTS do
		out[name] = folder:WaitForChild(name)
	end
	out.Debug = folder:WaitForChild("Debug")
	return (out :: any) :: Remotes
end

-- Server: makes the remotes (once).
function CombatRemotes.Create(): Remotes
	assert(RunService:IsServer(), "CombatRemotes.Create is server-only")
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then
		local folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
		remotes = folder
	end
	assert(remotes, "no Remotes folder")
	local folder = remotes:FindFirstChild("Combat")
	if not folder then
		local created = Instance.new("Folder")
		created.Name = "Combat"
		for _, name in EVENTS do
			local event = Instance.new("RemoteEvent")
			event.Name = name
			event.Parent = created
		end
		local debugRemote = Instance.new("RemoteFunction")
		debugRemote.Name = "Debug"
		debugRemote.Parent = created
		created.Parent = remotes
		folder = created
	end
	assert(folder, "no Combat remotes")
	local made = collect(folder)
	cached = made
	return made
end

-- Client (or server after Create): waits for the remotes.
function CombatRemotes.Get(): Remotes
	if cached then
		return cached
	end
	local folder = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Combat")
	local found = collect(folder)
	cached = found
	return found
end

return CombatRemotes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCF8FB9D6F4FA472FA5F6B9C3000C6756"><Properties><string name="Name">Loadout</string><ProtectedString name="Source"><![CDATA[--!strict
-- Loadout (ModuleScript)
-- Location: ReplicatedStorage > Combat > Loadout
--
-- Which move a key press picks. The attacker's client picks (it knows whether you're running,
-- airborne or holding Space); the server checks the pick is one this key could make.
-- Until the loadout menu exists every fighter carries the first build: Sword + Dagger + Lotus Fungus.
--
--   M1   chain position 1-3 (Chain): ground M1 1 / 2 / 3, or the launcher for 3 with Space held;
--        in the air M1 1 / 2 / the spike. Running (or a front dash) starts with the lunge instead.
--   M2   the dagger: the stab, or the air slash in the air.
--   One  the sword's 1, or the air 1.
--   Two / Three / Four   the Lotus stab / spore / grab of your meter stage (the form counts as
--        stage 3); the stab becomes the impale against an airborne opponent in front (stages 1, 3).
--   R    hold = the heal channel; a quick tap = rip out (rip = true).
--   G    the stage 3 form.

local Loadout = {}

export type Context = {
	air: boolean,
	running: boolean,
	spaceHeld: boolean,
	chain: number, -- the chain position this press would be (1-3)
	stage: number?, -- Lotus meter stage (1-3)
	targetAirborne: boolean?, -- an airborne opponent in front, within the impale's range
	rip: boolean?, -- R was tapped, not held
}

export type Build = { Weapon: string, Secondary: string, Magic: string }

Loadout.Default = { Weapon = "Sword", Secondary = "Dagger", Magic = "Lotus" } :: Build

local STAB = { "Lotus.Stab1", "Lotus.Strand2", "Lotus.Stab3" }
local IMPALE: { [number]: string } = { [1] = "Lotus.Impale1", [3] = "Lotus.Impale3" }
local SPORE = { "Lotus.Spore1", "Lotus.Spore2", "Lotus.Beam3" }
local GRAB = { "Lotus.Grab1", "Lotus.Grab2", "Lotus.Grab3" }

local M1_GROUND = { "Sword.M1_1", "Sword.M1_2", "Sword.M1_3" }
local M1_AIR = { "Sword.AirM1_1", "Sword.AirM1_2", "Sword.AirSpike" }

-- The move id for pressing `slot` in this situation, or nil.
function Loadout.Pick(slot: string, ctx: Context): string?
	if slot == "M1" then
		local chain = math.clamp(ctx.chain, 1, 3)
		if ctx.air then
			return M1_AIR[chain]
		end
		if ctx.running and chain == 1 then
			return "Sword.Lunge"
		end
		if chain == 3 and ctx.spaceHeld then
			return "Sword.Launcher"
		end
		return M1_GROUND[chain]
	elseif slot == "M2" then
		return if ctx.air then "Dagger.AirSlash" else "Dagger.Stab"
	elseif slot == "One" then
		return if ctx.air then "Sword.AirOne" else "Sword.One"
	end
	local stage = math.clamp(ctx.stage or 1, 1, 3)
	if slot == "Two" then
		if ctx.targetAirborne and IMPALE[stage] then
			return IMPALE[stage]
		end
		return STAB[stage]
	elseif slot == "Three" then
		return SPORE[stage]
	elseif slot == "Four" then
		return GRAB[stage]
	elseif slot == "R" then
		return if ctx.rip then "Lotus.RipOut" else "Lotus.Heal"
	elseif slot == "G" then
		return "Lotus.Form"
	end
	return nil
end

-- Could pressing `slot` ever pick `moveId` (the server's check of a client's pick)?
function Loadout.CanPick(slot: string, moveId: string): boolean
	for _, air in { false, true } do
		for _, running in { false, true } do
			for _, spaceHeld in { false, true } do
				for chain = 1, 3 do
					for stage = 1, 3 do
						for _, flag in { false, true } do
							local ctx = {
								air = air,
								running = running,
								spaceHeld = spaceHeld,
								chain = chain,
								stage = stage,
								targetAirborne = flag,
								rip = flag,
							}
							if Loadout.Pick(slot, ctx) == moveId then
								return true
							end
						end
					end
				end
			end
		end
	end
	return false
end

-- The chain position of the next M1: the one after `last` if the chain is still open.
function Loadout.NextChain(last: number, sinceEnd: number, window: number): number
	if last >= 1 and last < 3 and sinceEnd <= window then
		return last + 1
	end
	return 1
end

return Loadout
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBXE2B19E6070CE4F978118F08FA99C7EEB"><Properties><string name="Name">MoveSets</string></Properties><Item class="ModuleScript" referent="RBX3EF083130DB944C6A2E664D13EB19DDD"><Properties><string name="Name">Dagger</string><ProtectedString name="Source"><![CDATA[--!strict
-- Dagger (ModuleScript)
-- Location: ReplicatedStorage > Combat > MoveSets > Dagger
--
-- The first secondary weapon (right click): a dagger drawn from the left hip for each move.
-- The stab comes out a frame faster than an M1 and cancels into the sword's 1 on hit; in the air it's
-- a quick slash that cancels into the air 1. Both share one cooldown.
-- (docs/MoveData.md, "Dagger")

local MoveTypes = require(script.Parent.Parent.MoveTypes)

local Define = MoveTypes.Define

return {
	Define({
		Id = "Dagger.Stab",
		Name = "Dagger stab",
		Slot = "M2",
		Weapon = "Dagger",
		Animation = "DaggerStab",
		Startup = 4,
		Active = 2,
		Recovery = 12,
		Damage = 2,
		Hitbox = { Size = Vector3.new(3, 4, 4), Forward = 2.5 },
		OnHit = { Kind = "Stun", Stun = 16, Knockback = 1 },
		OnBlock = -2,
		Cooldown = 2.5,
		CooldownGroup = "Dagger",
		CancelInto = { "Sword.One" },
		Buildup = 15,
		Hitstop = 3,
		Motion = { Step = 1 },
		Fx = { Arc = "Stab", Hand = "Left", Swing = "DaggerSwing", Hit = "DaggerHit" },
	}),
	Define({
		Id = "Dagger.AirSlash",
		Name = "Dagger air slash",
		Slot = "M2",
		Weapon = "Dagger",
		Animation = "DaggerAirSlash",
		Startup = 4,
		Active = 2,
		Recovery = 10,
		Damage = 2,
		Hitbox = { Size = Vector3.new(4, 4, 4), Forward = 2.5 },
		OnHit = { Kind = "Stun", Stun = 16, Hang = true },
		OnBlock = -2,
		Air = true,
		Cooldown = 2.5,
		CooldownGroup = "Dagger",
		CancelInto = { "Sword.AirOne" },
		Buildup = 15,
		Hitstop = 3,
		Fx = { Arc = "Flat", Hand = "Left", Swing = "DaggerSwing", Hit = "DaggerHit" },
	}),
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXC86AE18F6106423BB7EB59AA3828BEF0"><Properties><string name="Name">Sword</string><ProtectedString name="Source"><![CDATA[--!strict
-- Sword (ModuleScript)
-- Location: ReplicatedStorage > Combat > MoveSets > Sword
--
-- The first weapon: a one-handed sword in the right hand (docs/MoveData.md, "Sword").
--   M1 (left click): a 3-hit chain. Each hit interrupts, but its stun ends 2 frames before the next
--     hit can land, so a block, a parry or armour gets out in between (they're not a true combo).
--     Hit 3 with Space held = the launcher; in the air, hit 3 = the unblockable spike.
--     While running (or from a front dash) = the lunge, a committal thrust that can cross a block.
--   1: the linker. It never knocks down and leaves a long stun, so any ability can follow; unsafe on
--     block. The ground and air versions share one 5 s cooldown: one 1 per combo.
-- The frame numbers are placeholders chosen so the rules fit together; playtests tune them.

local MoveTypes = require(script.Parent.Parent.MoveTypes)

local Define = MoveTypes.Define

return {
	Define({
		Id = "Sword.M1_1",
		Name = "M1 1",
		Slot = "M1",
		Weapon = "Sword",
		Animation = "M1Swing1",
		Startup = 5,
		Active = 2,
		Recovery = 11,
		Damage = 3,
		Hitbox = { Size = Vector3.new(5, 5, 5), Forward = 3 },
		OnHit = { Kind = "Stun", Stun = 15, Knockback = 2 },
		OnBlock = 0,
		Chain = 1,
		CancelInto = { "Sword.One" },
		Buildup = 20,
		Motion = { Step = 1.5 },
		Fx = { Arc = "Flat" },
	}),
	Define({
		Id = "Sword.M1_2",
		Name = "M1 2",
		Slot = "M1",
		Weapon = "Sword",
		Animation = "M1Swing2",
		Startup = 5,
		Active = 2,
		Recovery = 11,
		Damage = 3,
		Hitbox = { Size = Vector3.new(5, 5, 5), Forward = 3 },
		OnHit = { Kind = "Stun", Stun = 15, Knockback = 2 },
		OnBlock = 0,
		Chain = 2,
		CancelInto = { "Sword.One" },
		Buildup = 20,
		Motion = { Step = 1.5 },
		Fx = { Arc = "Backhand" },
	}),
	Define({
		Id = "Sword.M1_3",
		Name = "M1 3",
		Slot = "M1",
		Weapon = "Sword",
		Animation = "M1Swing3",
		Startup = 7,
		Active = 3,
		Recovery = 18,
		Damage = 5,
		Hitbox = { Size = Vector3.new(6, 5, 6), Forward = 3.5 },
		OnHit = { Kind = "Knockdown", Knockback = 20 },
		OnBlock = -8,
		Chain = 3,
		Buildup = 20,
		Hitstop = 6,
		Motion = { Step = 3 },
		Fx = { Arc = "Overhead", Swing = "SwordSwingHeavy", Hit = "SwordHitHeavy" },
	}),
	Define({
		Id = "Sword.Launcher",
		Name = "M1 3 + Space (launcher)",
		Slot = "M1",
		Weapon = "Sword",
		Animation = "SwordLauncher",
		Startup = 8,
		Active = 3,
		Recovery = 14,
		Damage = 4,
		Hitbox = { Size = Vector3.new(5, 7, 5), Forward = 3 },
		OnHit = { Kind = "Launch", Launch = 25 },
		OnBlock = -10,
		Chain = 3,
		JumpCancel = true,
		Buildup = 20,
		Hitstop = 5,
