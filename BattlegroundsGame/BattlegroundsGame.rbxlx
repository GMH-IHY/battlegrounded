	{ Bone = "RightAntenna", Name = "Feather", Class = "WedgePart", Shape = "Block", Size = Vector3.new(0.0700, 0.2336, 0.0907), CFrame = CFrame.new(0.66000, 1.41000, 0.10000, 0.00000, 0.76414, -0.64505, 0.00000, -0.64505, -0.76414, -1.00000, 0.00000, 0.00000), Color = Color3.fromRGB(38, 110, 116), Material = Enum.Material.SmoothPlastic },
	{ Bone = "RightAntenna", Name = "Feather", Class = "WedgePart", Shape = "Block", Size = Vector3.new(0.0700, 0.2336, 0.9170), CFrame = CFrame.new(0.33500, 1.02500, 0.10000, 0.00000, 0.76414, 0.64505, 0.00000, -0.64505, 0.76414, 1.00000, 0.00000, 0.00000), Color = Color3.fromRGB(38, 110, 116), Material = Enum.Material.SmoothPlastic },
	{ Bone = "RightAntenna", Name = "Glow", Class = "Part", Shape = "Ball", Size = Vector3.new(0.2600, 0.2600, 0.2600), CFrame = CFrame.new(0.81000, 1.76000, 0.18000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000, 0.00000, 0.00000, 0.00000, 1.00000), Color = Color3.fromRGB(41, 223, 235), Material = Enum.Material.Neon },
	{ Bone = "LeftAntenna", Name = "Stalk", Class = "Part", Shape = "Block", Size = Vector3.new(0.1300, 1.0434, 0.1300), CFrame = CFrame.new(-0.11000, 0.47500, 0.04000, 0.97422, -0.22485, 0.01845, 0.22561, 0.97096, -0.07966, 0.00000, 0.08176, 0.99665), Color = Color3.fromRGB(16, 38, 44), Material = Enum.Material.SmoothPlastic },
	{ Bone = "LeftAntenna", Name = "Stalk", Class = "Part", Shape = "Block", Size = Vector3.new(0.1100, 0.9963, 0.1100), CFrame = CFrame.new(-0.50000, 1.32500, 0.13000, 0.80128, -0.59490, 0.06356, 0.59829, 0.79675, -0.08512, 0.00000, 0.10623, 0.99434), Color = Color3.fromRGB(16, 38, 44), Material = Enum.Material.SmoothPlastic },
	{ Bone = "LeftAntenna", Name = "Feather", Class = "WedgePart", Shape = "Block", Size = Vector3.new(0.0700, 0.2642, 0.1737), CFrame = CFrame.new(0.00000, 0.60000, 0.10000, 0.00000, 0.78536, -0.61904, 0.00000, 0.61904, 0.78536, 1.00000, 0.00000, 0.00000), Color = Color3.fromRGB(38, 110, 116), Material = Enum.Material.SmoothPlastic },
	{ Bone = "LeftAntenna", Name = "Feather", Class = "WedgePart", Shape = "Block", Size = Vector3.new(0.0700, 0.2642, 0.9086), CFrame = CFrame.new(-0.33500, 1.02500, 0.10000, 0.00000, 0.78536, 0.61904, 0.00000, 0.61904, -0.78536, -1.00000, 0.00000, 0.00000), Color = Color3.fromRGB(38, 110, 116), Material = Enum.Material.SmoothPlastic },
