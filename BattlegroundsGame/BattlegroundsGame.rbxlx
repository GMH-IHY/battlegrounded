					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">AnimationGallery</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">02ef6e543fe1adde0acd19b0000003dd</UniqueId>
				<ProtectedString name="Source"><![CDATA[--!strict
-- AnimationGallery (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > AnimationGallery
--
-- Studio-only pose viewer. Settings menu (gear) > Debug > Animation gallery during Play: copies of
-- your character appear in a row, each frozen on one pose of an animation, so every pose can be
-- checked at once on the real avatar. The Next button steps to the next camera angle, then the next
-- animation; after the last one (or Close) the gallery closes. Reads the KeyframeSequences that StudioAnimationMirror copies into
-- ReplicatedStorage, so it always shows the latest saved edits.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

if not RunService:IsStudio() then
	return
end

local SettingsMenu = require(script.Parent:WaitForChild("SettingsMenu"))

local ORDER = {
	"DashForward",
	"DashRight",
	"DashLeft",
	"DashBack",
	"M1Swing1",
	"M1Swing2",
	"M1Swing3",
	"SwordLauncher",
	"SwordLunge",
	"SwordOne",
	"SwordAirSpike",
	"DaggerStab",
	"BlockHold",
	"Idle",
	"WalkForward",
	"Sprint",
	"Jump",
	"Fall",
	"Climb",
}
local ORIGIN = Vector3.new(140, 3, -120) -- open baseplate, away from the test course
local SPACING = 7
-- Camera angles, relative to the row (the copies face -Z).
type View = { name: string, offset: Vector3 }
local VIEWS: { View } = {
	{ name = "3/4 back", offset = Vector3.new(9, 5, 14) },
	{ name = "side (facing right)", offset = Vector3.new(0, 2, 0) }, -- special-cased below
	{ name = "front", offset = Vector3.new(0, 3, -16) },
}

local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "AnimationGallery"
gui.ResetOnSpawn = false
gui.DisplayOrder = 300
gui.Enabled = false
local label = Instance.new("TextLabel")
label.AnchorPoint = Vector2.new(0.5, 0)
label.Position = UDim2.new(0.5, 0, 0, 10)
label.Size = UDim2.fromOffset(700, 34)
label.BackgroundColor3 = Color3.new(0, 0, 0)
label.BackgroundTransparency = 0.3
label.Font = Enum.Font.ArialBold
label.TextSize = 20
label.TextColor3 = Color3.new(1, 1, 1)
label.Text = ""
label.Parent = gui

local function barButton(text: string, x: number): TextButton
	local b = Instance.new("TextButton")
	b.AnchorPoint = Vector2.new(0.5, 0)
	b.Position = UDim2.new(0.5, x, 0, 50)
	b.Size = UDim2.fromOffset(110, 30)
	b.BackgroundColor3 = Color3.new(0, 0, 0)
	b.BackgroundTransparency = 0.3
	b.Font = Enum.Font.ArialBold
	b.TextSize = 18
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Text = text
	b.Parent = gui
	return b
end
local nextButton = barButton("Next", -60)
local closeButton = barButton("Close", 60)
gui.Parent = player:WaitForChild("PlayerGui")

local folder: Folder? = nil
local sequenceIndex = 0
local viewIndex = 0
local poseCount = 0

-- The times at which each distinct pose shows. build.py writes every pose at the END of the span
-- it covers (Constant easing shows the later keyframe), so a pose is visible between two keys.
local function poseTimes(sequence: KeyframeSequence): { number }
	local keys: { number } = {}
	for _, child in sequence:GetChildren() do
		if child:IsA("Keyframe") then
			table.insert(keys, child.Time)
		end
	end
	table.sort(keys)
	local times: { number } = {}
	for i = 1, #keys - 1 do
		table.insert(times, (keys[i] + keys[i + 1]) / 2)
	end
	if #times == 0 and #keys > 0 then
		table.insert(times, keys[1])
	end
	return times
end

local function clearGallery()
	if folder then
		folder:Destroy()
		folder = nil
	end
end

local function makeCopy(source: Model): Model?
	local wasArchivable = source.Archivable
	source.Archivable = true
	local copy = source:Clone()
	source.Archivable = wasArchivable
	if not copy then
		return nil
	end
	for _, descendant in copy:GetDescendants() do
		if descendant:IsA("LuaSourceContainer") or descendant:IsA("Constraint") then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.Anchored = descendant.Name == "HumanoidRootPart"
			descendant.CanCollide = false
			descendant.CanQuery = false
		end
	end
	for _, child in copy:GetChildren() do
		if child.Name == "LowerBodyCollider" then
			child:Destroy()
		end
	end
	return copy
end

local function build(name: string): boolean
	clearGallery()
	local mirror = ReplicatedStorage:FindFirstChild("StudioAnimations")
	local sequence = mirror and mirror:FindFirstChild(name)
	local character = player.Character
	if not sequence or not sequence:IsA("KeyframeSequence") or not character then
		return false
	end
	local ok, animationId = pcall(function()
		return game:GetService("KeyframeSequenceProvider"):RegisterKeyframeSequence(sequence)
	end)
	if not ok then
		return false
	end
	local animation = Instance.new("Animation")
	animation.AnimationId = animationId

	local newFolder = Instance.new("Folder")
	newFolder.Name = "AnimationGallery"
	newFolder.Parent = Workspace
	folder = newFolder

	local times = poseTimes(sequence)
	poseCount = #times
	for i, t in times do
		local copy = makeCopy(character)
		if copy then
			copy.Name = string.format("%s_%d", name, i)
			local root = copy:FindFirstChild("HumanoidRootPart")
			local humanoid = copy:FindFirstChildOfClass("Humanoid")
			if root and root:IsA("BasePart") and humanoid then
				root.CFrame = CFrame.lookAt(ORIGIN + Vector3.new((i - 1) * SPACING, 0, 0), ORIGIN + Vector3.new((i - 1) * SPACING, 0, -1))
				humanoid.PlatformStand = true
				copy.Parent = newFolder
				local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
				local track = animator:LoadAnimation(animation)
				track.Priority = Enum.AnimationPriority.Action4
				track:Play(0, 1, 0)
				track.TimePosition = t
			end
		end
	end
	return true
end

local function applyView()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local rowCenter = ORIGIN + Vector3.new((poseCount - 1) * SPACING / 2, 0, 0)
	local rowLength = math.max(poseCount - 1, 1) * SPACING
	local view = VIEWS[viewIndex]
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = 40
	if view.name == "side (facing right)" then
		-- Each copy seen from its own left, one at a time would be ideal; a long lens from far
		-- along the row axis shows them overlapping, so instead look across the row from +X
		-- after turning every copy to face +X.
		if folder then
			for _, copy in folder:GetChildren() do
				local root = copy:FindFirstChild("HumanoidRootPart")
				if root and root:IsA("BasePart") then
					local position = root.Position
					root.CFrame = CFrame.lookAt(position, position + Vector3.xAxis)
				end
			end
		end
		local eye = rowCenter + Vector3.new(0, 2, rowLength * 1.35 + 14)
		camera.CFrame = CFrame.lookAt(eye, rowCenter + Vector3.new(0, -0.5, 0))
	else
		if folder then
			for _, copy in folder:GetChildren() do
				local root = copy:FindFirstChild("HumanoidRootPart")
				if root and root:IsA("BasePart") then
					local position = root.Position
					root.CFrame = CFrame.lookAt(position, position - Vector3.zAxis)
				end
			end
		end
		local scale = (rowLength * 1.2 + 12) / 16
		local eye = rowCenter + view.offset * scale
		camera.CFrame = CFrame.lookAt(eye, rowCenter + Vector3.new(0, -0.5, 0))
	end
	label.Text = string.format("%s  -  %d poses  -  %s view", ORDER[sequenceIndex], poseCount, view.name)
end

local function stop()
	clearGallery()
	gui.Enabled = false
	sequenceIndex, viewIndex = 0, 0
	local camera = Workspace.CurrentCamera
	if camera then
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = 70
	end
end

local function advance()
	if sequenceIndex == 0 then
		sequenceIndex, viewIndex = 1, 0
	end
	viewIndex += 1
	if viewIndex > #VIEWS then
		viewIndex = 1
		sequenceIndex += 1
	end
	while sequenceIndex <= #ORDER do
		if viewIndex ~= 1 or build(ORDER[sequenceIndex]) then
			gui.Enabled = true
			applyView()
			return
		end
		sequenceIndex += 1
	end
	stop()
end

nextButton.Activated:Connect(advance)
closeButton.Activated:Connect(stop)
SettingsMenu.AddButton("Debug", "Animation gallery", function()
	SettingsMenu.Close()
	if sequenceIndex == 0 then
		advance()
	end
end)

-- Also steppable from the command bar: game.Players.LocalPlayer.PlayerGui.AnimationGallery.Next:Fire()
local nextEvent = Instance.new("BindableEvent")
nextEvent.Name = "Next"
nextEvent.Event:Connect(advance)
nextEvent.Parent = gui
]]></ProtectedString></Properties>
			</Item>
			<Item class="LocalScript" referent="RBX5765D918DF2C4818AEC4C6B088172347">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<token name="RunContext">0</token>
					<string name="ScriptGuid">{C9201578-E8F9-4826-B4BB-631BF0D3C4DE}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">CollisionViewer</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">02ef6e543fe1adde0acd19b0000003de</UniqueId>
				<ProtectedString name="Source"><![CDATA[--!strict
-- CollisionViewer (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > CollisionViewer
--
-- Debug view of every character's collision boxes (yours, other players', dummies). Settings menu (gear)
-- > Debug > Collision boxes, or from the command bar:
-- game.Players.LocalPlayer.PlayerGui.CollisionViewer.Toggle:Fire()
--   green   body parts that are colliding right now (Head, Torso, ...)
--   orange  extra collision boxes movement adds (LowerBodyCollider for the legs, SlideCollider
--           while sliding)
--   yellow  outline of the HumanoidRootPart (what the physics moves; not a collision box)
-- Parts that aren't colliding at the moment (arms and legs, or the body while sliding) aren't
-- drawn. Only you see it. Set MovementConfig.DebugSpeedometer = false before release to remove
-- both debug views.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local SettingsMenu = require(script.Parent:WaitForChild("SettingsMenu"))
local Config = require(ReplicatedStorage:WaitForChild("Movement"):WaitForChild("MovementConfig"))

if not Config.DebugSpeedometer then
	return
end

local SLIDE_GROUP = "ParkourSlideBody"
local EXTRA_COLLIDERS: { [string]: boolean } = {
	LowerBodyCollider = true,
	SlideCollider = true,
}
local GREEN = Color3.fromRGB(80, 230, 110)
local ORANGE = Color3.fromRGB(255, 150, 40)
local YELLOW = Color3.fromRGB(255, 230, 60)
local RESCAN_INTERVAL = 0.5

local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "CollisionViewer"
gui.ResetOnSpawn = false
gui.Enabled = false
local label = Instance.new("TextLabel")
label.AnchorPoint = Vector2.new(0.5, 0)
label.Position = UDim2.new(0.5, 0, 0, 8)
label.Size = UDim2.fromOffset(420, 22)
label.BackgroundColor3 = Color3.new(0, 0, 0)
label.BackgroundTransparency = 0.4
label.BorderSizePixel = 0
label.Font = Enum.Font.Code
label.TextSize = 14
label.TextColor3 = Color3.new(1, 1, 1)
label.Text = "Collision boxes: green body, orange extra colliders, yellow root"
label.Parent = gui
gui.Parent = player:WaitForChild("PlayerGui")

local shown = false
local folder: Folder? = nil
local boxes: { [BasePart]: BoxHandleAdornment } = {}
local outlines: { [BasePart]: SelectionBox } = {}
local characters: { Model } = {}
local rescanTimer = 0

local function clear()
	if folder then
		folder:Destroy()
		folder = nil
	end
	table.clear(boxes)
	table.clear(outlines)
end

local function rescan()
	table.clear(characters)
	for _, child in Workspace:GetChildren() do
		if child:IsA("Model") and child:FindFirstChildOfClass("Humanoid") then
			table.insert(characters, child)
		end
	end
end

local function isColliding(part: BasePart): boolean
	return part.CanCollide and part.CollisionGroup ~= SLIDE_GROUP
end

local function update()
	local container = folder
	if not container then
		return
	end
	local seen: { [BasePart]: boolean } = {}
	for _, character in characters do
		if character.Parent then
			for _, descendant in character:GetDescendants() do
				if descendant:IsA("BasePart") then
					if descendant.Name == "HumanoidRootPart" then
						seen[descendant] = true
						if not outlines[descendant] then
							local outline = Instance.new("SelectionBox")
							outline.Adornee = descendant
							outline.Color3 = YELLOW
							outline.LineThickness = 0.03
							outline.SurfaceTransparency = 1
							outline.Parent = container
							outlines[descendant] = outline
						end
					elseif isColliding(descendant) then
						seen[descendant] = true
						local box = boxes[descendant]
						if not box then
							local created = Instance.new("BoxHandleAdornment")
							created.Adornee = descendant
							created.AlwaysOnTop = true
							created.ZIndex = 5
							created.Transparency = 0.55
							created.Color3 = if EXTRA_COLLIDERS[descendant.Name] then ORANGE else GREEN
							created.Parent = container
							boxes[descendant] = created
							box = created
						end
						if box then
							box.Size = descendant.Size
						end
					end
				end
			end
		end
	end
	for part, box in boxes do
		if not seen[part] then
			box:Destroy()
			boxes[part] = nil
		end
	end
	for part, outline in outlines do
		if not seen[part] then
			outline:Destroy()
			outlines[part] = nil
		end
	end
end

local function setShown(on: boolean)
	shown = on
	gui.Enabled = on
	clear()
	if on then
		local created = Instance.new("Folder")
		created.Name = "CollisionViewer"
		created.Parent = Workspace.CurrentCamera
		folder = created
		rescan()
		update()
	end
end

local setSwitch = SettingsMenu.AddToggle("Debug", "Collision boxes", false, setShown)

local toggleEvent = Instance.new("BindableEvent")
toggleEvent.Name = "Toggle"
toggleEvent.Event:Connect(function()
	setShown(not shown)
	setSwitch(shown)
end)
toggleEvent.Parent = gui

RunService.Heartbeat:Connect(function(dt: number)
	if not shown then
		return
	end
	rescanTimer += dt
	if rescanTimer >= RESCAN_INTERVAL then
		rescanTimer = 0
		rescan()
	end
	update()
end)
]]></ProtectedString></Properties>
			</Item>
			<Item class="LocalScript" referent="RBX31EF912C20524FE38E37D1E1B0BACB5F">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<token name="RunContext">0</token>
					<string name="ScriptGuid">{6ABD0A4A-30A6-47E8-849B-B483DC577456}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">DebugSpeedometer</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">02ef6e543fe1adde0acd19b0000003df</UniqueId>
				<ProtectedString name="Source"><![CDATA[--!strict
-- DebugSpeedometer (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > DebugSpeedometer
--
-- On-screen speed counter for checking movement against MovementConfig, plus combat frame data
-- (the move you're in, its frame and phase, what your last move did and its frame advantage).
-- Settings menu (gear) > Debug > Speedometer hides/shows it. Turn it off with MovementConfig.DebugSpeedometer = false.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local movementFolder = ReplicatedStorage:WaitForChild("Movement")
movementFolder:WaitForChild("CharacterMotor")
movementFolder:WaitForChild("MovementConfig")
movementFolder:WaitForChild("Dash")
movementFolder:WaitForChild("WallHop")
movementFolder:WaitForChild("LandingRoll")
movementFolder:WaitForChild("AutoParkour")
movementFolder:WaitForChild("Lantern")
movementFolder:WaitForChild("Stamina")

local CharacterMotor = require(ReplicatedStorage.Movement.CharacterMotor)
local Dash = require(ReplicatedStorage.Movement.Dash)
local WallHop = require(ReplicatedStorage.Movement.WallHop)
local LandingRoll = require(ReplicatedStorage.Movement.LandingRoll)
local AutoParkour = require(ReplicatedStorage.Movement.AutoParkour)
local Lantern = require(ReplicatedStorage.Movement.Lantern)
local Stamina = require(ReplicatedStorage.Movement.Stamina)
local SettingsMenu = require(script.Parent:WaitForChild("SettingsMenu"))
local Config = require(ReplicatedStorage.Movement.MovementConfig)
local Perf = require(ReplicatedStorage.Movement.Perf)
ReplicatedStorage:WaitForChild("Combat"):WaitForChild("CombatClient")
local CombatClient = require(ReplicatedStorage.Combat.CombatClient)

if not Config.DebugSpeedometer then
	return
end

local REFRESH_INTERVAL = 1 / 15 -- text updates per second (peaks are still tracked every frame)
local ON_TARGET_TOLERANCE = 0.5

local GREEN = "#6BE36B"
local YELLOW = "#F5CD30"
local RED = "#FF6060"
local GREY = "#BBBBBB"

local player = Players.LocalPlayer

-- UI (classic look: dark translucent box, bold Arial) -------------------------

local gui = Instance.new("ScreenGui")
gui.Name = "DebugSpeedometer"
gui.ResetOnSpawn = false
gui.DisplayOrder = 100

local frame = Instance.new("Frame")
frame.AnchorPoint = Vector2.new(0, 1)
frame.Position = UDim2.new(0, 10, 1, -10)
frame.Size = UDim2.fromOffset(460, 240)
frame.BackgroundColor3 = Color3.new(0, 0, 0)
frame.BackgroundTransparency = 0.45
frame.BorderSizePixel = 0
frame.Parent = gui

local padding = Instance.new("UIPadding")
padding.PaddingLeft = UDim.new(0, 8)
padding.PaddingTop = UDim.new(0, 6)
padding.Parent = frame

local label = Instance.new("TextLabel")
label.Size = UDim2.fromScale(1, 1)
label.BackgroundTransparency = 1
label.Font = Enum.Font.ArialBold
label.TextSize = 14
label.TextColor3 = Color3.new(1, 1, 1)
label.TextStrokeTransparency = 0.6
label.TextXAlignment = Enum.TextXAlignment.Left
label.TextYAlignment = Enum.TextYAlignment.Top
label.RichText = true
label.Text = "Waiting for character..."
label.Parent = frame

gui.Parent = player:WaitForChild("PlayerGui")

SettingsMenu.AddToggle("Debug", "Speedometer + frame data", true, function(on: boolean)
	gui.Enabled = on
end)

-- Tracking -------------------------------------------------------------------

local lastMode = ""
local takeoffY = 0
local apexY = 0
local airPeakSpeed = 0
local airMaxFall = 0

local lastJumpHeight = 0
local lastAirPeakSpeed = 0
local lastMaxFall = 0

local refreshTimer = 0

local function colour(text: string, hex: string): string
	return string.format('<font color="%s">%s</font>', hex, text)
end

local function onFrame(dt: number)
	local character = player.Character
	local motor = if character then CharacterMotor.Get(character) else nil
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if not motor or not humanoid or not root or not root:IsA("BasePart") then
		label.Text = "Waiting for character..."
		lastMode = ""
		return
	end

	local velocity = root.AssemblyLinearVelocity
	local horizontal = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	local mode = motor:GetMode()

	-- Airtime tracking: jump height, speed carried, fastest fall.
	if mode == "Air" and lastMode ~= "Air" then
		takeoffY = root.Position.Y
		apexY = takeoffY
		airPeakSpeed = horizontal
		airMaxFall = 0
	elseif mode == "Air" then
		apexY = math.max(apexY, root.Position.Y)
		airPeakSpeed = math.max(airPeakSpeed, horizontal)
		airMaxFall = math.max(airMaxFall, -velocity.Y)
	elseif lastMode == "Air" then
		lastJumpHeight = apexY - takeoffY
		lastAirPeakSpeed = airPeakSpeed
		lastMaxFall = airMaxFall
	end
	lastMode = mode

	refreshTimer += dt
	if refreshTimer < REFRESH_INTERVAL then
		return
	end
	refreshTimer = 0

	-- Speed line, coloured against the target speed while on the ground.
	local target = motor:GetTargetSpeed()
	local moving = humanoid.MoveDirection.Magnitude > 0.01
	local speedText = string.format("%.1f", horizontal)
	local targetText
	if mode == "Ground" and moving then
		local gap = math.abs(horizontal - target)
		local hex = if gap <= ON_TARGET_TOLERANCE then GREEN elseif gap <= 3 then YELLOW else RED
		speedText = colour(speedText, hex)
		targetText = string.format("/ %.1f %s", target, if motor:IsSprinting() then "(run)" else "(walk)")
	else
		targetText = colour("/ -", GREY)
	end

	local fallText = string.format("%.1f", if mode == "Air" then airMaxFall else lastMaxFall)
	local fallMax = math.max(airMaxFall, lastMaxFall)
	if fallMax > Config.TerminalVelocity + 1 then
		fallText = colour(fallText, RED)
	end

	local dash = if character then Dash.Get(character) else nil
	local dashText = "Dash: -"
	if dash then
		local cooldown = dash:GetCooldownRemaining()
		local state = if dash:IsBusy()
			then colour(dash:GetPhase() .. " " .. dash:GetKind(), YELLOW)
			elseif cooldown > 0 then colour(string.format("%.1fs", cooldown), RED)
			else colour("ready", GREEN)
		dashText = string.format("Dash: %s   last %.1f studs", state, dash:GetLastDistance())
	end

	-- Frame data: the move you're in (frame / phase), what the last one did, its advantage.
	local combat = if character then CombatClient.Get(character) else nil
	local combatText = "Combat: -"
	if combat and character then
		local combatState = tostring(character:GetAttribute("CombatState") or "-")
		local moveId = combat:GetMoveId()
		local moveText = if moveId
			then colour(string.format("%s  f%d %s", moveId, combat:GetFrame(), combat:GetPhase()), YELLOW)
			else "-"
		local advantage = combat:GetLastAdvantage()
		local advText = if advantage == nil then ""
			else colour(string.format("  %+d", advantage), if advantage >= 0 then GREEN else RED)
		combatText = string.format("Combat: %s   %s   last %s %s%s", combatState, moveText, combat:GetLastMove(),
			combat:GetLastResult(), advText)
	end

	local hop = if character then WallHop.Get(character) else nil
	local hopText = "Wall hops: -"
	if hop then
		hopText = string.format(
			"Wall hops: %d / %d left%s",
			hop:GetHopsLeft(),
			hop:GetMaxHops(),
			if hop:IsRunning() then "   " .. colour("wall run", YELLOW)
				elseif hop:GetLastFailure() ~= "" then "   " .. colour(hop:GetLastFailure(), GREY)
				else ""
		)
	end

	local roll = if character then LandingRoll.Get(character) else nil
	local rollText = "Roll: -"
	if roll then
		local info = roll:GetLastInfo()
		rollText = "Roll: "
			.. (if roll:IsRolling() then colour("rolling", YELLOW)
				elseif info ~= "" then colour(info, GREY)
				else "-")
	end

	local parkour = if character then AutoParkour.Get(character) else nil
	local parkourText = "Parkour: -"
	if parkour then
		local info = parkour:GetLastInfo()
		parkourText = "Parkour: "
			.. (if parkour:IsBusy() then colour(parkour:GetAction(), YELLOW)
				elseif info ~= "" then colour(info, GREY)
				else "-")
	end

	local stamina = if character then Stamina.Get(character) else nil
	local staminaText = if stamina
		then string.format("Stamina: %d / %d%s", math.floor(stamina:GetValue() + 0.5), stamina:GetMax(),
			if stamina:IsBurnout() then "  " .. colour("BURNOUT", RED) else "")
		else "Stamina: -"
	local lantern = if character then Lantern.Get(character) else nil
	local lanternText = "Lantern: -"
	if lantern and lantern:IsMoth() then
		local flight = lantern:GetFlight()
		local tag = lantern:GetTagTarget()
		local extra = if lantern:GetState() == "Charging"
			then string.format(" %d%%", math.floor(lantern:GetCharge() * 100 + 0.5))
			elseif lantern:GetGrabCooldown() > 0 then string.format(" (throw in %.1fs)", lantern:GetGrabCooldown())
			else ""
		lanternText = string.format("Lantern: %s%s%s", lantern:GetState(), if lantern:IsResting() then " (lying)" else "", extra)
			.. (if tag then colour("  tagged " .. tag.Name, YELLOW) else "")
			.. "\n"
			.. (if flight
				then colour(string.format("Flying %s  %.0f studs/s  turn %.0f deg/s", flight, lantern:GetSpeed(), lantern:GetTurnRate()), YELLOW)
				else "Fly: " .. colour(if lantern:GetLastInfo() ~= "" then lantern:GetLastInfo() else "-", GREY))
	elseif character then
		lanternText = "Race: " .. tostring(character:GetAttribute("Race") or "-")
	end

	local rig = if humanoid.RigType == Enum.HumanoidRigType.R6 then colour("R6", GREEN) else colour("R15", RED)

	label.Text = table.concat({
		string.format("Speed: %s %s", speedText, targetText),
		string.format("Vertical: %.1f", velocity.Y),
		string.format(
			"Mode: %s   Sprint: %s   HP speed: %s",
			mode,
			if motor:IsSprinting() then "yes" else "no",
			if motor:GetHealthSpeedScale() < 0.999
				then colour(string.format("x%.2f", motor:GetHealthSpeedScale()), YELLOW)
				else "x1"
		),
		string.format("Last jump: %.2f / %.1f studs", lastJumpHeight, Config.JumpHeight),
		string.format("Air peak speed: %.1f", if mode == "Air" then airPeakSpeed else lastAirPeakSpeed),
		string.format("Fall speed: %s / %d max", fallText, Config.TerminalVelocity),
		dashText,
		hopText,
		rollText,
		parkourText,
		staminaText,
		combatText,
		lanternText,
		string.format("Rig: %s", rig),
		colour("Settings (gear, top right) > Debug to hide", GREY),
	}, "\n")
end

RunService.RenderStepped:Connect(function(dt: number)
	if Perf.enabled then
		local t0 = os.clock()
		onFrame(dt)
		Perf.add("Debug overlay", os.clock() - t0)
	else
		onFrame(dt)
	end
end)
]]></ProtectedString></Properties>
			</Item>
			<Item class="LocalScript" referent="RBX25B07097140A425D81D8D1F5E440D0AC">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--!strict
-- HeadLook (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > HeadLook
--
-- Turns heads a little toward where each player's camera points, like Die of Death: the body
-- faces the way you walk and the head glances where you're looking. It's kept subtle, and it
-- moves in steps (jumps to a new angle, then holds it) to match the snappy animations.
--   Your character: aimed from your camera, and sent to the server a few times a second
--                   (HeadLookServer) so other players see it.
--   Other players:  read from their character's "HeadLook" attribute.
-- It also carries the shift-lock body twist (ShiftLock's "BodyTurn"), so other players see a
-- shift-locked character's body turn toward A/D too ("BodyTwist" attribute).
-- The head is turned by rotating the Neck joint's C0, which animations don't touch, so it
-- stacks on top of whatever animation is playing. All the numbers are in AnimationConfig.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

ReplicatedStorage:WaitForChild("Movement"):WaitForChild("AnimationConfig")
local Config = require(ReplicatedStorage.Movement.AnimationConfig)

-- With HeadLookEnabled off the head is never touched, but this script keeps running: it also
-- carries the shift-lock body twist to other players.
local HEAD_ENABLED = Config.HeadLookEnabled

local remote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("HeadLook") :: UnreliableRemoteEvent
local localPlayer = Players.LocalPlayer

local MAX_YAW = math.rad(Config.HeadMaxYaw)
local MAX_PITCH = math.rad(Config.HeadMaxPitch)
local MIN_STEP = math.rad(Config.HeadMinStep)
-- When the camera looks back at your own face (past this angle), the head faces forward
-- instead of whipping from one shoulder to the other.
local LOOK_BACK_LIMIT = math.rad(125)
local SEND_INTERVAL = 1 / math.max(Config.HeadLookSendRate, 1)

type HeadState = { baseC0: CFrame, yaw: number, pitch: number, steppedAt: number }
-- Keyed by the Neck joint. Not a weak table: Roblox can drop Instance keys from weak tables
-- while the Instance still exists, which made the head re-capture an already-turned neck as
-- its rest pose and drift further every time. Entries are removed when the neck is destroyed.
local states: { [Motor6D]: HeadState } = {}

local lastSentAt = 0
local lastSentYaw, lastSentPitch, lastSentTwist = 0, 0, 0
local TWIST_SEND_THRESHOLD = math.rad(3)
local TWIST_SMOOTHING = 14 -- other players' body twist catches up this fast (not stepped)

-- Other players' shift-lock body twist (ShiftLock twists our own locally), keyed by RootJoint.
type TwistState = { baseC0: CFrame, twist: number }
local twists: { [Motor6D]: TwistState } = {}

local function applyTwist(character: Model, target: number, dt: number)
	local root = character:FindFirstChild("HumanoidRootPart")
	local joint = root and root:FindFirstChild("RootJoint")
	if not joint or not joint:IsA("Motor6D") then
		return
	end
	local state = twists[joint]
	if not state then
		state = { baseC0 = joint.C0, twist = 0 }
		twists[joint] = state
		local connection: RBXScriptConnection
		connection = joint.AncestryChanged:Connect(function()
			if not joint:IsDescendantOf(game) then
				twists[joint] = nil
				connection:Disconnect()
			end
		end)
	end
	local diff = (target - state.twist + math.pi) % (2 * math.pi) - math.pi
	state.twist += diff * (1 - math.exp(-TWIST_SMOOTHING * dt))
	joint.C0 = CFrame.Angles(0, state.twist, 0) * state.baseC0
end

local function getNeck(character: Model): Motor6D?
	local torso = character:FindFirstChild("Torso")
	local neck = torso and torso:FindFirstChild("Neck")
	if neck and neck:IsA("Motor6D") then
		return neck
	end
	return nil
end

local function isAlive(character: Model): boolean
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

-- Where the head should point, from the camera direction relative to the torso.
local function cameraTarget(character: Model): (number, number)
	local camera = Workspace.CurrentCamera
	local torso = character:FindFirstChild("Torso")
	if not camera or not torso or not torso:IsA("BasePart") then
		return 0, 0
	end
	local direction = torso.CFrame:VectorToObjectSpace(camera.CFrame.LookVector)
	local yaw = math.atan2(-direction.X, -direction.Z) -- + = left
	local pitch = math.asin(math.clamp(direction.Y, -1, 1)) -- + = up
	if math.abs(yaw) > LOOK_BACK_LIMIT then
		return 0, 0
	end
	yaw = math.clamp(yaw * Config.HeadYawScale, -MAX_YAW, MAX_YAW)
	pitch = math.clamp(pitch * Config.HeadPitchScale, -MAX_PITCH, MAX_PITCH)
	return yaw, pitch
end

local function apply(neck: Motor6D, targetYaw: number, targetPitch: number)
	local state = states[neck]
	if not state then
		state = { baseC0 = neck.C0, yaw = 0, pitch = 0, steppedAt = 0 }
		states[neck] = state
		local connection: RBXScriptConnection
		connection = neck.AncestryChanged:Connect(function()
			if not neck:IsDescendantOf(game) then
				states[neck] = nil
				connection:Disconnect()
			end
		end)
	end
	-- Stepped, not smoothed: at most one jump per HeadStepInterval, and tiny changes are ignored.
	local now = os.clock()
	if now - state.steppedAt < Config.HeadStepInterval then
		return
	end
	if math.abs(targetYaw - state.yaw) < MIN_STEP and math.abs(targetPitch - state.pitch) < MIN_STEP then
		return
	end
	state.steppedAt = now
	state.yaw = targetYaw
	state.pitch = targetPitch
	local base = state.baseC0
	neck.C0 = CFrame.new(base.Position)
		* CFrame.Angles(0, targetYaw, 0)
		* CFrame.Angles(targetPitch, 0, 0)
		* base.Rotation
end

RunService.RenderStepped:Connect(function(dt: number)
	for _, player in Players:GetPlayers() do
		local character = player.Character
		if not character then
			continue
		end
		local neck = getNeck(character)
		if not neck then
			continue
		end

		local yaw, pitch = 0, 0
		if player == localPlayer then
			if HEAD_ENABLED and isAlive(character) then
				yaw, pitch = cameraTarget(character)
			end
			local twistValue = character:GetAttribute("BodyTurn") -- set by ShiftLock
			local twist = if typeof(twistValue) == "number" then twistValue else 0
			local now = os.clock()
			local changed = math.abs(yaw - lastSentYaw) > MIN_STEP * 0.5
				or math.abs(pitch - lastSentPitch) > MIN_STEP * 0.5
				or math.abs(twist - lastSentTwist) > TWIST_SEND_THRESHOLD
			if changed and now - lastSentAt >= SEND_INTERVAL then
				lastSentAt = now
				lastSentYaw, lastSentPitch, lastSentTwist = yaw, pitch, twist
				remote:FireServer(yaw, pitch, twist)
			end
		else
			local look = character:GetAttribute("HeadLook")
			if typeof(look) == "Vector2" and isAlive(character) then
				yaw, pitch = look.X, look.Y
			end
			local twistValue = character:GetAttribute("BodyTwist") -- set by HeadLookServer
			applyTwist(character, if typeof(twistValue) == "number" then twistValue else 0, dt)
		end
		if HEAD_ENABLED then
			apply(neck, yaw, pitch)
		end
	end
end)
]]></ProtectedString>
