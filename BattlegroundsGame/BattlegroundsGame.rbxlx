		Animation = "LotusGrab",
		AnimSpeed = 16 / 18, -- the animation is timed for the stage 3 grab's 16-frame startup
		Startup = 18,
		Active = 3,
		Recovery = 30,
		Damage = 8,
		Hitbox = { Size = Vector3.new(4, 5, 4), Forward = 2.5 },
		Grab = { Hold = 30, Throw = 12 },
